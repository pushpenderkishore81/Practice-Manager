<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>KSC Practice Manager 2</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
:root{
  --navy:#1f2a44;--navy2:#2c3a5c;--ink:#1d2433;--muted:#667085;--line:#e3e7ee;--bg:#f4f6fa;--card:#fff;
  --blue:#2e6bd6;--green:#1e8e3e;--greenbg:#e6f4ea;--red:#c62828;--redbg:#fdecea;--amber:#b26a00;--amberbg:#fff4e0;--greybg:#eef1f6;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;color-scheme:light;font-family:"Segoe UI",Calibri,Arial,sans-serif;font-size:13.5px;color:var(--ink);background:var(--bg)}
button,input,select,textarea{font:inherit;color:inherit}
[hidden]{display:none!important}
/* ---------- auth ---------- */
#auth{min-height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1f2a44 0%,#2c3a5c 55%,#3d4f7a 100%);padding:20px}
.authbox{background:#fff;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.35);width:100%;max-width:420px;padding:32px 34px}
.brand{display:flex;align-items:center;gap:12px;margin-bottom:6px}
.logo{width:42px;height:42px;border-radius:10px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:17px;letter-spacing:.5px}
.authbox h1{font-size:19px;margin:0}
.authbox .sub{color:var(--muted);font-size:12.5px;margin:0 0 22px}
.field{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.field label{font-size:12px;font-weight:600;color:#475467}
.field input,.field select,.field textarea{border:1px solid #cfd5df;border-radius:8px;padding:8px 10px;background:#fff;outline:none;width:100%}
.field textarea{min-height:64px;resize:vertical}
.field input[type=checkbox],.field input[type=radio]{width:auto;padding:0}
.mtSvc{min-width:130px}.mtPer{min-width:120px}.mtForm{min-width:170px}
#mtT td{vertical-align:middle}#mtT input,#mtT select{border:1px solid #cfd5df;border-radius:6px;padding:5px 6px}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(46,107,214,.15)}
.req::after{content:" *";color:var(--red)}
.btn{border:1px solid #cfd5df;background:#fff;border-radius:8px;padding:7px 13px;cursor:pointer;font-weight:600;font-size:12.5px;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.btn:hover{background:#f2f4f8}
.btn.primary{background:var(--navy);border-color:var(--navy);color:#fff}
.btn.primary:hover{background:var(--navy2)}
.btn.danger{color:var(--red);border-color:#f0c4c4}
.btn.danger:hover{background:var(--redbg)}
.btn.sm{padding:4px 9px;font-size:12px;margin:2px 0}
.btn.block{width:100%;justify-content:center;padding:10px}
.link{background:none;border:none;color:var(--blue);cursor:pointer;padding:0;font-size:12.5px}
.err{color:var(--red);font-size:12.5px;min-height:18px;margin:4px 0 8px}
.meter{height:5px;border-radius:3px;background:#e6e9ef;overflow:hidden;margin-top:4px}
.meter i{display:block;height:100%;width:0;transition:width .2s}
.secnote{font-size:11.5px;color:var(--muted);margin-top:16px;line-height:1.5;border-top:1px solid var(--line);padding-top:12px}
/* ---------- app shell ---------- */
#app{display:flex;height:100%}
#side{width:218px;background:var(--navy);color:#cdd5e6;display:flex;flex-direction:column;flex-shrink:0}
#side .brand{padding:18px 16px 14px;margin:0;border-bottom:1px solid rgba(255,255,255,.08)}
#side .logo{background:#fff;color:var(--navy);width:36px;height:36px;font-size:14px}
#side .firm{font-weight:700;color:#fff;font-size:13px;line-height:1.25}
#side .firm small{display:block;font-weight:400;color:#9fb0cf;font-size:11px}
#nav{padding:10px 8px;flex:1;overflow:auto}
#nav a{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;color:#cdd5e6;text-decoration:none;cursor:pointer;margin-bottom:2px;font-weight:500}
#nav a:hover{background:rgba(255,255,255,.07);color:#fff}
#nav a.on{background:#fff;color:var(--navy);font-weight:700}
#nav .ico{width:18px;text-align:center;font-size:14px}
#nav a[data-badge]:not([data-badge=""])::after{content:attr(data-badge);margin-left:auto;background:#e53935;color:#fff;border-radius:10px;padding:0 7px;font-size:11px;font-weight:700}
#nav .grp{font-size:10.5px;text-transform:uppercase;letter-spacing:.8px;color:#7f90b3;padding:12px 12px 4px}
#nav button.grp{display:flex;align-items:center;gap:6px;width:100%;background:none;border:none;text-align:left;cursor:pointer;border-radius:2px;font-size:10.5px;text-transform:uppercase;letter-spacing:.8px;color:#7f90b3;padding:12px 12px 4px}
#nav button.grp:hover{color:#fff}#nav button.grp span:first-child{flex:1}
#nav button.grp .chev{font-size:10px;transition:transform .15s}#nav button.grp.closed .chev{transform:rotate(-90deg)}#nav button.grp.closed{padding-bottom:8px}
#nav button.grp .gb{background:#e53935;color:#fff;border-radius:10px;padding:0 6px;font-size:10px;letter-spacing:0}
#side .who{padding:12px 14px;border-top:1px solid rgba(255,255,255,.08);font-size:12px}
#side .who b,#side .me b{color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#side .me{padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.08);font-size:12px}#side .me .mebtn{margin:0}
.logo.haslogo{background:#fff!important;border-color:#fff!important;padding:3px;overflow:hidden}
.mebtn{display:flex;gap:10px;align-items:center;width:100%;background:none;border:1px solid transparent;border-radius:6px;padding:4px;margin:-4px -4px 2px;cursor:pointer;color:inherit;font:inherit}.mebtn:hover{border-color:rgba(255,255,255,.18);background:rgba(255,255,255,.05)}
#main{flex:1;display:flex;flex-direction:column;min-width:0}
#top{height:56px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px;padding:0 20px;flex-shrink:0}
#top h2{font-size:16px;margin:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gsearch{position:relative}
.gsearch input{border:1px solid #cfd5df;border-radius:8px;padding:7px 10px 7px 30px;width:280px;background:#f8f9fb}
.gsearch::before{content:"⌕";position:absolute;left:10px;top:5px;color:#98a2b3;font-size:16px}
.gsearch .res{position:absolute;top:38px;left:0;right:0;background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:0 10px 30px rgba(0,0,0,.12);z-index:30;max-height:320px;overflow:auto}
.gsearch .res div{padding:8px 12px;cursor:pointer;border-bottom:1px solid #f1f3f6}
.gsearch .res div:hover{background:#f4f7fd}
#view{flex:1;overflow:auto;padding:20px}
#navT{display:none}
@media(max-width:820px){
  #app{flex-direction:column;height:auto;min-height:100%}
  #side{width:100%;position:sticky;top:0;z-index:20}
  #side .brand{padding:10px 14px}
  #nav,#side .who,#side .me{display:none}
  body.navopen #nav,body.navopen #side .who,body.navopen #side .me{display:block}
  #nav{max-height:60vh}
  #navT{display:inline-flex}
  #top{height:auto;flex-wrap:wrap;padding:10px max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px));gap:8px}
  .gsearch,.gsearch input{width:100%}
  #view{padding:14px max(16px,env(safe-area-inset-right,0px)) 14px max(16px,env(safe-area-inset-left,0px));overflow:visible}
  .fgrid{grid-template-columns:1fr}
  .toolbar input[type=search]{width:100%}
  .two{grid-template-columns:1fr}
  .authbox{padding:24px 20px}
  .mbox{max-width:100%!important}
  #modal{padding:12px}
}
/* ---------- components ---------- */
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
.card h3{margin:0 0 12px;font-size:14px}
.grid{display:grid;gap:14px}
.kpis{grid-template-columns:repeat(auto-fit,minmax(160px,1fr))}
.kpi{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px;cursor:pointer}
.kpi:hover{border-color:#b9c4d8}
.kpi .l{font-size:11.5px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px}
.kpi .v{font-size:24px;font-weight:700;margin-top:6px}
.kpi.red .v{color:var(--red)} .kpi.amber .v{color:var(--amber)} .kpi.green .v{color:var(--green)}
.two{grid-template-columns:1fr 1fr}
@media(max-width:1100px){.two{grid-template-columns:1fr}}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
.toolbar .sp{flex:1}
.toolbar input,.toolbar select{border:1px solid #cfd5df;border-radius:8px;padding:6px 9px;background:#fff;max-width:200px}
.toolbar input[type=search]{width:220px}
.tablewrap{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:auto}
table.t{border-collapse:collapse;width:100%;font-size:12.5px}
table.t th{background:#f6f8fb;text-align:left;font-weight:700;color:#475467;padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap;position:sticky;top:0;cursor:pointer;user-select:none}
table.t th.num,table.t td.num{text-align:right}
table.t td{padding:8px 10px;border-bottom:1px solid #f0f2f5;vertical-align:top;white-space:nowrap}
table.t tbody tr:hover{background:#f8fafd;cursor:pointer}
table.t tfoot td{font-weight:700;background:#f6f8fb;border-top:1px solid var(--line)}
.empty{padding:40px;text-align:center;color:var(--muted)}
.chip{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11.5px;font-weight:600;white-space:nowrap;background:var(--greybg);color:#475467}
.chip.green{background:var(--greenbg);color:var(--green)} .chip.red{background:var(--redbg);color:var(--red)}
.chip.amber{background:var(--amberbg);color:var(--amber)} .chip.blue{background:#e8f0fe;color:#1a56c4}
.muted{color:var(--muted)} .small{font-size:11.5px} .b{font-weight:700} .red{color:var(--red)} .green{color:var(--green)}
.count{color:var(--muted);font-size:12px;margin:8px 2px}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin:16px 0 12px}
.tabs button{border:none;background:none;padding:9px 14px;cursor:pointer;font-weight:600;color:var(--muted);border-bottom:2px solid transparent}
.tabs button.on{color:var(--navy);border-bottom-color:var(--navy)}
.dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px 24px}
.dl div span{display:block;font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.3px}
.bar{height:8px;background:#edf0f5;border-radius:4px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--blue)}
/* ---------- multi-select filter ---------- */
.ms{position:relative;display:inline-block}
.ms>.btn{font-weight:500}
.ms>.btn.on{border-color:var(--blue);color:var(--blue);background:#f2f6fd}
.ms-pop{position:absolute;top:36px;left:0;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px rgba(0,0,0,.15);z-index:40;width:280px;padding:8px}
.ms-pop input[type=search]{width:100%;max-width:none;margin-bottom:6px}
.ms-list{max-height:260px;overflow:auto}
.ms-list label{display:flex;gap:7px;align-items:center;padding:4px 4px;font-size:12.5px;border-radius:6px;cursor:pointer}
.ms-list label:hover{background:#f4f7fd}
table.t.cw th{position:sticky;top:0;padding:0;user-select:none}
table.t.cw th>.cc{padding:9px 10px;overflow:hidden;text-overflow:ellipsis}
table.t.cw td{padding:0}table.t.cw td>.cc{padding:8px 10px;overflow:hidden;text-overflow:ellipsis}
table.t.cw.wrap td{white-space:normal}table.t.cw.wrap td>.cc{white-space:normal;overflow-wrap:break-word}
table.t.cw th .rz{position:absolute;top:0;right:-3px;width:8px;height:100%;cursor:col-resize;z-index:3}
table.t.cw th .rz:hover,body.colres table.t.cw th .rz{background:rgba(46,107,214,.35)}
body.colres,body.colres *{cursor:col-resize!important;user-select:none}
table.t.cw th.dragging{opacity:.45}table.t.cw th.dropL{box-shadow:inset 3px 0 0 var(--blue)}table.t.cw th.dropR{box-shadow:inset -3px 0 0 var(--blue)}
table.t.cw td.selc,table.t.cw th:first-child{padding:8px 10px}
#bell{position:relative;font-size:15px;padding:5px 10px}#bell.has{border-color:#f1b0ac;background:#fff5f4}
#bellN{position:absolute;top:-6px;right:-6px;background:#e53935;color:#fff;border-radius:10px;font-size:10.5px;padding:0 6px;line-height:17px}
#bell.ring{animation:ring .9s ease 2}@keyframes ring{0%,100%{transform:rotate(0)}20%{transform:rotate(14deg)}40%{transform:rotate(-12deg)}60%{transform:rotate(8deg)}80%{transform:rotate(-4deg)}}
@media (prefers-reduced-motion: reduce){#bell.ring{animation:none}}
.bellpop{position:fixed;z-index:90;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(0,0,0,.18);width:340px;max-width:calc(100vw - 16px)}
.bellpop a{display:block;padding:9px 10px;border-bottom:1px solid #f1f3f6;cursor:pointer;font-size:12.5px;color:var(--ink);text-decoration:none}.bellpop a:hover{background:#f4f7fd}
.swb{min-width:30px;width:auto;height:22px;border-radius:6px;border:1px solid rgba(0,0,0,.15);cursor:pointer;font-size:10.5px;color:#475467;padding:0 6px;vertical-align:middle}.swb:hover{outline:2px solid #1d2433;outline-offset:1px}
.colpop{position:fixed;z-index:95;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(0,0,0,.18);padding:12px;width:220px}
.colpop [data-c]{width:28px;height:28px;border-radius:6px;border:1px solid rgba(0,0,0,.12);cursor:pointer;padding:0}
.cfb{border:1px solid #d5dbe5;background:#fff;border-radius:5px;font-size:10px;line-height:1;padding:2px 4px;margin-right:6px;cursor:pointer;color:#667085;vertical-align:1px}.cfb:hover{border-color:var(--blue);color:var(--blue)}
.cfb.on{background:var(--blue);border-color:var(--blue);color:#fff}
.cfpop{position:fixed;z-index:95;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(0,0,0,.18);padding:12px;width:280px;font-weight:400;text-transform:none}
.cfrow{display:flex;gap:8px;align-items:center;padding:4px 2px;font-size:12.5px;cursor:pointer;border-radius:6px}.cfrow:hover{background:#f4f7fd}
.pfb{border:none;background:none;cursor:pointer;padding:2px 3px;border-radius:5px;line-height:1;font-size:13px;opacity:.35;display:inline-flex}.pfb:hover{background:#eef2fb;opacity:1}.pfb.on{opacity:1}.pfb[data-flag]{opacity:1}
table.t tr.pinned td{background:#fffbea}
.flagmenu{position:fixed;z-index:90;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px rgba(0,0,0,.18);padding:6px;width:220px;display:flex;flex-direction:column}
.flagmenu button{border:none;background:none;text-align:left;padding:7px 8px;border-radius:6px;cursor:pointer;display:flex;gap:8px;align-items:center;font-size:12.5px}.flagmenu button:hover{background:#f4f7fd}
.umenu-pop{width:230px;padding:6px 0;border-radius:6px}.umenu-pop button{padding:8px 14px;border-radius:0;gap:10px;color:var(--ink)}.umenu-pop button svg{flex-shrink:0;color:#5B6872}
.umenu-pop button:hover,.umenu-pop button:focus-visible{background:#EEF4F1;outline:none}.umenu-pop button.danger,.umenu-pop button.danger svg{color:var(--red)}.umenu-pop hr{border:none;border-top:1px solid var(--line);margin:6px 0}
.umenu-pop .umh{padding:6px 14px 8px;font-weight:600;font-size:12.5px;border-bottom:1px solid var(--line);margin-bottom:6px;display:flex;flex-direction:column}.umenu-pop .umh span{font-weight:400;color:var(--muted);font-size:11.5px}
.teamt th{white-space:normal;vertical-align:bottom}.teamt td{vertical-align:middle}.teamt .pwc{white-space:nowrap}.btn.ib{padding:4px 6px;margin-left:4px}.btn.ib.on{border-color:var(--blue);color:var(--blue)}
.btn.umenu[aria-expanded="true"]{border-color:var(--blue);color:var(--blue)}
.notice{background:#eef4ff;border:1px solid #c9d8f5;border-radius:10px;padding:8px 12px;margin-bottom:8px;font-size:12.5px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}.notice.warn{background:#fff6e5;border-color:#f1d29a}
#bulkBar:not(:empty){display:flex;gap:8px;align-items:center;flex-wrap:wrap;background:#eef2fb;border:1px solid #c9d6f3;border-radius:10px;padding:8px 12px;margin-bottom:10px}
/* ---------- trackers ---------- */
table.trk{border-collapse:separate;border-spacing:0;font-size:12px;width:100%}
table.trk th{background:#f6f8fb;color:#475467;font-weight:700;padding:7px 6px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:2;white-space:nowrap;text-align:center}
table.trk th.l,table.trk td.l{text-align:left;position:sticky;left:0;background:#fff;z-index:1;min-width:200px;max-width:260px;border-right:1px solid var(--line)}
table.trk th.l{background:#f6f8fb;z-index:3}
table.trk td.f{text-align:left;position:sticky;left:200px;background:#fff;z-index:1;white-space:nowrap;border-right:1px solid var(--line);color:#475467;font-weight:600}
table.trk th.f{position:sticky;left:200px;z-index:3;text-align:left}
table.trk td{padding:5px 5px;border-bottom:1px solid #eef0f4;text-align:center;vertical-align:middle}
table.trk tr.first td{border-top:2px solid #e3e7ee}
table.trk td.cell{cursor:pointer;min-width:74px}
table.trk td.cell:hover{background:#f4f7fd}
table.trk td.cell.add:hover::after{content:"＋";color:#98a2b3}
.tc{display:inline-block;border-radius:6px;padding:2px 6px;font-size:11px;font-weight:600;white-space:nowrap;margin:1px 0;line-height:1.35}
.tc.ok{background:var(--greenbg);color:var(--green)} .tc.late{background:#fde7d9;color:#b4380d} .tc.od{background:var(--redbg);color:var(--red)}
.tc.soon{background:var(--amberbg);color:var(--amber)} .tc.pend{background:var(--greybg);color:#475467} .tc.rev{background:#e8f0fe;color:#1a56c4} .tc.na{background:#f3f3f3;color:#999;text-decoration:line-through}
.tc.amt{background:#eef7ee;color:#2d6a33;font-weight:500}
#tGrid.selmode td.cell{cursor:copy}#tGrid.selmode .tc[data-w]{outline:1px dashed #b0b7c3;outline-offset:1px}#tGrid .tc.picked{outline:2px solid var(--blue)!important;box-shadow:0 0 0 3px rgba(46,107,214,.2)}
#tGrid.selmode .tc[data-w]::before{content:"☐ "}#tGrid .tc.picked::before{content:"☑ "!important}
.tc small.udn{margin-top:2px;padding-top:2px;border-top:1px dotted currentColor;font-weight:600}.tc small.udn.n{color:#B45309}
.tc small{display:block;font-weight:500;font-size:10px;opacity:.85}.tc.prog{background:#e8f0fe;color:#1a56c4}
.legend{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:11.5px;color:var(--muted)}
/* ---------- modal ---------- */
#modal{position:fixed;inset:0;background:rgba(16,24,40,.45);display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;z-index:50;overflow:auto}
.mbox{background:#fff;border-radius:14px;width:100%;max-width:820px;box-shadow:0 24px 60px rgba(0,0,0,.3)}
.mbox.narrow{max-width:520px}
.mhead{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.mhead h3{margin:0;font-size:15px}
.mbody{padding:18px 20px;max-height:calc(100vh - 220px);overflow:auto}
.mfoot{padding:12px 20px;border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end;align-items:center}
.mfoot .sp{flex:1}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}
.fgrid .full{grid-column:1/-1}
.checks{display:flex;flex-wrap:wrap;gap:6px 14px;padding:6px 0}
.calwrap{max-width:100%}.cal{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--card)}
.calh,.calr{display:grid;grid-template-columns:repeat(7,minmax(0,1fr)) 110px}.calh div{padding:7px 8px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#5b6b78;border-bottom:2px solid #0D1A26;background:#f4f6f5}
.cald{all:unset;box-sizing:border-box;display:block;min-height:104px;padding:6px 7px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);cursor:pointer;font-size:11.5px;overflow:hidden}.cald:hover{outline:2px solid #0A6B4C;outline-offset:-2px}.cald:focus-visible{outline:2px solid #0A6B4C;outline-offset:-2px}
.cald.out{opacity:.45}.cald.today .cdn span{background:#0A6B4C;color:#fff;border-radius:10px;padding:0 6px}.cald.sel{outline:2px solid #0D1A26;outline-offset:-2px}
.cdn{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin-bottom:3px}.cdn b{font-size:11px;background:#0D1A26;color:#fff;border-radius:9px;padding:0 6px}
.cdi{display:flex;align-items:center;gap:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.5}.cdi i{flex:none;width:7px;height:7px;border-radius:2px}.cdi.over{color:#B3261E;font-weight:600}.cdi.done{opacity:.55;text-decoration:line-through}.cdi.more{color:#5b6b78}
.calw{padding:8px;border-bottom:1px solid var(--line);background:#f8faf9;font-size:12px;display:flex;flex-direction:column;justify-content:center;gap:4px}.calw b{font-size:18px}.calw .bar{height:6px;background:#e3e8e6;border-radius:3px;overflow:hidden}.calw .bar i{display:block;height:100%;background:#D67828}.calw.busy{background:#FFF3E6}.calw.busy .small{color:#B45309;font-weight:600}
.kmenu{position:absolute;z-index:150;background:#fff;border:1px solid #cfd8d5;border-radius:8px;box-shadow:0 12px 32px rgba(0,0,0,.18);min-width:300px;max-width:340px;padding:4px 0;max-height:70vh;overflow:auto}
.kmenu button[role=menuitem]{all:unset;box-sizing:border-box;display:block;width:100%;padding:7px 12px;cursor:pointer;font-size:13px}.kmenu button[role=menuitem]:hover,.kmenu button[role=menuitem]:focus-visible{background:#EEF3F1}
.kmh{font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:#6b7b86;padding:8px 12px 3px}.kmsep{border-top:1px solid #e3e8e6;margin:4px 0}.kmrow{display:flex;align-items:center}.kmrow button[role=menuitem]{flex:1}.kmx{all:unset;cursor:pointer;padding:4px 10px;color:#8a97a0}.kmx:hover{color:#B3261E}
.kpal{position:fixed;inset:0;z-index:300;background:rgba(13,26,38,.45);display:flex;justify-content:center;align-items:flex-start;padding:12vh 16px 16px}
.kbox{width:100%;max-width:640px;background:#fff;border-radius:12px;box-shadow:0 24px 60px rgba(0,0,0,.35);overflow:hidden}.kbox input{width:100%;box-sizing:border-box;border:none;border-bottom:1px solid #e3e8e6;padding:16px 18px;font-size:17px;outline:none}
#kres{max-height:52vh;overflow:auto;padding:4px 0}.kit{display:flex;gap:10px;align-items:center;padding:8px 18px;cursor:pointer}.kit.on{background:#E8F2EE}.kic{width:22px;text-align:center}.kt{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:55%}.ks{color:#6b7b86;font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;text-align:right}
.kempty{padding:18px;color:#6b7b86}.kfoot{display:flex;gap:14px;padding:8px 18px;border-top:1px solid #e3e8e6;font-size:11.5px;color:#6b7b86;background:#f8faf9}
@media (max-width:760px){.calh,.calr{grid-template-columns:repeat(7,minmax(0,1fr))}.calh div:last-child,.calw{display:none}.cald{min-height:64px}.cdi{display:none}}
.pkgbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:2px 0 4px}.svgrid th.svh{font-size:10.5px;text-align:center;white-space:normal;min-width:46px;padding-left:4px;padding-right:4px;line-height:1.2}.svgrid td.svc{text-align:center}.svgrid td.svc input{width:16px;height:16px;cursor:pointer}.svgrid tfoot td{position:sticky;bottom:0;background:var(--card)}
.checks label{font-weight:400;font-size:12.5px;display:flex;gap:5px;align-items:center;color:var(--ink)}
.picklist{border:1px solid var(--line);border-radius:8px;max-height:200px;overflow:auto;padding:6px 10px}
.picklist label{display:flex;gap:8px;padding:3px 0;font-size:12.5px;align-items:center}
#toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;padding:10px 18px;border-radius:8px;font-size:13px;z-index:80;box-shadow:0 8px 24px rgba(0,0,0,.25)}
/* ---------- print ---------- */
#printArea{display:none}
@media print{
  @page{size:A4 landscape;margin:12mm}
  body{background:#fff}
  #auth,#app,#modal,#toast{display:none!important}
  #printArea{display:block;font-family:Arial,sans-serif;font-size:10px;color:#000}
  #printArea .ph{border-bottom:2px solid #1f2a44;padding-bottom:6px;margin-bottom:10px}
  #printArea .ph .fn{font-size:15px;font-weight:700;color:#1f2a44}
  #printArea .ph .fa{font-size:9.5px;color:#444}
  #printArea h2{font-size:13px;margin:8px 0 2px}
  #printArea .pm{font-size:9.5px;color:#444;margin-bottom:8px}
  #printArea table{border-collapse:collapse;width:100%}
  #printArea th{background:#1f2a44!important;color:#fff!important;-webkit-print-color-adjust:exact;print-color-adjust:exact;font-size:9.5px;padding:5px;text-align:left;border:1px solid #1f2a44}
  #printArea td{border:1px solid #bbb;padding:4px 5px;font-size:9.5px;vertical-align:top}
  #printArea td.num,#printArea th.num{text-align:right}
  #printArea tfoot td{font-weight:700;background:#eef1f6!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  #printArea .pf{margin-top:14px;font-size:9px;color:#666;display:flex;justify-content:space-between}
  #printArea .sec{margin-top:14px}
  #printArea .kv{display:grid;grid-template-columns:repeat(3,1fr);gap:4px 18px;font-size:10px;margin-bottom:8px}
  #printArea tr{page-break-inside:avoid}
}
</style>
<style id="kscLedgerTheme">
/* Ledger theme: matches the Kishore Sharma & Co website. Ink sidebar, ruled paper, ledger-green accent, marigold marks. Light-only by design. */
:root{--navy:#0D1A26;--navy2:#1B2C3B;--ink:#0D1A26;--muted:#4B5A62;--line:#D4DEDA;--bg:#EDF1EF;--card:#F8FAF9;
  --blue:#0A6B4C;--green:#2E7D32;--greenbg:#E4F2E6;--mark:#D9930B;--greybg:#E6ECEA;
  --disp:"Bricolage Grotesque",ui-sans-serif,system-ui,sans-serif;--sans:"IBM Plex Sans","Segoe UI",Arial,sans-serif;--mono:"IBM Plex Mono",ui-monospace,Menlo,monospace}
html,body{font-family:var(--sans);background:var(--bg)}
#view{background-image:repeating-linear-gradient(to bottom,transparent 0 31px,rgba(201,213,209,.45) 31px 32px)}
h1,h2,h3,.mhead h3{font-family:var(--disp);letter-spacing:-.015em}
/* login */
#auth{background:#0D1A26 repeating-linear-gradient(to bottom,transparent 0 31px,rgba(237,241,239,.06) 31px 32px)}
.authbox{border-radius:2px;border-top:4px solid var(--mark);box-shadow:0 30px 70px -20px rgba(0,0,0,.6)}
.authbox h1{font-size:24px;font-weight:800}
.logo{border-radius:50%;background:transparent;border:2px solid var(--blue);color:var(--blue);font-family:var(--disp);font-weight:800;letter-spacing:-.04em}
#side .logo{background:transparent;border-color:var(--mark);color:var(--mark)}
/* controls */
.btn{border-radius:2px;border-color:#B9C7C2;background:#fff}
.btn:hover{background:#EEF3F1}
.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}
.btn.primary:hover{background:#085A40}
.field input,.field select,.field textarea,.toolbar input,.toolbar select,.gsearch input,#mtT input,#mtT select{border-radius:2px;border-color:#C3D0CB}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(10,107,76,.15)}
.field label{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:500;color:var(--muted)}
:focus-visible{outline:2px solid var(--mark);outline-offset:2px}
/* shell */
#side{background:#0D1A26;color:#B8C6C2}
#side .firm{font-family:var(--disp);font-size:14px}
#side .firm small{font-family:var(--mono);color:#7F948F;letter-spacing:.06em;text-transform:uppercase;font-size:10px}
#nav a{border-radius:2px;color:#B8C6C2;border-left:3px solid transparent}
#nav a.on{background:#EDF1EF;color:#0D1A26;border-left-color:var(--mark)}
#nav .grp{font-family:var(--mono);color:#6E8580;letter-spacing:.14em}
#top{background:var(--card);border-bottom:2px solid var(--ink)}
#top h2{font-size:20px;font-weight:800}
.gsearch input{background:#fff}
/* surfaces */
.card,.tablewrap,.kpi,.mbox,.ms-pop,.bellpop,.colpop,.cfpop,.flagmenu,.gsearch .res{border-radius:2px}
.card,.tablewrap{background:var(--card)}
.kpi{background:var(--card);border-top:2px solid var(--ink)}
.kpi:hover{border-color:var(--blue)}
.kpi .l{font-family:var(--mono);font-weight:500;letter-spacing:.1em;font-size:10.5px}
.kpi .v{font-family:var(--mono);font-weight:500;font-variant-numeric:tabular-nums}
table.t th,table.trk th{background:#E9EFEC;font-family:var(--mono);font-weight:500;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);border-bottom:2px solid var(--ink)}
table.t td.num,table.t tfoot td{font-family:var(--mono);font-variant-numeric:tabular-nums}
table.t tfoot td{background:#E9EFEC}
table.t tbody tr:hover,table.trk td.cell:hover{background:#EEF4F1}
table.trk th.l,table.trk th.f{background:#E9EFEC}
.tabs{border-bottom:1px solid var(--line)}
.tabs button.on{color:var(--ink);border-bottom-color:var(--mark)}
.chip.blue,.tc.rev,.tc.prog{background:#E2F0EA;color:#0A6B4C}
.bar i{background:var(--blue)}
.ms>.btn.on{border-color:var(--blue);color:var(--blue);background:#EEF4F1}
.mhead{border-bottom:2px solid var(--ink)}
#modal{background:rgba(13,26,38,.5)}
#toast{background:var(--ink);border-left:4px solid var(--mark);border-radius:2px;font-family:var(--mono);font-size:12.5px}
.notice{border-radius:2px;background:#EAF3EF;border-color:#BFD9CD}
#bulkBar:not(:empty){border-radius:2px;background:#EAF3EF;border-color:#BFD9CD}
@media print{#printArea .ph{border-bottom-color:#0D1A26}#printArea .ph .fn{color:#0D1A26}#printArea th{background:#0D1A26!important;border-color:#0D1A26}}
</style>


<!-- ======================= AUTH ======================= -->
<div id="auth">
  <div class="authbox">
    <div class="brand"><div class="logo" id="authLogo">PM</div><div><h1 id="authTitle">Practice Manager</h1></div></div>
    <p class="sub" id="authSub">Client work, compliance &amp; billing tracker</p>

    <form id="setupForm" hidden autocomplete="off">
      <div class="field"><label class="req">Firm name</label><input id="suFirm" required maxlength="120" placeholder="e.g. Kishore Sharma &amp; Co."></div>
      <div class="field"><label class="req">Your user name</label><input id="suUser" required maxlength="40" placeholder="e.g. pushpender"></div>
      <div class="field"><label class="req">Master password</label><input id="suPass" type="password" required minlength="10" autocomplete="new-password"><div class="meter"><i id="suMeter"></i></div><span class="small muted" id="suHint">At least 10 characters with letters, numbers and a symbol.</span></div>
      <div class="field"><label class="req">Confirm password</label><input id="suPass2" type="password" required autocomplete="new-password"></div>
      <div class="err" id="suErr"></div>
      <button class="btn primary block" type="submit">Create secure workspace</button>
      <div class="secnote">Your data is encrypted on this computer with AES-256 using a key derived from your password. <b>There is no password recovery</b> – if you forget it, the data cannot be opened. Keep a backup (Settings › Backup).<br><br>
      <button class="link" type="button" id="suRestore">Already have a backup file? Restore it</button></div>
    </form>

    <form id="loginForm" hidden autocomplete="off">
      <div class="field"><label>User name</label><input id="liUser" required maxlength="40" autocomplete="username"></div>
      <div class="field"><label>Password</label><input id="liPass" type="password" required autocomplete="current-password"></div>
      <div class="err" id="liErr"></div>
      <button class="btn primary block" type="submit" id="liBtn">Unlock</button>
      <div class="secnote"><span id="liNote">🔒 Data stays on this computer, encrypted. The app makes no internet connections.</span><br>
      <button class="link" type="button" id="liRestore">Restore from a backup file</button><div class="small muted" id="authVer" style="margin-top:8px"></div></div>
    </form>
    <input type="file" id="restoreFile" accept=".kscbak,.json,application/json" hidden>
  </div>
</div>

<!-- ======================= APP ======================= -->
<div id="app" hidden>
  <aside id="side">
    <div class="brand"><div class="logo" id="sideLogo">KS</div><div class="firm" id="sideFirm">Firm<small>Practice Manager</small></div></div>
    <div class="me"><button type="button" class="mebtn" id="meBtn" title="My profile – change name and photo"><span id="meAv"></span><span style="display:flex;flex-direction:column;min-width:0;text-align:left"><b id="whoName"></b><span><span class="chip" id="whoRole"></span> <span class="small" style="color:#9fb0cf">Edit profile</span></span></span></button></div>
    <nav id="nav"></nav>
    <div class="who">
      <button class="btn sm" id="lockBtn" style="margin-top:8px;background:transparent;color:#fff;border-color:rgba(255,255,255,.3)">🔒 Lock now</button>
      <button type="button" class="link" id="verBtn" title="See what's new" style="display:block;margin-top:10px;color:#9fb0cf;font-size:11px"></button></div>
  </aside>
  <main id="main">
    <header id="top"><button class="btn sm" id="navT" aria-label="Menu">☰</button><h2 id="pageTitle">Dashboard</h2><span id="sync" class="small muted" hidden></span><button class="btn sm" id="bell" hidden title="Approvals waiting for you">🔔<b id="bellN" hidden></b></button>
      <div class="gsearch"><input id="gsearch" placeholder="Find client – name, code, PAN, GSTIN  ·  Ctrl+K for everything" autocomplete="off"><div class="res" id="gres" hidden></div></div>
    </header>
    <section id="view"></section>
  </main>
</div>

<div id="modal" hidden></div>
<div id="toast" hidden></div>
<div id="printArea"></div>

<script>
"use strict";
/* =====================================================================
   Practice Manager – single-file, offline, encrypted
   Storage: IndexedDB (encrypted vault) + optional linked auto-save file
   Crypto : PBKDF2-SHA256 (600,000 iterations) -> AES-256-GCM key-wrap of a random data key
   ===================================================================== */
const APPVER = "1.0"; // data format version – do not change (backups depend on it)
/* Software version – increase with every published change, newest first in CHANGES */
const RELEASE = { v: "2.22", at: "2026-11-12T00:44+05:30" }; // release date and time (IST)
const CHANGES = [
  ["2.22", "2026-11-12T00:44+05:30", ["Overview › Calendar: month view of every due date – returns, notices (latest adjourned date) and DSC expiries – with darker days for heavier load, a week-load column that marks the crunch week, filters by staff and service, and a day list that opens each task", "Saved views (★ Views in Work Tracker and Notices & Cases): ready-made views such as My overdue GST, Audits pending review, Due in the next 7 days, Data awaited; save your own filters as a view, for yourself or the whole team", "Ctrl+K quick search from anywhere: jump to any client (name, code, PAN, GSTIN), task (e.g. 'sharma 3b oct'), notice, saved view or page, or start a new task, client or notice – keyboard only"]],
  ["2.21", "2026-11-12T00:34+05:30", ["Compliance Trackers › Notices & Cases: every notice, scrutiny, reassessment, block assessment, show cause notice, penalty and appeal with department, section, AY, DIN, issuing officer, issue and due dates, status and amount", "Proceedings log: replies, adjournments, hearings, follow-ups and orders; the due date moves to the latest adjourned or hearing date", "Document checklist on every case (pending / requested / received) with ready lists for scrutiny, search, GST and demand cases", "Compliance Trackers › Search / Survey Groups: group everyone covered in a search, survey, seizure or raid, with each member's role, status, notices, due dates and documents, and a printable status sheet", "Dashboard alert for notices overdue or due in 7 days; new right 'Notices & cases' in Team & Rights (on for Staff, off for Interns)"]],
  ["2.20", "2026-11-12T00:02+05:30", ["Generate (GST, TDS and other trackers): the clients whose Services covered include that tracker's service are selected for you, with a 'show selected only' view", "Select clients by service, by package or by client type in one click", "Generate for: whole year, one month, one quarter, or a one-time task (your own task name and due date) for the selected clients"]],
  ["2.19", "2026-11-11T23:50+05:30", ["Clients › Services by client: one screen with every client and a tick box for each service, saved as you click, with filters and totals", "Service packages (ITR only, GST only, GST + ITR, GST + TDS + ITR, Tax audit client, Company – full compliance) – pick one to tick a set of services, then adjust per client", "Select several clients and apply a package, or add / remove one service, in one step", "Manage packages: rename, add or change packages to suit the firm", "Client form: Quick pick buttons above Services covered"]],
  ["2.18", "2026-11-11T23:38+05:30", ["Portal Logins: the encryption and Activity Log notice is shown to Admins only, not to staff or interns"]],
  ["2.17", "2026-11-11T23:33+05:30", ["Fix: portal login IDs and passwords now stay saved after logging in again", "Fix: staff and interns can be ticked in Who can see portal logins; Set password first button where a password is not recorded", "Fix: staff passwords recorded by the Admin are now kept in the online workspace"]],
  ["2.16", "2026-11-11T23:14+05:30", ["One client, many GSTINs: add every state registration of a business under the same client, each with its own label", "GST Tracker shows a separate row for each GSTIN, and Generate for the year creates returns for each GSTIN", "Tasks for a client with several GSTINs ask which GSTIN the return is for", "A GSTIN already under another client is blocked, and a second client with the same PAN needs confirmation", "Bulk import adds a new GSTIN to the existing client with the same PAN instead of creating another client", "Clients › Merge duplicates (Admin): combine clients that are the same business, moving all their records and GSTINs into one"]],
  ["2.15", "2026-11-11T23:00+05:30", ["DSC Register: holder, token location, expiry, with alerts on the dashboard 30 days before expiry", "Portal Logins: client logins for GST, Income Tax, MCA and more, encrypted with a separate key; the Admin chooses who else can see them", "Document Requests: checklists of documents pending from a client, with a ready WhatsApp / email message", "Engagement Letters: draft from a template, track sent and signed, with fee and UDIN"]],
  ["2.14", "2026-11-11T22:51+05:30", ["Your name, photo and Edit profile now sit at the top of the sidebar, under the firm name"]],
  ["2.13", "2026-11-11T22:45+05:30", ["Versions & rollback: the Admin can switch the app to any saved version with one click, and back again", "Every saved version keeps this option, so you can always return to the latest"]],
  ["2.12", "2026-11-11T22:41+05:30", ["Firm name & logo: the Admin can upload the firm's logo and change its name (click the firm name at the top of the sidebar, or Settings › Firm details)", "The logo shows in the sidebar and on the login screen, and can be used on invoices"]],
  ["2.11", "2026-11-11T22:38+05:30", ["My profile: change your display name and photo (click your name at the bottom of the sidebar)", "Photos shown in the sidebar and in Team & Rights; the Admin can change any user's photo", "Every version now shows its release date and time"]],
  ["2.10", "2026-11-11T22:34+05:30", ["Sidebar groups start folded at every login; the current page stays visible"]],
  ["2.9", "2026-11-11T22:30+05:30", ["Version number and release date shown in the app", "“What's new” history (Settings › About this software)"]],
  ["2.8", "2026-11-11T22:07+05:30", ["Admin can see staff and intern passwords – encrypted, opened only by Admin logins", "Team & Rights: one Manage ▾ menu per user; table fits the page"]],
  ["2.7", "2026-11-11T21:57+05:30", ["Only the Admin can set or change staff and intern passwords", "Set password dialog with strong-password generator and copy"]],
  ["2.6", "2026-11-11T21:52+05:30", ["Sidebar groups can be folded and unfolded"]],
  ["2.5", "2026-11-11T21:44+05:30", ["Billing: period filter – current / previous month, current / previous FY, any FY, custom dates", "Billing: drag to move and resize columns, column chooser"]],
  ["2.4", "2026-11-11T21:37+05:30", ["Bulk import of parties, invoices, receipts and opening balances from Excel", "Duplicate invoices skipped, balance check after import, undo"]],
  ["2.3", "2026-11-11T21:00+05:30", ["Clients can be made visible to the Admin only"]],
  ["2.2", "2026-11-11T00:38+05:30", ["Dashboard panels in a fixed order, sorted by due date, and collapsible"]],
  ["2.1", "2026-11-10T22:45+05:30", ["UDIN and UDIN date on tasks, shown in the compliance trackers", "UDIN Register shows tasks waiting for a UDIN"]],
  ["2.0", "2026-11-10T20:22+05:30", ["New look matching the Kishore Sharma & Co website; all features of KSC Practice Manager kept"]],
];
const relFmt = at => { const [d, t] = at.split("T"), hh = +t.slice(0, 2), mm = t.slice(3, 5); return `${d.split("-").reverse().join("-")}, ${(hh % 12) || 12}:${mm} ${hh < 12 ? "am" : "pm"} IST`; };
const verText = () => `Version ${RELEASE.v} · ${relFmt(RELEASE.at)}`;
const avatarOf = u => ((S.db && S.db.settings.avatars) || {})[u] || "";
function avatarHTML(u, size = 32) { const src = avatarOf(u), nm = uname(u) || u, ini = nm.split(/[\s._-]+/).filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join("") || "?";
  return src ? `<img src="${src}" alt="" width="${size}" height="${size}" style="width:${size}px;height:${size}px;border-radius:50%;object-fit:cover;flex-shrink:0;display:block">`
    : `<span aria-hidden="true" style="width:${size}px;height:${size}px;border-radius:50%;background:#2F4A5E;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:${Math.round(size * .38)}px;font-weight:600;flex-shrink:0">${esc(ini)}</span>`; }
function renderMe() { if ($("#meAv")) $("#meAv").innerHTML = avatarHTML(S.user, 34); if ($("#whoName")) $("#whoName").textContent = uname(S.user) || S.user; }
function shrinkPhoto(file) { return new Promise((res, rej) => { if (!/^image\//.test(file.type)) return rej(new Error("Choose a picture file (JPG or PNG).")); if (file.size > 15 * 1024 * 1024) return rej(new Error("That picture is larger than 15 MB."));
  const url = URL.createObjectURL(file), img = new Image(); img.onload = () => { const n = 192, c = document.createElement("canvas"); c.width = c.height = n; const k = Math.min(img.width, img.height), x = c.getContext("2d");
    x.drawImage(img, (img.width - k) / 2, (img.height - k) / 2, k, k, 0, 0, n, n); URL.revokeObjectURL(url); res(c.toDataURL("image/jpeg", .85)); };
  img.onerror = () => { URL.revokeObjectURL(url); rej(new Error("This picture could not be opened. Try a JPG or PNG.")); }; img.src = url; }); }
const firmInitials = n => (n || "PM").split(/\s+/).filter(w => /^[A-Za-z]/.test(w)).slice(0, 2).map(w => w[0].toUpperCase()).join("") || "PM";
function logoInto(el, src, name) { if (!el) return; if (src) { el.innerHTML = `<img src="${src}" alt="" style="width:100%;height:100%;object-fit:contain;border-radius:inherit">`; el.classList.add("haslogo"); } else { el.textContent = firmInitials(name); el.classList.remove("haslogo"); } }
function brandRender() { const f = S.db.settings.firm; $("#sideFirm").innerHTML = `${esc(f.name)}<small>Practice Manager</small>`; logoInto($("#sideLogo"), f.logo, f.name);
  const br = $("#side .brand"); if (br) { br.style.cursor = isAdmin() ? "pointer" : ""; br.title = isAdmin() ? "Change firm name and logo" : ""; br.onclick = isAdmin() ? () => firmDialog() : null; } }
function shrinkLogo(file) { return new Promise((res, rej) => { if (!/^image\//.test(file.type)) return rej(new Error("Choose a picture file (PNG, JPG or SVG).")); if (file.size > 15 * 1024 * 1024) return rej(new Error("That picture is larger than 15 MB."));
  const url = URL.createObjectURL(file), img = new Image(); img.onload = () => { const n = 256, c = document.createElement("canvas"); c.width = c.height = n; const w = img.naturalWidth || n, h = img.naturalHeight || n, k = Math.min(n / w, n / h);
    c.getContext("2d").drawImage(img, (n - w * k) / 2, (n - h * k) / 2, w * k, h * k); URL.revokeObjectURL(url); res(c.toDataURL("image/png")); };
  img.onerror = () => { URL.revokeObjectURL(url); rej(new Error("This picture could not be opened. Try a PNG or JPG.")); }; img.src = url; }); }
function firmDialog() {
  if (!isAdmin()) return toast("Only the Admin can change the firm name and logo");
  const f = S.db.settings.firm, B = BS(); let logo = f.logo || "";
  const m = openModal(`<div class="mhead"><h3>Firm name & logo</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap"><div id="fdL" class="logo" style="width:96px;height:96px;font-size:30px;border-radius:12px;background:#fff;color:var(--navy);border:1px solid var(--line)"></div>
      <div style="display:flex;flex-direction:column;gap:8px"><label class="btn" style="cursor:pointer">🖼 <span id="fdUp">${logo ? "Change logo" : "Upload logo"}</span><input type="file" id="fdF" accept="image/*" hidden></label><button type="button" class="btn" id="fdR" ${logo ? "" : "hidden"}>Remove logo</button>
        <span class="small muted">PNG with a transparent background looks best.</span></div></div>
    <div class="field" style="margin-top:16px"><label class="req" for="fdN">Firm name</label><input id="fdN" maxlength="120" value="${esc(f.name || "")}"></div>
    <label class="small" style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="fdB" ${!B.logo || B.logo === f.logo ? "checked" : ""}> Also use this logo on invoices</label>
    <p class="small muted">Shown at the top of the sidebar and on the login screen for everyone in the firm.</p><div class="err" id="fdE"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="fdX">Cancel</button><button class="btn primary" id="fdY">Save</button></div>`, true);
  const show = () => { logoInto($("#fdL", m), logo, $("#fdN", m).value); $("#fdR", m).hidden = !logo; $("#fdUp", m).textContent = logo ? "Change logo" : "Upload logo"; };
  show(); $("#fdN", m).oninput = () => { if (!logo) show(); };
  $("#fdF", m).onchange = async e => { const x = e.target.files[0]; if (!x) return; try { logo = await shrinkLogo(x); $("#fdE", m).textContent = ""; show(); } catch (err) { $("#fdE", m).textContent = err.message; } e.target.value = ""; };
  $("#fdR", m).onclick = () => { logo = ""; show(); };
  $("#mx", m).onclick = $("#fdX", m).onclick = closeModal;
  $("#fdY", m).onclick = async () => { const nm = $("#fdN", m).value.trim(); if (!nm) return $("#fdE", m).textContent = "Enter the firm name.";
    const old = f.logo || ""; f.name = nm; if (logo) f.logo = logo; else delete f.logo;
    if ($("#fdB", m).checked) { if (logo) B.logo = logo; else if (B.logo === old) B.logo = ""; }
    S.vault.firm = nm; S.vault.logo = logo; log("Edited", "Settings", `Firm name and logo – ${nm}`); await saveNow(); closeModal(); toast("Firm details saved"); brandRender(); if (S.route === "settings") viewSettings(); };
}
function profileDialog(u = S.user) {
  if (u !== S.user && !isAdmin()) return toast("You can only change your own profile");
  const st = S.db.settings; let pic = avatarOf(u); const self = u === S.user;
  const m = openModal(`<div class="mhead"><h3>${self ? "My profile" : "Profile – " + esc(uname(u))}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap"><div id="pfAv"></div>
      <div style="display:flex;flex-direction:column;gap:8px"><label class="btn" style="cursor:pointer">📷 ${pic ? "Change photo" : "Upload photo"}<input type="file" id="pfF" accept="image/*" hidden></label><button type="button" class="btn" id="pfR" ${pic ? "" : "hidden"}>Remove photo</button></div></div>
    <div class="field" style="margin-top:16px"><label for="pfN">Display name</label><input id="pfN" maxlength="60" value="${esc((st.names || {})[u] || "")}" placeholder="e.g. Pushpender Kishore Sharma"><span class="small muted">Shown in the sidebar, task lists and reports. Login ID <b>${esc(u)}</b> stays the same.</span></div>
    <div class="err" id="pfE"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="pfX">Cancel</button><button class="btn primary" id="pfY">Save</button></div>`, true);
  const show = () => { const keep = avatarOf(u); (st.avatars = st.avatars || {})[u] = pic; $("#pfAv", m).innerHTML = avatarHTML(u, 96); if (keep) st.avatars[u] = keep; else delete st.avatars[u]; $("#pfR", m).hidden = !pic; };
  show();
  $("#pfF", m).onchange = async e => { const f = e.target.files[0]; if (!f) return; try { pic = await shrinkPhoto(f); $("#pfE", m).textContent = ""; show(); } catch (err) { $("#pfE", m).textContent = err.message; } e.target.value = ""; };
  $("#pfR", m).onclick = () => { pic = ""; show(); };
  $("#mx", m).onclick = $("#pfX", m).onclick = closeModal;
  $("#pfY", m).onclick = () => { const nm = $("#pfN", m).value.trim(); st.names = st.names || {}; st.avatars = st.avatars || {};
    if (nm) st.names[u] = nm; else delete st.names[u]; if (pic) st.avatars[u] = pic; else delete st.avatars[u];
    log("Edited", "User", `Profile of ${u} updated${nm ? " – " + nm : ""}`); save(); closeModal(); toast("Profile saved"); renderMe(); renderNav(); if (S.route === "team") viewTeam(); };
}
function showChanges() {
  const m = openModal(`<div class="mhead"><h3>What's new · KSC Practice Manager</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p style="margin-top:0">You are using <b>version ${RELEASE.v}</b>, released on <b>${relFmt(RELEASE.at)}</b>.</p>
    ${CHANGES.map(([v, d, items], i) => `<div style="padding:10px 0;border-top:1px solid var(--line)"><b>Version ${v}</b> <span class="muted small">· ${relFmt(d)}</span>${i === 0 ? ' <span class="chip green">current</span>' : ""}<ul class="small" style="margin:6px 0 0;padding-left:18px">${items.map(t => `<li>${esc(t)}</li>`).join("")}</ul></div>`).join("")}</div>
    <div class="mfoot"><span class="sp"></span><button class="btn primary" id="cvX">Close</button></div>`);
  $("#mx", m).onclick = $("#cvX", m).onclick = closeModal;
}
const ITER = 600000;
const $ = (s, el = document) => el.querySelector(s);
const $$ = (s, el = document) => [...el.querySelectorAll(s)];
const esc = s => String(s ?? "").replace(/[&<>"'`]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;","`":"&#96;"}[c]));
const enc = new TextEncoder(), dec = new TextDecoder();
const b64 = buf => { const b = new Uint8Array(buf); let s = ""; for (let i = 0; i < b.length; i += 0x8000) s += String.fromCharCode.apply(null, b.subarray(i, i + 0x8000)); return btoa(s); };
const unb64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
const rnd = n => crypto.getRandomValues(new Uint8Array(n));
const uid = () => (crypto.randomUUID ? crypto.randomUUID() : b64(rnd(12)));

/* ------------------------------------------------------------------ crypto */
async function deriveKEK(pw, salt, iter) {
  const base = await crypto.subtle.importKey("raw", enc.encode(pw), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey({ name: "PBKDF2", salt, iterations: iter, hash: "SHA-256" }, base, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
}
async function aesEnc(key, bytes) { const iv = rnd(12); const ct = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, bytes); return { iv: b64(iv), ct: b64(ct) }; }
async function aesDec(key, o) { return new Uint8Array(await crypto.subtle.decrypt({ name: "AES-GCM", iv: unb64(o.iv) }, key, unb64(o.ct))); }
const importDEK = raw => crypto.subtle.importKey("raw", raw, { name: "AES-GCM" }, false, ["encrypt", "decrypt"]);
/* Admin key: opens the record of staff / intern passwords. Wrapped separately for each Admin's own password, so other roles cannot read it. */
async function akUnlock(usr, kek, V) { S.ak = null; S.akRaw = null;
  try { if (usr.ak) { const raw = await aesDec(kek, usr.ak); S.akRaw = raw; S.ak = await importDEK(raw); return; }
    if (!V.users.some(x => x.ak)) { const raw = rnd(32); usr.ak = await aesEnc(kek, raw); S.akRaw = raw; S.ak = await importDEK(raw); } } catch { S.ak = null; S.akRaw = null; } }
async function akWrapFor(usr, password) { if (S.akRaw) usr.ak = await aesEnc(await deriveKEK(password, unb64(usr.salt), usr.iter || ITER), S.akRaw); else delete usr.ak; }
async function pwbRead() { if (!S.ak || !S.vault || !S.vault.pwb) return {}; try { return JSON.parse(dec.decode(await aesDec(S.ak, S.vault.pwb))); } catch { return {}; } }
async function pwbSet(u, pw) { if (!S.ak) return false; const b = await pwbRead(); if (pw == null) delete b[u]; else b[u] = { p: pw, at: new Date().toISOString(), by: S.user }; S.vault.pwb = await aesEnc(S.ak, enc.encode(JSON.stringify(b))); return true; }
const roleOfU = u => ((S.db && S.db.settings.roles) || {})[u] || ((S.vault && S.vault.users.find(x => x.u === u)) || {}).role || "";
async function afterPwSet(u, pw) { const usr = S.vault.users.find(x => x.u === u); if (!usr) return;
  if (roleOfU(u) === "Admin") { await akWrapFor(usr, pw); await pwbSet(u, null); } else { delete usr.ak; await pwbSet(u, pw); }
  if (usr.ck) { if (S.ckRaw && roleOfU(u) !== "Admin") usr.ck = await aesEnc(await deriveKEK(pw, unb64(usr.salt), usr.iter || ITER), S.ckRaw); else delete usr.ck; } }
async function wrapForUser(username, role, password, dekRaw) {
  const salt = rnd(16); const kek = await deriveKEK(password, salt, ITER);
  const w = await aesEnc(kek, dekRaw);
  return { u: username, role, salt: b64(salt), iter: ITER, wiv: w.iv, wct: w.ct, created: new Date().toISOString() };
}

/* ------------------------------------------------------------------ IndexedDB */
const IDB = {
  db: null,
  open() { return new Promise((res, rej) => { const r = indexedDB.open("KSC_PracticeManager", 1); r.onupgradeneeded = () => r.result.createObjectStore("kv"); r.onsuccess = () => { this.db = r.result; res(); }; r.onerror = () => rej(r.error); }); },
  get(k) { return new Promise((res, rej) => { const t = this.db.transaction("kv").objectStore("kv").get(k); t.onsuccess = () => res(t.result); t.onerror = () => rej(t.error); }); },
  put(k, v) { return new Promise((res, rej) => { const t = this.db.transaction("kv", "readwrite"); t.objectStore("kv").put(v, k); t.oncomplete = () => res(); t.onerror = () => rej(t.error); }); },
  del(k) { return new Promise((res, rej) => { const t = this.db.transaction("kv", "readwrite"); t.objectStore("kv").delete(k); t.oncomplete = () => res(); t.onerror = () => rej(t.error); }); },
};

/* ------------------------------------------------------------------ state */
const S = { vault: null, dek: null, dekRaw: null, user: null, role: null, db: null, route: "dashboard", f: {}, sort: {}, last: Date.now(), fileHandle: null };
const isAdmin = () => S.role === "Admin";
const PERMS = [
  ["viewAllWork", "See all work of the firm", "Otherwise only work assigned to or created by the user"],
  ["createWork", "Create new work items", "Includes recurring compliance generator"],
  ["editAllWork", "Edit work of other users", "Otherwise can edit only own / assigned work"],
  ["assignWork", "Assign work to other users", "Otherwise work is always assigned to self"],
  ["markDone", "Mark work as Filed / Done", "Otherwise can move work only up to 'Under review' for your approval"],
  ["viewFees", "See fees, bills and receivables", "Fee columns, client statement, receivable reports"],
  ["editFees", "Enter fees, bills and receipts", ""],
  ["manageClients", "Add and edit clients", "Otherwise client list is read-only"],
  ["challans", "Challan register", "View and add challans"],
  ["reimb", "Reimbursements", "View and add expenses"],
  ["udins", "UDIN register", "View and add UDINs"],
  ["reports", "Reports & client status", ""],
  ["print", "Print", ""],
  ["export", "Export to Excel / share", "Takes data out of the app"],
  ["freeEdit", "Edit / delete own tasks any time", "Otherwise own tasks lock after the edit window (default 1 hour) and need your approval to modify or delete – one change per approval"],
  ["billing", "Billing", "Create bills, record payments, change bill format"],
  ["documents", "Documents", "Attach, link and open documents in the shared documents folder"],
  ["dsc", "DSC register", "View and update the DSC register"],
  ["docreq", "Document requests", "Create document checklists and send reminders to clients"],
  ["engage", "Engagement letters", "Create and update engagement letters"],
  ["cases", "Notices & cases", "View and update notices, assessments and search / survey groups"],
  ["delete", "Delete records", ""],
];
const PRESET = {
  Staff: { viewAllWork: 1, createWork: 1, editAllWork: 1, assignWork: 1, markDone: 1, viewFees: 1, editFees: 1, manageClients: 1, challans: 1, reimb: 1, udins: 1, reports: 1, print: 1, export: 1, documents: 1, freeEdit: 1, billing: 1, delete: 0, dsc: 1, docreq: 1, engage: 1, cases: 1 },
  Intern: { viewAllWork: 0, createWork: 1, editAllWork: 0, assignWork: 0, markDone: 0, viewFees: 0, editFees: 0, manageClients: 0, challans: 1, reimb: 1, udins: 0, reports: 0, print: 1, export: 0, documents: 1, freeEdit: 0, billing: 0, delete: 0, dsc: 1, docreq: 1, engage: 0, cases: 0 },
};
const permsOf = (u, role) => role === "Admin" ? Object.fromEntries(PERMS.map(p => [p[0], 1])) : { ...(PRESET[role] || PRESET.Intern), ...((S.db.settings.perms || {})[u] || {}) };
const can = p => isAdmin() || !!permsOf(S.user, S.role)[p];
const mineW = w => w.assigned === S.user || w.createdBy === S.user;
const cHid = c => !!c && c.adminOnly === "Yes";
const hidSet = () => new Set((S.db.clients || []).filter(cHid).map(c => c.id));
const showC = id => isAdmin() || !hidSet().has(id);
const vC = () => isAdmin() ? S.db.clients : S.db.clients.filter(c => !cHid(c));
const vR = ent => { const a = S.db[ent] || []; if (isAdmin()) return a; const h = hidSet(); return h.size ? a.filter(x => !h.has(x.client)) : a; };
const visW = () => { const a = can("viewAllWork") ? S.db.works : S.db.works.filter(mineW); if (isAdmin()) return a; const h = hidSet(); return h.size ? a.filter(w => !h.has(w.client)) : a; };
const dataFor = ent => ent === "works" ? visW() : ent === "clients" ? vC() : ["challans", "reimb", "udins", "dsc", "docreq", "engage"].includes(ent) ? vR(ent) : S.db[ent];
const colsFor = (cols) => cols.filter(c => !(c.fee && !can("viewFees")) && !(c.adm && !isAdmin()));
const uname = u => (u && S.db && (S.db.settings.names || {})[u]) || u || "";
const ulabel = u => { const n = (S.db.settings.names || {})[u]; return n && n !== u ? `${n} (${u})` : u; };
const SVCMAP = [[/^GSTR|CMP-08|^GST|LUT|E-?way/i, "GST"], [/TDS\/TCS payment|TDS payment|TCS payment|TDS challan|^Challan/i, "TDS Challan"], [/24Q|26Q|27Q|27EQ|TDS|TCS|Form 16/i, "TDS Return"], [/AOC|MGT|ADT|DIR-3|DPT|MSME|INC-|LLP|Board|AGM|ROC|MCA/i, "ROC / MCA"],
  [/^ITR|Revised|Updated ITR/i, "Income Tax Return"], [/3CD|3CA|3CB|Tax audit|29B|10CCB/i, "Tax Audit"], [/Statutory audit|CARO/i, "Statutory Audit"], [/Advance tax/i, "Advance Tax"],
  [/UDIN|Certificate|15CB|Net worth|Turnover cert/i, "UDIN / Certification"], [/Bookkeeping|Accounting/i, "Accounting"], [/Notice|Assessment|Appeal/i, "Notice / Assessment"], [/Registration/i, "Registration"]];
function svcFor(form) { if (!form) return ""; const hit = SVCMAP.find(([re]) => re.test(form)); if (hit) return hit[1]; return (S.db.settings.formService || {})[form] || ""; }
function ruleFor(service, form) { const rules = S.db.settings.assignRules || []; const t = rules.find(r => r.type === "task" && form && r.value.toLowerCase() === form.toLowerCase()); if (t) return t.user; const v = rules.find(r => r.type === "service" && r.value === service); return v ? v.user : ""; }
function lockState(w) {
  if (!w || can("freeEdit") || w.createdBy !== S.user) return null;
  const win = num(S.db.settings.editWindow || 60), age = (Date.now() - new Date(w.createdAt || 0).getTime()) / 60000;
  if (age <= win) return { mode: "free", left: Math.max(1, Math.ceil(win - age)) };
  if (w.grant && w.grant.user === S.user && !w.grant.used) return { mode: "grant", type: w.grant.type };
  const pend = (S.db.requests || []).find(q => q.workId === w.id && q.user === S.user && q.status === "Pending");
  return { mode: "locked", pending: pend };
}
const canSelfDelete = w => { const L = lockState(w); return !!L && (L.mode === "free" || (L.mode === "grant" && L.type === "delete")); };
const ENTPERM = { clients: "manageClients", works: "createWork", challans: "challans", reimb: "reimb", udins: "udins" };

/* ------------------------------------------------------------------ dates & numbers */
const pad = n => String(n).padStart(2, "0");
const iso = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const today = () => iso(new Date());
const dmy = s => s ? s.split("-").reverse().join("-") : "";
const days = (a, b) => Math.round((new Date(b + "T00:00:00") - new Date(a + "T00:00:00")) / 86400000);
const addDays = (s, n) => { const d = new Date(s + "T00:00:00"); d.setDate(d.getDate() + n); return iso(d); };
const inr = v => (v === "" || v == null || isNaN(v)) ? "" : Number(v).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const inr0 = v => Number(v || 0).toLocaleString("en-IN", { maximumFractionDigits: 0 });
const num = v => { const n = parseFloat(v); return isNaN(n) ? 0 : n; };
const curFYStart = () => { const d = new Date(); return d.getMonth() >= 3 ? d.getFullYear() : d.getFullYear() - 1; };
const fyLabel = y => `${y}-${String((y + 1) % 100).padStart(2, "0")}`;
const FYS = (() => { const y = curFYStart(); const a = []; for (let i = y + 1; i >= y - 5; i--) a.push(fyLabel(i)); return a; })();

/* ------------------------------------------------------------------ masters */
const CTYPE = ["Individual", "HUF", "Proprietorship", "Partnership Firm", "LLP", "Private Limited", "Public Limited", "OPC", "Trust / Society", "AOP / BOI"];
const SVC = ["GST", "TDS Return", "TDS Challan", "ROC / MCA", "Income Tax Return", "Tax Audit", "Statutory Audit", "UDIN / Certification", "Accounting", "Advance Tax", "Notice / Assessment", "Registration", "Project / Other"];
const STATUS = ["Not started", "Data awaited", "In progress", "Under review", "Filed / Done", "On hold", "Cancelled"];
const CLOSED = ["Filed / Done", "Cancelled"];
const STCOLORS = ["#1a73e8", "#1e8e3e", "#e8710a", "#d93025", "#8e24aa", "#00897b", "#6d4c41", "#546e7a", "#c2185b", "#f9a825"];
const custSt = () => (S.db && S.db.settings.statuses) || [];
const custStOf = s => custSt().find(x => x.name === s);
const stg = s => STATUS.includes(s) ? s : (custStOf(s) || {}).stage || (s ? "In progress" : "Not started");
const isClosedSt = s => CLOSED.includes(stg(s));
const allStatus = cid => [...STATUS, ...custSt().filter(x => !cid || !(x.clients || []).length || x.clients.includes(cid)).map(x => x.name)];
const canManageSt = () => isAdmin();
const firstAdmin = () => { const st = S.db.settings; return (st.staff || []).find(u => ((st.roles || {})[u]) === "Admin") || (S.vault && (S.vault.users.find(x => x.role === "Admin") || {}).u) || ""; };
const stLabel = s => ((S.db && S.db.settings.stLabels) || {})[s] || s;
const PRIORITY = ["High", "Normal", "Low"];
const PERIODS = ["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar", "Q1", "Q2", "Q3", "Q4", "H1", "H2", "Annual", "One-time"];
const FORMS = ["GSTR-1", "GSTR-1 (QRMP)", "GSTR-3B", "GSTR-3B (QRMP)", "CMP-08", "GSTR-4", "GSTR-9", "GSTR-9C", "GST Registration / Amendment", "GST Refund (RFD-01)", "GST Notice reply",
  "TDS/TCS payment", "Form 24Q", "Form 26Q", "Form 27Q", "Form 27EQ", "Form 16 / 16A", "TDS correction",
  "AOC-4", "MGT-7 / MGT-7A", "ADT-1", "DIR-3 KYC", "DPT-3", "MSME-1", "INC-20A", "LLP Form 8", "LLP Form 11", "Board / AGM minutes",
  "ITR-1", "ITR-2", "ITR-3", "ITR-4", "ITR-5", "ITR-6", "ITR-7", "ITR (non-audit)", "ITR (audit)", "Revised / Updated ITR", "Advance tax", "Notice reply / Assessment",
  "Form 3CA-3CD", "Form 3CB-3CD", "Tax audit (3CD)", "Form 29B / 10CCB / others", "Statutory audit report", "UDIN generation", "Certificate", "Bookkeeping", "Others"];
const allSvc = () => [...SVC, ...((S.db && S.db.settings.customServices) || [])];
const allForms = () => [...FORMS, ...((S.db && S.db.settings.customForms) || [])].sort((a, b) => a.localeCompare(b));
const TAXTYPE = ["GST", "TDS / TCS", "Income Tax", "Advance Tax", "Self-Assessment Tax", "ROC / MCA Fee", "Professional Tax", "Other"];
const HEAD = ["Tax", "Interest", "Late fee", "Penalty", "Fee", "Others"];
const PAIDBY = ["Client", "Firm (reimbursable)", "Firm (not reimbursable)"];
const MODE = ["Net banking", "UPI", "Debit card", "NEFT / RTGS", "Over the counter", "Cash", "Cheque"];
const RNATURE = ["Govt. challan paid for client", "ROC / MCA filing fee", "DSC purchase / renewal", "Stamp duty", "Courier / postage", "Travel / conveyance", "Printing / stationery", "Notary / attestation", "Other"];
const UDOC = ["Statutory audit report", "Tax audit report (3CA/3CB-3CD)", "Net worth certificate", "Turnover certificate", "Form 15CB", "CARO / other audit report", "GST audit / reconciliation", "Certificate – other", "Others"];

/* ------------------------------------------------------------------ entity schemas */
/* ---- several GST registrations under one client */
const GSTST = { "01": "Jammu & Kashmir", "02": "Himachal Pradesh", "03": "Punjab", "04": "Chandigarh", "05": "Uttarakhand", "06": "Haryana", "07": "Delhi", "08": "Rajasthan", "09": "Uttar Pradesh", "10": "Bihar", "11": "Sikkim", "12": "Arunachal Pradesh", "13": "Nagaland", "14": "Manipur", "15": "Mizoram", "16": "Tripura", "17": "Meghalaya", "18": "Assam", "19": "West Bengal", "20": "Jharkhand", "21": "Odisha", "22": "Chhattisgarh", "23": "Madhya Pradesh", "24": "Gujarat", "25": "Daman & Diu", "26": "Dadra & Nagar Haveli and Daman & Diu", "27": "Maharashtra", "28": "Andhra Pradesh (old)", "29": "Karnataka", "30": "Goa", "31": "Lakshadweep", "32": "Kerala", "33": "Tamil Nadu", "34": "Puducherry", "35": "Andaman & Nicobar", "36": "Telangana", "37": "Andhra Pradesh", "38": "Ladakh", "97": "Other Territory", "99": "Centre Jurisdiction" };
const GSTRE = /^\d{2}[A-Z]{5}\d{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/;
const gstState = g => GSTST[String(g || "").slice(0, 2)] || "";
const gstsOf = c => { if (!c) return []; const L = Array.isArray(c.gstins) && c.gstins.length ? c.gstins : c.gstin ? [{ g: c.gstin, label: "" }] : []; return L.filter(x => x && x.g); };
const gstLbl = x => [x.g, gstState(x.g), x.label].filter(Boolean).join(" · ");
const multiG = cid => gstsOf(clientById(cid)).length > 1;
const ENT = {
  clients: { title: "Clients", one: "Client", icon: "👥", fields: [
    { k: "code", l: "Client code", req: 1, upper: 1, ph: "C001" }, { k: "name", l: "Client name", req: 1 },
