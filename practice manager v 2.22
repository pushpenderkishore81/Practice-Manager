    { k: "nature", l: "Nature of expense", t: "select", o: RNATURE, req: 1 }, { k: "desc", l: "Description" }, { k: "ref", l: "Voucher / bill ref." },
    { k: "amount", l: "Amount spent (₹)", t: "number", req: 1 }, { k: "paidfrom", l: "Paid by (staff / firm a/c)" }, { k: "billdate", l: "Billed to client on", t: "date" },
    { k: "billno", l: "Bill no." }, { k: "recovered", l: "Amount recovered (₹)", t: "number" }, { k: "recdate", l: "Recovered on", t: "date" }, { k: "remarks", l: "Remarks", t: "textarea", full: 1 }] },
  udins: { title: "UDIN Register", one: "UDIN", icon: "🔖", fields: [
    { k: "date", l: "UDIN generation date", t: "date", req: 1, def: today }, { k: "client", l: "Client", t: "client", req: 1 },
    { k: "doc", l: "Document type", t: "select", o: UDOC, req: 1 }, { k: "fy", l: "FY / period", t: "select", o: FYS, def: () => fyLabel(curFYStart()) },
    { k: "signdate", l: "Date of signing", t: "date" }, { k: "udin", l: "UDIN", req: 1, upper: 1 }, { k: "partner", l: "Signing partner (M. No.)" },
    { k: "revoked", l: "Revoked?", t: "select", o: ["No", "Yes"], def: "No" }, { k: "remarks", l: "Remarks", t: "textarea", full: 1 }] },
};

/* ------------------------------------------------------------------ data helpers */
const blankDB = firm => ({ ver: APPVER, created: new Date().toISOString(),
  settings: { firm: { name: firm, address: "", phone: "", email: "", frn: "", partner: "", mno: "" }, staff: [], autolock: 10, defaultPartner: "" },
  clients: [], works: [], challans: [], reimb: [], udins: [], log: [], dsc: [], docreq: [], engage: [], creds: [], cases: [], sgroups: [] });
const clientById = id => S.db.clients.find(c => c.id === id);
const cname = id => { const c = clientById(id); return c ? c.name : "(deleted client)"; };
const ccode = id => { const c = clientById(id); return c ? c.code : ""; };
const isOpen = w => !isClosedSt(w.status);
function delayInfo(w) {
  if (!w.due) return { txt: "", cls: "", sortv: 99999, overdue: false };
  if (w.filed) { const d = days(w.due, w.filed); return d > 0 ? { txt: `Late ${d}d`, cls: "red", sortv: 50000 + d, overdue: false, late: d } : { txt: "On time", cls: "green", sortv: 60000, overdue: false, late: 0 }; }
  if (stg(w.status) === "Cancelled") return { txt: "", cls: "", sortv: 70000 };
  const d = days(today(), w.due);
  if (d < 0) return { txt: `Overdue ${-d}d`, cls: "red", sortv: d, overdue: true };
  if (d <= 7) return { txt: d === 0 ? "Due today" : `Due in ${d}d`, cls: "amber", sortv: d, soon: true };
  return { txt: `Due in ${d}d`, cls: "", sortv: d };
}
const stColor = s => { const c = custStOf(s); return c ? c.color : ((S.db && S.db.settings.stColors) || {})[s] || ""; };
const statusChip = s => { const c = custStOf(s), col = stColor(s); if (col) return `<span class="chip" style="background:${col}1f;color:${col}" title="${isClosedSt(stg(s)) ? "Completed" : "Pending"} status">${esc(stLabel(s))}</span>`; const g = stg(s);
  return `<span class="chip ${g === "Filed / Done" ? "green" : g === "Cancelled" ? "" : g === "On hold" ? "amber" : g === "Under review" ? "blue" : ""}">${esc(stLabel(s || ""))}</span>`; };
const udinApp = w => w.udinReq === "Yes" || (!w.udinReq && !!w.udin);
const udinPend = w => udinApp(w) && !w.udin && stg(w.status) !== "Cancelled";
const UDINSVC = ["Tax Audit", "Statutory Audit", "UDIN / Certification"];
const woOut = w => num(w.fee) - num(w.received);
const chReimbDue = c => c.paidby === "Firm (reimbursable)" ? num(c.amount) - num(c.recovered) : 0;
const reBal = r => num(r.amount) - num(r.recovered);
function log(action, entity, desc) {
  S.db.log.unshift({ ts: new Date().toISOString(), user: S.user, action, entity, desc, ...(CL.uid ? { cu: CL.uid } : {}) });
  if (S.db.log.length > (CL.on ? 20000 : 5000)) S.db.log.length = CL.on ? 20000 : 5000;
}

/* ------------------------------------------------------------------ save (encrypted) */
let saveTimer = null, saving = Promise.resolve();
function save() { clearTimeout(saveTimer); saveTimer = setTimeout(() => { saving = saveNow(); }, 300); }
async function saveNow() {
  if (!S.db || !S.dek) return;
  if (CL.on) { cloudPush(); return cloudDrain(); }
  const o = await aesEnc(S.dek, enc.encode(JSON.stringify(S.db)));
  S.vault.data = o; S.vault.updated = new Date().toISOString();
  await IDB.put("vault", S.vault);
  if (S.fileHandle) {
    try {
      if ((await S.fileHandle.queryPermission({ mode: "readwrite" })) === "granted") {
        const w = await S.fileHandle.createWritable(); await w.write(JSON.stringify(S.vault)); await w.close();
      }
    } catch (e) { console.warn("auto-save file failed", e); }
  }
}

/* ------------------------------------------------------------------ UI helpers */
function toast(msg, ms = 2600) { const t = $("#toast"); t.textContent = msg; t.hidden = false; clearTimeout(t._t); t._t = setTimeout(() => t.hidden = true, ms); }
function openModal(html, narrow) { const m = $("#modal"); m.innerHTML = `<div class="mbox ${narrow ? "narrow" : ""}">${html}</div>`; m.hidden = false; const f = $("input,select,textarea", m); if (f) f.focus(); return m; }
function closeModal() { const m = $("#modal"); m.hidden = true; m.innerHTML = ""; }
function confirmBox(title, msg, okLabel = "Confirm", danger = true) {
  return new Promise(res => {
    const m = openModal(`<div class="mhead"><h3>${esc(title)}</h3></div><div class="mbody">${msg}</div>
      <div class="mfoot"><button class="btn" id="cbNo">Cancel</button><button class="btn ${danger ? "danger" : "primary"}" id="cbYes">${esc(okLabel)}</button></div>`, true);
    $("#cbNo", m).onclick = () => { closeModal(); res(false); };
    $("#cbYes", m).onclick = () => { closeModal(); res(true); };
  });
}
function download(name, content, mime) {
  const blob = content instanceof Blob ? content : new Blob([content], { type: mime });
  if (CL.on) { if (!CL.downloads) return toast("Downloads are not available in this view");
    CL.downloads.save({ filename: name, data: blob }).then(() => {}, e => { if (e && e.code === "rejected_extension") alertBox("Can't download this file type here", `<p>${esc(name)} cannot be saved from the online app because of its file type.</p>`); else if (!(e && e.code === "declined")) toast("Download failed: " + ((e && e.message) || "unavailable")); }); return; }
  const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click();
  setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1500);
}
function pwScore(p) { let s = 0; if (p.length >= 10) s++; if (p.length >= 14) s++; if (/[a-z]/.test(p) && /[A-Z]/.test(p)) s++; if (/\d/.test(p)) s++; if (/[^A-Za-z0-9]/.test(p)) s++; return s; }
function pwOk(p) { return p.length >= 10 && /[A-Za-z]/.test(p) && /\d/.test(p) && /[^A-Za-z0-9]/.test(p); }
function meter(el, p) { const s = pwScore(p); el.style.width = (s * 20) + "%"; el.style.background = s <= 2 ? "#c62828" : s === 3 ? "#e09b00" : "#1e8e3e"; }

document.addEventListener("click", e => {
  const b = e.target.closest && e.target.closest("[data-vis]"); if (!b) return;
  e.stopPropagation(); e.preventDefault(); if (!isAdmin()) return;
  const c = clientById(b.dataset.vis); if (!c) return;
  c.adminOnly = cHid(c) ? "No" : "Yes"; c.updatedBy = S.user; c.updatedAt = new Date().toISOString();
  log("Edited", "Client", `${c.code} – ${c.name}: ${cHid(c) ? "hidden from staff and interns (Admin only)" : "made visible to staff and interns"}`);
  save(); b.textContent = cHid(c) ? "🔒 Admin only" : "👥 Visible to team"; b.title = cHid(c) ? "Only Admin can see this client. Click to show it to staff and interns." : "Staff and interns can see this client. Click to hide it from them.";
  toast(cHid(c) ? `${c.name} is now hidden from staff and interns` : `${c.name} is now visible to staff and interns`);
}, true);

/* ------------------------------------------------------------------ BULK IMPORT (Excel) */
const IMP = {
  parties: { sheet: "Parties", cols: [["name", "Party Name", 1], ["code", "Client Code"], ["type", "Client Type"], ["pan", "PAN"], ["gstin", "GSTIN"], ["mobile", "Mobile"], ["email", "Email"], ["address", "Address"], ["state", "State"], ["opening", "Opening Balance"], ["obDate", "Opening Balance Date"], ["books", "Balance as per Books"]] },
  invoices: { sheet: "Invoices", cols: [["no", "Invoice No", 1], ["date", "Invoice Date", 1], ["party", "Party Name", 1], ["item", "Item / Particulars", 1], ["sac", "SAC"], ["qty", "Qty"], ["rate", "Rate"], ["amount", "Amount", 1], ["due", "Due Date"], ["notes", "Notes"], ["status", "Status"]] },
  receipts: { sheet: "Receipts", cols: [["date", "Date", 1], ["party", "Party Name", 1], ["amount", "Amount", 1], ["mode", "Mode"], ["ref", "Reference"], ["inv", "Invoice No"]] },
};
function loadXLSX() {
  if (window.XLSX) return Promise.resolve(window.XLSX);
  return new Promise((res, rej) => { const s = document.createElement("script"); s.src = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";
    s.onload = () => window.XLSX ? res(window.XLSX) : rej(new Error("The Excel reader did not load.")); s.onerror = () => rej(new Error("Could not load the Excel reader. Check the internet connection and try again.")); document.head.appendChild(s); });
}
const impH = h => String(h ?? "").toLowerCase().replace(/\(.*?\)|[*₹]/g, "").replace(/[^a-z0-9]+/g, " ").trim();
const impNum = v => typeof v === "number" ? v : num(String(v ?? "").replace(/[,₹\s]/g, ""));
const impTxt = v => String(v ?? "").trim();
function impDate(v) {
  if (v === "" || v == null) return "";
  if (typeof v === "number") { const d = new Date(Math.round((v - 25569) * 86400000)); return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`; }
  if (v instanceof Date) return iso(v);
  const s = String(v).trim(); let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/); if (m) return `${m[1]}-${pad(+m[2])}-${pad(+m[3])}`;
  m = s.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2,4})$/); if (m) return `${m[3].length === 2 ? "20" + m[3] : m[3]}-${pad(+m[2])}-${pad(+m[1])}`;
  return null;
}
const impNorm = s => (" " + String(s || "").toLowerCase().replace(/&/g, " and ").replace(/\bm\/s\.?/g, " ").replace(/[^a-z0-9]+/g, " ") + " ")
  .replace(/\bprivate\b/g, "pvt").replace(/\blimited\b/g, "ltd").replace(/\bcompany\b/g, "co").replace(/\bthe\b/g, " ").replace(/\s+/g, " ").trim();
function impGuessType(n) {
  const s = String(n || "");
  if (/private\s+limited|pvt\.?\s*ltd/i.test(s)) return "Private Limited"; if (/\bllp\b/i.test(s)) return "LLP"; if (/\b(limited|ltd)\b/i.test(s)) return "Public Limited";
  if (/association|society|trust|condominium|\brwa\b|welfare|foundation/i.test(s)) return "Trust / Society"; if (/\bhuf\b/i.test(s)) return "HUF";
  if (/&\s*(co|sons)\b|traders|enterprises|industries|store|manufactur|works|agency|associates|solutions|services|products|exports|developers|builders/i.test(s)) return "Proprietorship";
  return "Individual";
}
function impRead(XLSX, buf) {
  const wb = XLSX.read(buf, { type: "array" }); const out = { parties: [], invoices: [], receipts: [], errors: [] };
  for (const k in IMP) {
    const def = IMP[k], wsName = wb.SheetNames.find(n => impH(n) === impH(def.sheet)); if (!wsName) { if (k !== "parties") out.errors.push(`Sheet “${def.sheet}” not found – skipped.`); continue; }
    const rows = XLSX.utils.sheet_to_json(wb.Sheets[wsName], { header: 1, raw: true, defval: "" });
    const hi = rows.slice(0, 6).findIndex(r => r.some(c => impH(c) === impH(def.cols[0][1]))); if (hi < 0) { out.errors.push(`${def.sheet}: header row with “${def.cols[0][1]}” not found.`); continue; }
    const H = rows[hi].map(impH), idx = Object.fromEntries(def.cols.map(([key, lab]) => [key, H.indexOf(impH(lab))]));
    const miss = def.cols.filter(c => c[2] && idx[c[0]] < 0).map(c => c[1]); if (miss.length) { out.errors.push(`${def.sheet}: missing column(s) ${miss.join(", ")}.`); continue; }
    rows.slice(hi + 1).forEach((r, i) => {
      if (!r.some(c => impTxt(c))) return; const o = { _row: hi + i + 2 };
      def.cols.forEach(([key]) => o[key] = idx[key] >= 0 ? r[idx[key]] : "");
      const bad = def.cols.filter(c => c[2] && impTxt(o[c[0]]) === "").map(c => c[1]);
      ["date", "due", "obDate"].forEach(f => { if (f in o) { const d = impDate(o[f]); if (d === null) bad.push(`${f === "due" ? "Due Date" : f === "obDate" ? "Opening Balance Date" : "Date"} not understood (“${o[f]}”)`); o[f] = d || ""; } });
      if (bad.length) return out.errors.push(`${def.sheet} row ${o._row}: ${bad.join(", ")} – row skipped.`);
      out[k].push(o);
    });
  }
  return out;
}
/* turn the sheets into a plan; matching to clients can be changed in the preview */
function impPlan(raw) {
  const P = new Map(); const party = (name, extra) => { const key = impNorm(name); if (!key) return null; if (!P.has(key)) P.set(key, { key, name: impTxt(name), code: "", type: "", pan: "", gstin: "", mobile: "", email: "", address: "", state: "", opening: 0, obDate: "", books: null }); const p = P.get(key); if (extra) Object.assign(p, extra); return p; };
  raw.parties.forEach(r => party(r.name, { name: impTxt(r.name), code: impTxt(r.code).toUpperCase(), type: impTxt(r.type), pan: impTxt(r.pan).toUpperCase(), gstin: impTxt(r.gstin).toUpperCase(), mobile: impTxt(r.mobile), email: impTxt(r.email),
    address: impTxt(r.address), state: impTxt(r.state), opening: impNum(r.opening), obDate: r.obDate, books: impTxt(r.books) === "" ? null : impNum(r.books) }));
  const inv = new Map();
  raw.invoices.forEach(r => { const p = party(r.party); const no = impTxt(r.no), k = p.key + "|" + no.toLowerCase();
    if (!inv.has(k)) inv.set(k, { key: k, party: p.key, no, date: r.date, due: r.due, notes: impTxt(r.notes), cancelled: /cancel/i.test(impTxt(r.status)), lines: [] });
    const amt = Math.round(impNum(r.amount) * 100) / 100, qty = impTxt(r.qty) === "" ? 1 : impNum(r.qty), rate = impTxt(r.rate) === "" ? amt / (qty || 1) : impNum(r.rate);
    inv.get(k).lines.push({ desc: impTxt(r.item), sac: impTxt(r.sac), qty, rate: Math.round(rate * 100) / 100, amount: amt }); });
  const invoices = [...inv.values()].map(i => ({ ...i, total: Math.round(i.lines.reduce((a, l) => a + l.amount, 0) * 100) / 100 })).sort((a, b) => a.date.localeCompare(b.date) || a.no.localeCompare(b.no, undefined, { numeric: true }));
  const receipts = raw.receipts.map(r => { const p = party(r.party); return { party: p.key, date: r.date, amount: Math.round(impNum(r.amount) * 100) / 100, mode: impTxt(r.mode) || "Other", ref: impTxt(r.ref), inv: impTxt(r.inv), _row: r._row }; })
    .filter(r => r.amount > 0).sort((a, b) => a.date.localeCompare(b.date));
  const parties = [...P.values()].sort((a, b) => a.name.localeCompare(b.name));
  parties.forEach(p => { const c = impMatch(p); p.match = c ? c.id : ""; p.how = c ? c._how : ""; });
  return { parties, invoices, receipts, errors: raw.errors };
}
const impPan = p => p.pan || (p.gstin && p.gstin.length === 15 ? p.gstin.slice(2, 12) : "");
/* new parties in the file that share a PAN with an earlier new party join that party's client */
function impJoins(plan) { const first = {}, out = {}; plan.parties.forEach(p => { if (p.match) return; const pan = impPan(p); if (!pan) return; if (first[pan]) out[p.key] = first[pan]; else first[pan] = p; }); return out; }
function impMatch(p) {
  const C = S.db.clients; let c;
  if (p.gstin && (c = C.find(x => gstsOf(x).some(g => (g.g || "").toUpperCase() === p.gstin)))) return { ...c, _how: "GSTIN" };
  const pan = impPan(p);
  if (pan && (c = C.find(x => (x.pan || "").toUpperCase() === pan || gstsOf(x).some(g => (g.g || "").toUpperCase().slice(2, 12) === pan)))) return { ...c, _how: "PAN" };
  if (p.code && (c = C.find(x => (x.code || "").toUpperCase() === p.code && impNorm(x.name) === p.key))) return { ...c, _how: "Code" };
  if ((c = C.find(x => impNorm(x.name) === p.key))) return { ...c, _how: "Name" };
  return null;
}
/* which file invoices already exist in the app (for the current matching) */
function impDups(plan) {
  const cid = Object.fromEntries(plan.parties.map(p => [p.key, p.match]));
  const bills = (S.db.bills || []).filter(b => !isPF(b));
  plan.invoices.forEach(i => { i.dup = ""; i.dupWhy = ""; const c = cid[i.party]; const src = "x|" + i.party + "|" + i.no.toLowerCase() + "|" + i.date;
    let b = bills.find(x => x.src === src); if (b) { i.dup = b.id; i.dupWhy = "Imported earlier"; return; }
    if (!c) return;
    const mine = bills.filter(x => x.client === c);
    if ((b = mine.find(x => String(x.no).trim().toLowerCase() === i.no.toLowerCase()))) { i.dup = b.id; i.dupWhy = `Same invoice no. (${b.no})`; return; }
    if (!i.cancelled && (b = mine.find(x => x.status !== "Cancelled" && Math.abs(num(x.total) - i.total) < 1 && Math.abs(days(x.date, i.date)) <= 3))) { i.dup = b.id; i.dupWhy = `Same amount, date ${dmy(b.date)} (${b.no})`; } });
}
function viewImport() {
  if (!isAdmin()) return toast("Only the Admin can import");
  const last = (S.db.settings.importBatches || []).slice(-1)[0];
  const m = openModal(`<div class="mhead"><h3>⬆ Bulk import from Excel</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p>Import <b>parties, invoices, receipts and opening balances</b> from an Excel file. Nothing is saved until you check the preview and press <b>Import</b>.</p>
    <ol class="small" style="line-height:1.7"><li>Download the template, or use a file prepared in the same format (sheets <b>Parties</b>, <b>Invoices</b>, <b>Receipts</b>).</li>
      <li>Parties are matched to your clients by GSTIN, PAN or name. Unmatched parties become new clients.</li>
      <li>Invoices you already have (same number, or same client, amount and date) are skipped, so nothing is duplicated.</li>
      <li>Receipts are applied to the invoice named in the row, then to the party's oldest unpaid invoices. If you give <b>Balance as per Books</b>, each party's balance is checked after import.</li></ol>
    <div class="notice warn">Take a backup first: Settings › Backup. You can also undo the last import from this screen.</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px"><button class="btn" id="impTpl">⬇ Download blank template</button><label class="btn primary" style="cursor:pointer">📄 Choose Excel file…<input type="file" id="impF" accept=".xlsx,.xls,.xlsm" hidden></label></div>
    <div class="err" id="impE"></div>
    ${last ? `<div class="card" style="margin-top:14px"><b>Last import</b> · ${esc(last.file || "")} · ${new Date(last.at).toLocaleString("en-IN")} · ${last.n.inv} invoice(s), ${last.n.rec} receipt(s), ${last.n.cl} new client(s)
      <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap">${last.recon ? '<button class="btn sm" id="impRc">Balance check</button>' : ""}<button class="btn sm danger" id="impUndo">Undo this import</button></div></div>` : ""}
    </div><div class="mfoot"><span class="sp"></span><button class="btn" id="impX">Close</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "720px";
  $("#mx", m).onclick = $("#impX", m).onclick = closeModal;
  $("#impTpl", m).onclick = async () => { try { const X = await loadXLSX(); const wb = X.utils.book_new();
    X.utils.book_append_sheet(wb, X.utils.aoa_to_sheet([["How to fill this file"], [""], ["Parties: one row per party. Only Party Name is required. Opening Balance creates an opening-balance invoice. Balance as per Books is used only to check balances after import."],
      ["Invoices: one row per invoice line. Rows with the same Invoice No and Party Name form one invoice. Required: Invoice No, Invoice Date, Party Name, Item / Particulars, Amount. Status = Cancelled imports a cancelled invoice."],
      ["Receipts: one row per payment received. Required: Date, Party Name, Amount. Invoice No (optional) applies the receipt to that invoice first; the rest goes to the oldest unpaid invoices."],
      ["Dates: DD-MM-YYYY or Excel dates. Amounts in rupees, without the ₹ sign."], [""], ["Example (do not paste into the sheets): Invoices row → 2025/101 | 15-04-2025 | Sample Traders | ITR filing AY 2025-26 | 998231 | 1 | 5000 | 5000 | 30-04-2025 | | "]]), "Instructions");
    for (const k in IMP) X.utils.book_append_sheet(wb, X.utils.aoa_to_sheet([IMP[k].cols.map(c => c[1] + (c[2] ? " *" : ""))]), IMP[k].sheet);
    download("Practice Manager – bulk import template.xlsx", new Blob([X.write(wb, { type: "array", bookType: "xlsx" })], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" })); } catch (e) { $("#impE", m).textContent = e.message || e; } };
  $("#impF", m).onchange = async e => { const f = e.target.files[0]; if (!f) return; $("#impE", m).textContent = "Reading…";
    try { const X = await loadXLSX(); const raw = impRead(X, new Uint8Array(await f.arrayBuffer())); const plan = impPlan(raw);
      if (!plan.invoices.length && !plan.receipts.length && !plan.parties.length) { $("#impE", m).innerHTML = "Nothing to import." + (raw.errors.length ? "<br>" + raw.errors.slice(0, 5).map(esc).join("<br>") : ""); return; }
      plan.file = f.name; impPreview(plan); } catch (err) { $("#impE", m).textContent = "Could not read the file: " + (err.message || err); } };
  if ($("#impUndo", m)) $("#impUndo", m).onclick = () => impUndo(last);
  if ($("#impRc", m)) $("#impRc", m).onclick = () => impReconView(last.recon, last.file);
}
function impPreview(plan) {
  impDups(plan);
  const cl = S.db.clients.slice().sort((a, b) => a.name.localeCompare(b.name));
  const opts = cl.map(c => `<option value="${c.id}">${esc(c.name)} (${esc(c.code)})</option>`).join("");
  let tab = "sum";
  const m = openModal(`<div class="mhead"><h3>Import preview · ${esc(plan.file)}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody" style="max-height:calc(100vh - 230px)"><div id="ipSum"></div>
    <div class="tabs"><button data-ip="sum" class="on">Summary</button><button data-ip="par">Parties (${plan.parties.length})</button><button data-ip="inv">Invoices (${plan.invoices.length})</button><button data-ip="err">Problems (${plan.errors.length})</button></div><div id="ipBody"></div></div>
    <div class="mfoot"><span class="small muted" id="ipNote"></span><span class="sp"></span><button class="btn" id="ipX">Cancel</button><button class="btn primary" id="ipGo">Import</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "1100px";
  const stats = () => { impDups(plan); const J = impJoins(plan); const nw = plan.parties.filter(p => !p.match && !J[p.key]), inv = plan.invoices.filter(i => !i.dup || i.force), dup = plan.invoices.filter(i => i.dup && !i.force);
    return { nw, inv, dup, canc: inv.filter(i => i.cancelled).length, amt: inv.filter(i => !i.cancelled).reduce((a, i) => a + i.total, 0), rec: plan.receipts.reduce((a, r) => a + r.amount, 0), ob: plan.parties.filter(p => p.opening > 0) }; };
  const k = (l, v, c = "") => `<div class="kpi ${c}" style="cursor:default"><div class="l">${l}</div><div class="v" style="font-size:20px">${v}</div></div>`;
  const draw = () => { const s = stats();
    $("#ipSum", m).innerHTML = `<div class="grid kpis">${k("Parties matched", plan.parties.length - s.nw.length, "green")}${k("New clients to create", s.nw.length, s.nw.length ? "amber" : "")}${k("Invoices to import", s.inv.length)}${k("Already in app – skipped", s.dup.length, s.dup.length ? "amber" : "")}${k("Invoice value (₹)", inr0(s.amt))}${k("Receipts in file (₹)", inr0(s.rec))}</div>`;
    $("#ipNote", m).textContent = `${s.inv.length} invoice(s)${s.canc ? ` incl. ${s.canc} cancelled` : ""} and `+`${s.ob.length} opening balance(s) will be imported. ${plan.receipts.length} receipt row(s) in the file; any already recorded are skipped.`;
    const B = $("#ipBody", m);
    if (tab === "sum") B.innerHTML = `<p>Check the <b>Parties</b> tab: each party is linked to one of your clients or will be created as a new client. Change the link where a match is wrong.</p>
      <p>Invoices already in Practice Manager are listed in the <b>Invoices</b> tab as skipped. Receipts already recorded on your invoices (same date and amount) are also skipped.</p>
      ${plan.errors.length ? `<div class="notice warn">${plan.errors.length} row(s) could not be read and will be left out. See the Problems tab.</div>` : ""}`;
    if (tab === "par") { B.innerHTML = `<div class="tablewrap" style="max-height:52vh"><table class="t"><thead><tr><th>Party in file</th><th>GSTIN / PAN</th><th>Link to</th><th>Matched by</th><th class="num">Invoices</th><th class="num">Balance as per books</th></tr></thead><tbody>
      ${plan.parties.map((p, i) => `<tr><td><b>${esc(p.name)}</b></td><td class="small">${esc(p.gstin || p.pan)}</td><td><select data-pm="${i}" style="max-width:320px;border:1px solid #cfd5df;border-radius:6px;padding:4px"><option value="">＋ Create new client (${esc(p.type || impGuessType(p.name))})</option>${opts}</select></td>
        <td>${p.match ? `<span class="chip green">${esc(p.how || "You")}</span>` : impJoins(plan)[p.key] ? `<span class="chip blue" title="Same PAN – this GSTIN is added to the new client ${esc(impJoins(plan)[p.key].name)}">Same PAN → ${esc(impJoins(plan)[p.key].name)}</span>` : '<span class="chip amber">New</span>'}</td><td class="num">${plan.invoices.filter(x => x.party === p.key).length || ""}</td><td class="num">${p.books == null ? "" : inr(p.books)}</td></tr>`).join("")}</tbody></table></div>`;
      $$("[data-pm]", B).forEach(sel => { const p = plan.parties[+sel.dataset.pm]; sel.value = p.match; sel.onchange = () => { p.match = sel.value; p.how = sel.value ? "You" : ""; draw(); }; }); }
    if (tab === "inv") { const rows = plan.invoices.slice().sort((a, b) => (!!b.dup - !!a.dup) || a.date.localeCompare(b.date)); const pn = Object.fromEntries(plan.parties.map(p => [p.key, p.name]));
      B.innerHTML = `<div class="tablewrap" style="max-height:52vh"><table class="t"><thead><tr><th>Invoice no.</th><th>Date</th><th>Party</th><th class="num">Lines</th><th class="num">Amount (₹)</th><th>Result</th></tr></thead><tbody>
      ${rows.slice(0, 1500).map(i => `<tr><td><b>${esc(i.no)}</b></td><td>${dmy(i.date)}</td><td>${esc(pn[i.party])}</td><td class="num">${i.lines.length}</td><td class="num">${inr(i.total)}</td>
        <td>${i.dup ? `<span class="chip amber">Skip – ${esc(i.dupWhy)}</span> <label class="small"><input type="checkbox" data-force="${esc(i.key)}" ${i.force ? "checked" : ""}> import anyway</label>` : i.cancelled ? '<span class="chip">Cancelled</span>' : '<span class="chip green">New</span>'}</td></tr>`).join("")}</tbody></table></div>`;
      $$("[data-force]", B).forEach(x => x.onchange = () => { const i = plan.invoices.find(v => v.key === x.dataset.force); i.force = x.checked; draw(); }); }
    if (tab === "err") B.innerHTML = plan.errors.length ? `<ul class="small">${plan.errors.map(e => `<li>${esc(e)}</li>`).join("")}</ul>` : '<div class="empty">No problems found.</div>'; };
  $$("[data-ip]", m).forEach(b => b.onclick = () => { tab = b.dataset.ip; $$("[data-ip]", m).forEach(x => x.classList.toggle("on", x === b)); draw(); });
  $("#mx", m).onclick = $("#ipX", m).onclick = () => { closeModal(); viewImport(); };
  $("#ipGo", m).onclick = () => { const s = stats(); $("#ipGo", m).disabled = true; $("#ipGo", m).textContent = "Importing…"; setTimeout(() => { try { impCommit(plan); } catch (e) { $("#ipGo", m).disabled = false; $("#ipGo", m).textContent = "Import"; alertBox("Import stopped", `<p>${esc(e.message || e)}</p><p>Nothing was saved.</p>`); } }, 30); };
  draw();
}
function impCommit(plan) {
  const batch = "imp" + Date.now().toString(36), now = new Date().toISOString(), rec = { batch, at: now, by: S.user, file: plan.file, fills: [], n: {} };
  const snapshot = JSON.stringify({ clients: S.db.clients, bills: S.db.bills || [], works: S.db.works, reimb: S.db.reimb, challans: S.db.challans });
  try {
    impDups(plan); const cid = {}, batchByPan = {}; let newC = 0;
    plan.parties.forEach(p => {
      if (p.match) { const c = clientById(p.match); cid[p.key] = c.id; const fill = {};
        [["pan", impPan(p)], ["gstin", p.gstin], ["mobile", p.mobile], ["email", p.email], ["address", p.address]].forEach(([f, v]) => { if (v && !c[f]) { fill[f] = c[f] || ""; c[f] = v; } });
        if (p.gstin && !gstsOf(c).some(g => g.g.toUpperCase() === p.gstin)) { fill.gstins = Array.isArray(c.gstins) ? JSON.parse(JSON.stringify(c.gstins)) : undefined; c.gstins = [...gstsOf(c), { g: p.gstin, label: p.state || "" }]; }
        if (Object.keys(fill).length) rec.fills.push({ id: c.id, old: fill }); return; }
      const pan = impPan(p), mate = pan && batchByPan[pan];
      if (mate) { cid[p.key] = mate.id; if (p.gstin && !gstsOf(mate).some(g => g.g === p.gstin)) mate.gstins.push({ g: p.gstin, label: p.state || "" });
        ["mobile", "email", "address"].forEach(f => { if (p[f] && !mate[f]) mate[f] = p[f]; }); return; }
      const code = p.code && !S.db.clients.some(x => (x.code || "").toUpperCase() === p.code) ? p.code : nextClientCode();
      const c = { id: uid(), code, name: p.name, type: CTYPE.includes(p.type) ? p.type : impGuessType(p.name), active: "Active", pan: impPan(p), gstin: p.gstin, gstins: p.gstin ? [{ g: p.gstin, label: p.state || "" }] : [], tan: "", cin: "", contact: "", mobile: p.mobile, email: p.email, group: "",
        manager: "", services: [], address: p.address, remarks: p.state ? "State: " + p.state : "", createdBy: S.user, createdAt: now, imp: batch };
      S.db.clients.push(c); cid[p.key] = c.id; newC++; if (c.pan) batchByPan[c.pan] = c; });
    S.db.bills = S.db.bills || []; const B = BS(); const fileBills = {}; let nInv = 0;
    const mkBill = (client, no, date, due, lines, notes, cancelled, src) => {
      if (S.db.bills.some(x => !isPF(x) && String(x.no).toLowerCase() === String(no).toLowerCase() && x.client !== client)) no = no + " (imp)";
      const ls = lines.map(l => ({ id: uid(), kind: "custom", ref: "", desc: l.desc, sac: l.sac, qty: l.qty, rate: l.rate, amount: l.amount, taxable: true, status: "", paid: 0 }));
      const tot = Math.round(ls.reduce((a, l) => a + l.amount, 0) * 100) / 100;
      const b = { id: uid(), no, date, due: due || "", fy: fyOf(date), client, lines: ls, tax: "none", rate: B.rate, taxable: tot, nontax: 0, cgst: 0, sgst: 0, igst: 0, round: 0, total: tot, notes, payMode: "Credit", showStatus: false, showQty: true,
        type: "invoice", status: cancelled ? "Cancelled" : "Active", receipts: [], createdBy: S.user, createdAt: now, imp: batch, src };
      S.db.bills.push(b); nInv++; return b; };
    plan.invoices.forEach(i => { const c = cid[i.party]; if (!c) return; const src = "x|" + i.party + "|" + i.no.toLowerCase() + "|" + i.date;
      if (i.dup && !i.force) { const b = S.db.bills.find(x => x.id === i.dup); if (b && b.status !== "Cancelled") (fileBills[c] = fileBills[c] || []).push(b); return; }
      const b = mkBill(c, i.no, i.date, i.due, i.lines, i.notes, i.cancelled, src); if (!i.cancelled) (fileBills[c] = fileBills[c] || []).push(b); });
    plan.parties.filter(p => p.opening > 0).forEach(p => { const c = cid[p.key], d = p.obDate || today(), src = "ob|" + p.key + "|" + d;
      if (S.db.bills.some(x => x.src === src)) return; const b = mkBill(c, "OB-" + clientById(c).code, d, "", [{ desc: `Opening balance as on ${dmy(d)}`, sac: "", qty: 1, rate: p.opening, amount: Math.round(p.opening * 100) / 100 }], "", false, src);
      (fileBills[c] = fileBills[c] || []).push(b); });
    let nRec = 0, skipped = 0; const unapplied = [];
    const open = c => (fileBills[c] || []).filter(b => billBal(b) > 0.004).sort((a, b) => a.date.localeCompare(b.date) || String(a.no).localeCompare(String(b.no), undefined, { numeric: true }));
    const put = (b, amt, r, src) => { (b.receipts = b.receipts || []).push({ id: uid(), date: r.date, amount: Math.round(amt * 100) / 100, mode: r.mode, ref: r.ref, by: S.user, at: now, imp: batch, src }); allocate(b, amt, r.date); };
    plan.receipts.forEach((r, n) => { const c = cid[r.party]; if (!c) return; const src = "r|" + r.party + "|" + r.date + "|" + r.amount + "|" + r.ref.toLowerCase() + "|" + r.inv.toLowerCase();
      const clientBills = S.db.bills.filter(b => b.client === c && !isPF(b));
      if (clientBills.some(b => (b.receipts || []).some(x => x.src === src && x.imp !== batch) || (b.receipts || []).some(x => !x.imp && x.date === r.date && Math.abs(num(x.amount) - r.amount) < 0.01))) { skipped++; return; }
      let left = r.amount; nRec++;
      if (r.inv) { const b = (fileBills[c] || []).find(x => String(x.no).toLowerCase() === r.inv.toLowerCase() || String(x.no).toLowerCase() === (r.inv + " (imp)").toLowerCase()); if (b && billBal(b) > 0.004) { const t = Math.min(left, billBal(b)); put(b, t, r, src); left -= t; } }
      for (const b of open(c)) { if (left <= 0.004) break; const t = Math.min(left, billBal(b)); put(b, t, r, src); left -= t; }
      if (left > 0.004) unapplied.push({ party: r.party, date: r.date, amount: Math.round(left * 100) / 100 }); });
    const grp = []; plan.parties.forEach(p => { const g = grp.find(x => x.c === cid[p.key]); if (g) { g.ps.push(p); } else grp.push({ c: cid[p.key], ps: [p] }); });
    const recon = grp.map(G => ({ key: G.ps.map(p => p.key), name: G.ps.map(p => p.name).filter((n, i, a) => a.indexOf(n) === i).join(" + ") + (G.ps.length > 1 ? ` (${G.ps.length} GSTINs)` : ""), books: G.ps.some(p => p.books == null) ? null : Math.round(G.ps.reduce((a, p) => a + p.books, 0) * 100) / 100 })).map(p => { const c = cid[p.key[0]], fb = new Set((fileBills[c] || []).map(b => b.id));
      const all = S.db.bills.filter(b => b.client === c && !isPF(b) && b.status !== "Cancelled" && !b.convertedTo);
      const inFile = all.filter(b => fb.has(b.id)).reduce((a, b) => a + Math.max(0, billBal(b)), 0), other = all.filter(b => !fb.has(b.id)).reduce((a, b) => a + Math.max(0, billBal(b)), 0);
      const adv = unapplied.filter(u => p.key.includes(u.party)).reduce((a, u) => a + u.amount, 0), pm = Math.round((inFile - adv) * 100) / 100;
      return { name: p.name, client: c, code: (clientById(c) || {}).code || "", books: p.books, pm, other: Math.round(other * 100) / 100, adv: Math.round(adv * 100) / 100, diff: p.books == null ? null : Math.round((pm - p.books) * 100) / 100 }; });
    rec.n = { inv: nInv, rec: nRec, cl: newC, skippedInv: plan.invoices.filter(i => i.dup && !i.force).length, skippedRec: skipped };
    rec.recon = recon.map(r => ({ n: r.name, c: r.code, b: r.books, p: r.pm, o: r.other, a: r.adv, d: r.diff }));
    (S.db.settings.importBatches = S.db.settings.importBatches || []).push(rec); if (S.db.settings.importBatches.length > 5) S.db.settings.importBatches.shift();
    log("Imported", "Billing", `${plan.file}: ${nInv} invoice(s), ${nRec} receipt(s), ${newC} new client(s); ${rec.n.skippedInv} invoice(s) and ${skipped} receipt(s) already in the app were skipped`);
    save(); closeModal(); toast("Import complete"); go("billing"); setTimeout(() => impReconView(rec.recon, plan.file, rec.n), 200);
  } catch (e) { const s = JSON.parse(snapshot); Object.assign(S.db, s); throw e; }
}
function impReconView(recon, file, n) {
  const withB = recon.filter(r => r.b != null), ok = withB.filter(r => Math.abs(r.d) < 1), bad = withB.filter(r => Math.abs(r.d) >= 1);
  const sumB = withB.reduce((a, r) => a + r.b, 0), sumP = withB.reduce((a, r) => a + r.p, 0);
  const rows = recon.slice().sort((a, b) => (b.d == null ? -1 : Math.abs(b.d)) - (a.d == null ? -1 : Math.abs(a.d)) || a.n.localeCompare(b.n));
  const m = openModal(`<div class="mhead"><h3>Balance check · ${esc(file || "")}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    ${n ? `<p>Imported <b>${n.inv}</b> invoice(s) and <b>${n.rec}</b> receipt(s); created <b>${n.cl}</b> new client(s). Skipped as already in the app: ${n.skippedInv} invoice(s), ${n.skippedRec} receipt(s).</p>` : ""}
    ${withB.length ? `<div class="notice ${bad.length ? "warn" : ""}" style="font-size:13.5px">${bad.length ? `⚠ <b>${bad.length}</b> of ${withB.length} parties do not match the books.` : `✔ All <b>${withB.length}</b> parties match the books.`} Total as per books ₹ ${inr(sumB)} · in Practice Manager ₹ ${inr(sumP)}.</div>` : '<p class="muted">The file had no “Balance as per Books”, so balances were not checked.</p>'}
    <div class="tablewrap" style="max-height:52vh"><table class="t"><thead><tr><th>Party</th><th>Code</th><th class="num">As per books (₹)</th><th class="num">In Practice Manager (₹)</th><th class="num">Difference (₹)</th><th>Result</th><th class="num">Other invoices not in file (₹)</th></tr></thead><tbody>
    ${rows.map(r => `<tr><td><b>${esc(r.n)}</b></td><td>${esc(r.c)}</td><td class="num">${r.b == null ? "" : inr(r.b)}</td><td class="num">${inr(r.p)}${r.a ? `<div class="small muted">after ₹${inr(r.a)} advance</div>` : ""}</td><td class="num ${r.d && Math.abs(r.d) >= 1 ? "red b" : ""}">${r.d == null ? "" : inr(r.d)}</td>
      <td>${r.b == null ? "" : Math.abs(r.d) < 1 ? '<span class="chip green">Matched</span>' : '<span class="chip red">Difference</span>'}</td><td class="num">${r.o ? inr(r.o) : ""}</td></tr>`).join("")}</tbody></table></div>
    <p class="small muted">“In Practice Manager” is the unpaid amount of this party's invoices from the file (including invoices you already had that matched them), less any receipts that were more than the invoices (advance). “Other invoices not in file” are invoices that exist only in Practice Manager; they are not part of the check.</p></div>
    <div class="mfoot"><button class="btn" id="rcEx">⬇ Excel</button><span class="sp"></span><button class="btn primary" id="rcX">Close</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "1000px";
  $("#mx", m).onclick = $("#rcX", m).onclick = closeModal;
  $("#rcEx", m).onclick = () => exportCSV("Import balance check", [{ l: "Party", x: r => r.n }, { l: "Code", x: r => r.c }, { l: "As per books", x: r => r.b ?? "" }, { l: "In Practice Manager", x: r => r.p }, { l: "Difference", x: r => r.d ?? "" }, { l: "Result", x: r => r.b == null ? "" : Math.abs(r.d) < 1 ? "Matched" : "Difference" }, { l: "Other invoices not in file", x: r => r.o }], rows);
}
async function impUndo(rec) {
  if (!rec) return;
  const bills = (S.db.bills || []).filter(b => b.imp === rec.batch), recs = (S.db.bills || []).filter(b => b.imp !== rec.batch && (b.receipts || []).some(r => r.imp === rec.batch));
  if (!(await confirmBox("Undo import", `<p>Remove everything added by the import of <b>${esc(rec.file)}</b> on ${new Date(rec.at).toLocaleString("en-IN")}?</p><p>${bills.length} invoice(s), the receipts it recorded, and the clients it created (unless you have since added work or bills for them) will be removed. Details it filled into existing clients are cleared again.</p>`, "Undo import"))) return;
  recs.forEach(b => { unlinkBill(b); b.receipts = b.receipts.filter(r => r.imp !== rec.batch); linkBill(b); });
  const del = new Set(bills.map(b => b.id)); S.db.bills = S.db.bills.filter(b => !del.has(b.id));
  const used = id => S.db.works.some(w => w.client === id) || S.db.bills.some(b => b.client === id) || S.db.challans.some(c => c.client === id) || S.db.reimb.some(r => r.client === id) || S.db.udins.some(u => u.client === id);
  const before = S.db.clients.length; S.db.clients = S.db.clients.filter(c => c.imp !== rec.batch || used(c.id)); const nc = before - S.db.clients.length;
  (rec.fills || []).forEach(f => { const c = clientById(f.id); if (c) Object.assign(c, f.old); });
  S.db.settings.importBatches = (S.db.settings.importBatches || []).filter(x => x.batch !== rec.batch);
  log("Undone", "Billing", `Import of ${rec.file}: removed ${bills.length} invoice(s) and ${nc} client(s)`); save(); closeModal(); toast("Import undone"); go("billing");
}

/* ------------------------------------------------------------------ AUTH */
const FAILKEY = "ksc_pm_fail";
const ss = { get: k => { try { return sessionStorage.getItem(k); } catch { return null; } }, set: (k, v) => { try { sessionStorage.setItem(k, v); } catch {} } };
function failState() { try { return JSON.parse(localStorage.getItem(FAILKEY)) || { n: 0, until: 0 }; } catch { return { n: 0, until: 0 }; } }
function setFail(o) { try { localStorage.setItem(FAILKEY, JSON.stringify(o)); } catch {} }

async function boot() {
  if ($("#verBtn")) { $("#verBtn").textContent = verText(); $("#verBtn").onclick = showChanges; } if ($("#authVer")) $("#authVer").textContent = "KSC Practice Manager · " + verText();
  if (!window.crypto || !crypto.subtle) { document.body.innerHTML = "<p style='padding:40px'>This browser does not support secure encryption. Please open the file in Google Chrome or Microsoft Edge.</p>"; return; }
  if (window.claude && typeof window.claude.use === "function") return cloudBoot();
  await IDB.open();
  S.vault = await IDB.get("vault");
  try { S.fileHandle = await IDB.get("filehandle") || null; } catch { S.fileHandle = null; }
  try { S.docRoot = await IDB.get("docroot") || null; } catch { S.docRoot = null; }
  showAuth();
}
function showAuth() {
  $("#app").hidden = true; $("#auth").hidden = false; closeModal(); $("#printArea").innerHTML = "";
  if ($("#cloudMsg")) $("#cloudMsg").remove();
  if (CL.on) $("#liNote").textContent = "🔒 Online workspace. Your data is encrypted in your browser with your password before it is stored online.";
  if (CL.on && !S.vault && !CL.isOwner && !S.importVault) { $("#setupForm").hidden = true; $("#loginForm").hidden = true; $("#authTitle").textContent = "Practice Manager"; $("#authSub").textContent = "Online workspace";
    $("#authSub").insertAdjacentHTML("afterend", `<p id="cloudMsg" class="small">The online workspace has not been set up yet. Ask the owner to open this link and create it.</p>`); return; }
  if (S.importVault) { $("#setupForm").hidden = true; $("#loginForm").hidden = false; $("#authTitle").textContent = (S.importVault.firm || "Practice Manager") + " – import"; $("#authSub").textContent = "Log in with the backup's Admin user name and password to upload it online"; return; }
  if (!S.vault) {
    $("#setupForm").hidden = false; $("#loginForm").hidden = true;
    $("#authTitle").textContent = "Set up Practice Manager"; $("#authSub").textContent = CL.on ? "Create the online workspace – or restore your existing backup below" : "Create your encrypted workspace (one-time)";
  } else {
    $("#setupForm").hidden = true; $("#loginForm").hidden = false;
    $("#authTitle").textContent = S.vault.firm || "Practice Manager"; logoInto($("#authLogo"), S.vault.logo, S.vault.firm); $("#authSub").textContent = CL.on ? "Online workspace – enter your Practice Manager login" : "Enter your password to unlock";
    const lu = ss.get("ksc_last_user"); if (lu) $("#liUser").value = lu;
    setTimeout(() => ($("#liUser").value ? $("#liPass") : $("#liUser")).focus(), 50);
  }
}
$("#suPass").addEventListener("input", e => meter($("#suMeter"), e.target.value));
$("#setupForm").addEventListener("submit", async e => {
  e.preventDefault();
  const firm = $("#suFirm").value.trim(), u = $("#suUser").value.trim().toLowerCase(), p = $("#suPass").value, p2 = $("#suPass2").value;
  const err = $("#suErr");
  if (!/^[a-z0-9._-]{3,40}$/.test(u)) return err.textContent = "User name: 3–40 letters, numbers, dot, dash or underscore.";
  if (!pwOk(p)) return err.textContent = "Password must be at least 10 characters with letters, numbers and a symbol.";
  if (p !== p2) return err.textContent = "Passwords do not match.";
  err.textContent = "Creating encrypted workspace…";
  const dekRaw = rnd(32);
  const usr = await wrapForUser(u, "Admin", p, dekRaw); { const raw = rnd(32); usr.ak = await aesEnc(await deriveKEK(p, unb64(usr.salt), usr.iter || ITER), raw); S.akRaw = raw; S.ak = await importDEK(raw); }
  S.vault = CL.on ? { app: "KSC-PM", v: 2, firm, users: [usr], cols: [], updated: new Date().toISOString() } : { app: "KSC-PM", v: 1, firm, users: [usr], data: null, updated: null };
  S.dekRaw = dekRaw; S.dek = await importDEK(dekRaw); S.user = u; S.role = "Admin";
  S.db = blankDB(firm); S.db.settings.staff = [u]; S.db.settings.roles = { [u]: "Admin" }; S.db.settings.lastLogin = { [u]: new Date().toISOString() };
  log("Setup", "System", CL.on ? "Online workspace created" : "Workspace created");
  if (CL.on) { CL.last.clear(); await cloudSubscribeAll(); }
  await saveNow();
  $("#setupForm").reset(); err.textContent = "";
  enterApp();
});
$("#loginForm").addEventListener("submit", async e => {
  e.preventDefault();
  const err = $("#liErr"); const fs = failState();
  if (fs.until > Date.now()) return err.textContent = `Too many failed attempts. Try again in ${Math.ceil((fs.until - Date.now()) / 1000)} s.`;
  const u = $("#liUser").value.trim().toLowerCase(), p = $("#liPass").value;
  $("#liBtn").disabled = true; err.textContent = "Unlocking…";
  try {
    const V = S.importVault || S.vault;
    const usr = V.users.find(x => x.u === u);
    if (!usr) throw new Error("bad");
    const kek = await deriveKEK(p, unb64(usr.salt), usr.iter || ITER);
    const dekRaw = await aesDec(kek, { iv: usr.wiv, ct: usr.wct });
    const dek = await importDEK(dekRaw);
    let db;
    if (CL.on && S.importVault) { db = JSON.parse(dec.decode(await aesDec(dek, S.importVault.data)));
      if (((db.settings.roles || {})[u] || usr.role) !== "Admin") { err.textContent = "Only an Admin of the backup can upload it."; return; } }
    else if (CL.on) { S.dek = dek; err.textContent = "Loading online data…"; db = await cloudLoad(m => err.textContent = m); }
    else db = JSON.parse(dec.decode(await aesDec(dek, S.vault.data)));
    const sec = db.settings; sec.roles = sec.roles || {}; sec.lastLogin = sec.lastLogin || {};
    if ((sec.disabled || []).includes(u)) { setFail({ n: 0, until: 0 }); err.textContent = "This login has been disabled by the Admin."; $("#liPass").value = ""; if (CL.on) cloudUnsubscribe(); S.dek = null; S.db = null; return; }
    S.dekRaw = dekRaw; S.dek = dek; S.db = db; S.user = u; S.role = sec.roles[u] || usr.role;
    if (S.role === "Admin") await akUnlock(usr, kek, V); else { S.ak = null; S.akRaw = null; }
    await ckUnlock(usr, kek);
    if (CL.on && S.importVault) { S.vault = { app: "KSC-PM", v: 2, firm: S.importVault.firm || db.settings.firm.name, users: S.importVault.users, cols: [], ...(S.importVault.pwb ? { pwb: S.importVault.pwb } : {}), ...(S.importVault.ckA ? { ckA: S.importVault.ckA } : {}), updated: new Date().toISOString() }; S.importVault = null;
      CL.last.clear(); log("Imported", "System", "Backup uploaded to the online workspace"); err.textContent = "Uploading your data…"; await cloudSubscribeAll(); cloudPush(); await cloudDrain(120000); }
    S.prevLogin = sec.lastLogin[u] || ""; sec.lastLogin[u] = new Date().toISOString();
    setFail({ n: 0, until: 0 }); ss.set("ksc_last_user", u);
    $("#liPass").value = ""; err.textContent = "";
    log("Login", "System", "Signed in"); save();
    const newly = visW().filter(w => w.assigned === u && w.assignedBy && w.assignedBy !== u && w.assignedAt > S.prevLogin && isOpen(w)).length;
    const decided = (S.db.requests || []).filter(q => q.user === u && q.status !== "Pending" && q.decidedAt > S.prevLogin);
    const pendAdm = S.role === "Admin" ? (S.db.requests || []).filter(q => q.status === "Pending").length : 0;
    const rvN = S.role === "Admin" ? S.db.works.filter(w => stg(w.status) === "Under review").length : 0;
    const msgs = [newly ? `${newly} new task(s) assigned to you` : "", decided.length ? `${decided.filter(q => q.status === "Approved").length} request(s) approved, ${decided.filter(q => q.status === "Rejected").length} rejected` : "", pendAdm || rvN ? `🔔 ${pendAdm + rvN} item(s) waiting in Approvals` : ""].filter(Boolean);
    if (msgs.length) setTimeout(() => toast(msgs.join(" · "), 6000), 400);
    if (S.fileHandle) { try { await S.fileHandle.requestPermission({ mode: "readwrite" }); } catch {} }
    enterApp();
  } catch (ex) {
    const n = fs.n + 1; const until = n >= 5 ? Date.now() + Math.min(3600000, 30000 * 2 ** (n - 5)) : 0;
    setFail({ n, until });
    err.textContent = n >= 5 ? `Incorrect user name or password. Locked for ${Math.round((until - Date.now()) / 1000)} s.` : `Incorrect user name or password (${n} failed attempt${n > 1 ? "s" : ""}).`;
    $("#liPass").value = "";
  } finally { $("#liBtn").disabled = false; }
});
function lock(reason) {
  if (!S.db) return;
  saveNow().finally(() => { if (CL.on) cloudUnsubscribe(); S.db = null; S.dek = null; S.dekRaw = null; S.ak = null; S.akRaw = null; S.ck = null; S.ckRaw = null; S.user = null; S.role = null; $("#view").innerHTML = ""; showAuth(); if (reason) $("#liErr").textContent = reason; });
}
$("#lockBtn").onclick = () => lock();
$("#bell").onclick = e => { e.stopPropagation(); bellMenu(); };
$("#navT").onclick = () => document.body.classList.toggle("navopen");
["mousemove", "keydown", "click", "scroll", "touchstart"].forEach(ev => document.addEventListener(ev, () => S.last = Date.now(), { passive: true }));
setInterval(() => { if (S.db && Date.now() - S.last > (S.db.settings.autolock || 10) * 60000) lock("Locked automatically after inactivity."); }, 15000);

/* restore from backup (auth screen) */
function pickRestore() { $("#restoreFile").value = ""; $("#restoreFile").click(); }
$("#suRestore").onclick = pickRestore; $("#liRestore").onclick = pickRestore;
$("#restoreFile").addEventListener("change", async e => {
  const file = e.target.files[0]; if (!file) return;
  try {
    const v = JSON.parse(await file.text());
    if (v.app !== "KSC-PM" || !Array.isArray(v.users) || !v.data) throw new Error("Not a Practice Manager backup file.");
    if (CL.on) { if (!CL.isOwner) throw new Error("Only the owner of this online workspace can upload a backup.");
      if (S.vault) throw new Error("The online workspace already has data. To replace it, log in as Admin, go to Settings › Erase online workspace, then restore.");
      S.importVault = v; toast("Backup loaded – log in with its Admin password to upload it"); showAuth(); return; }
    if (S.vault && !(await confirmBox("Restore backup", `<p>This replaces the data currently stored in this browser with the backup <b>${esc(file.name)}</b> (saved ${esc((v.updated || "").slice(0, 10))}).</p><p>You will log in with the user names and passwords that were valid when the backup was made.</p>`, "Replace and restore"))) return;
    await IDB.put("vault", v); S.vault = v; toast("Backup restored – log in with that backup's password"); showAuth();
  } catch (ex) { alertBox("Restore failed", esc(ex.message)); }
});
function alertBox(title, html) { const m = openModal(`<div class="mhead"><h3>${esc(title)}</h3></div><div class="mbody">${html}</div><div class="mfoot"><button class="btn primary" id="abOk">OK</button></div>`, true); $("#abOk", m).onclick = closeModal; }

/* ------------------------------------------------------------------ APP SHELL */
const NAV = [
  ["grp", "Overview"], ["dashboard", "Dashboard", "◧"], ["calendar", "Calendar", "📅"], ["approvals", "Approvals", "🔔", "REVIEW"], ["mywork", "My Work", "✅"], ["status", "Client Status", "◉", "reports"],
  ["grp", "Compliance Trackers"], ["tgst", "GST Returns", "🟦"], ["ttdsq", "TDS Returns (Qtr)", "🟪"], ["ttdsm", "TDS Challans (Monthly)", "🟫"], ["troc", "ROC / MCA", "🟧"], ["titr", "ITR & Audits", "🟩"], ["cases", "Notices & Cases", "⚖", "cases"], ["sgroups", "Search / Survey Groups", "🔎", "cases"],
  ["grp", "Registers"], ["clients", "Clients", "👥"], ["works", "Work Tracker", "📋"], ["challans", "Challans", "🧾", "challans"], ["reimb", "Reimbursements", "💼", "reimb"], ["udins", "UDIN Register", "🔖", "udins"],
  ["grp", "Client Desk"], ["dsc", "DSC Register", "🔑", "dsc"], ["docreq", "Document Requests", "📨", "docreq"], ["engage", "Engagement Letters", "📝", "engage"], ["creds", "Portal Logins", "🔐", "CREDS"],
  ["grp", "Output"], ["billing", "Billing", "💳", "billing"], ["reports", "Reports", "📊", "reports"],
  ["grp", "Admin"], ["bin", "Bin", "🗑", "ADMIN"], ["team", "Team & Rights", "🧑‍🤝‍🧑", "ADMIN"], ["log", "Activity Log", "🕘", "ADMIN"], ["settings", "Settings & Security", "⚙"],
];
const navOk = n => !n[3] || (n[3] === "CREDS" ? credOK() : n[3] === "REVIEW" ? isAdmin() : n[3] === "ADMIN" ? isAdmin() : n[3] === "billing" ? can("billing") && can("viewFees") : can(n[3]));
function migrateTDS() {
  const st = S.db.settings; if (st.tdsSplit) return; st.tdsSplit = 1; const isCh = f => /TDS\/TCS payment|TDS payment|TCS payment|challan/i.test(f || ""); let n = 0;
  S.db.works.forEach(w => { if (w.service === "TDS / TCS") { w.service = isCh(w.form) || (MONTHS.includes(w.period) && !/24Q|26Q|27Q|27EQ/i.test(w.form)) ? "TDS Challan" : "TDS Return"; n++; } });
  S.db.clients.forEach(c => { if ((c.services || []).includes("TDS / TCS")) c.services = [...new Set(c.services.flatMap(x => x === "TDS / TCS" ? ["TDS Return", "TDS Challan"] : [x]))]; });
  st.assignRules = (st.assignRules || []).flatMap(r => r.type === "service" && r.value === "TDS / TCS" ? [{ ...r, value: "TDS Return" }, { ...r, value: "TDS Challan" }] : [r]);
  Object.keys(st.formService || {}).forEach(k => { if (st.formService[k] === "TDS / TCS") st.formService[k] = isCh(k) ? "TDS Challan" : "TDS Return"; });
  if (n) log("Updated", "System", `TDS service split into “TDS Return” and “TDS Challan” – ${n} task(s) updated`); save();
}
function enterApp() {
  S.navOpen = new Set();
  S.db.bin = S.db.bin || []; ["dsc", "docreq", "engage", "creds", "cases", "sgroups"].forEach(k => S.db[k] = S.db[k] || []); if (isAdmin()) migrateTDS(); S._apprSeen = null;
  $("#auth").hidden = true; $("#app").hidden = false; S.last = Date.now();
  const f = S.db.settings.firm;
  if (f.logo && !S.vault.logo) S.vault.logo = f.logo; brandRender();
  $("#whoName").textContent = ulabel(S.user); $("#whoRole").textContent = S.role; renderMe(); if ($("#meBtn")) $("#meBtn").onclick = () => profileDialog(S.user);
  S.vault.firm = f.name;
  go(S.route || "dashboard");
}
function cloudLabels(root) { if (!CL.on) return; $$("button", root).forEach(b => { if (/^🖨 Print/.test(b.textContent)) b.textContent = b.textContent.replace(/^🖨 Print( list| slips)?/, (m0, x) => "📄 Printable " + (x ? x.trim() : "copy")); }); }
if (typeof MutationObserver !== "undefined") new MutationObserver(() => { if (CL && CL.on) cloudLabels(document.body); }).observe(document.documentElement, { childList: true, subtree: true });
function renderNav() {
  let G = "";
  $("#nav").innerHTML = NAV.filter(n => n[0] === "grp" ? (n[1] !== "Admin" && n[1] !== "Output") || NAV.some(m => m[0] !== "grp" && NAV.indexOf(m) > NAV.indexOf(n) && navOk(m) && NAV.slice(NAV.indexOf(n) + 1, NAV.indexOf(m)).every(x => x[0] !== "grp")) : navOk(n)).map(n => n[0] === "grp" ? (G = n[1], `<button type="button" class="grp" data-g="${esc(n[1])}" title="Show or hide this group"><span>${n[1]}</span><span class="gb" hidden></span><span class="chev" aria-hidden="true">▾</span></button>`) :
    `<a data-g="${esc(G)}" data-r="${n[0]}" data-badge="${n[0] === "approvals" ? apprCount() || "" : n[0] === "bin" ? (S.db.bin || []).filter(b => b.status === "Pending").length || "" : ""}" class="${S.route.split(":")[0] === n[0] || (S.route.startsWith("client:") && n[0] === "clients") ? "on" : ""}"><span class="ico">${n[2]}</span>${n[1]}</a>`).join("");
  $$("#nav a").forEach(a => a.onclick = () => { document.body.classList.remove("navopen"); go(a.dataset.r); });
  applyNavGroups(); updateBell();
}
/* sidebar groups start folded at every login; groups opened stay open until logout */
function applyNavGroups() { const open = S.navOpen = S.navOpen || new Set();
  $$("#nav .grp").forEach(g => { const name = g.dataset.g, shut = !open.has(name), items = $$("#nav a").filter(a => a.dataset.g === name);
    items.forEach(a => a.hidden = shut && !a.classList.contains("on"));
    g.classList.toggle("closed", shut); g.setAttribute("aria-expanded", String(!shut));
    const n = shut ? items.reduce((t, a) => t + (parseInt(a.dataset.badge) || 0), 0) : 0, gb = g.querySelector(".gb"); gb.textContent = n || ""; gb.hidden = !n;
    g.onclick = () => { if (open.has(name)) open.delete(name); else open.add(name); applyNavGroups(); }; }); }
/* ------------------------------------------------------------------ APPROVALS (admin / reviewers) */
const pendReq = () => isAdmin() ? (S.db.requests || []).filter(q => q.status === "Pending") : [];
const reviewTasks = () => isAdmin() ? S.db.works.filter(w => stg(w.status) === "Under review") : [];
const pendDel = () => isAdmin() ? (S.db.bin || []).filter(b => b.status === "Pending") : [];
const apprCount = () => S.db ? pendReq().length + reviewTasks().length + pendDel().length : 0;
function updateBell() {
  const b = $("#bell"); if (!b || !S.db) return; const n = apprCount(); const ok = isAdmin() || can("markDone");
  b.hidden = !isAdmin(); $("#bellN").textContent = n || ""; $("#bellN").hidden = !n; b.classList.toggle("has", !!n);
  try { document.title = (n ? `(${n}) ` : "") + (S.db.settings.firm.name || "Practice Manager"); } catch {}
  const ids = new Set([...pendReq().map(q => "r" + q.id), ...reviewTasks().map(w => "w" + w.id), ...pendDel().map(b => "d" + b.id)]);
  if (S._apprSeen) { const fresh = [...ids].filter(i => !S._apprSeen.has(i));
    if (fresh.length && S.route !== "approvals") { const r = pendReq().find(q => fresh.includes("r" + q.id)), w = reviewTasks().find(x => fresh.includes("w" + x.id));
      const dl = pendDel().find(x => fresh.includes("d" + x.id));
      toast(`🔔 ${dl && !r && !w ? `${uname(dl.by)} deleted “${cname(dl.item.client)} – ${dl.item.form}” – approve or restore it` : r ? `${uname(r.user)} asked to ${r.type === "delete" ? "delete" : "change"} a task` : `${uname(w.updatedBy || w.assigned)} sent “${cname(w.client)} – ${w.form}” for your review`}${fresh.length > 1 ? ` (+${fresh.length - 1} more)` : ""} – see Approvals`, 6000);
      b.classList.remove("ring"); void b.offsetWidth; b.classList.add("ring"); chime(); } }
  S._apprSeen = ids;
}
let _actx = null; function chime() { if (!(S.db.settings.notify || {})[S.user]) return; try { _actx = _actx || new (window.AudioContext || window.webkitAudioContext)(); const o = _actx.createOscillator(), g = _actx.createGain(); o.frequency.value = 880; g.gain.setValueAtTime(0.0001, _actx.currentTime); g.gain.exponentialRampToValueAtTime(0.15, _actx.currentTime + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, _actx.currentTime + 0.5); o.connect(g).connect(_actx.destination); o.start(); o.stop(_actx.currentTime + 0.5); } catch {} }
function bellMenu() {
  $$(".bellpop").forEach(x => x.remove()); const rq = pendReq(), rv = reviewTasks(), pd = pendDel();
  const d = document.createElement("div"); d.className = "bellpop";
  d.innerHTML = `<div class="b" style="padding:8px 10px;border-bottom:1px solid var(--line)">🔔 Waiting for you (${rq.length + rv.length + pd.length})</div><div style="max-height:320px;overflow:auto">
    ${pd.map(b => `<a data-go="approvals"><b>${esc(uname(b.by))}</b> deleted <b class="red">${esc(cname(b.item.client) + " – " + b.item.form + " " + (b.item.period || ""))}</b> – needs your OK<br><span class="small muted">${esc(new Date(b.at).toLocaleString("en-IN"))}</span></a>`).join("")}
    ${rq.map(q => { const w = S.db.works.find(x => x.id === q.workId); return `<a data-go="approvals"><b>${esc(uname(q.user))}</b> asks to ${q.type === "delete" ? "<b class='red'>delete</b>" : "<b>change</b>"} ${w ? esc(cname(w.client) + " – " + w.form) : "a task"}<br><span class="small muted">${esc(new Date(q.ts).toLocaleString("en-IN"))}</span></a>`; }).join("")}
    ${rv.map(w => `<a data-go="approvals"><b>${esc(cname(w.client))}</b> – ${esc(w.form)} ${esc(w.period || "")} sent for review${w.assigned ? " by " + esc(uname(w.assigned)) : ""}<br><span class="small muted">${w.updatedAt ? esc(new Date(w.updatedAt).toLocaleString("en-IN")) : ""}</span></a>`).join("")}
    ${rq.length + rv.length + pd.length ? "" : '<div class="small muted" style="padding:14px 10px">Nothing waiting for you.</div>'}</div>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border-top:1px solid var(--line)"><label class="small" style="display:flex;gap:6px;align-items:center"><input type="checkbox" id="bSnd" ${(S.db.settings.notify || {})[S.user] ? "checked" : ""}> Sound for new items</label><button class="btn sm primary" data-go="approvals">Open Approvals</button></div>`;
  document.body.appendChild(d); const r = $("#bell").getBoundingClientRect(); d.style.top = (r.bottom + 6) + "px"; d.style.right = Math.max(8, window.innerWidth - r.right) + "px";
  d.onclick = e => e.stopPropagation(); $$("[data-go]", d).forEach(a => a.onclick = () => { d.remove(); go("approvals"); });
  $("#bSnd", d).onchange = e => { const n = S.db.settings.notify = S.db.settings.notify || {}; n[S.user] = e.target.checked; save(); if (e.target.checked) { chime(); toast("A short sound will play when something new needs your approval"); } };
  setTimeout(() => document.addEventListener("click", () => d.remove(), { once: true }), 0);
}
function viewApprovals() {
  setTitle("Approvals"); const rv = reviewTasks().sort((a, b) => (a.due || "9999").localeCompare(b.due || "9999"));
  const done = (S.db.works || []).filter(w => w.reviewedBy === S.user && w.reviewedAt).sort((a, b) => b.reviewedAt.localeCompare(a.reviewedAt)).slice(0, 8);
  $("#view").innerHTML = `<div class="grid kpis" style="margin-bottom:14px"><div class="kpi ${pendReq().length ? "amber" : "green"}" style="cursor:default"><div class="l">Change requests</div><div class="v">${pendReq().length}</div></div>
      <div class="kpi ${rv.length ? "amber" : "green"}" style="cursor:default"><div class="l">Tasks sent for review</div><div class="v">${rv.length}</div></div>
      <div class="kpi ${pendDel().length ? "red" : "green"}" style="cursor:default"><div class="l">Deletions to approve</div><div class="v">${pendDel().length}</div></div></div>
    ${pendDel().length ? `<div class="card" style="margin-bottom:14px"><h3>🗑 Tasks deleted by staff – waiting for your OK (${pendDel().length})</h3><p class="small" style="margin-top:0">These tasks are already out of the work list. <b>Approve</b> keeps them deleted (they stay in the Bin, where you can still restore them). <b>Restore</b> puts them back.</p>
      <div class="tablewrap" style="border:none"><table class="t"><thead><tr><th>Client</th><th>Task</th><th>Status</th><th>Deleted by</th><th>When</th><th>Reason</th><th></th></tr></thead><tbody>${pendDel().map(b => `<tr><td><b>${esc(cname(b.item.client))}</b></td><td>${esc(b.item.form)} ${esc(b.item.period || "")} ${esc(b.item.fy || "")}</td><td>${statusChip(b.item.status)}</td><td>${esc(uname(b.by))}</td><td class="small">${esc(new Date(b.at).toLocaleString("en-IN"))}</td><td class="small" style="white-space:normal;max-width:240px">${esc(b.reason || "")}</td>
      <td style="text-align:right"><button class="btn sm danger" data-bdok="${b.id}">✓ Approve deletion</button> <button class="btn sm" data-bdres="${b.id}">↩ Restore</button></td></tr>`).join("")}</tbody></table></div></div>` : ""}
    <div class="card"><h3>📝 Tasks waiting for your review (${rv.length})</h3>
      ${rv.length ? `<div class="toolbar" style="margin-bottom:8px"><label class="small" style="display:flex;gap:6px;align-items:center"><input type="checkbox" id="apAll"> Select all</label><button class="btn sm primary" id="apOkAll">✓ Approve selected</button><span class="small muted">Approving marks the task Filed / Done. Sending back returns it to In progress with your note.</span></div>
      <div class="tablewrap" style="border:none"><table class="t"><thead><tr><th></th><th>Client</th><th>Task</th><th>Due</th><th>Filed</th><th>ARN</th><th>Done by</th><th>Sent</th><th></th></tr></thead><tbody>
      ${rv.map(w => `<tr><td><input type="checkbox" class="apS" value="${w.id}"></td><td><b>${esc(cname(w.client))}</b></td><td><a class="link" data-open="${w.id}">${esc(w.form)} ${esc(w.period || "")} ${esc(w.fy || "")}</a>${(w.docs || []).length ? ` <span class="chip blue">📎${w.docs.length}</span>` : ""}${(w.notes || []).length ? ` <span class="chip" title="${esc((w.notes.slice(-1)[0] || {}).text || "")}">💬${w.notes.length}</span>` : ""}</td>
        <td>${dmy(w.due)}</td><td>${dmy(w.filed)}</td><td class="small">${esc(w.arn || "")}</td><td>${esc(uname(w.assigned))}</td><td class="small">${w.updatedAt ? esc(new Date(w.updatedAt).toLocaleString("en-IN")) : ""}</td>
        <td style="text-align:right"><button class="btn sm primary" data-apok="${w.id}">✓ Approve</button> <button class="btn sm" data-apback="${w.id}">↩ Send back</button></td></tr>`).join("")}</tbody></table></div>` : '<p class="small muted" style="margin:0">Nothing to review. When someone sets a task to “Under review”, it appears here.</p>'}</div>
    ${isAdmin() ? requestsCardHTML() : ""}
    ${done.length ? `<div class="card" style="margin-top:14px"><h3>Recently reviewed by you</h3><table class="t"><tbody>${done.map(w => `<tr><td>${esc(cname(w.client))} – ${esc(w.form)} ${esc(w.period || "")}</td><td>${statusChip(w.status)}</td><td class="small muted">${esc(new Date(w.reviewedAt).toLocaleString("en-IN"))}</td></tr>`).join("")}</tbody></table></div>` : ""}`;
  const now = () => new Date().toISOString();
  const approve = ids => { const t = now(); let n = 0; S.db.works.filter(w => ids.includes(w.id)).forEach(w => { w.status = "Filed / Done"; if (!w.filed) w.filed = today(); w.reviewedBy = S.user; w.reviewedAt = t; w.updatedBy = S.user; w.updatedAt = t; (w.notes = w.notes || []).push({ ts: t, user: S.user, text: "Reviewed and approved." }); n++; });
    log("Approved", "Review", `${n} task(s) approved`); save(); toast(`${n} task(s) approved and marked Filed / Done`); renderNav(); viewApprovals(); };
  $$("[data-apok]").forEach(b => b.onclick = () => approve([b.dataset.apok]));
  if ($("#apAll")) $("#apAll").onchange = e => $$(".apS").forEach(x => x.checked = e.target.checked);
  if ($("#apOkAll")) $("#apOkAll").onclick = () => { const ids = $$(".apS:checked").map(x => x.value); if (!ids.length) return toast("Tick the tasks to approve"); approve(ids); };
  $$("[data-apback]").forEach(b => b.onclick = () => { const w = S.db.works.find(x => x.id === b.dataset.apback);
    const m = openModal2(`<div class="mhead"><h3>Send back – ${esc(cname(w.client))} – ${esc(w.form)}</h3></div><div class="mbody"><div class="field"><label>What needs to be corrected? (sent to ${esc(uname(w.assigned) || "the assignee")})</label><textarea id="sbT" placeholder="e.g. Challan amount doesn't match books – recheck interest"></textarea></div></div><div class="mfoot"><button class="btn" id="sbN">Cancel</button><button class="btn primary" id="sbY">↩ Send back</button></div>`);
    $("#sbN", m).onclick = () => m.remove();
    $("#sbY", m).onclick = () => { const t = now(), note = $("#sbT", m).value.trim(); w.status = "In progress"; w.reviewedBy = S.user; w.reviewedAt = t; w.updatedBy = S.user; w.updatedAt = t; (w.notes = w.notes || []).push({ ts: t, user: S.user, text: "Sent back for correction" + (note ? ": " + note : ".") });
      log("Sent back", "Review", `${describe("works", w)}${note ? " – " + note : ""}`); save(); m.remove(); toast("Sent back"); renderNav(); viewApprovals(); }; });
  bindRequests(viewApprovals);
  $$("[data-bdok]").forEach(b => b.onclick = () => { binApprove([b.dataset.bdok]); viewApprovals(); });
  $$("[data-bdres]").forEach(b => b.onclick = () => { binRestore([b.dataset.bdres]); viewApprovals(); });
}
/* ------------------------------------------------------------------ DELETE → BIN (with undo and Admin approval) */
const canDelW = w => isAdmin() || can("delete") || can("editAllWork") || mineW(w);
function toastAction(msg, label, fn, ms = 9000) { const t = $("#toast"); t.innerHTML = `${esc(msg)} <button class="btn sm" id="tAct" style="margin-left:10px;background:#fff;color:var(--navy)">${esc(label)}</button>`; t.hidden = false; clearTimeout(t._t);
  $("#tAct", t).onclick = () => { t.hidden = true; fn(); }; t._t = setTimeout(() => t.hidden = true, ms); }
function binWorks(ws, reason, after) {
  const now = new Date().toISOString(), adm = isAdmin(), ids = new Set(ws.map(w => w.id));
  S.db.works = S.db.works.filter(w => !ids.has(w.id));
  ws.forEach(w => { S.db.bin.push({ id: w.id, item: w, by: S.user, at: now, reason: reason || "", status: adm ? "Deleted" : "Pending", ...(adm ? { decidedBy: S.user, decidedAt: now } : {}) }); log(adm ? "Deleted" : "Delete requested", "Work item", describe("works", w) + (reason ? " – " + reason : "")); });
  if (S.sel) S.sel.clear(); if (S.tsel) S.tsel.clear(); save(); renderNav();
  const back = after || (() => go(S.route)); back();
  toastAction(`${ws.length} task(s) ${adm ? "moved to the Bin" : "deleted – sent to Admin for approval"}`, "↩ Undo", () => { const n = binRestore([...ids], true); toast(`${n} task(s) restored`); back(); });
}
function binRestore(ids, silent) { let n = 0; const now = new Date().toISOString();
  S.db.bin = S.db.bin.filter(b => { if (!ids.includes(b.id)) return true; if (!S.db.works.some(w => w.id === b.id)) { const w = b.item; w.updatedBy = S.user; w.updatedAt = now; (w.notes = w.notes || []).push({ ts: now, user: S.user, text: `Restored from the Bin (deleted by ${b.by}${b.reason ? ": " + b.reason : ""}).` }); S.db.works.push(w); n++; } return false; });
  if (n) log("Restored", "Work item", `${n} task(s) restored from the Bin`); save(); renderNav(); if (!silent) toast(`${n} task(s) restored`); return n; }
function binApprove(ids) { const now = new Date().toISOString(); let n = 0; S.db.bin.forEach(b => { if (ids.includes(b.id) && b.status === "Pending") { b.status = "Deleted"; b.decidedBy = S.user; b.decidedAt = now; n++; } });
  log("Approved", "Deletion", `${n} task deletion(s) approved`); save(); renderNav(); toast(`${n} deletion(s) approved – kept in the Bin`); }
function deleteWorks(ws, after) {
  const ok = ws.filter(canDelW); if (!ok.length) return toast("You can't delete these tasks");
  const adm = isAdmin();
  const m = openModal2(`<form id="dwF"><div class="mhead"><h3>🗑 Delete ${ok.length === 1 ? "task" : ok.length + " tasks"}</h3></div><div class="mbody">
    <p style="margin-top:0">${ok.length === 1 ? `<b>${esc(describe("works", ok[0]))}</b>` : `<b>${ok.length}</b> task(s)`}${ws.length - ok.length ? ` <span class="small muted">(${ws.length - ok.length} skipped – no right)</span>` : ""}</p>
    <p class="small">${adm ? "The task(s) go to the <b>Bin</b>. You can restore them from there at any time." : "The task(s) leave the work list and go to the <b>Admin for approval</b>. You can undo straight after deleting; after that only the Admin can restore them from the Bin."}</p>
    <div class="field"><label>Reason ${adm ? "(optional)" : "(helps the Admin approve it)"}</label><textarea id="dwR" maxlength="300" placeholder="e.g. duplicate task, created by mistake, client left"></textarea></div></div>
    <div class="mfoot"><button type="button" class="btn" id="dwN">Cancel</button><button class="btn danger" type="submit">${adm ? "Move to Bin" : "Delete & send for approval"}</button></div></form>`);
  $("#dwN", m).onclick = () => m.remove();
  $("#dwF", m).onsubmit = e => { e.preventDefault(); const r = $("#dwR", m).value.trim(); m.remove(); closeModal(); binWorks(ok, r, after); };
}
function viewBin() {
  setTitle("Bin"); const f = S.f.bin = S.f.bin || { show: "all" };
  const all = (S.db.bin || []).slice().sort((a, b) => b.at.localeCompare(a.at)); const rows = all.filter(b => f.show === "all" || (f.show === "pending" ? b.status === "Pending" : b.status === "Deleted"));
  S.binSel = S.binSel || new Set(); [...S.binSel].forEach(i => { if (!all.some(b => b.id === i)) S.binSel.delete(i); });
  $("#view").innerHTML = `<p class="small muted" style="margin:0 0 10px">Every deleted task comes here first. Restore puts it back exactly as it was. Tasks deleted by staff or interns wait here for your approval (also shown in Approvals).</p>
    <div class="toolbar"><select id="bnS"><option value="all">All (${all.length})</option><option value="pending" ${f.show === "pending" ? "selected" : ""}>Waiting for approval (${all.filter(b => b.status === "Pending").length})</option><option value="deleted" ${f.show === "deleted" ? "selected" : ""}>Deleted (${all.filter(b => b.status === "Deleted").length})</option></select>
      <span class="sp"></span><button class="btn" id="bnRes">↩ Restore selected</button><button class="btn" id="bnOk">✓ Approve selected</button><button class="btn danger" id="bnKill">Delete selected forever</button></div>
    ${rows.length ? `<div class="tablewrap"><table class="t"><thead><tr><th><input type="checkbox" id="bnAll"></th><th>Client</th><th>Task</th><th>FY / period</th><th>Task status</th><th>Deleted by</th><th>When</th><th>Reason</th><th>Bin status</th><th></th></tr></thead><tbody>
    ${rows.map(b => `<tr><td><input type="checkbox" class="bnS" value="${b.id}" ${S.binSel.has(b.id) ? "checked" : ""}></td><td><b>${esc(cname(b.item.client))}</b></td><td>${esc(b.item.form)}</td><td>${esc(b.item.fy || "")} ${esc(b.item.period || "")}</td><td>${statusChip(b.item.status)}</td><td>${esc(uname(b.by))}</td><td class="small">${esc(new Date(b.at).toLocaleString("en-IN"))}</td><td class="small" style="white-space:normal;max-width:220px">${esc(b.reason || "")}</td>
      <td>${b.status === "Pending" ? '<span class="chip amber">Waiting for approval</span>' : `<span class="chip">Deleted</span> <span class="small muted">${esc(uname(b.decidedBy || ""))}</span>`}</td><td style="text-align:right"><button class="btn sm" data-bres="${b.id}">↩ Restore</button></td></tr>`).join("")}</tbody></table></div>` : `<div class="tablewrap"><div class="empty">The Bin is empty.</div></div>`}`;
  $("#bnS").onchange = e => { f.show = e.target.value; viewBin(); };
  if ($("#bnAll")) $("#bnAll").onchange = e => { $$(".bnS").forEach(x => { x.checked = e.target.checked; x.checked ? S.binSel.add(x.value) : S.binSel.delete(x.value); }); };
  $$(".bnS").forEach(x => x.onchange = () => x.checked ? S.binSel.add(x.value) : S.binSel.delete(x.value));
  $$("[data-bres]").forEach(b => b.onclick = () => { binRestore([b.dataset.bres]); viewBin(); });
  const sel = () => { const ids = [...S.binSel]; if (!ids.length) toast("Tick tasks first"); return ids; };
  $("#bnRes").onclick = () => { const ids = sel(); if (ids.length) { binRestore(ids); S.binSel.clear(); viewBin(); } };
  $("#bnOk").onclick = () => { const ids = sel(); if (ids.length) { binApprove(ids); viewBin(); } };
  $("#bnKill").onclick = async () => { const ids = sel(); if (!ids.length) return;
    if (!(await confirmBox("Delete forever", `<p>Permanently delete <b>${ids.length}</b> task(s)? They can't be restored after this.</p>`, "Delete forever"))) return;
    S.db.bin = S.db.bin.filter(b => !ids.includes(b.id)); S.binSel.clear(); log("Deleted forever", "Work item", `${ids.length} task(s) removed from the Bin`); save(); renderNav(); toast("Deleted forever"); viewBin(); };
}
function go(route) {
  S.route = route; renderNav(); $("#view").scrollTop = 0;
  const [r, arg] = route.split(":");
  const nv = NAV.find(n => n[0] === r); if (nv && !navOk(nv)) { route = "dashboard"; S.route = route; renderNav(); return viewDashboard(); }
  const V = { bin: viewBin, approvals: viewApprovals, billing: viewBilling, mywork: viewMyWork, team: viewTeam, tgst: () => viewTracker("tgst"), ttdsq: () => viewTracker("ttdsq"), ttdsm: () => viewTracker("ttdsm"), troc: () => viewTracker("troc"), titr: () => viewTracker("titr"), dashboard: viewDashboard, status: viewStatus, clients: () => viewList("clients"), works: () => viewList("works"), challans: () => viewList("challans"),
    reimb: () => viewList("reimb"), udins: () => viewList("udins"), dsc: () => viewList("dsc"), docreq: () => viewList("docreq"), engage: () => viewList("engage"), creds: viewCreds, clientsvc: viewClientSvc, calendar: viewCalendar, cases: viewCases, sgroups: viewSGroups, sgroup: () => viewSGroup(arg), reports: viewReports, log: viewLog, settings: viewSettings, client: () => viewClient(arg) };
  (V[r] || viewDashboard)();
}
const setTitle = t => $("#pageTitle").textContent = t;

/* global search */
$("#gsearch").addEventListener("input", e => {
  const q = e.target.value.trim().toLowerCase(); const box = $("#gres");
  if (!q || !S.db) { box.hidden = true; return; }
  const hits = vC().filter(c => [c.name, c.code, c.pan, c.group, ...gstsOf(c).map(x => x.g)].some(v => (v || "").toLowerCase().includes(q))).slice(0, 12);
  box.innerHTML = hits.length ? hits.map(c => `<div data-id="${c.id}"><b>${esc(c.name)}</b> <span class="muted small">${esc(c.code)} · ${esc(c.type)} ${c.pan ? "· " + esc(c.pan) : ""}</span></div>`).join("") : `<div class="muted">No client found</div>`;
  box.hidden = false;
  $$("div[data-id]", box).forEach(d => d.onclick = () => { box.hidden = true; e.target.value = ""; go("client:" + d.dataset.id); });
});
document.addEventListener("click", e => { if (!e.target.closest(".gsearch")) $("#gres").hidden = true; });
document.addEventListener("keydown", e => { if (e.key === "Escape" && !$("#modal").hidden) closeModal(); });

/* ------------------------------------------------------------------ COLUMN DEFINITIONS */
const COLS = {
  clients: [
    { l: "Team access", adm: 1, v: r => `<button type="button" class="btn sm" data-vis="${r.id}" title="${cHid(r) ? "Only Admin can see this client. Click to show it to staff and interns." : "Staff and interns can see this client. Click to hide it from them."}">${cHid(r) ? "🔒 Admin only" : "👥 Visible to team"}</button>`, s: r => cHid(r) ? 0 : 1, x: r => cHid(r) ? "Admin only" : "Visible to team" },
    { l: "Code", v: r => esc(r.code), s: r => r.code, x: r => r.code },
    { l: "Client name", v: r => `<b>${esc(r.name)}</b>`, s: r => r.name, x: r => r.name },
    { l: "Type", v: r => esc(r.type), s: r => r.type, x: r => r.type },
    { l: "PAN", v: r => esc(r.pan), x: r => r.pan }, { l: "GSTIN", v: r => { const L = gstsOf(r); return L.length ? esc(L[0].g) + (L.length > 1 ? ` <span class="chip blue" title="${esc(L.map(gstLbl).join("\n"))}">+${L.length - 1} more</span>` : "") : ""; }, x: r => gstsOf(r).map(x => x.g).join("; ") },
    { l: "Mobile", v: r => esc(r.mobile), x: r => r.mobile }, { l: "Handled by", v: r => esc(r.manager), x: r => r.manager },
    { l: "Open work", v: r => { const n = S.db.works.filter(w => w.client === r.id && isOpen(w)).length; return n || ""; }, s: r => S.db.works.filter(w => w.client === r.id && isOpen(w)).length, num: 1, x: r => S.db.works.filter(w => w.client === r.id && isOpen(w)).length },
    { l: "Status", v: r => `<span class="chip ${r.active === "Inactive" ? "" : "green"}">${esc(r.active || "Active")}</span>`, s: r => r.active, x: r => r.active || "Active" },
  ],
  works: [
    { l: "📌", pf: 1, v: r => pinFlagHTML(r), s: r => (isPinned(r) ? 0 : 1) + "" + (FLAGS.findIndex(f => f[0] === r.flag) + 1 || 9), x: r => [isPinned(r) ? "Pinned" : "", flagName(r.flag)].filter(Boolean).join(", ") },
    { l: "Client", v: r => `<b>${esc(cname(r.client))}</b><div class="muted small">${esc(ccode(r.client))}</div>`, s: r => cname(r.client), x: r => cname(r.client) },
    { l: "Service", v: r => esc(r.service), s: r => r.service, x: r => r.service },
    { l: "Return / work", v: r => esc(r.form) + (r.gstin && multiG(r.client) ? ` <span class="small muted">· ${esc(r.gstin)}</span>` : "") + ((r.docs || []).length ? ` <span class="chip blue" title="Documents attached">📎${r.docs.length}</span>` : "") + ((r.notes || []).length ? ` <span class="chip" title="Updates">💬${r.notes.length}</span>` : ""), s: r => r.form, x: r => r.form },
    { l: "FY", v: r => esc(r.fy), s: r => r.fy, x: r => r.fy }, { l: "Period", v: r => esc(r.period), x: r => r.period },
    { l: "Due date", v: r => dmy(r.due), s: r => r.due || "9999", x: r => dmy(r.due) },
    { l: "Filed / done", v: r => dmy(r.filed), s: r => r.filed || "", x: r => dmy(r.filed) },
    { l: "Timeline", v: r => { const d = delayInfo(r); return d.txt ? `<span class="chip ${d.cls}">${d.txt}</span>` : ""; }, s: r => delayInfo(r).sortv, x: r => delayInfo(r).txt },
    { l: "Status", v: r => statusChip(r.status) + (r.priority === "High" && isOpen(r) ? ' <span class="chip red">High</span>' : ""), s: r => allStatus().indexOf(r.status), x: r => stLabel(r.status) },
    { l: "Done by", v: r => esc(uname(r.assigned)), s: r => uname(r.assigned), x: r => uname(r.assigned) },
    { l: "ARN / UDIN", v: r => esc(r.arn) + (r.udin ? `<div class="muted small">UDIN ${esc(r.udin)}${r.udinDate ? " · " + dmy(r.udinDate) : ""}</div>` : udinPend(r) ? `<div><span class="chip amber">UDIN pending</span></div>` : ""), x: r => [r.arn, r.udin ? r.udin + (r.udinDate ? " (" + dmy(r.udinDate) + ")" : "") : udinPend(r) ? "UDIN pending" : ""].filter(Boolean).join(" / ") },
    { l: "Fee (₹)", fee: 1, v: r => inr(r.fee), s: r => num(r.fee), num: 1, sum: r => num(r.fee), x: r => num(r.fee) || "" },
    { l: "Bill", fee: 1, v: r => r.billno ? `<span class="chip blue">${esc(r.billno)}</span>` : (num(r.fee) > 0 ? '<span class="chip amber">Unbilled</span>' : ""), s: r => r.billno || "", x: r => r.billno || "" },
    { l: "Outstanding (₹)", fee: 1, v: r => woOut(r) ? `<span class="${woOut(r) > 0 ? "red b" : ""}">${inr(woOut(r))}</span>` : "", s: woOut, num: 1, sum: woOut, x: r => woOut(r) || "" },
    { l: "Remarks", v: r => `<span class="small">${esc((r.remarks || "").slice(0, 60))}</span>`, x: r => r.remarks, pOnly: 0 },
  ],
  challans: [
    { l: "Date", v: r => dmy(r.date), s: r => r.date, x: r => dmy(r.date) },
    { l: "Client", v: r => `<b>${esc(cname(r.client))}</b>`, s: r => cname(r.client), x: r => cname(r.client) },
    { l: "Tax type", v: r => esc(r.taxtype), s: r => r.taxtype, x: r => r.taxtype }, { l: "Head", v: r => esc(r.head), x: r => r.head },
    { l: "FY / period", v: r => esc([r.fy, r.period].filter(Boolean).join(" · ")), x: r => [r.fy, r.period].filter(Boolean).join(" ") },
    { l: "Challan / CPIN", v: r => esc(r.cpin), x: r => r.cpin }, { l: "CIN / BSR", v: r => esc(r.cin), x: r => r.cin },
    { l: "Mode / bank", v: r => esc([r.mode, r.bank].filter(Boolean).join(" · ")), x: r => [r.mode, r.bank].filter(Boolean).join(" ") },
    { l: "Amount (₹)", v: r => inr(r.amount), s: r => num(r.amount), num: 1, sum: r => num(r.amount), x: r => num(r.amount) },
    { l: "Paid by", v: r => `<span class="chip ${r.paidby === "Firm (reimbursable)" ? "amber" : ""}">${esc(r.paidby)}</span>`, s: r => r.paidby, x: r => r.paidby },
    { l: "Due from client (₹)", v: r => chReimbDue(r) ? `<span class="red b">${inr(chReimbDue(r))}</span>` : "", s: chReimbDue, num: 1, sum: chReimbDue, x: r => chReimbDue(r) || "" },
    { l: "Linked work", v: r => esc(r.work), x: r => r.work },
  ],
  reimb: [
    { l: "Date", v: r => dmy(r.date), s: r => r.date, x: r => dmy(r.date) },
    { l: "Client", v: r => `<b>${esc(cname(r.client))}</b>`, s: r => cname(r.client), x: r => cname(r.client) },
    { l: "Nature", v: r => esc(r.nature), s: r => r.nature, x: r => r.nature }, { l: "Description", v: r => esc(r.desc), x: r => r.desc },
    { l: "Ref.", v: r => esc(r.ref), x: r => r.ref },
    { l: "Amount (₹)", v: r => inr(r.amount), s: r => num(r.amount), num: 1, sum: r => num(r.amount), x: r => num(r.amount) },
    { l: "Billed on", v: r => dmy(r.billdate), x: r => dmy(r.billdate) }, { l: "Recovered (₹)", v: r => inr(r.recovered), num: 1, sum: r => num(r.recovered), x: r => num(r.recovered) || "" },
    { l: "Balance (₹)", v: r => reBal(r) ? `<span class="${reBal(r) > 0 ? "red b" : ""}">${inr(reBal(r))}</span>` : `<span class="chip green">Settled</span>`, s: reBal, num: 1, sum: reBal, x: r => reBal(r) },
  ],
  udins: [
    { l: "UDIN date", v: r => dmy(r.date), s: r => r.date, x: r => dmy(r.date) },
    { l: "Client", v: r => `<b>${esc(cname(r.client))}</b>`, s: r => cname(r.client), x: r => cname(r.client) },
    { l: "Document", v: r => esc(r.doc), s: r => r.doc, x: r => r.doc }, { l: "FY", v: r => esc(r.fy), x: r => r.fy },
    { l: "Signed on", v: r => dmy(r.signdate), x: r => dmy(r.signdate) },
    { l: "UDIN", v: r => `<b>${esc(r.udin)}</b>`, x: r => r.udin }, { l: "Partner", v: r => esc(r.partner), x: r => r.partner },
    { l: "Gap (days)", v: r => { if (!r.signdate || !r.date) return ""; const d = days(r.signdate, r.date); return `<span class="${d > 60 ? "red b" : ""}">${d}</span>`; }, num: 1, x: r => r.signdate && r.date ? days(r.signdate, r.date) : "" },
    { l: "Status", v: r => r.revoked === "Yes" ? '<span class="chip red">Revoked</span>' : '<span class="chip green">Valid</span>', x: r => r.revoked === "Yes" ? "Revoked" : "Valid" },
  ],
};

/* ------------------------------------------------------------------ EXCEL-LIKE COLUMNS (move, resize, show / hide – saved per user) */
function colCSS(ck, cols) { const p = colPref(ck); return cols.map((c, i) => p.w[c.l] ? `.cw .k${i}{width:${p.w[c.l]}px;min-width:${p.w[c.l]}px;max-width:${p.w[c.l]}px}` : "").join(""); }
function tableHTMLcw(ent, cols, rows, withDel, sel, ck) {
  const p = colPref(ck), st = S.sort[ent] || {}; const hasSum = cols.some(c => c.sum);
  const head = `<tr>${sel ? `<th style="width:28px"><input type="checkbox" class="selall" title="Select all shown"></th>` : ""}${cols.map((c, i) => `<th class="${c.num ? "num" : ""}" data-i="${i}" data-l="${esc(c.l)}" draggable="true" title="Click to sort · drag to move · drag the right edge to resize (double-click it to auto-fit)"><div class="cc k${i}">${c.pf || ent === "bills" ? "" : `<button type="button" class="cfb ${cfOn(ck, c.l) ? "on" : ""}" data-cf="${esc(c.l)}" title="Filter / sort this column">${cfOn(ck, c.l) ? "▼" : "▾"}</button>`}${esc(c.l)}${st.i === i ? (st.d > 0 ? " ▲" : " ▼") : ""}</div><span class="rz" data-rz="${i}"></span></th>`).join("")}${withDel ? "<th></th>" : ""}</tr>`;
  const body = rows.length ? rows.map(r => `<tr data-id="${r.id}" ${isPinned(r) ? 'class="pinned"' : ""}>${sel ? `<td class="selc"><input type="checkbox" class="selr" value="${r.id}" ${S.sel && S.sel.has(r.id) ? "checked" : ""}></td>` : ""}${cols.map((c, i) => `<td class="${c.num ? "num" : ""}"><div class="cc k${i}">${c.v(r) ?? ""}</div></td>`).join("")}${withDel ? `<td><button class="btn sm danger" data-del="${r.id}" title="Delete">✕</button></td>` : ""}</tr>`).join("")
    : `<tr><td colspan="${cols.length + (sel ? 1 : 0) + (withDel ? 1 : 0)}"><div class="empty">${S.archView ? "Nothing archived yet. In the work list, select completed tasks and click <b>📦 Archive</b>." : "No records match. Use <b>＋ Add</b> to create one, or clear the filters."}</div></td></tr>`;
  const foot = hasSum && rows.length ? `<tfoot><tr>${sel ? "<td></td>" : ""}${cols.map((c, i) => `<td class="${c.num ? "num" : ""}"><div class="cc k${i}">${c.sum ? inr(rows.reduce((a, r) => a + c.sum(r), 0)) : i === 0 ? "Total" : ""}</div></td>`).join("")}${withDel ? "<td></td>" : ""}</tr></tfoot>` : "";
  return `<style id="cwCSS">${colCSS(ck, cols)}</style><div class="tablewrap"><table class="t cw ${p.wrap ? "wrap" : ""}" data-ck="${ck}"><thead>${head}</thead><tbody>${body}</tbody>${foot}</table></div>`;
}
function bindColUI(ck, redraw) {
  const tbl = $(`table[data-ck="${ck}"]`); if (!tbl) return;
  $$(".cfb", tbl).forEach(b => { b.addEventListener("mousedown", e => e.stopPropagation()); b.onclick = e => { e.stopPropagation(); e.preventDefault(); colFilterPop(ck, b.dataset.cf, b, redraw); }; }); const p = colPref(ck); const cols = () => $$("th[data-l]", tbl).map(th => th.dataset.l);
  const fullOrder = () => { const shown = cols(); const all = colsFor(COLS[ck]).map(c => c.l); const rest = all.filter(l => !shown.includes(l)); return [...shown, ...rest]; };
  // resize
  $$(".rz", tbl).forEach(h => {
    h.addEventListener("click", e => e.stopPropagation());
    h.addEventListener("dblclick", e => { e.stopPropagation(); const l = h.parentElement.dataset.l; delete p.w[l]; save(); redraw(); });
    h.addEventListener("mousedown", e => { e.preventDefault(); e.stopPropagation(); S._colBusy = true; const th = h.parentElement, l = th.dataset.l, i = +h.dataset.rz, x0 = e.clientX, w0 = th.getBoundingClientRect().width;
      const css = $("#cwCSS"); const base = css.textContent.replace(new RegExp(`\\.cw \\.k${i}\\{[^}]*\\}`, "g"), ""); document.body.classList.add("colres");
      const mv = ev => { const w = Math.max(40, Math.round(w0 + ev.clientX - x0)); p.w[l] = w; css.textContent = base + `.cw .k${i}{width:${w}px;min-width:${w}px;max-width:${w}px}`; };
      const up = () => { document.removeEventListener("mousemove", mv); document.removeEventListener("mouseup", up); document.body.classList.remove("colres"); save(); setTimeout(() => S._colBusy = false, 50); };
      document.addEventListener("mousemove", mv); document.addEventListener("mouseup", up); });
  });
  // move (drag a heading onto another)
  let drag = null;
  $$("th[data-l]", tbl).forEach(th => {
    th.addEventListener("dragstart", e => { if (S._colBusy) return e.preventDefault(); drag = th.dataset.l; th.classList.add("dragging"); try { e.dataTransfer.setData("text/plain", drag); e.dataTransfer.effectAllowed = "move"; } catch {} });
    th.addEventListener("dragend", () => { th.classList.remove("dragging"); $$("th.dropL,th.dropR", tbl).forEach(x => x.classList.remove("dropL", "dropR")); });
    th.addEventListener("dragover", e => { if (!drag || drag === th.dataset.l) return; e.preventDefault(); const r = th.getBoundingClientRect(), right = e.clientX > r.left + r.width / 2; th.classList.toggle("dropR", right); th.classList.toggle("dropL", !right); });
    th.addEventListener("dragleave", () => th.classList.remove("dropL", "dropR"));
    th.addEventListener("drop", e => { e.preventDefault(); if (!drag || drag === th.dataset.l) return; const right = th.classList.contains("dropR"); const o = fullOrder().filter(l => l !== drag); let at = o.indexOf(th.dataset.l) + (right ? 1 : 0); o.splice(at, 0, drag);
      p.order = o; delete S.sort[ck]; drag = null; save(); redraw(); });
  });
}
function colChooser(ck, redraw) {
  const p = colPref(ck); const all = colsFor(COLS[ck]); let order = [...applyColPrefs(ck, all).map(c => c.l), ...all.map(c => c.l).filter(l => p.hidden.includes(l))];
  const m = openModal(`<div class="mhead"><h3>▦ Columns</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p class="small" style="margin-top:0">Tick the columns to show and use ↑ ↓ to change their order. In the list itself you can also drag a heading to move it, drag its right edge to make it wider or narrower, and double-click the edge to fit it to the contents. Your layout is saved for you only.</p>
    <div id="ccL" class="picklist" style="max-height:52vh"></div>
    <label style="display:flex;gap:8px;align-items:center;margin-top:10px"><input type="checkbox" id="ccWrap" ${p.wrap ? "checked" : ""}> Wrap long text onto more lines (taller rows)</label></div>
    <div class="mfoot"><button class="btn" id="ccReset">Reset to default</button><span class="sp"></span><button class="btn" id="ccN">Cancel</button><button class="btn primary" id="ccY">Apply</button></div>`, true);
  const hid = new Set(p.hidden);
  const draw = () => { $("#ccL", m).innerHTML = order.map((l, i) => `<div style="display:flex;align-items:center;gap:8px;padding:3px 0;border-bottom:1px solid #f1f3f6"><label style="flex:1;display:flex;gap:8px;align-items:center;padding:0"><input type="checkbox" data-c="${esc(l)}" ${hid.has(l) ? "" : "checked"}> ${esc(l === "📌" ? "📌 Pin & flag" : l)}${p.w[l] ? ` <span class="small muted">${p.w[l]}px</span>` : ""}</label>
      <button type="button" class="btn sm" data-up="${i}" ${i ? "" : "disabled"}>↑</button><button type="button" class="btn sm" data-dn="${i}" ${i < order.length - 1 ? "" : "disabled"}>↓</button></div>`).join("");
    $$("[data-c]", m).forEach(x => x.onchange = () => { x.checked ? hid.delete(x.dataset.c) : hid.add(x.dataset.c); });
    $$("[data-up]", m).forEach(b => b.onclick = () => { const i = +b.dataset.up; [order[i - 1], order[i]] = [order[i], order[i - 1]]; draw(); });
    $$("[data-dn]", m).forEach(b => b.onclick = () => { const i = +b.dataset.dn; [order[i + 1], order[i]] = [order[i], order[i + 1]]; draw(); }); };
  draw();
  $("#mx", m).onclick = $("#ccN", m).onclick = closeModal;
  $("#ccReset", m).onclick = () => { p.order = []; p.hidden = []; p.w = {}; p.wrap = false; delete S.sort[ck]; save(); closeModal(); toast("Columns reset"); redraw(); };
  $("#ccY", m).onclick = () => { if (hid.size >= order.length) return toast("Keep at least one column"); p.order = order; p.hidden = [...hid]; p.wrap = $("#ccWrap", m).checked; delete S.sort[ck]; save(); closeModal(); redraw(); };
}

function trkBulk(redraw) {
  const bar = $("#tBulk"); if (!bar) return; if (!S.tsel) { bar.innerHTML = ""; return; }
  const n = S.tsel.size; const pick = () => S.db.works.filter(w => S.tsel.has(w.id));
  bar.innerHTML = `<div id="bulkBar" style="margin-bottom:10px"><b>${n ? n + " selected" : "Click tasks in the grid to select them (click a cell to select all its tasks)"}</b>
    ${n ? `${can("assignWork") ? `<select id="tbAs"><option value="">Assign to…</option><option value="__none__">(unassigned)</option>${(S.db.settings.staff || []).map(s => `<option value="${esc(s)}">${esc(ulabel(s))}</option>`).join("")}</select>` : ""}
    <select id="tbSt"><option value="">Change status…</option>${allStatus().filter(x => can("markDone") || !isClosedSt(x)).map(x => `<option value="${esc(x)}">${esc(stLabel(x))}</option>`).join("")}</select>
    <input type="date" id="tbDue" title="Set due date" style="border:1px solid #cfd5df;border-radius:8px;padding:4px 8px"><button class="btn sm" id="tbDueGo">Set due date</button>
    <button class="btn sm" id="tbArc">📦 Archive</button><button class="btn sm" id="tbUn">↩ Undo archive</button><button class="btn sm danger" id="tbDel">🗑 Delete</button><button class="btn sm" id="tbClr">Clear selection</button>` : ""}</div>`;
  if (!n) return;
  const editable = w => can("editAllWork") || (mineW(w) && (!lockState(w) || lockState(w).mode !== "locked"));
  const apply = (fn, label) => { const all = pick(), ok = all.filter(editable), now = new Date().toISOString(); ok.forEach(w => { fn(w); w.updatedBy = S.user; w.updatedAt = now; });
    log("Bulk edit", "Work item", `${label} – ${ok.length} item(s) (tracker)`); save(); toast(`${label}: ${ok.length} updated${all.length - ok.length ? `, ${all.length - ok.length} skipped (no right / locked)` : ""}`); redraw(); };
  if ($("#tbAs")) $("#tbAs").onchange = e => { const u = e.target.value; if (!u) return; const v = u === "__none__" ? "" : u; apply(w => { if (w.assigned !== v) { w.assigned = v; w.assignedBy = S.user; w.assignedAt = new Date().toISOString(); } }, "Assigned to " + (v ? uname(v) : "nobody")); };
  $("#tbSt").onchange = e => { const v = e.target.value; if (!v) return; apply(w => { w.status = v; if (stg(v) === "Filed / Done" && !w.filed) w.filed = today(); }, "Status → " + v); };
  $("#tbDueGo").onclick = () => { const v = $("#tbDue").value; if (!v) return toast("Pick a date first"); apply(w => w.due = v, "Due date → " + dmy(v)); };
  const canArc = w => can("editAllWork") || mineW(w);
  $("#tbArc").onclick = () => { const all = pick(), ok = all.filter(w => !isOpen(w) && canArc(w)), now = new Date().toISOString(); if (!ok.length) return toast("Only completed tasks can be archived");
    ok.forEach(w => { w.archived = true; w.archivedBy = S.user; w.archivedAt = now; }); log("Archived", "Work item", `${ok.length} task(s) (tracker)`); save(); toast(`${ok.length} archived${all.length - ok.length ? ` · ${all.length - ok.length} still open, not archived` : ""}`); redraw(); };
  $("#tbUn").onclick = () => { const ok = pick().filter(w => w.archived && canArc(w)); if (!ok.length) return toast("None of the selected tasks are archived"); ok.forEach(w => { delete w.archived; delete w.archivedBy; delete w.archivedAt; });
    log("Restored", "Work item", `${ok.length} task(s) taken out of the archive (tracker)`); save(); toast(`${ok.length} back in the work list`); redraw(); };
  if ($("#tbDel")) $("#tbDel").onclick = () => deleteWorks(pick(), redraw);
  $("#tbClr").onclick = () => { S.tsel.clear(); redraw(); };
}

/* ------------------------------------------------------------------ FLAG & PIN */
const FLAGS = [["red", "Red – urgent", "#d93025"], ["orange", "Orange – follow up", "#e8710a"], ["green", "Green – ready", "#1e8e3e"], ["blue", "Blue – waiting on client", "#1a73e8"], ["purple", "Purple – review", "#8e24aa"]];
const flagName = k => (FLAGS.find(f => f[0] === k) || [])[1] || "";
const isPinned = w => (w.pins || []).includes(S.user);
const flagSVG = (c, on) => `<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 1v14" stroke="${on ? c : "#b0b7c3"}" stroke-width="1.6"/><path d="M3.8 2h9l-2.2 3.2L12.8 8.5h-9z" fill="${on ? c : "none"}" stroke="${on ? c : "#b0b7c3"}" stroke-width="1.2"/></svg>`;
function pinFlagHTML(w) {
  const fl = FLAGS.find(f => f[0] === w.flag);
  return `<span class="pfc" style="display:inline-flex;gap:2px;align-items:center"><button type="button" class="pfb ${isPinned(w) ? "on" : ""}" data-pin="${w.id}" title="${isPinned(w) ? "Unpin" : "Pin to top of my list"}">📌</button><button type="button" class="pfb" data-flag="${w.id}" title="${fl ? esc(fl[1]) + " – click to change" : "Add a flag"}">${flagSVG(fl ? fl[2] : "", !!fl)}</button></span>`;
}
function togglePin(w) { const p = new Set(w.pins || []); p.has(S.user) ? p.delete(S.user) : p.add(S.user); w.pins = [...p]; save(); }
function setFlag(ids, k) { const now = new Date().toISOString(); S.db.works.filter(w => ids.includes(w.id)).forEach(w => { if (k) { w.flag = k; w.flagBy = S.user; w.flagAt = now; } else { delete w.flag; delete w.flagBy; delete w.flagAt; } });
  log("Flag", "Work item", `${ids.length} task(s) → ${k ? flagName(k) : "no flag"}`); save(); }
function flagMenu(anchor, ids, after) {
  $$(".flagmenu").forEach(x => x.remove());
  const d = document.createElement("div"); d.className = "flagmenu";
  d.innerHTML = FLAGS.map(f => `<button type="button" data-k="${f[0]}">${flagSVG(f[2], true)} ${esc(f[1])}</button>`).join("") + '<button type="button" data-k="">✕ Remove flag</button>';
  document.body.appendChild(d); const r = anchor.getBoundingClientRect();
  d.style.left = Math.max(8, Math.min(window.innerWidth - 230, r.left)) + "px"; d.style.top = Math.min(window.innerHeight - 220, r.bottom + 4) + "px";
  $$("button", d).forEach(b => b.onclick = e => { e.stopPropagation(); d.remove(); setFlag(ids, b.dataset.k); after && after(); });
  setTimeout(() => document.addEventListener("click", () => d.remove(), { once: true }), 0);
}
document.addEventListener("click", e => { const b = e.target.closest(".pfb"); if (!b || !S.db) return; e.stopPropagation(); e.preventDefault();
  const w = S.db.works.find(x => x.id === (b.dataset.pin || b.dataset.flag)); if (!w) return;
  if (b.dataset.pin) { togglePin(w); toast(isPinned(w) ? "Pinned to the top of your list" : "Unpinned"); go(S.route); }
  else flagMenu(b, [w.id], () => go(S.route)); }, true);

/* ------------------------------------------------------------------ FILTERS */
const FILTERS = {
  clients: [{ k: "type", l: "All types", o: CTYPE }, { k: "active", l: "All statuses", o: ["Active", "Inactive"] }, { k: "manager", l: "All staff", o: "staff" }],
  works: [{ k: "client", l: "Clients", o: "client", multi: 1 }, { k: "form", l: "Tasks", o: "forms", multi: 1 }, { k: "service", l: "Services", o: allSvc, multi: 1 }, { k: "status", l: "Status", o: () => [["Open (not done)", "Open (not done)"], ...allStatus().map(x => [x, stLabel(x)])], multi: 1 },
    { k: "assigned", l: "Assigned to", o: () => [["__none__", "(unassigned)"], ...filterOpts("staff")], multi: 1, pairs: 1 }, { k: "fy", l: "All FYs", o: FYS },
    { k: "duep", l: "Any due date", o: ["Overdue", "Due today", "Next 7 days", "This month", "Next month", "No due date"] }, { k: "flag", l: "Flags", o: () => [["__pin__", "📌 Pinned by me"], ...FLAGS.map(f => [f[0], f[1]]), ["__any__", "Any flag"], ["__none__", "No flag"]], multi: 1, pairs: 1 }, { k: "timeline", l: "More…", o: ["Filed late", "Fee outstanding", "Not billed (fee entered)", "Created by interns"] }],
  challans: [{ k: "client", l: "All clients", o: "client" }, { k: "taxtype", l: "All tax types", o: TAXTYPE }, { k: "fy", l: "All FYs", o: FYS }, { k: "paidby", l: "Paid by – all", o: PAIDBY }],
  reimb: [{ k: "client", l: "All clients", o: "client" }, { k: "nature", l: "All natures", o: RNATURE }, { k: "bal", l: "All", o: ["Balance due", "Settled"] }],
  udins: [{ k: "client", l: "All clients", o: "client" }, { k: "doc", l: "All documents", o: UDOC }, { k: "fy", l: "All FYs", o: FYS }],
};
/* ================================================================== CLIENT REGISTERS – DSC, document requests, engagement letters, portal logins (v2.15) */
const DSCTYPE = ["Class 3 – Signing", "Class 3 – Signing & Encryption", "DGFT", "Other"];
const DSCCA = ["eMudhra", "Capricorn", "Pantasign", "Vsign", "Sify", "IDSign", "XtraTrust", "Other"];
const ENGTYPE = ["Statutory audit", "Tax audit", "Income tax compliance", "GST compliance", "Accounting & bookkeeping", "Company law / ROC compliance", "Certification", "Other"];
const ENGST = ["Draft", "Sent", "Signed", "Declined"];
ENT.dsc = { title: "DSC Register", one: "DSC", icon: "🔑", fields: [
  { k: "client", l: "Client", t: "client", req: 1 }, { k: "holder", l: "DSC holder name", req: 1, ph: "e.g. Rajesh Kumar (Director)" },
  { k: "pan", l: "Holder PAN", upper: 1, ph: "AAAAA9999A" }, { k: "dclass", l: "DSC type", t: "select", o: DSCTYPE, def: "Class 3 – Signing" },
  { k: "issuer", l: "Issued by", t: "select", o: DSCCA }, { k: "serial", l: "Token / certificate serial no." },
  { k: "issue", l: "Issue date", t: "date" }, { k: "expiry", l: "Expiry date", t: "date", req: 1 },
  { k: "custody", l: "Token is with", t: "select", o: ["Firm", "Client", "Other"], def: "Firm", req: 1 }, { k: "location", l: "Kept at (if with firm)", ph: "e.g. Cabinet 2, drawer B" },
  { k: "recvd", l: "Received from client on", t: "date" }, { k: "returned", l: "Returned to client on", t: "date" },
  { k: "remarks", l: "Remarks (keep the token PIN in Portal Logins, not here)", t: "textarea", full: 1 }] };
ENT.docreq = { title: "Document Requests", one: "Document request", icon: "📨", fields: [{ k: "client", l: "Client", t: "client", req: 1 }, { k: "title", l: "Request", req: 1 }] };
ENT.engage = { title: "Engagement Letters", one: "Engagement letter", icon: "📝", fields: [{ k: "client", l: "Client", t: "client", req: 1 }, { k: "type", l: "Engagement", t: "select", o: ENGTYPE, req: 1 }] };
const dscSt = r => { if (!r.expiry) return { k: "", txt: "", cls: "" }; const d = days(today(), r.expiry);
  return d < 0 ? { k: "Expired", txt: `Expired ${-d}d ago`, cls: "red" } : d <= 30 ? { k: "Expiring in 30 days", txt: d === 0 ? "Expires today" : `Expires in ${d}d`, cls: "amber" } : { k: "Valid", txt: "Valid", cls: "green" }; };
const drPend = r => (r.items || []).filter(i => !i.ok);
const drSt = r => { const p = drPend(r).length; if (!(r.items || []).length) return { k: "Pending", txt: "No items", cls: "" }; if (!p) return { k: "Complete", txt: "Complete", cls: "green" };
  return r.due && r.due < today() ? { k: "Pending", txt: `Overdue · ${p} pending`, cls: "red" } : { k: "Pending", txt: `${p} pending`, cls: "amber" }; };
COLS.dsc = [
  { l: "Client", v: r => `<b>${esc(cname(r.client))}</b>`, s: r => cname(r.client), x: r => cname(r.client) },
  { l: "Holder", v: r => esc(r.holder) + (r.pan ? `<div class="small muted">${esc(r.pan)}</div>` : ""), s: r => r.holder, x: r => r.holder + (r.pan ? " (" + r.pan + ")" : "") },
  { l: "Type", v: r => esc(r.dclass), x: r => r.dclass }, { l: "Issued by", v: r => esc(r.issuer), x: r => r.issuer },
  { l: "Expiry", v: r => dmy(r.expiry), s: r => r.expiry, x: r => dmy(r.expiry) },
  { l: "Status", v: r => { const t = dscSt(r); return t.txt ? `<span class="chip ${t.cls}">${t.txt}</span>` : ""; }, s: r => r.expiry, x: r => dscSt(r).txt },
  { l: "Token with", v: r => esc(r.custody || "") + (r.custody === "Firm" && r.location ? `<div class="small muted">${esc(r.location)}</div>` : ""), s: r => r.custody, x: r => [r.custody, r.location].filter(Boolean).join(" – ") },
  { l: "Serial no.", v: r => esc(r.serial), x: r => r.serial }];
COLS.docreq = [
  { l: "Client", v: r => `<b>${esc(cname(r.client))}</b>`, s: r => cname(r.client), x: r => cname(r.client) },
  { l: "Request", v: r => esc(r.title), s: r => r.title, x: r => r.title },
  { l: "Received", v: r => `${(r.items || []).length - drPend(r).length} of ${(r.items || []).length}`, num: 1, s: r => drPend(r).length, x: r => `${(r.items || []).length - drPend(r).length} of ${(r.items || []).length}` },
  { l: "Still pending", v: r => esc(drPend(r).slice(0, 3).map(i => i.t).join(", ") + (drPend(r).length > 3 ? ` +${drPend(r).length - 3} more` : "")), x: r => drPend(r).map(i => i.t).join("; ") },
  { l: "Due", v: r => dmy(r.due), s: r => r.due || "9", x: r => dmy(r.due) },
  { l: "Last reminder", v: r => { const s = (r.sent || []).slice(-1)[0]; return s ? `${dmy(s.at.slice(0, 10))} <span class="small muted">${esc(s.via)}</span>` : '<span class="muted">not sent</span>'; }, s: r => ((r.sent || []).slice(-1)[0] || {}).at || "", x: r => { const s = (r.sent || []).slice(-1)[0]; return s ? dmy(s.at.slice(0, 10)) + " " + s.via : ""; } },
  { l: "Status", v: r => { const t = drSt(r); return `<span class="chip ${t.cls}">${t.txt}</span>`; }, s: r => drSt(r).txt, x: r => drSt(r).txt }];
COLS.engage = [
  { l: "Client", v: r => `<b>${esc(cname(r.client))}</b>`, s: r => cname(r.client), x: r => cname(r.client) },
  { l: "Engagement", v: r => esc(r.type), s: r => r.type, x: r => r.type }, { l: "FY", v: r => esc(r.fy), x: r => r.fy },
  { l: "Fee (₹)", v: r => r.fee ? inr(r.fee) : "", num: 1, s: r => num(r.fee), x: r => num(r.fee) || "", fee: 1 },
  { l: "Issued", v: r => dmy(r.date), s: r => r.date, x: r => dmy(r.date) },
  { l: "Status", v: r => `<span class="chip ${r.status === "Signed" ? "green" : r.status === "Sent" ? "amber" : r.status === "Declined" ? "red" : ""}">${esc(r.status || "Draft")}</span>`, s: r => r.status, x: r => r.status },
  { l: "Signed on", v: r => dmy(r.signedOn), s: r => r.signedOn, x: r => dmy(r.signedOn) }, { l: "UDIN", v: r => esc(r.udin), x: r => r.udin }];
FILTERS.dsc = [{ k: "client", l: "All clients", o: "client" }, { k: "dst", l: "All statuses", o: ["Expired", "Expiring in 30 days", "Valid"] }, { k: "custody", l: "Token with – all", o: ["Firm", "Client", "Other"] }];
FILTERS.docreq = [{ k: "client", l: "All clients", o: "client" }, { k: "drs", l: "Pending and complete", o: ["Pending", "Complete"] }];
FILTERS.engage = [{ k: "client", l: "All clients", o: "client" }, { k: "type", l: "All engagements", o: ENGTYPE }, { k: "status", l: "All statuses", o: ENGST }, { k: "fy", l: "All FYs", o: FYS }];
Object.assign(ENTPERM, { dsc: "dsc", docreq: "docreq", engage: "engage" });

/* ---------------- document requests */
const DRTPL = {
  "ITR – salaried individual": ["Form 16 from employer", "AIS / TIS (or allow us to download it)", "Bank statements of all accounts for the year", "Interest certificates (savings, FD)", "Investment proofs for deductions (80C, 80D etc.)", "Home loan interest certificate", "Capital gains statement (shares / mutual funds)", "Rent receipts / HRA details"],
  "ITR – business or profession": ["Books of account / Tally backup", "Bank statements of all accounts", "Sales and purchase registers", "Fixed asset additions and sales with bills", "Loan statements and interest certificates", "TDS certificates (Form 16A)", "Investment proofs for deductions", "Stock statement at year end"],
  "GST return – monthly": ["Sales invoices / sales register for the month", "Purchase invoices / purchase register", "Credit and debit notes", "Bank statement for the month", "E-way bills (if any)", "Expense bills with GST"],
  "Tax audit": ["Trial balance and ledgers", "Fixed asset register with additions and sales", "Stock statement (quantity and value)", "Loan and deposit confirmations", "TDS returns and challans", "GST returns and reconciliation", "Details of payments to related parties", "Cash payments above ₹10,000 (if any)"],
  "Statutory audit / company annual filing": ["Trial balance, ledgers and bank statements", "Board and AGM minutes for the year", "List of directors and shareholders with changes", "Fixed asset register and stock details", "Loan agreements and confirmations", "Related party transactions", "Contingent liabilities and legal cases", "Management representation letter (signed)"],
  "New GST registration": ["PAN of the business / proprietor", "Aadhaar of proprietor / partners / directors", "Passport-size photographs", "Proof of business address (electricity bill / property tax receipt)", "Rent agreement or NOC from the owner", "Cancelled cheque or bank statement", "Partnership deed / incorporation certificate (if applicable)", "Authorisation letter / board resolution"],
  "TDS return – quarterly": ["Salary details for the quarter", "Vendor payments with PAN", "TDS challans paid", "Lower deduction certificates (if any)"],
};
const waNum = m => { const d = String(m || "").replace(/\D/g, ""); return d.length === 10 ? "91" + d : d.length === 12 && d.startsWith("91") ? d : d.length === 11 && d.startsWith("0") ? "91" + d.slice(1) : d; };
function drMessage(r) {
  const c = clientById(r.client) || {}, f = S.db.settings.firm, p = drPend(r);
  return `Dear ${c.contact || c.name || "Sir/Madam"},\n\nFor ${r.title}, we still need the following from you:\n${p.map((i, n) => `${n + 1}. ${i.t}`).join("\n")}\n\n${r.due ? `Please share these by ${dmy(r.due)}.\n\n` : ""}Thank you,\n${f.name}${f.phone ? "\n" + f.phone : ""}`;
}
function docReqDialog(id, after, preset = {}) {
  const ex = id ? S.db.docreq.find(x => x.id === id) : null; if (!ex && !can("docreq")) return toast("You do not have the right to add document requests");
  const r = ex ? JSON.parse(JSON.stringify(ex)) : { client: preset.client || "", title: "", due: addDays(today(), 7), items: [], notes: "", sent: [] };
  const cl = vC().filter(c => c.active !== "Inactive" || c.id === r.client).sort((a, b) => a.name.localeCompare(b.name));
  const m = openModal(`<div class="mhead"><h3>${ex ? "Document request" : "＋ New document request"}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody"><div class="fgrid">
    <div class="field"><label class="req" for="drC">Client</label><select id="drC"><option value="">— select client —</option>${cl.map(c => `<option value="${c.id}" ${c.id === r.client ? "selected" : ""}>${esc(c.name)} (${esc(c.code)})</option>`).join("")}</select></div>
    <div class="field"><label for="drT">Start from a checklist</label><select id="drT"><option value="">— choose to add its items —</option>${Object.keys(DRTPL).map(k => `<option>${esc(k)}</option>`).join("")}</select></div>
    <div class="field"><label class="req" for="drN">Request</label><input id="drN" maxlength="120" value="${esc(r.title)}" placeholder="e.g. ITR AY 2026-27 documents"></div>
    <div class="field"><label for="drD">Needed by</label><input type="date" id="drD" value="${esc(r.due || "")}"></div></div>
    <label class="small b">Documents · tick what has been received</label><div id="drI" class="picklist" style="max-height:38vh"></div>
    <div style="display:flex;gap:6px;margin-top:6px"><input id="drA" placeholder="Add another document…" style="flex:1;border:1px solid #cfd5df;border-radius:6px;padding:6px 8px"><button type="button" class="btn" id="drAB">＋ Add</button></div>
    <div class="field" style="margin-top:10px"><label for="drNo">Notes</label><textarea id="drNo" maxlength="1000">${esc(r.notes || "")}</textarea></div>
    ${(r.sent || []).length ? `<div class="small muted">Reminders sent: ${r.sent.slice(-5).map(s => `${dmy(s.at.slice(0, 10))} (${esc(s.via)}, ${esc(uname(s.by))})`).join(" · ")}</div>` : ""}<div class="err" id="drE"></div></div>
    <div class="mfoot">${ex && can("delete") ? '<button class="btn danger" id="drDel">Delete</button>' : ""}<span class="sp"></span><button class="btn" id="drX">Cancel</button><button class="btn" id="drMsg">💬 Message to client</button><button class="btn primary" id="drY">Save</button></div>`);
  const drawI = () => { $("#drI", m).innerHTML = r.items.length ? r.items.map((it, i) => `<label style="justify-content:space-between"><span style="display:flex;gap:8px;align-items:center"><input type="checkbox" data-ok="${i}" ${it.ok ? "checked" : ""}> <span style="${it.ok ? "text-decoration:line-through;color:var(--muted)" : ""}">${esc(it.t)}</span>${it.ok && it.on ? ` <span class="small muted">received ${dmy(it.on)}</span>` : ""}</span><button type="button" class="btn sm" data-rm="${i}" aria-label="Remove ${esc(it.t)}">✕</button></label>`).join("") : '<div class="small muted" style="padding:6px 0">No documents yet. Choose a checklist above or add them one by one.</div>';
    $$("[data-ok]", m).forEach(x => x.onchange = () => { const it = r.items[+x.dataset.ok]; it.ok = x.checked; it.on = x.checked ? today() : ""; drawI(); });
    $$("[data-rm]", m).forEach(x => x.onclick = e => { e.preventDefault(); r.items.splice(+x.dataset.rm, 1); drawI(); }); };
  drawI();
  const add = t => { t = t.trim(); if (t && !r.items.some(i => i.t.toLowerCase() === t.toLowerCase())) r.items.push({ t, ok: false, on: "" }); };
  $("#drT", m).onchange = e => { const k = e.target.value; if (!k) return; DRTPL[k].forEach(add); if (!$("#drN", m).value.trim()) $("#drN", m).value = k + " documents"; e.target.value = ""; drawI(); };
  $("#drAB", m).onclick = () => { add($("#drA", m).value); $("#drA", m).value = ""; drawI(); $("#drA", m).focus(); };
  $("#drA", m).onkeydown = e => { if (e.key === "Enter") { e.preventDefault(); $("#drAB", m).click(); } };
  $("#mx", m).onclick = $("#drX", m).onclick = closeModal;
  const collect = () => { r.client = $("#drC", m).value; r.title = $("#drN", m).value.trim(); r.due = $("#drD", m).value; r.notes = $("#drNo", m).value.trim();
    if (!r.client) throw "Select a client."; if (!r.title) throw "Give the request a name."; if (!r.items.length) throw "Add at least one document."; };
  const store = () => { const now = new Date().toISOString();
    if (ex) { Object.assign(ex, r, { updatedBy: S.user, updatedAt: now }); log("Edited", "Document request", describe("docreq", ex)); return ex; }
    const n = { id: uid(), ...r, createdBy: S.user, createdAt: now }; S.db.docreq.push(n); log("Added", "Document request", describe("docreq", n)); return n; };
  $("#drY", m).onclick = () => { try { collect(); } catch (e) { return $("#drE", m).textContent = e; } store(); save(); closeModal(); toast("Saved"); (after || (() => go(S.route)))(); };
  $("#drMsg", m).onclick = () => { try { collect(); } catch (e) { return $("#drE", m).textContent = e; } const rec = store(); save(); closeModal(); drMessageDialog(rec, after); };
  if ($("#drDel", m)) $("#drDel", m).onclick = () => { closeModal(); deleteRecord("docreq", ex.id, after); };
}
function drMessageDialog(r, after) {
  const c = clientById(r.client) || {}, msg = drMessage(r), subj = `Documents pending – ${r.title}`, wa = waNum(c.mobile);
  if (!drPend(r).length) return alertBox("Nothing pending", `<p>All documents for <b>${esc(r.title)}</b> have been received.</p>`);
  const m = openModal(`<div class="mhead"><h3>Message to ${esc(c.name || "client")}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <div class="field"><label for="dmT">Message (you can edit it)</label><textarea id="dmT" style="min-height:220px;font-family:inherit">${esc(msg)}</textarea></div>
    <p class="small muted" style="margin:0">WhatsApp: ${wa ? esc("+" + wa) : "no mobile number saved for this client – WhatsApp will ask you to pick a contact"} · Email: ${c.email ? esc(c.email) : "no email saved"} · Email subject: <span style="user-select:all">${esc(subj)}</span></p></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="dmC">Copy message</button><a class="btn" id="dmW" target="_blank" rel="noopener">WhatsApp</a><button class="btn primary" id="dmS">Mark as sent</button></div>`);
  const upd = () => { $("#dmW", m).href = `https://wa.me/${wa}?text=${encodeURIComponent($("#dmT", m).value)}`; }; upd(); $("#dmT", m).oninput = upd;
  const sent = via => { (r.sent = r.sent || []).push({ at: new Date().toISOString(), by: S.user, via }); log("Sent", "Document request", `${describe("docreq", r)} – ${via}`); save(); };
  $("#dmC", m).onclick = async () => { try { await navigator.clipboard.writeText($("#dmT", m).value); toast("Message copied – paste it in WhatsApp or email"); } catch { $("#dmT", m).select(); toast("Press Ctrl+C to copy"); } };
  $("#dmW", m).onclick = () => { sent("WhatsApp"); toast("Opening WhatsApp – reminder recorded"); };
  $("#dmS", m).onclick = () => { sent("Email / other"); closeModal(); toast("Reminder recorded"); (after || (() => go(S.route)))(); };
  $("#mx", m).onclick = () => { closeModal(); (after || (() => go(S.route)))(); };
}

/* ---------------- engagement letters (wording is a starting draft – review before use) */
const ENGSCOPE = {
  "Statutory audit": ["Audit of the financial statements for the year ending 31 March {FYEND} in accordance with the Standards on Auditing issued by the Institute of Chartered Accountants of India", "Reporting on the matters required by the applicable law, including the Companies (Auditor's Report) Order where it applies", "Communicating to those charged with governance any significant matters that come to our notice during the audit"],
  "Tax audit": ["Audit of the books of account under section 44AB of the Income-tax Act, 1961 for FY {FY}", "Preparing and certifying the tax audit report in the prescribed form, with the statement of particulars", "Uploading the report on the income-tax portal after your approval"],
  "Income tax compliance": ["Computing total income and tax payable for FY {FY}", "Preparing and filing the income-tax return", "Advising on advance tax instalments during the year", "Responding to routine intimations and communications on the return"],
  "GST compliance": ["Preparing and filing monthly / quarterly GST returns for FY {FY}", "Reconciling input tax credit with the details available on the GST portal", "Preparing the annual return and reconciliation statement where applicable", "Advising on routine GST queries"],
  "Accounting & bookkeeping": ["Recording transactions in the books of account from the documents you provide", "Preparing bank reconciliations and monthly / quarterly management reports", "Preparing the trial balance and draft financial statements for FY {FY}"],
  "Company law / ROC compliance": ["Preparing and filing the annual returns and financial statements with the Registrar of Companies for FY {FY}", "Maintaining statutory registers and drafting minutes of board and general meetings", "Filing event-based forms when you tell us of the event"],
  "Certification": ["Examining the records you provide and issuing the certificate you have requested, with a UDIN", "Our certificate will be based only on the records and explanations given to us"],
  "Other": ["[Describe the work to be done]"] };
function engBody(r) {
  const c = clientById(r.client) || {}, f = S.db.settings.firm, fy = r.fy || fyLabel(curFYStart()), fyEnd = (+fy.slice(0, 4) + 1);
  const scope = (ENGSCOPE[r.type] || ENGSCOPE.Other).map(s => "- " + s.replace("{FY}", fy).replace("{FYEND}", fyEnd)).join("\n");
  return `Dear Sir / Madam,

Engagement letter – ${r.type} for FY ${fy}

Thank you for appointing ${f.name} for the work described below. This letter sets out what we will do, what we need from you, and our fees, so that there is a clear understanding between us.

Scope of our work
${scope}

Your responsibilities
- Keeping proper books of account and records, and giving us complete and correct information on time
- Giving us access to all records, documents and people we need for this work
- Telling us promptly about any change in your business, ownership or address that may affect this work
- Confirming important information and explanations in writing when we ask

Our responsibilities
- We will carry out the work with due professional care and in line with the standards and guidance issued by the Institute of Chartered Accountants of India
- We will keep your information confidential and use it only for this engagement, except where the law requires otherwise
- Our work is based on the information you give us; it is not designed to detect every error or fraud

Timelines
We will complete the work within the due dates under the applicable law, provided we receive your records and information in good time.

Fees
Our fee for this engagement is ₹ ${r.fee ? inr(r.fee) : "[amount]"}${r.feeTerms ? ", " + r.feeTerms : ", plus GST and out-of-pocket expenses at actuals"}.

This engagement will continue for later years unless either of us ends it or changes it in writing.

Please sign and return a copy of this letter to confirm that you agree with these terms.

Yours faithfully,
For ${f.name}
Chartered Accountants${f.frn ? "\nFRN: " + f.frn : ""}

${r.partner || f.partner || "[Partner name]"}
Partner


Accepted on behalf of ${c.name || "[client]"}

Signature: ____________________     Name: ____________________     Date: __________`;
}
function engHTML(r) {
  const c = clientById(r.client) || {}, f = S.db.settings.firm;
  const body = esc(r.body || engBody(r)).split(/\n{2,}/).map(p => { const L = p.split("\n"); if (L.every(l => l.startsWith("- "))) return `<ul>${L.map(l => `<li>${l.slice(2)}</li>`).join("")}</ul>`;
    if (L.length > 1 && L.slice(1).every(l => l.startsWith("- "))) return `<p><b>${L[0]}</b></p><ul>${L.slice(1).map(l => `<li>${l.slice(2)}</li>`).join("")}</ul>`; return `<p>${L.join("<br>")}</p>`; }).join("");
  return `<!doctype html><html><head><meta charset="utf-8"><title>Engagement letter – ${esc(c.name || "")}</title><style>body{font-family:Georgia,'Times New Roman',serif;color:#111;max-width:760px;margin:30px auto;padding:0 28px;line-height:1.55;font-size:14px}
    .hd{display:flex;gap:16px;align-items:center;border-bottom:2px solid #0B1F33;padding-bottom:10px;margin-bottom:18px}.hd img{width:64px;height:64px;object-fit:contain}.fn{font-size:20px;font-weight:bold;color:#0B1F33}.fa{font-size:12px;color:#444}
    ul{margin:4px 0 12px 0;padding-left:22px}p{margin:0 0 12px}.to{margin-bottom:16px}@media print{body{margin:0}}</style></head><body>
    <div class="hd">${f.logo ? `<img src="${f.logo}" alt="">` : ""}<div><div class="fn">${esc(f.name)}</div><div class="fa">Chartered Accountants${f.frn ? " · FRN " + esc(f.frn) : ""}<br>${esc(f.address || "").replace(/\n/g, ", ")}${f.phone ? " · " + esc(f.phone) : ""}${f.email ? " · " + esc(f.email) : ""}</div></div></div>
    <div class="to">Date: ${dmy(r.date || today())}<br><br>To,<br><b>${esc(c.name || "")}</b>${c.address ? "<br>" + esc(c.address).replace(/\n/g, "<br>") : ""}</div>${body}</body></html>`;
}
function engDialog(id, after, preset = {}) {
  const ex = id ? S.db.engage.find(x => x.id === id) : null; if (!ex && !can("engage")) return toast("You do not have the right to add engagement letters");
  const r = ex ? JSON.parse(JSON.stringify(ex)) : { client: preset.client || "", type: "Income tax compliance", fy: fyLabel(curFYStart()), fee: "", feeTerms: "", date: today(), status: "Draft", signedOn: "", udin: "", partner: S.db.settings.firm.partner || "", body: "" };
  const cl = vC().filter(c => c.active !== "Inactive" || c.id === r.client).sort((a, b) => a.name.localeCompare(b.name)), F = can("viewFees");
  const m = openModal(`<div class="mhead"><h3>${ex ? "Engagement letter" : "＋ New engagement letter"}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody"><div class="fgrid">
    <div class="field"><label class="req" for="enC">Client</label><select id="enC"><option value="">— select client —</option>${cl.map(c => `<option value="${c.id}" ${c.id === r.client ? "selected" : ""}>${esc(c.name)} (${esc(c.code)})</option>`).join("")}</select></div>
    <div class="field"><label class="req" for="enT">Engagement</label><select id="enT">${ENGTYPE.map(t => `<option ${t === r.type ? "selected" : ""}>${t}</option>`).join("")}</select></div>
    <div class="field"><label for="enF">Financial year</label><select id="enF">${FYS.map(y => `<option ${y === r.fy ? "selected" : ""}>${y}</option>`).join("")}</select></div>
    ${F ? `<div class="field"><label for="enFee">Fee (₹)</label><input type="number" id="enFee" min="0" step="1" value="${esc(r.fee)}"></div><div class="field full"><label for="enFT">Fee terms</label><input id="enFT" maxlength="200" value="${esc(r.feeTerms || "")}" placeholder="plus GST and out-of-pocket expenses at actuals; 50% on acceptance"></div>` : ""}
    <div class="field"><label for="enD">Letter date</label><input type="date" id="enD" value="${esc(r.date || "")}"></div><div class="field"><label for="enP">Signing partner</label><input id="enP" maxlength="80" value="${esc(r.partner || "")}"></div>
    <div class="field"><label for="enS">Status</label><select id="enS">${ENGST.map(t => `<option ${t === r.status ? "selected" : ""}>${t}</option>`).join("")}</select></div><div class="field"><label for="enSO">Signed by client on</label><input type="date" id="enSO" value="${esc(r.signedOn || "")}"></div>
    <div class="field full"><label for="enU">UDIN (if the work needs one)</label><input id="enU" list="enUL" maxlength="20" value="${esc(r.udin || "")}" style="text-transform:uppercase"><datalist id="enUL"></datalist></div></div>
    <div style="display:flex;align-items:end;gap:8px"><label class="small b" for="enB" style="flex:1">Letter text – a starting draft for you to review; edit freely</label><button type="button" class="btn sm" id="enR">↻ Rebuild from template</button></div>
    <textarea id="enB" style="width:100%;min-height:260px;border:1px solid #cfd5df;border-radius:6px;padding:8px;font-family:inherit;margin-top:4px">${esc(r.body || engBody(r))}</textarea><div class="err" id="enE"></div></div>
    <div class="mfoot">${ex && can("delete") ? '<button class="btn danger" id="enDel">Delete</button>' : ""}<span class="sp"></span><button class="btn" id="enX">Cancel</button><button class="btn" id="enV">Preview / download</button><button class="btn primary" id="enY">Save</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "900px";
  let edited = !!(ex && ex.body);
  const fillU = () => { const c = $("#enC", m).value; const u = [...new Set([...S.db.udins.filter(x => x.client === c).map(x => x.udin), ...S.db.works.filter(w => w.client === c && w.udin).map(w => w.udin)])]; $("#enUL", m).innerHTML = u.map(x => `<option value="${esc(x)}">`).join(""); };
  fillU();
  const collect = () => { r.client = $("#enC", m).value; r.type = $("#enT", m).value; r.fy = $("#enF", m).value; if (F) { r.fee = $("#enFee", m).value; r.feeTerms = $("#enFT", m).value.trim(); }
    r.date = $("#enD", m).value; r.partner = $("#enP", m).value.trim(); r.status = $("#enS", m).value; r.signedOn = $("#enSO", m).value; r.udin = $("#enU", m).value.trim().toUpperCase(); r.body = $("#enB", m).value; };
  const rebuild = () => { collect(); r.body = ""; $("#enB", m).value = engBody(r); edited = false; };
  ["#enC", "#enT", "#enF", "#enFee", "#enFT", "#enP"].forEach(s => { const el = $(s, m); if (el) el.addEventListener("change", () => { if (s === "#enC") fillU(); if (!edited) rebuild(); }); });
  $("#enB", m).oninput = () => edited = true;
  $("#enS", m).onchange = () => { if ($("#enS", m).value === "Signed" && !$("#enSO", m).value) $("#enSO", m).value = today(); };
  $("#enR", m).onclick = rebuild;
  $("#mx", m).onclick = $("#enX", m).onclick = closeModal;
  $("#enV", m).onclick = () => { collect(); if (!r.client) return $("#enE", m).textContent = "Select a client."; const html = engHTML(r); previewHTML(html, "Engagement letter – " + cname(r.client));
    const box = $$(".mfoot").pop(); if (box && !box.querySelector("#enDl")) { const b = document.createElement("button"); b.className = "btn"; b.id = "enDl"; b.textContent = "⬇ Download"; b.onclick = () => download(`Engagement_letter_${cname(r.client).replace(/[^A-Za-z0-9]+/g, "_")}_${r.fy}.html`, html, "text/html"); box.insertBefore(b, box.firstChild); } };
  $("#enY", m).onclick = () => { collect(); if (!r.client) return $("#enE", m).textContent = "Select a client."; const now = new Date().toISOString();
    if (ex) { Object.assign(ex, r, { updatedBy: S.user, updatedAt: now }); log("Edited", "Engagement letter", describe("engage", ex)); }
    else { const n = { id: uid(), ...r, createdBy: S.user, createdAt: now }; S.db.engage.push(n); log("Added", "Engagement letter", describe("engage", n)); }
    save(); closeModal(); toast("Saved"); (after || (() => go(S.route)))(); };
  if ($("#enDel", m)) $("#enDel", m).onclick = () => { closeModal(); deleteRecord("engage", ex.id, after); };
}

/* ---------------- portal logins – encrypted with a key only Admins and chosen users hold */
const PORTALS = [["GST", "https://services.gst.gov.in"], ["Income Tax", "https://eportal.incometax.gov.in"], ["TRACES", "https://www.tdscpc.gov.in"], ["MCA", "https://www.mca.gov.in"], ["EPFO", "https://unifiedportal-emp.epfindia.gov.in"], ["ESIC", "https://www.esic.gov.in"],
  ["Professional tax", ""], ["ICEGATE / DGFT", "https://www.icegate.gov.in"], ["Bank / net banking", ""], ["DSC token PIN", ""], ["Other", ""]];
const portalUrl = p => (PORTALS.find(x => x[0] === p) || [])[1] || "";
async function ckUnlock(usr, kek) { S.ck = null; S.ckRaw = null;
  try { let raw = null; if (S.ak && S.vault.ckA) raw = await aesDec(S.ak, S.vault.ckA); else if (usr.ck) raw = await aesDec(kek, usr.ck); if (raw) { S.ckRaw = raw; S.ck = await importDEK(raw); } } catch { S.ck = null; S.ckRaw = null; } }
async function ckEnsure() { if (S.ck) return true; if (!isAdmin() || !S.ak) return false; if (S.vault.ckA) { try { S.ckRaw = await aesDec(S.ak, S.vault.ckA); S.ck = await importDEK(S.ckRaw); return true; } catch { return false; } }
  const raw = rnd(32); S.vault.ckA = await aesEnc(S.ak, raw); S.vault.users.forEach(x => { delete x.ck; }); S.ckRaw = raw; S.ck = await importDEK(raw); await saveNow(); return true; }
const credOK = () => isAdmin() || !!S.ck;
const credUsers = () => S.vault.users.filter(x => x.ck).map(x => x.u);
async function credSec(r) { try { return JSON.parse(dec.decode(await aesDec(S.ck, r.sec))); } catch { return null; } }
async function viewCreds() {
  setTitle("Portal Logins");
  if (!(await ckEnsure())) { $("#view").innerHTML = `<div class="card"><h3>🔐 Portal Logins</h3><p>${isAdmin() ? "Portal logins could not be opened for your login. Ask another Admin to set your password once, then log in again." : "You have not been given access to portal logins. Ask the Admin."}</p></div>`; return; }
  const f = S.f.creds = S.f.creds || {};
  const rows = () => (S.db.creds || []).filter(r => showC(r.client) && (!f.client || r.client === f.client) && (!f.portal || r.portal === f.portal) && (!f.q || (cname(r.client) + " " + r.portal + " " + (r.label || "")).toLowerCase().includes(f.q.toLowerCase())))
    .sort((a, b) => cname(a.client).localeCompare(cname(b.client)) || a.portal.localeCompare(b.portal));
  $("#view").innerHTML = `${isAdmin() ? `<div class="notice">🔐 Logins are encrypted in your browser with a separate key. Only Admins${credUsers().length ? " and " + credUsers().map(uname).map(esc).join(", ") : ""} can open them. Every time a password is shown or copied, it is recorded in the Activity Log.</div>` : ""}
    <div class="toolbar"><input type="search" id="crQ" placeholder="Search client or portal…" value="${esc(f.q || "")}"><select id="crC"><option value="">All clients</option>${filterOpts("client").map(([v, l]) => `<option value="${esc(v)}" ${f.client === v ? "selected" : ""}>${esc(l)}</option>`).join("")}</select>
      <select id="crP"><option value="">All portals</option>${PORTALS.map(p => `<option ${f.portal === p[0] ? "selected" : ""}>${p[0]}</option>`).join("")}</select><span class="sp"></span>
      ${isAdmin() ? '<button class="btn" id="crWho">👥 Who can see these</button>' : ""}<button class="btn primary" id="crAdd">＋ Add login</button></div><div id="crT"></div>`;
  const draw = async () => { const R = rows(); const secs = await Promise.all(R.map(credSec));
    $("#crT").innerHTML = R.length ? `<div class="tablewrap"><table class="t"><thead><tr><th>Client</th><th>Portal</th><th>User ID</th><th>Password</th><th>Notes</th><th>Updated</th><th></th></tr></thead><tbody>${R.map((r, i) => { const s = secs[i] || {}; const u = portalUrl(r.portal);
      return `<tr data-id="${r.id}"><td><b>${esc(cname(r.client))}</b></td><td>${esc(r.portal)}${r.label ? `<div class="small muted">${esc(r.label)}</div>` : ""}${u ? `<div><a class="small" href="${u}" target="_blank" rel="noopener">open portal ↗</a></div>` : ""}</td>
        <td>${secs[i] === null ? '<span class="chip amber" title="Saved with an older key that was not kept online. Click Edit and enter the user ID and password again.">Re-enter – click Edit</span>' : ""}<span style="font-family:Consolas,monospace;user-select:all">${esc(s.user || "")}</span>${s.user ? ` <button type="button" class="btn sm ib" data-cp="u" aria-label="Copy user ID" title="Copy user ID">⧉</button>` : ""}</td>
        <td style="white-space:nowrap"><span class="crv" style="font-family:Consolas,monospace">${s.pass ? "••••••••" : '<span class="muted small">—</span>'}</span>${s.pass ? ` <button type="button" class="btn sm ib" data-sh aria-label="Show password" title="Show password">👁</button><button type="button" class="btn sm ib" data-cp="p" aria-label="Copy password" title="Copy password">⧉</button>` : ""}</td>
        <td class="small" style="white-space:normal;max-width:240px">${esc(s.notes || "")}</td><td class="small">${dmy((r.updatedAt || r.createdAt || "").slice(0, 10))}<div class="muted">${esc(uname(r.updatedBy || r.createdBy))}</div></td>
        <td><button type="button" class="btn sm" data-ed>Edit</button></td></tr>`; }).join("")}</tbody></table></div>` : '<div class="tablewrap"><div class="empty">No portal logins saved yet. Use <b>＋ Add login</b>.</div></div>';
    $$("#crT tr[data-id]").forEach((tr, i) => { const r = R[i], s = secs[i] || {}, what = `${cname(r.client)} – ${r.portal}`;
      const sh = $("[data-sh]", tr); if (sh) sh.onclick = () => { const v = $(".crv", tr), on = v.textContent !== s.pass; v.textContent = on ? s.pass : "••••••••"; if (on) { log("Viewed", "Portal login", what); save(); setTimeout(() => { if (v.isConnected) v.textContent = "••••••••"; }, 20000); } };
      $$("[data-cp]", tr).forEach(b => b.onclick = async () => { const val = b.dataset.cp === "p" ? s.pass : s.user; try { await navigator.clipboard.writeText(val); toast(b.dataset.cp === "p" ? "Password copied" : "User ID copied"); } catch { toast("Copy not allowed here – select and press Ctrl+C"); if (b.dataset.cp === "p") $(".crv", tr).textContent = s.pass; } if (b.dataset.cp === "p") { log("Copied", "Portal login", what); save(); } });
      $("[data-ed]", tr).onclick = () => credDialog(r, draw); }); };
  $("#crQ").oninput = e => { f.q = e.target.value; draw(); }; $("#crC").onchange = e => { f.client = e.target.value; draw(); }; $("#crP").onchange = e => { f.portal = e.target.value; draw(); };
  $("#crAdd").onclick = () => credDialog(null, draw); if ($("#crWho")) $("#crWho").onclick = credAccess;
  draw();
}
async function credDialog(r, after) {
  const s = r ? (await credSec(r)) || {} : {}; const cl = vC().slice().sort((a, b) => a.name.localeCompare(b.name));
  const m = openModal(`<div class="mhead"><h3>${r ? "Edit portal login" : "＋ Add portal login"}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody"><div class="fgrid">
    <div class="field"><label class="req" for="cdC">Client</label><select id="cdC"><option value="">— select client —</option>${cl.map(c => `<option value="${c.id}" ${r && c.id === r.client ? "selected" : ""}>${esc(c.name)} (${esc(c.code)})</option>`).join("")}</select></div>
    <div class="field"><label class="req" for="cdP">Portal</label><select id="cdP">${PORTALS.map(p => `<option ${r && r.portal === p[0] ? "selected" : ""}>${p[0]}</option>`).join("")}</select></div>
    <div class="field full"><label for="cdL">Label (optional)</label><input id="cdL" maxlength="80" value="${esc(r ? r.label || "" : "")}" placeholder="e.g. GSTIN 06AAAAA0000A1Z5, or director's name"></div>
    <div class="field"><label for="cdU">User ID</label><input id="cdU" autocomplete="off" spellcheck="false" maxlength="120" value="${esc(s.user || "")}"></div>
    <div class="field"><label for="cdW">Password / PIN</label><input id="cdW" autocomplete="off" spellcheck="false" maxlength="200" value="${esc(s.pass || "")}" style="font-family:Consolas,monospace"></div>
    <div class="field full"><label for="cdN">Notes</label><textarea id="cdN" maxlength="500" placeholder="e.g. security question answer, registered mobile">${esc(s.notes || "")}</textarea></div></div><div class="err" id="cdE"></div></div>
    <div class="mfoot">${r && (isAdmin() || can("delete")) ? '<button class="btn danger" id="cdDel">Delete</button>' : ""}<span class="sp"></span><button class="btn" id="cdX">Cancel</button><button class="btn primary" id="cdY">Save</button></div>`, true);
  $("#mx", m).onclick = $("#cdX", m).onclick = closeModal;
  $("#cdY", m).onclick = async () => { const c = $("#cdC", m).value, p = $("#cdP", m).value; if (!c) return $("#cdE", m).textContent = "Select a client.";
    const sec = await aesEnc(S.ck, enc.encode(JSON.stringify({ user: $("#cdU", m).value.trim(), pass: $("#cdW", m).value, notes: $("#cdN", m).value.trim() }))), now = new Date().toISOString();
    S.db.creds = S.db.creds || [];
    if (r) { Object.assign(r, { client: c, portal: p, label: $("#cdL", m).value.trim(), sec, updatedBy: S.user, updatedAt: now }); log("Edited", "Portal login", `${cname(c)} – ${p}`); }
    else { S.db.creds.push({ id: uid(), client: c, portal: p, label: $("#cdL", m).value.trim(), sec, createdBy: S.user, createdAt: now }); log("Added", "Portal login", `${cname(c)} – ${p}`); }
    save(); closeModal(); toast("Saved"); after(); };
  if ($("#cdDel", m)) $("#cdDel", m).onclick = async () => { if (!(await confirmBox("Delete login", `<p>Delete the ${esc(r.portal)} login of <b>${esc(cname(r.client))}</b>?</p>`, "Delete"))) return;
    S.db.creds = S.db.creds.filter(x => x.id !== r.id); log("Deleted", "Portal login", `${cname(r.client)} – ${r.portal}`); save(); toast("Deleted"); after(); };
}
async function credAccess() {
  if (!isAdmin() || !(await ckEnsure())) return; const book = await pwbRead();
  const users = S.vault.users.filter(x => roleOfU(x.u) !== "Admin");
  const m = openModal(`<div class="mhead"><h3>Who can see portal logins</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p class="small" style="margin-top:0">Admins can always see them. Tick the staff and interns who may also open them. Access is set up with the password you gave them, so their password must be recorded (Team &amp; Rights › Set password).</p>
    ${users.length ? `<div class="picklist">${users.map(x => `<label><input type="checkbox" data-u="${esc(x.u)}" ${x.ck ? "checked" : ""} ${book[x.u] || x.ck ? "" : "disabled"}> ${esc(uname(x.u))} <span class="small muted">${esc(roleOfU(x.u))}</span>${book[x.u] || x.ck ? "" : ` <button type="button" class="btn sm" data-setpw="${esc(x.u)}">Set password first</button>`}</label>`).join("")}</div>` : '<p class="muted">No staff or interns yet.</p>'}
    <p class="small muted">Removing someone stops them from opening logins from their next sign-in. Change any password they may have copied if needed.</p><div class="err" id="caE"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="caX">Cancel</button><button class="btn primary" id="caY">Save</button></div>`, true);
  $("#mx", m).onclick = $("#caX", m).onclick = closeModal;
  $$("[data-setpw]", m).forEach(b => b.onclick = e => { e.preventDefault(); closeModal(); S.pwBack = credAccess; resetPw(b.dataset.setpw); });
  $("#caY", m).onclick = async () => { $("#caE", m).textContent = "Saving…"; const ch = [];
    for (const b of $$("[data-u]", m)) { const usr = S.vault.users.find(x => x.u === b.dataset.u); if (!usr) continue;
      if (b.checked && !usr.ck) { const pw = (book[usr.u] || {}).p; if (!pw) continue; usr.ck = await aesEnc(await deriveKEK(pw, unb64(usr.salt), usr.iter || ITER), S.ckRaw); ch.push("+" + usr.u); }
      if (!b.checked && usr.ck) { delete usr.ck; ch.push("−" + usr.u); } }
    if (ch.length) log("Rights", "Portal login", "Access changed: " + ch.join(", ")); await saveNow(); closeModal(); toast("Access saved"); viewCreds(); };
}

function filterOpts(o) {
  if (o === "client") return vC().slice().sort((a, b) => a.name.localeCompare(b.name)).map(c => [c.id, c.name]);
  if (o === "staff") return (S.db.settings.staff || []).map(s => [s, ulabel(s)]);
  if (o === "forms") return [...new Set([...(S.db.works || []).map(w => w.form).filter(Boolean)])].sort().map(x => [x, x]);
  const L = typeof o === "function" ? o() : o; return L.map(x => Array.isArray(x) ? x : [x, x]);
}
function applyFilters(ent, rows) {
  const f = S.f[ent] || {}; const q = (f.q || "").toLowerCase();
  return rows.filter(r => {
    for (const fd of FILTERS[ent]) {
      const v = f[fd.k]; if (!v || (Array.isArray(v) && !v.length)) continue;
      if (ent === "dsc" && fd.k === "dst") { if (dscSt(r).k !== v) return false; continue; }
      if (ent === "docreq" && fd.k === "drs") { if (drSt(r).k !== v) return false; continue; }
      if (Array.isArray(v)) {
        if (fd.k === "status") { if (!(v.includes(r.status) || (v.includes("Open (not done)") && isOpen(r)))) return false; continue; }
        if (fd.k === "assigned") { if (!(v.includes(r.assigned) || (v.includes("__none__") && !r.assigned))) return false; continue; }
        if (fd.k === "flag") { if (!(v.includes(r.flag) || (v.includes("__pin__") && isPinned(r)) || (v.includes("__any__") && r.flag) || (v.includes("__none__") && !r.flag))) return false; continue; }
        if (!v.includes(r[fd.k] || "")) return false; continue; }
      if (ent === "works" && fd.k === "status") { if (v === "Open (not done)" ? !isOpen(r) : r.status !== v) return false; continue; }
      if (ent === "works" && fd.k === "duep") { const t = today(), d = r.due;
        if (v === "No due date") { if (d) return false; continue; } if (!d) return false;
        if (v === "Overdue" && !(d < t && isOpen(r))) return false; if (v === "Due today" && d !== t) return false;
        if (v === "Next 7 days" && !(d >= t && d <= addDays(t, 7))) return false; if (v === "This month" && d.slice(0, 7) !== t.slice(0, 7)) return false;
        if (v === "Next month") { const n = new Date(t.slice(0, 8) + "01T00:00:00"); n.setMonth(n.getMonth() + 1); if (d.slice(0, 7) !== iso(n).slice(0, 7)) return false; } continue; }
      if (ent === "works" && fd.k === "timeline") { const d = delayInfo(r);
        if (v === "Overdue" && !d.overdue) return false; if (v === "Due in 7 days" && !(d.soon && isOpen(r))) return false;
        if (v === "Filed late" && !(d.late > 0)) return false; if (v === "Fee outstanding" && !(woOut(r) > 0)) return false;
        if (v === "Not billed (fee entered)" && !(num(r.fee) > 0 && !r.billId && !r.billno)) return false;
        if (v === "Created by interns" && !(((S.db.settings.roles || {})[r.createdBy]) === "Intern")) return false; continue; }
      if (ent === "reimb" && fd.k === "bal") { if (v === "Balance due" ? reBal(r) <= 0 : reBal(r) > 0) return false; continue; }
      if ((r[fd.k] || "") !== v) return false;
    }
    if (f.from && ent !== "clients") { const dv = ent === "works" ? (r.due || r.filed) : ent === "dsc" ? r.expiry : ent === "docreq" ? r.due : r.date; if (!dv || dv < f.from) return false; }
    if (f.to && ent !== "clients") { const dv = ent === "works" ? (r.due || r.filed) : ent === "dsc" ? r.expiry : ent === "docreq" ? r.due : r.date; if (!dv || dv > f.to) return false; }
    if (q) { const hay = Object.values(r).join(" ").toLowerCase() + " " + (r.client ? (cname(r.client) + " " + ccode(r.client)).toLowerCase() : ""); if (!hay.includes(q)) return false; }
    return true;
  });
}
function sortRows(ent, rows, cols = COLS[ent], key = ent) {
  const out = sortRows0(ent, rows, cols, key);
  if (ent !== "works") return out;
  const p = out.filter(isPinned); return p.length ? [...p, ...out.filter(w => !isPinned(w))] : out;
}
function sortRows0(ent, rows, cols, key) {
  const st = S.sort[key];
  if (!st) { // default sort
    if (ent === "works") return rows.sort((a, b) => (isOpen(b) - isOpen(a)) || ((a.due || "9999") < (b.due || "9999") ? -1 : 1));
    if (ent === "clients") return rows.sort((a, b) => a.name.localeCompare(b.name));
    return rows.sort((a, b) => (b.date || "").localeCompare(a.date || ""));
  }
  const c = cols[st.i]; const kf = c.s || c.x;
  return rows.sort((a, b) => { const x = kf(a), y = kf(b); const r = (typeof x === "number" && typeof y === "number") ? x - y : String(x ?? "").localeCompare(String(y ?? ""), undefined, { numeric: true }); return st.d * r; });
}

/* ------------------------------------------------------------------ LIST VIEW */
function udinTaskPanel() {
  const all = visW().filter(udinApp), pend = all.filter(udinPend), done = all.filter(w => w.udin);
  const tab = S.udinTab = S.udinTab || "pend", rows = (tab === "pend" ? pend : done).slice().sort((a, b) => tab === "pend" ? (a.due || "9").localeCompare(b.due || "9") : (b.udinDate || "").localeCompare(a.udinDate || ""));
  const html = `<div class="card" id="udinPanel" style="margin-bottom:14px">
    <h3 style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:center">UDIN status of tasks <span class="small muted" style="font-weight:400;font-family:inherit">Tasks marked "UDIN applicable" in the Work Tracker</span></h3>
    <div class="grid kpis" style="margin-bottom:12px">
      <div class="kpi ${tab === "pend" ? "amber" : ""}" data-ut="pend"><div class="l">UDIN to be generated</div><div class="v">${pend.length}</div></div>
      <div class="kpi ${tab === "done" ? "green" : ""}" data-ut="done"><div class="l">UDIN updated on task</div><div class="v">${done.length}</div></div>
      <div class="kpi"><div class="l">Pending &amp; work filed</div><div class="v ${pend.filter(w => stg(w.status) === "Filed / Done").length ? "red" : ""}">${pend.filter(w => stg(w.status) === "Filed / Done").length}</div></div>
    </div>
    <div class="tablewrap" style="max-height:340px"><table class="t"><thead><tr><th>Client</th><th>Task</th><th>FY / period</th><th>Assigned</th><th>Status</th><th>${tab === "pend" ? "Due" : "UDIN"}</th><th>${tab === "pend" ? "Signed / filed" : "UDIN date"}</th><th></th></tr></thead><tbody>
    ${rows.length ? rows.map(w => `<tr data-uw="${w.id}"><td><b>${esc(cname(w.client))}</b></td><td>${esc(w.form)}</td><td>${esc([w.fy, w.period].filter(Boolean).join(" · "))}</td><td>${esc(uname(w.assigned))}</td><td>${statusChip(w.status)}</td>
      <td>${tab === "pend" ? `<span class="${delayInfo(w).overdue ? "red b" : ""}">${dmy(w.due)}</span>` : `<b>${esc(w.udin)}</b>`}</td><td>${tab === "pend" ? dmy(w.filed) : dmy(w.udinDate)}</td><td><button class="btn sm ${tab === "pend" ? "primary" : ""}" data-uw="${w.id}">${tab === "pend" ? "Enter UDIN" : "Open"}</button></td></tr>`).join("")
      : `<tr><td colspan="8" class="empty">${tab === "pend" ? "No tasks are waiting for a UDIN." : "No task has a UDIN entered yet."}</td></tr>`}
    </tbody></table></div>
    <p class="small muted" style="margin:10px 0 0">The register below lists UDINs recorded directly in the register.</p></div>`;
  $("#view").insertAdjacentHTML("afterbegin", html);
  $$("#udinPanel [data-ut]").forEach(k => k.onclick = () => { S.udinTab = k.dataset.ut; viewList("udins"); });
  $$("#udinPanel tr[data-uw]").forEach(tr => tr.onclick = e => { e.stopPropagation(); editRecord("works", tr.dataset.uw, () => viewList("udins")); });
}
/* ------------------------------------------------------------------ MERGE CLIENTS (one client, many GSTINs) */
const panOfC = c => ((c.pan || "").toUpperCase()) || ((gstsOf(c)[0] || {}).g || "").toUpperCase().slice(2, 12);
function mergeGroups() { const by = {}; S.db.clients.forEach(c => { const p = panOfC(c); if (/^[A-Z]{5}[0-9]{4}[A-Z]$/.test(p)) (by[p] = by[p] || []).push(c); });
  return Object.entries(by).filter(([, l]) => l.length > 1).map(([pan, l]) => ({ pan, list: l.slice().sort((a, b) => (mergeLinks(b.id) - mergeLinks(a.id)) || (a.createdAt || "").localeCompare(b.createdAt || "") || a.code.localeCompare(b.code)) })); }
const mergeLinks = id => ["works", "challans", "reimb", "udins", "bills", "dsc", "docreq", "engage", "creds", "cases"].reduce((a, k) => a + (S.db[k] || []).filter(x => x.client === id).length, 0);
function mergeClients(keepId, dupIds) {
  const K = clientById(keepId), D = dupIds.filter(x => x !== keepId).map(clientById).filter(Boolean); if (!K || !D.length) return 0;
  const set = new Set(D.map(d => d.id)); let n = 0;
  ["works", "challans", "reimb", "udins", "bills", "dsc", "docreq", "engage", "creds", "cases"].forEach(k => (S.db[k] || []).forEach(r => { if (set.has(r.client)) { r.client = keepId; n++; } }));
  (S.db.sgroups || []).forEach(g => { if (!g.members.some(x => set.has(x.client))) return; const keep = g.members.find(x => x.client === keepId); g.members.forEach(x => { if (set.has(x.client)) { if (keep) keep.docs = [...(keep.docs || []), ...(x.docs || [])]; x.client = keepId; } }); g.members = g.members.filter((x, i, a) => a.findIndex(y => y.client === x.client) === i); });
  (S.db.bin || []).forEach(b => { if (b.item && set.has(b.item.client)) b.item.client = keepId; });
  custSt().forEach(x => { if ((x.clients || []).some(c => set.has(c))) x.clients = [...new Set(x.clients.map(c => set.has(c) ? keepId : c))]; });
  const G = gstsOf(K).map(x => ({ ...x })); D.forEach(d => gstsOf(d).forEach(g => { if (!G.some(x => x.g.toUpperCase() === g.g.toUpperCase())) G.push({ ...g }); }));
  K.gstins = G; K.gstin = G[0] ? G[0].g : "";
  const skip = ["id", "code", "name", "gstin", "gstins", "createdBy", "createdAt", "imp", "updatedBy", "updatedAt", "docs", "remarks", "adminOnly", "active"];
  D.forEach(d => Object.keys(d).forEach(f => { if (skip.includes(f)) return; const v = d[f];
    if (Array.isArray(v)) { K[f] = [...new Set([...(Array.isArray(K[f]) ? K[f] : []), ...v])]; return; }
    if ((K[f] == null || K[f] === "") && v != null && v !== "") K[f] = v; }));
  const docs = D.flatMap(d => d.docs || []); if (docs.length) K.docs = [...(K.docs || []), ...docs];
  if (!K.pan) K.pan = panOfC(K);
  K.remarks = [K.remarks, `Merged from ${D.map(d => `${d.name} (${d.code})`).join(", ")} on ${dmy(today())}`, ...D.map(d => d.remarks).filter(Boolean)].filter(Boolean).join("\n");
  K.updatedBy = S.user; K.updatedAt = new Date().toISOString();
  S.db.clients = S.db.clients.filter(c => !set.has(c.id));
  log("Edited", "Client", `Merged ${D.map(d => `${d.code} – ${d.name}`).join(", ")} into ${K.code} – ${K.name} (${n} record(s) moved, ${G.length} GSTIN(s))`); save();
  return n;
}
async function mergeConfirm(keepId, dupIds) {
  const K = clientById(keepId), D = dupIds.filter(x => x !== keepId).map(clientById).filter(Boolean); if (!K || !D.length) return toast("Choose the client to keep and at least one other client");
  const n = D.reduce((a, d) => a + mergeLinks(d.id), 0), G = [...new Set([...gstsOf(K), ...D.flatMap(gstsOf)].map(g => g.g.toUpperCase()))];
  const panX = [...new Set([K, ...D].map(panOfC).filter(Boolean))];
  if (!(await confirmBox("Merge clients", `<p>Keep <b>${esc(K.name)} (${esc(K.code)})</b> and merge into it:</p><ul>${D.map(d => `<li>${esc(d.name)} (${esc(d.code)}) – ${mergeLinks(d.id)} record(s)</li>`).join("")}</ul>
    <p>${n} record(s) – tasks, bills, challans, reimbursements, UDINs, DSCs, document requests, engagement letters and portal logins – move to ${esc(K.code)}. The client will have ${G.length} GSTIN(s): ${G.map(esc).join(", ") || "none"}. The other client(s) are then removed.</p>
    ${panX.length > 1 ? `<div class="notice warn">These clients have different PANs (${panX.map(esc).join(", ")}). Merge only if they are the same business.</div>` : ""}<p class="small muted">Download a backup first if you are unsure (Settings › Backup). This cannot be undone.</p>`, "Merge"))) return mergeDialog();
  const moved = mergeClients(keepId, dupIds); toast(`Merged – ${moved} record(s) moved to ${K.code}`); mergeDialog();
}
function mergeDialog() {
  if (!isAdmin()) return toast("Only the Admin can merge clients");
  const gs = mergeGroups(), cl = S.db.clients.slice().sort((a, b) => a.name.localeCompare(b.name));
  const opts = cl.map(c => `<option value="${c.id}">${esc(c.name)} (${esc(c.code)})${gstsOf(c).length ? " · " + gstsOf(c).length + " GSTIN" : ""}</option>`).join("");
  const m = openModal(`<div class="mhead"><h3>Merge duplicate clients</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody" style="max-height:calc(100vh - 230px)">
    <p class="small muted" style="margin-top:0">One business = one client. If the same business was added more than once (for example once for each state GSTIN), merge them: every GSTIN, task, bill and record moves to the client you keep.</p>
    <h4 style="margin:12px 0 6px">Clients with the same PAN</h4>
    ${gs.length ? gs.map((g, i) => `<div class="card" style="padding:10px 12px;margin-bottom:10px"><div style="display:flex;align-items:center;gap:8px;margin-bottom:6px"><b style="flex:1">PAN ${esc(g.pan)}</b><button class="btn sm primary" data-mg="${i}">Merge this group</button></div>
      <table class="t"><thead><tr><th>Keep</th><th>Merge</th><th>Client</th><th>GSTIN(s)</th><th class="num">Records</th></tr></thead><tbody>${g.list.map((c, j) => `<tr><td><input type="radio" name="mk${i}" value="${c.id}" ${j === 0 ? "checked" : ""}></td><td><input type="checkbox" class="md${i}" value="${c.id}" checked></td>
        <td><b>${esc(c.name)}</b> <span class="small muted">${esc(c.code)}</span></td><td class="small">${gstsOf(c).map(x => esc(x.g)).join("<br>") || "–"}</td><td class="num">${mergeLinks(c.id)}</td></tr>`).join("")}</tbody></table></div>`).join("")
      : '<div class="empty" style="padding:14px">No two clients share a PAN.</div>'}
    <h4 style="margin:16px 0 6px">Merge any two clients</h4>
    <div class="fgrid"><div class="field"><label>Keep this client</label><select id="mgK"><option value=""></option>${opts}</select></div><div class="field"><label>Merge this client into it</label><select id="mgD"><option value=""></option>${opts}</select></div></div>
    </div><div class="mfoot"><span class="sp"></span><button class="btn" id="mgX">Close</button><button class="btn primary" id="mgGo">Merge selected pair</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "820px";
  $("#mx", m).onclick = $("#mgX", m).onclick = () => { closeModal(); if (S.route === "clients") go("clients"); };
  $$("[data-mg]", m).forEach(b => b.onclick = () => { const i = b.dataset.mg, k = ($(`input[name="mk${i}"]:checked`, m) || {}).value;
    mergeConfirm(k, $$(`.md${i}`, m).filter(x => x.checked).map(x => x.value)); });
  $("#mgGo", m).onclick = () => { const k = $("#mgK", m).value, d = $("#mgD", m).value; if (!k || !d || k === d) return toast("Choose two different clients"); mergeConfirm(k, [d]); };
}
/* ------------------------------------------------------------------ SERVICES BY CLIENT (packages + grid) */
const PKG_DEF = [
  { name: "ITR only", services: ["Income Tax Return"] },
  { name: "GST only", services: ["GST"] },
  { name: "GST + ITR", services: ["GST", "Income Tax Return", "Advance Tax"] },
  { name: "GST + TDS + ITR", services: ["GST", "TDS Return", "TDS Challan", "Income Tax Return", "Advance Tax"] },
  { name: "Tax audit client", services: ["GST", "Income Tax Return", "Tax Audit", "Advance Tax", "UDIN / Certification"] },
  { name: "Company – full compliance", services: ["GST", "TDS Return", "TDS Challan", "ROC / MCA", "Income Tax Return", "Statutory Audit", "Tax Audit", "Accounting", "Advance Tax", "UDIN / Certification"] }];
const pkgs = () => (S.db && S.db.settings.svcPackages) || PKG_DEF;
const SVCSHORT = { "GST": "GST", "TDS Return": "TDS return", "TDS Challan": "TDS challan", "ROC / MCA": "ROC", "Income Tax Return": "ITR", "Tax Audit": "Tax audit", "Statutory Audit": "Stat. audit", "UDIN / Certification": "UDIN / cert.", "Accounting": "Accounts", "Advance Tax": "Adv. tax", "Notice / Assessment": "Notice", "Registration": "Regn.", "Project / Other": "Other" };
const sameSet = (a, b) => a.length === b.length && a.every(x => b.includes(x));
const pkgOf = c => { const s = c.services || []; if (!s.length) return ""; const p = pkgs().find(p => sameSet(p.services, s)); return p ? p.name : "Custom"; };
function bindPkgPick(m) { const box = $("#f_services", m); if (!box) return;
  const bar = document.createElement("div"); bar.className = "pkgbar";
  bar.innerHTML = `<span class="small muted">Quick pick:</span>${pkgs().map((p, i) => `<button type="button" class="btn sm" data-pk="${i}" title="${esc(p.services.join(", "))}">${esc(p.name)}</button>`).join("")}<button type="button" class="btn sm" data-pk="-1">Clear</button>`;
  box.parentNode.insertBefore(bar, box);
  $$("[data-pk]", bar).forEach(b => b.onclick = () => { const p = pkgs()[+b.dataset.pk]; $$("input", box).forEach(x => x.checked = !!p && p.services.includes(x.value)); }); }
function viewClientSvc() {
  setTitle("Services by client"); const edit = can("manageClients");
  const f = S.f.csvc = S.f.csvc || {}; const sel = new Set(); const SV = allSvc();
  $("#view").innerHTML = `<p class="small muted" style="margin:0 0 10px">Tick what you do for each client – one click per box, saved straight away. Or pick a <b>package</b> to tick a set of services at once, then adjust any box for that client.</p>
    <div class="toolbar"><input type="search" id="svQ" placeholder="Search client…" value="${esc(f.q || "")}">
      <select id="svT"><option value="">All client types</option>${CTYPE.map(t => `<option ${f.type === t ? "selected" : ""}>${t}</option>`).join("")}</select>
      <select id="svP"><option value="">All packages</option>${pkgs().map(p => `<option ${f.pkg === p.name ? "selected" : ""}>${esc(p.name)}</option>`).join("")}<option value="Custom" ${f.pkg === "Custom" ? "selected" : ""}>Custom</option><option value="none" ${f.pkg === "none" ? "selected" : ""}>No services ticked</option></select>
      <select id="svS"><option value="">Any service</option>${SV.map(s => `<option ${f.svc === s ? "selected" : ""}>${esc(s)}</option>`).join("")}</select>
      <span class="sp"></span>${edit ? '<button class="btn" id="svM">Manage packages</button>' : ""}<button class="btn" id="svB">← Clients</button></div>
    ${edit ? `<div class="toolbar" id="svBulk" style="display:none;background:#EEF3F1;border-radius:8px;padding:8px 10px"><b id="svN"></b><span class="small muted">selected:</span>
      <select id="svBP"><option value="">Apply package…</option>${pkgs().map((p, i) => `<option value="${i}">${esc(p.name)}</option>`).join("")}</select>
      <select id="svBA"><option value="">Add service…</option>${SV.map(s => `<option>${esc(s)}</option>`).join("")}</select>
      <select id="svBR"><option value="">Remove service…</option>${SV.map(s => `<option>${esc(s)}</option>`).join("")}</select><button class="btn sm" id="svBX">Clear selection</button></div>` : ""}
    <div id="svT2"></div>`;
  const rows = () => vC().filter(c => (!f.q || (c.name + " " + c.code + " " + (c.group || "")).toLowerCase().includes(f.q.toLowerCase())) && (!f.type || c.type === f.type)
    && (!f.pkg || (f.pkg === "none" ? !(c.services || []).length : pkgOf(c) === f.pkg)) && (!f.svc || (c.services || []).includes(f.svc))).sort((a, b) => a.name.localeCompare(b.name));
  const setSvc = (c, list, why) => { c.services = SV.filter(s => list.includes(s)).concat(list.filter(s => !SV.includes(s))); c.updatedBy = S.user; c.updatedAt = new Date().toISOString(); if (why) log("Edited", "Client", `${c.code} – ${c.name}: services ${why}`); };
  const bulk = () => { const b = $("#svBulk"); if (!b) return; b.style.display = sel.size ? "flex" : "none"; $("#svN").textContent = sel.size; };
  const draw = () => { const R = rows();
    $("#svT2").innerHTML = R.length ? `<div class="tablewrap" style="max-height:calc(100vh - 260px)"><table class="t svgrid"><thead><tr>${edit ? '<th><input type="checkbox" id="svAll" title="Select all shown"></th>' : ""}<th>Client</th><th>Package</th>
      ${SV.map(s => `<th class="svh" title="${esc(s)}">${esc(SVCSHORT[s] || s)}</th>`).join("")}</tr></thead><tbody>${R.map(c => { const pk = pkgOf(c);
        return `<tr data-id="${c.id}">${edit ? `<td><input type="checkbox" class="svR" ${sel.has(c.id) ? "checked" : ""}></td>` : ""}<td><b>${esc(c.name)}</b><div class="small muted">${esc(c.code)} · ${esc(c.type || "")}</div></td>
        <td>${edit ? `<select class="svPk"><option value="">${pk ? "" : "—"}</option>${pkgs().map((p, i) => `<option value="${i}" ${pk === p.name ? "selected" : ""}>${esc(p.name)}</option>`).join("")}${pk === "Custom" ? '<option value="c" selected>Custom</option>' : ""}</select>` : esc(pk || "—")}</td>
        ${SV.map(s => `<td class="svc"><input type="checkbox" data-s="${esc(s)}" ${(c.services || []).includes(s) ? "checked" : ""} ${edit ? "" : "disabled"} aria-label="${esc(c.name)} – ${esc(s)}"></td>`).join("")}</tr>`; }).join("")}</tbody>
      <tfoot><tr>${edit ? "<td></td>" : ""}<td class="small muted">${R.length} client(s)</td><td></td>${SV.map(s => `<td class="svc small muted">${R.filter(c => (c.services || []).includes(s)).length}</td>`).join("")}</tr></tfoot></table></div>`
      : '<div class="tablewrap"><div class="empty">No clients match.</div></div>';
    if (!edit) return;
    $$("#svT2 tr[data-id]").forEach(tr => { const c = clientById(tr.dataset.id);
      $$("[data-s]", tr).forEach(x => x.onchange = () => { const s = x.dataset.s, L = (c.services || []).filter(v => v !== s); if (x.checked) L.push(s); setSvc(c, L, (x.checked ? "+ " : "− ") + s); save(); draw(); });
      $(".svPk", tr).onchange = e => { const p = pkgs()[+e.target.value]; if (!p) return draw(); setSvc(c, [...p.services], "set to " + p.name); save(); draw(); };
      $(".svR", tr).onchange = e => { e.target.checked ? sel.add(c.id) : sel.delete(c.id); bulk(); }; });
    const all = $("#svAll"); if (all) { all.checked = R.length && R.every(c => sel.has(c.id)); all.onchange = () => { R.forEach(c => all.checked ? sel.add(c.id) : sel.delete(c.id)); draw(); bulk(); }; } };
  const doBulk = (fn, what) => { const L = [...sel].map(clientById).filter(Boolean); L.forEach(c => setSvc(c, fn(c.services || []))); log("Edited", "Client", `Services for ${L.length} client(s): ${what}`); save(); toast(`${L.length} client(s) updated`); draw(); };
  if (edit) {
    $("#svBP").onchange = e => { const p = pkgs()[+e.target.value]; e.target.value = ""; if (p) doBulk(() => [...p.services], "set to " + p.name); };
    $("#svBA").onchange = e => { const s = e.target.value; e.target.value = ""; if (s) doBulk(L => L.includes(s) ? L : [...L, s], "+ " + s); };
    $("#svBR").onchange = e => { const s = e.target.value; e.target.value = ""; if (s) doBulk(L => L.filter(v => v !== s), "− " + s); };
    $("#svBX").onclick = () => { sel.clear(); bulk(); draw(); };
    $("#svM").onclick = pkgDialog; }
  const bind = (id, k, ev = "change") => $(id).addEventListener(ev, e => { f[k] = e.target.value; draw(); });
  bind("#svQ", "q", "input"); bind("#svT", "type"); bind("#svP", "pkg"); bind("#svS", "svc"); $("#svB").onclick = () => go("clients");
  draw();
}
function pkgDialog() {
  const L = JSON.parse(JSON.stringify(pkgs())), SV = allSvc();
  const m = openModal(`<div class="mhead"><h3>Service packages</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody" style="max-height:calc(100vh - 230px)">
    <p class="small muted" style="margin-top:0">A package is a set of services you often do together. Picking it ticks those services; you can still change any box for one client. Changing a package here does not change clients already set.</p><div id="pkL"></div>
    <button type="button" class="btn sm" id="pkAdd">＋ New package</button><div class="err" id="pkE"></div></div>
    <div class="mfoot"><button class="btn" id="pkR">Restore defaults</button><span class="sp"></span><button class="btn" id="pkX">Cancel</button><button class="btn primary" id="pkY">Save</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "820px";
  const draw = () => { $("#pkL", m).innerHTML = L.map((p, i) => `<div class="card" style="padding:10px 12px;margin-bottom:10px"><div style="display:flex;gap:8px;align-items:center"><input class="pkN" data-i="${i}" value="${esc(p.name)}" maxlength="60" style="flex:1;font-weight:600;border:1px solid #cfd5df;border-radius:6px;padding:5px 8px"><button type="button" class="btn sm" data-del="${i}">Remove</button></div>
      <div class="checks">${SV.map(s => `<label><input type="checkbox" data-i="${i}" value="${esc(s)}" ${p.services.includes(s) ? "checked" : ""}>${esc(s)}</label>`).join("")}</div></div>`).join("") || '<p class="muted">No packages.</p>';
    $$(".pkN", m).forEach(x => x.oninput = () => L[+x.dataset.i].name = x.value);
    $$(".checks input", m).forEach(x => x.onchange = () => { const p = L[+x.dataset.i]; p.services = SV.filter(s => s === x.value ? x.checked : p.services.includes(s)); });
    $$("[data-del]", m).forEach(b => b.onclick = () => { L.splice(+b.dataset.del, 1); draw(); }); };
  $("#pkAdd", m).onclick = () => { L.push({ name: "New package", services: [] }); draw(); };
  $("#pkR", m).onclick = () => { L.splice(0, L.length, ...JSON.parse(JSON.stringify(PKG_DEF))); draw(); };
  $("#mx", m).onclick = $("#pkX", m).onclick = closeModal;
  $("#pkY", m).onclick = () => { const names = L.map(p => p.name.trim());
    if (names.some(n => !n)) return $("#pkE", m).textContent = "Every package needs a name.";
    if (new Set(names.map(n => n.toLowerCase())).size !== names.length) return $("#pkE", m).textContent = "Two packages have the same name.";
    if (L.some(p => !p.services.length)) return $("#pkE", m).textContent = "Tick at least one service in every package.";
    S.db.settings.svcPackages = L.map(p => ({ name: p.name.trim(), services: p.services })); log("Edited", "Settings", "Service packages"); save(); closeModal(); toast("Packages saved"); if (S.route === "clientsvc") viewClientSvc(); };
  draw();
}
/* ------------------------------------------------------------------ NOTICES, CASES & ASSESSMENTS · SEARCH / SURVEY GROUPS */
const CDEPT = ["Income Tax", "GST", "TDS / TCS", "ROC / MCA", "Customs / DGFT", "Other"];
const CKIND = ["Notice / information sought", "Scrutiny assessment", "Reassessment (escaped income)", "Search / block assessment", "Show cause notice", "Demand / rectification", "Penalty proceedings", "Audit", "Appeal", "Prosecution / compounding", "Other"];
const CSECT = {
  "Income Tax": ["142(1)", "143(1)(a)", "143(2)", "143(3)", "144", "148", "148A(b)", "148A(d)", "131", "133(6)", "133A", "132", "153A", "153C", "158BC (block)", "158BD (block)", "154", "156 (demand)", "263", "270A", "271(1)(c)", "271AAB", "274", "250 – CIT(A)", "253 – ITAT"],
  GST: ["61 – ASMT-10", "65 – audit", "66 – special audit", "67 – inspection / search", "73 – SCN", "74 – SCN", "74A – SCN", "76", "79 – recovery", "122 – penalty", "129 – detention", "130 – confiscation", "29 – cancellation (REG-17)", "DRC-01A", "107 – appeal"],
  "TDS / TCS": ["200A", "201", "206AB", "221", "234E", "271H", "272A(2)"],
  "ROC / MCA": ["206 – inspection", "207", "208", "454 – adjudication", "92", "137", "99"], "Customs / DGFT": [], Other: [] };
const CSTAT = ["Received", "Documents awaited", "Reply in progress", "Reply filed", "Adjournment sought", "Hearing fixed", "Order passed", "Appeal filed", "Closed"];
const CACTIVE = ["Received", "Documents awaited", "Reply in progress", "Adjournment sought", "Hearing fixed"];
const CEVT = ["Follow-up", "Reply filed", "Adjournment sought", "Adjournment granted", "Hearing attended", "Documents submitted", "Order received", "Note"];
const DOCST = ["Pending", "Requested", "Received"];
const DOCTPL = {
  "Scrutiny / reassessment": ["Notice copy", "ITR and computation", "Audited financials / tax audit report", "Bank statements", "Sales and purchase ledgers", "26AS / AIS / TIS reconciliation", "Capital account", "Loan confirmations"],
  "Search / survey": ["Panchnama copy", "Statement u/s 132(4) / 131 copy", "Inventory of seized material", "Copy of seized documents", "Bank statements – 6 years", "ITRs and computations – 6 years", "Books of accounts", "Asset and investment details", "Cash flow / source of cash"],
  "GST notice": ["Notice / SCN copy (DRC-01 / ASMT-10)", "GSTR-1 vs GSTR-3B reconciliation", "GSTR-2B vs books reconciliation", "Purchase invoices", "E-way bills", "Payment and challan proofs"],
  "Penalty / demand": ["Order copy", "Demand notice", "Challan / payment proof", "Rectification application"] };
const GACT = ["Search", "Survey", "Seizure", "Raid", "Inspection"];
const GROLE = ["Main person", "Company / firm", "Family member", "Associate concern", "Employee", "Other"];
const GMST = ["Covered in action", "Statement recorded", "Notice received", "Reply filed", "Assessment in progress", "Assessment completed", "Appeal", "Closed"];
const effDue = c => c.next || c.due || "";
const caseOpen = c => c.status !== "Closed";
const caseUrgent = c => CACTIVE.includes(c.status || "Received");
const caseOver = c => caseUrgent(c) && effDue(c) && effDue(c) < today();
const caseSoon = c => caseUrgent(c) && effDue(c) && effDue(c) >= today() && effDue(c) <= addDays(today(), 7);
const docCount = L => DOCST.map(s => (L || []).filter(d => d.st === s).length);
const docTxt = L => { const [p, r, d] = docCount(L); return (L || []).length ? `<span class="${p ? "red" : ""}">${p} pending</span> · ${r} requested · ${d} received` : '<span class="muted">—</span>'; };
const caseChip = c => { const s = c.status || "Received"; const cls = s === "Closed" || s === "Order passed" ? "green" : s === "Reply filed" || s === "Appeal filed" ? "blue" : caseOver(c) ? "red" : "amber"; return `<span class="chip ${cls}">${esc(s)}</span>`; };
const dueCell = c => { const d = effDue(c); if (!d) return '<span class="muted">—</span>'; const late = caseOver(c), soon = caseSoon(c);
  return `<b class="${late ? "red" : soon ? "" : ""}" style="${soon ? "color:var(--amber)" : ""}">${dmy(d)}</b>${late ? `<div class="small red">overdue ${Math.round((new Date(today()) - new Date(d)) / 864e5)}d</div>` : soon ? '<div class="small" style="color:var(--amber)">due soon</div>' : ""}${c.next && c.due && c.next !== c.due ? `<div class="small muted">adjourned from ${dmy(c.due)}</div>` : ""}`; };
const sgById = id => (S.db.sgroups || []).find(g => g.id === id);
const caseDesc = c => `${cname(c.client)} – ${c.dept} ${c.section ? "u/s " + c.section : ""}${c.ay ? " · " + c.ay : ""}`;

function viewCases() {
  setTitle("Notices & Cases");
  const f = S.f.cases = S.f.cases || { st: "open" }; const edit = can("cases");
  const ay = []; for (let y = new Date().getFullYear() + 1; y >= 2012; y--) ay.push(`AY ${y}-${String(y + 1).slice(2)}`);
  $("#view").innerHTML = `<p class="small muted" style="margin:0 0 10px">Every notice, assessment, appeal and penalty case with its section, dates, adjournments, follow-ups and documents. The due date follows the latest adjournment or hearing date.</p>
    <div id="csK"></div>
    <div class="toolbar"><input type="search" id="csQ" placeholder="Search client, section, DIN…" value="${esc(f.q || "")}">
      <select id="csSt"><option value="open" ${f.st === "open" ? "selected" : ""}>Open cases</option><option value="over" ${f.st === "over" ? "selected" : ""}>Overdue</option><option value="soon" ${f.st === "soon" ? "selected" : ""}>Due in 7 days</option><option value="fu" ${f.st === "fu" ? "selected" : ""}>Follow-up due</option><option value="closed" ${f.st === "closed" ? "selected" : ""}>Closed</option><option value="" ${!f.st ? "selected" : ""}>All</option>${CSTAT.map(s => `<option value="s:${esc(s)}" ${f.st === "s:" + s ? "selected" : ""}>Status: ${esc(s)}</option>`).join("")}</select>
      <select id="csD"><option value="">All departments</option>${CDEPT.map(d => `<option ${f.dept === d ? "selected" : ""}>${d}</option>`).join("")}</select>
      <select id="csC"><option value="">All clients</option>${filterOpts("client").map(([v, l]) => `<option value="${esc(v)}" ${f.client === v ? "selected" : ""}>${esc(l)}</option>`).join("")}</select>
      <select id="csA"><option value="">All staff</option>${(S.db.settings.staff || []).map(s => `<option value="${esc(s)}" ${f.as === s ? "selected" : ""}>${esc(ulabel(s))}</option>`).join("")}</select>
      <select id="csG"><option value="">Any group</option>${(S.db.sgroups || []).map(g => `<option value="${g.id}" ${f.g === g.id ? "selected" : ""}>${esc(g.name)}</option>`).join("")}</select>
      <span class="sp"></span><button class="btn" id="csVw">★ Views</button><button class="btn" id="csSG">🔎 Search / survey groups</button>${edit ? '<button class="btn primary" id="csAdd">＋ Add notice / case</button>' : ""}</div><div id="csT"></div>`;
  const all = () => vR("cases");
  const rows = () => all().filter(c => {
    const st = f.st || ""; if (st === "open" && !caseOpen(c)) return false; if (st === "closed" && caseOpen(c)) return false; if (st === "over" && !caseOver(c)) return false; if (st === "soon" && !caseSoon(c)) return false;
    if (st === "fu" && !(caseOpen(c) && c.follow && c.follow <= today())) return false; if (st.startsWith("s:") && (c.status || "Received") !== st.slice(2)) return false;
    if (f.dept && c.dept !== f.dept) return false; if (f.client && c.client !== f.client) return false; if (f.as && c.assigned !== f.as) return false; if (f.g && c.group !== f.g) return false;
    if (f.q) { const q = f.q.toLowerCase(); if (![cname(c.client), c.section, c.din, c.kind, c.ay, c.authority, c.remarks, c.gstin].some(v => (v || "").toLowerCase().includes(q))) return false; }
    return true; }).sort((a, b) => (caseOpen(b) - caseOpen(a)) || (effDue(a) || "9999").localeCompare(effDue(b) || "9999"));
  const draw = () => { const A = all().filter(caseOpen), R = rows();
    const k = (l, v, cls, st) => `<div class="kpi ${cls}" data-kst="${st}" style="cursor:pointer"><div class="l">${l}</div><div class="v">${v}</div></div>`;
    const docsP = A.reduce((a, c) => a + docCount(c.docs)[0], 0);
    $("#csK").innerHTML = `<div class="grid kpis" style="margin-bottom:12px">${k("Open cases", A.length, "", "open")}${k("Overdue", A.filter(caseOver).length, A.some(caseOver) ? "red" : "", "over")}${k("Due in 7 days", A.filter(caseSoon).length, "amber", "soon")}${k("Follow-ups due", A.filter(c => c.follow && c.follow <= today()).length, "", "fu")}${k("Documents pending", docsP, docsP ? "amber" : "", "open")}${k("Search / survey groups", (S.db.sgroups || []).filter(g => g.status !== "Closed").length, "", "sg")}</div>`;
    $$("[data-kst]").forEach(x => x.onclick = () => { if (x.dataset.kst === "sg") return go("sgroups"); f.st = x.dataset.kst; $("#csSt").value = f.st; draw(); });
    $("#csT").innerHTML = R.length ? `<div class="tablewrap"><table class="t"><thead><tr><th>Client</th><th>Department · section</th><th>Case</th><th>Notice ref / DIN</th><th>Issued</th><th>Due / next date</th><th>Status</th><th>Follow-up</th><th>Documents</th><th>Handled by</th></tr></thead><tbody>
      ${R.map(c => { const g = c.group && sgById(c.group); return `<tr data-id="${c.id}" style="cursor:pointer"><td><b>${esc(cname(c.client))}</b>${c.gstin ? `<div class="small muted">${esc(c.gstin)}</div>` : ""}${g ? `<div><span class="chip blue" title="Search / survey group">🔎 ${esc(g.name)}</span></div>` : ""}</td>
        <td>${esc(c.dept)}${c.section ? `<div><b>u/s ${esc(c.section)}</b></div>` : ""}</td><td>${esc(c.kind || "")}${c.ay ? `<div class="small muted">${esc(c.ay)}</div>` : ""}</td>
        <td class="small" style="font-family:Consolas,monospace">${esc(c.din || "")}</td><td>${c.issue ? dmy(c.issue) : "—"}</td><td>${dueCell(c)}</td><td>${caseChip(c)}</td>
        <td>${c.follow ? `<span class="${caseOpen(c) && c.follow <= today() ? "red" : ""}">${dmy(c.follow)}</span>` : '<span class="muted">—</span>'}</td><td class="small">${docTxt(c.docs)}</td><td>${esc(uname(c.assigned))}</td></tr>`; }).join("")}</tbody></table></div>`
      : `<div class="tablewrap"><div class="empty">No notices or cases here.${edit ? " Use <b>＋ Add notice / case</b>." : ""}</div></div>`;
    $$("#csT tr[data-id]").forEach(tr => tr.onclick = () => caseDialog(S.db.cases.find(c => c.id === tr.dataset.id), {}, draw)); };
  const bind = (id, k, ev = "change") => $(id).addEventListener(ev, e => { f[k] = e.target.value; draw(); });
  bind("#csQ", "q", "input"); bind("#csSt", "st"); bind("#csD", "dept"); bind("#csC", "client"); bind("#csA", "as"); bind("#csG", "g");
  $("#csSG").onclick = () => go("sgroups"); $("#csVw").onclick = e => viewsMenu(e.currentTarget, "cases"); if ($("#csAdd")) $("#csAdd").onclick = () => caseDialog(null, {}, draw);
  draw();
}

function docEditor(box, L, ro) {
  const draw = () => { box.innerHTML = `${L.length ? `<table class="t" style="margin-bottom:6px"><thead><tr><th>Document</th><th style="width:150px">Status</th><th style="width:150px">Date</th><th style="width:40px"></th></tr></thead><tbody>${L.map((d, i) => `<tr>
      <td>${ro ? esc(d.name) : `<input data-dn="${i}" value="${esc(d.name)}" maxlength="150" style="width:100%;border:1px solid #cfd5df;border-radius:6px;padding:4px 7px">`}</td>
      <td>${ro ? esc(d.st) : `<select data-ds="${i}" style="width:100%">${DOCST.map(s => `<option ${d.st === s ? "selected" : ""}>${s}</option>`).join("")}</select>`}</td>
      <td>${ro ? (d.date ? dmy(d.date) : "") : `<input type="date" data-dd="${i}" value="${esc(d.date || "")}" style="width:100%">`}</td><td>${ro ? "" : `<button type="button" class="btn sm ib" data-dx="${i}" aria-label="Remove document" title="Remove">✕</button>`}</td></tr>`).join("")}</tbody></table>` : '<p class="small muted" style="margin:4px 0 8px">No documents listed yet.</p>'}
    ${ro ? "" : `<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center"><input class="dnew" placeholder="Add a document, e.g. Bank statement FY 2023-24" maxlength="150" style="flex:1;min-width:220px;border:1px solid #cfd5df;border-radius:6px;padding:5px 8px"><button type="button" class="btn sm dadd">＋ Add</button>
      <select class="dtpl" style="width:auto"><option value="">Add a checklist…</option>${Object.keys(DOCTPL).map(k => `<option>${esc(k)}</option>`).join("")}</select></div>`}`;
    if (ro) return;
    $$("[data-dn]", box).forEach(x => x.oninput = () => L[+x.dataset.dn].name = x.value);
    $$("[data-ds]", box).forEach(x => x.onchange = () => { const d = L[+x.dataset.ds]; d.st = x.value; if (!d.date || x.value !== "Pending") d.date = today(); draw(); });
    $$("[data-dd]", box).forEach(x => x.onchange = () => L[+x.dataset.dd].date = x.value);
    $$("[data-dx]", box).forEach(x => x.onclick = () => { L.splice(+x.dataset.dx, 1); draw(); });
    const add = () => { const v = $(".dnew", box).value.trim(); if (!v) return; L.push({ id: uid(), name: v, st: "Pending", date: "" }); draw(); $(".dnew", box).focus(); };
    $(".dadd", box).onclick = add; $(".dnew", box).onkeydown = e => { if (e.key === "Enter") { e.preventDefault(); add(); } };
    $(".dtpl", box).onchange = e => { (DOCTPL[e.target.value] || []).forEach(n => { if (!L.some(d => d.name.toLowerCase() === n.toLowerCase())) L.push({ id: uid(), name: n, st: "Pending", date: "" }); }); draw(); }; };
  draw();
}

function caseDialog(rec, pre = {}, after) {
  const edit = can("cases"); if (!rec && !edit) return toast("You do not have the right to add cases");
  const r = JSON.parse(JSON.stringify(rec || { dept: "Income Tax", status: "Received", kind: "Notice / information sought", assigned: S.user, ...pre }));
  r.docs = r.docs || []; r.events = r.events || [];
  const cl = vC().slice().sort((a, b) => a.name.localeCompare(b.name)); const ro = !edit;
  const ay = []; for (let y = new Date().getFullYear() + 1; y >= 2012; y--) ay.push(`AY ${y}-${String(y + 1).slice(2)}`);
  const m = openModal(`<div class="mhead"><h3>${rec ? "Notice / case" : "＋ New notice / case"}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody" style="max-height:calc(100vh - 230px)">
    <div class="fgrid">
      <div class="field"><label class="req" for="ceC">Client</label><select id="ceC" ${ro ? "disabled" : ""}><option value="">— select client —</option>${cl.map(c => `<option value="${c.id}" ${c.id === r.client ? "selected" : ""}>${esc(c.name)} (${esc(c.code)})</option>`).join("")}</select>${ro ? "" : '<button type="button" class="link small" id="ceNC">＋ new client</button>'}</div>
      <div class="field" id="ceGF"><label for="ceGst">GSTIN</label><select id="ceGst"></select></div>
      <div class="field"><label class="req" for="ceD">Department</label><select id="ceD">${CDEPT.map(d => `<option ${r.dept === d ? "selected" : ""}>${d}</option>`).join("")}</select></div>
      <div class="field"><label for="ceS">Section</label><input id="ceS" list="ceSL" maxlength="60" value="${esc(r.section || "")}" placeholder="e.g. 143(2), 148A(b), 74"><datalist id="ceSL"></datalist></div>
      <div class="field"><label for="ceK">Type of case</label><select id="ceK">${CKIND.map(k => `<option ${r.kind === k ? "selected" : ""}>${k}</option>`).join("")}</select></div>
      <div class="field"><label for="ceAY">AY / FY / period</label><input id="ceAY" list="ceAYL" maxlength="40" value="${esc(r.ay || "")}" placeholder="e.g. AY 2024-25, or block AY 2019-20 to 2025-26"><datalist id="ceAYL">${ay.map(a => `<option>${a}</option>`).join("")}</datalist></div>
      <div class="field"><label for="ceDin">Notice no. / DIN / reference</label><input id="ceDin" maxlength="80" value="${esc(r.din || "")}"></div>
      <div class="field"><label for="ceAu">Issued by (AO / ward / officer)</label><input id="ceAu" maxlength="120" value="${esc(r.authority || "")}" placeholder="e.g. ITO Ward 2(1), Faridabad"></div>
      <div class="field"><label for="ceI">Issue date</label><input type="date" id="ceI" value="${esc(r.issue || "")}"></div>
      <div class="field"><label class="req" for="ceDu">Reply / compliance due date</label><input type="date" id="ceDu" value="${esc(r.due || "")}"></div>
      <div class="field"><label for="ceNx">Current next date (after adjournment / hearing)</label><input type="date" id="ceNx" value="${esc(r.next || "")}"></div>
      <div class="field"><label for="ceSt">Status</label><select id="ceSt">${CSTAT.map(s => `<option ${(r.status || "Received") === s ? "selected" : ""}>${s}</option>`).join("")}</select></div>
      <div class="field"><label for="ceFu">Next follow-up (internal)</label><input type="date" id="ceFu" value="${esc(r.follow || "")}"></div>
      <div class="field"><label for="ceAs">Handled by</label><select id="ceAs"><option value=""></option>${(S.db.settings.staff || []).map(s => `<option value="${esc(s)}" ${r.assigned === s ? "selected" : ""}>${esc(ulabel(s))}</option>`).join("")}</select></div>
      <div class="field"><label for="ceAmt">Amount involved / demand (₹)</label><input type="number" min="0" step="1" id="ceAmt" value="${esc(r.amount || "")}"></div>
      <div class="field"><label for="ceG">Search / survey group</label><select id="ceG"><option value="">— none —</option>${(S.db.sgroups || []).map(g => `<option value="${g.id}" ${r.group === g.id ? "selected" : ""}>${esc(g.name)}</option>`).join("")}</select></div>
      <div class="field full"><label for="ceR">Remarks</label><textarea id="ceR" maxlength="2000" placeholder="Issues raised, additions proposed, strategy…">${esc(r.remarks || "")}</textarea></div></div>
    <h4 style="margin:14px 0 6px">Proceedings, adjournments and follow-ups</h4><div id="ceEv"></div>
    <h4 style="margin:14px 0 6px">Documents</h4><div id="ceDoc"></div><div class="err" id="ceE"></div></div>
    <div class="mfoot">${rec && (isAdmin() || can("delete")) ? '<button class="btn danger" id="ceDel">Delete</button>' : ""}<span class="small muted">${rec ? `Added by ${esc(uname(rec.createdBy))} on ${dmy((rec.createdAt || "").slice(0, 10))}${rec.updatedAt ? ` · edited by ${esc(uname(rec.updatedBy))} on ${dmy(rec.updatedAt.slice(0, 10))}` : ""}` : ""}</span><span class="sp"></span><button class="btn" id="ceX">${ro ? "Close" : "Cancel"}</button>${ro ? "" : '<button class="btn primary" id="ceY">Save</button>'}</div>`);
  m.querySelector(".mbox").style.maxWidth = "1000px";
  if (ro) $$("input,select,textarea", $(".fgrid", m)).forEach(x => x.disabled = true);
  const gst = () => { const G = gstsOf(clientById($("#ceC", m).value)); $("#ceGF", m).hidden = !G.length || $("#ceD", m).value !== "GST";
    $("#ceGst", m).innerHTML = `<option value="">—</option>` + G.map(x => `<option value="${esc(x.g)}" ${r.gstin === x.g ? "selected" : ""}>${esc(gstLbl(x))}</option>`).join(""); };
  const sect = () => $("#ceSL", m).innerHTML = (CSECT[$("#ceD", m).value] || []).map(s => `<option>${esc(s)}</option>`).join("");
  $("#ceC", m).onchange = gst; $("#ceD", m).onchange = () => { gst(); sect(); }; gst(); sect();
  if ($("#ceNC", m)) $("#ceNC", m).onclick = () => quickClient($("#ceC", m));
  const evBox = $("#ceEv", m);
  const drawEv = () => { const E = r.events.slice().sort((a, b) => b.date.localeCompare(a.date));
    evBox.innerHTML = `${E.length ? `<table class="t" style="margin-bottom:6px"><thead><tr><th style="width:110px">Date</th><th>What happened</th><th style="width:120px">Next date</th><th>Remarks</th><th style="width:110px">By</th><th style="width:40px"></th></tr></thead><tbody>${E.map(e => `<tr><td>${dmy(e.date)}</td><td><b>${esc(e.type)}</b></td><td>${e.next ? dmy(e.next) : ""}</td><td class="small" style="white-space:normal">${esc(e.remarks || "")}</td><td class="small">${esc(uname(e.by))}</td><td>${ro ? "" : `<button type="button" class="btn sm ib" data-ex="${e.id}" aria-label="Remove entry" title="Remove">✕</button>`}</td></tr>`).join("")}</tbody></table>` : '<p class="small muted" style="margin:4px 0 8px">Nothing recorded yet.</p>'}
      ${ro ? "" : `<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:flex-end"><div><div class="small muted">Date</div><input type="date" class="evD" value="${today()}"></div>
        <div><div class="small muted">What happened</div><select class="evT" style="width:auto">${CEVT.map(t => `<option>${t}</option>`).join("")}</select></div>
        <div><div class="small muted">Next date (if any)</div><input type="date" class="evN"></div>
        <div style="flex:1;min-width:200px"><div class="small muted">Remarks</div><input class="evR" maxlength="500" style="width:100%;border:1px solid #cfd5df;border-radius:6px;padding:5px 8px" placeholder="e.g. Adjourned at request; AO asked for bank statements"></div>
        <button type="button" class="btn sm primary evAdd">＋ Add entry</button></div>`}`;
    $$("[data-ex]", evBox).forEach(b => b.onclick = () => { r.events = r.events.filter(e => e.id !== b.dataset.ex); drawEv(); });
    if (ro) return;
    $(".evAdd", evBox).onclick = () => { const e = { id: uid(), date: $(".evD", evBox).value || today(), type: $(".evT", evBox).value, next: $(".evN", evBox).value, remarks: $(".evR", evBox).value.trim(), by: S.user, at: new Date().toISOString() };
      r.events.push(e);
      if (e.next) { $("#ceNx", m).value = e.next; }
      const st = $("#ceSt", m); const map = { "Reply filed": "Reply filed", "Adjournment sought": "Adjournment sought", "Adjournment granted": "Hearing fixed", "Order received": "Order passed", "Hearing attended": e.next ? "Hearing fixed" : st.value, "Documents submitted": st.value };
      if (map[e.type]) st.value = map[e.type];
      if (e.type === "Follow-up" && e.next) $("#ceFu", m).value = e.next;
      drawEv(); toast("Entry added – click Save to keep it"); }; };
  drawEv(); docEditor($("#ceDoc", m), r.docs, ro);
  $("#mx", m).onclick = $("#ceX", m).onclick = closeModal;
  if ($("#ceY", m)) $("#ceY", m).onclick = () => { const E = $("#ceE", m);
    const o = { client: $("#ceC", m).value, gstin: $("#ceGF", m).hidden ? "" : $("#ceGst", m).value, dept: $("#ceD", m).value, section: $("#ceS", m).value.trim(), kind: $("#ceK", m).value, ay: $("#ceAY", m).value.trim(), din: $("#ceDin", m).value.trim(),
      authority: $("#ceAu", m).value.trim(), issue: $("#ceI", m).value, due: $("#ceDu", m).value, next: $("#ceNx", m).value, status: $("#ceSt", m).value, follow: $("#ceFu", m).value, assigned: $("#ceAs", m).value, amount: $("#ceAmt", m).value, group: $("#ceG", m).value, remarks: $("#ceR", m).value.trim() };
    if (!o.client) return E.textContent = "Select the client."; if (!o.due && !o.next) return E.textContent = "Enter the due date (or the next hearing date).";
    if (o.issue && o.due && o.due < o.issue) return E.textContent = "The due date is before the issue date.";
    r.docs = r.docs.filter(d => d.name.trim()); const now = new Date().toISOString(); S.db.cases = S.db.cases || [];
    if (o.group) { const g = sgById(o.group); if (g && !g.members.some(x => x.client === o.client)) g.members.push({ client: o.client, role: "Other", st: "Notice received", remarks: "", docs: [] }); }
    if (rec) { Object.assign(rec, o, { docs: r.docs, events: r.events, updatedBy: S.user, updatedAt: now }); log("Edited", "Notice / case", caseDesc(rec)); }
    else { const n = { id: uid(), ...o, docs: r.docs, events: r.events, createdBy: S.user, createdAt: now }; S.db.cases.push(n); log("Added", "Notice / case", caseDesc(n)); }
    save(); closeModal(); toast("Saved"); (after || (() => go(S.route)))(); };
  if ($("#ceDel", m)) $("#ceDel", m).onclick = async () => { if (!(await confirmBox("Delete case", `<p>Delete <b>${esc(caseDesc(rec))}</b> with its proceedings and document list?</p>`, "Delete"))) return;
    S.db.cases = S.db.cases.filter(x => x.id !== rec.id); log("Deleted", "Notice / case", caseDesc(rec)); save(); toast("Deleted"); (after || (() => go(S.route)))(); };
}

/* ---------------- search / survey groups */
function viewSGroups() {
  setTitle("Search / Survey Groups"); const edit = can("cases"); const f = S.f.sgroups = S.f.sgroups || { st: "Active" };
  $("#view").innerHTML = `<p class="small muted" style="margin:0 0 10px">Group every person and concern covered in one search, survey, seizure or raid. Track each member's status, notices, due dates and documents in one place.</p>
    <div class="toolbar"><input type="search" id="sgQ" placeholder="Search group or member…" value="${esc(f.q || "")}"><select id="sgS"><option value="Active" ${f.st === "Active" ? "selected" : ""}>Active groups</option><option value="Closed" ${f.st === "Closed" ? "selected" : ""}>Closed groups</option><option value="" ${!f.st ? "selected" : ""}>All groups</option></select>
      <span class="sp"></span><button class="btn" id="sgB">⚖ Notices & Cases</button>${edit ? '<button class="btn primary" id="sgAdd">＋ New group</button>' : ""}</div><div id="sgT"></div>`;
  const draw = () => { const G = (S.db.sgroups || []).filter(g => (!f.st || (g.status || "Active") === f.st) && (!f.q || [g.name, g.section, g.authority, ...g.members.map(x => cname(x.client))].some(v => (v || "").toLowerCase().includes(f.q.toLowerCase()))))
      .sort((a, b) => (b.date || "").localeCompare(a.date || ""));
    $("#sgT").innerHTML = G.length ? `<div class="tablewrap"><table class="t"><thead><tr><th>Group</th><th>Action</th><th>Date of action</th><th class="num">Members</th><th class="num">Open notices</th><th>Next due</th><th>Documents</th><th>Status</th></tr></thead><tbody>${G.map(g => { const cs = vR("cases").filter(c => c.group === g.id), op = cs.filter(caseOpen), nd = op.map(effDue).filter(Boolean).sort()[0];
        const docs = [...g.members.flatMap(x => x.docs || []), ...cs.flatMap(c => c.docs || [])];
        return `<tr data-id="${g.id}" style="cursor:pointer"><td><b>${esc(g.name)}</b><div class="small muted">${esc(g.dept || "")}${g.authority ? " · " + esc(g.authority) : ""}</div></td><td>${esc(g.action)}${g.section ? `<div class="small">u/s ${esc(g.section)}</div>` : ""}</td><td>${g.date ? dmy(g.date) : "—"}</td>
          <td class="num">${g.members.filter(x => showC(x.client)).length}</td><td class="num">${op.length}${op.some(caseOver) ? ` <span class="chip red">${op.filter(caseOver).length} overdue</span>` : ""}</td><td>${nd ? dmy(nd) : "—"}</td><td class="small">${docTxt(docs)}</td><td><span class="chip ${g.status === "Closed" ? "green" : "amber"}">${esc(g.status || "Active")}</span></td></tr>`; }).join("")}</tbody></table></div>`
      : `<div class="tablewrap"><div class="empty">No groups yet.${edit ? " Use <b>＋ New group</b> to record a search, survey or raid." : ""}</div></div>`;
    $$("#sgT tr[data-id]").forEach(tr => tr.onclick = () => go("sgroup:" + tr.dataset.id)); };
  $("#sgQ").oninput = e => { f.q = e.target.value; draw(); }; $("#sgS").onchange = e => { f.st = e.target.value; draw(); };
  $("#sgB").onclick = () => go("cases"); if ($("#sgAdd")) $("#sgAdd").onclick = () => sgDialog(null);
  draw();
}
function sgDialog(g) {
  const r = g ? { ...g } : { action: "Search", dept: "Income Tax", status: "Active", section: "132", date: "" };
  const m = openModal(`<div class="mhead"><h3>${g ? "Edit group" : "＋ New search / survey group"}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody"><div class="fgrid">
    <div class="field full"><label class="req" for="sgN">Group name</label><input id="sgN" maxlength="120" value="${esc(r.name || "")}" placeholder="e.g. Aggarwal Group – search 14-08-2026"></div>
    <div class="field"><label for="sgA">Action</label><select id="sgA">${GACT.map(a => `<option ${r.action === a ? "selected" : ""}>${a}</option>`).join("")}</select></div>
    <div class="field"><label for="sgD">Department</label><select id="sgD">${CDEPT.map(d => `<option ${r.dept === d ? "selected" : ""}>${d}</option>`).join("")}</select></div>
    <div class="field"><label for="sgSe">Section</label><input id="sgSe" list="sgSL" maxlength="60" value="${esc(r.section || "")}"><datalist id="sgSL">${["132", "132A", "133A", "131", "153A", "153C", "158BC", "67 (GST)", "71 (GST)", "Customs 105"].map(s => `<option>${s}</option>`).join("")}</datalist></div>
    <div class="field"><label for="sgDt">Date of action</label><input type="date" id="sgDt" value="${esc(r.date || "")}"></div>
    <div class="field"><label for="sgAu">Authority / officer</label><input id="sgAu" maxlength="120" value="${esc(r.authority || "")}" placeholder="e.g. DDIT (Inv.) Unit 3, Delhi"></div>
    <div class="field"><label for="sgSt">Status</label><select id="sgSt">${["Active", "Closed"].map(s => `<option ${(r.status || "Active") === s ? "selected" : ""}>${s}</option>`).join("")}</select></div>
    <div class="field full"><label for="sgR">Remarks</label><textarea id="sgR" maxlength="2000" placeholder="Premises covered, cash / jewellery seized, statements recorded…">${esc(r.remarks || "")}</textarea></div></div><div class="err" id="sgE"></div></div>
    <div class="mfoot">${g && (isAdmin() || can("delete")) ? '<button class="btn danger" id="sgDel">Delete group</button>' : ""}<span class="sp"></span><button class="btn" id="sgX">Cancel</button><button class="btn primary" id="sgY">Save</button></div>`);
  $("#mx", m).onclick = $("#sgX", m).onclick = closeModal;
  $("#sgY", m).onclick = () => { const o = { name: $("#sgN", m).value.trim(), action: $("#sgA", m).value, dept: $("#sgD", m).value, section: $("#sgSe", m).value.trim(), date: $("#sgDt", m).value, authority: $("#sgAu", m).value.trim(), status: $("#sgSt", m).value, remarks: $("#sgR", m).value.trim() };
    if (!o.name) return $("#sgE", m).textContent = "Enter a name for the group."; const now = new Date().toISOString(); S.db.sgroups = S.db.sgroups || [];
    if (g) { Object.assign(g, o, { updatedBy: S.user, updatedAt: now }); log("Edited", "Search group", g.name); save(); closeModal(); viewSGroup(g.id); }
    else { const n = { id: uid(), ...o, members: [], createdBy: S.user, createdAt: now }; S.db.sgroups.push(n); log("Added", "Search group", n.name); save(); closeModal(); go("sgroup:" + n.id); } };
  if ($("#sgDel", m)) $("#sgDel", m).onclick = async () => { const n = (S.db.cases || []).filter(c => c.group === g.id).length;
    if (!(await confirmBox("Delete group", `<p>Delete the group <b>${esc(g.name)}</b>?</p><p>${n} notice(s) linked to it stay in Notices & Cases, without the group.</p>`, "Delete"))) return;
    (S.db.cases || []).forEach(c => { if (c.group === g.id) c.group = ""; }); S.db.sgroups = S.db.sgroups.filter(x => x.id !== g.id); log("Deleted", "Search group", g.name); save(); go("sgroups"); };
}
function viewSGroup(id) {
  const g = sgById(id); if (!g) return go("sgroups"); setTitle(g.name); const edit = can("cases");
  const cs = () => vR("cases").filter(c => c.group === g.id);
  const draw = () => { const C = cs(), op = C.filter(caseOpen), M = g.members.filter(x => showC(x.client));
    const allDocs = [...M.flatMap(x => x.docs || []), ...C.flatMap(c => c.docs || [])], [dp, dr, dd] = docCount(allDocs);
    const k = (l, v, cls = "") => `<div class="kpi ${cls}" style="cursor:default"><div class="l">${l}</div><div class="v">${v}</div></div>`;
    $("#view").innerHTML = `<div class="toolbar"><button class="btn" id="sgBack">← All groups</button><span class="sp"></span>${edit ? '<button class="btn" id="sgEd">✎ Edit group</button><button class="btn" id="sgPr">🖨 Print status</button><button class="btn primary" id="sgAddM">＋ Add members</button>' : '<button class="btn" id="sgPr">🖨 Print status</button>'}</div>
      <div class="card" style="margin-bottom:12px"><div style="display:flex;gap:20px;flex-wrap:wrap"><div><div class="small muted">Action</div><b>${esc(g.action)}${g.section ? " u/s " + esc(g.section) : ""}</b></div><div><div class="small muted">Department</div><b>${esc(g.dept || "")}</b></div>
        <div><div class="small muted">Date of action</div><b>${g.date ? dmy(g.date) : "—"}</b></div><div><div class="small muted">Authority</div><b>${esc(g.authority || "—")}</b></div><div><div class="small muted">Status</div><span class="chip ${g.status === "Closed" ? "green" : "amber"}">${esc(g.status || "Active")}</span></div></div>
        ${g.remarks ? `<p class="small" style="margin:10px 0 0;white-space:pre-wrap">${esc(g.remarks)}</p>` : ""}</div>
      <div class="grid kpis" style="margin-bottom:12px">${k("Members", M.length)}${k("Open notices", op.length)}${k("Overdue", op.filter(caseOver).length, op.some(caseOver) ? "red" : "")}${k("Next due", op.map(effDue).filter(Boolean).sort()[0] ? dmy(op.map(effDue).filter(Boolean).sort()[0]) : "—")}${k("Docs pending", dp, dp ? "amber" : "")}${k("Docs requested", dr)}${k("Docs received", dd, "green")}</div>
      ${M.length ? `<div class="tablewrap"><table class="t"><thead><tr><th>Member</th><th style="width:160px">Role</th><th style="width:190px">Status</th><th>Notices (section · issued · due · status)</th><th>Documents</th><th></th></tr></thead><tbody>${M.map((x, i) => { const mc = C.filter(c => c.client === x.client).sort((a, b) => (effDue(a) || "").localeCompare(effDue(b) || "")); const docs = [...(x.docs || []), ...mc.flatMap(c => c.docs || [])];
        return `<tr data-m="${i}"><td><b>${esc(cname(x.client))}</b><div class="small muted">${esc((clientById(x.client) || {}).code || "")} · ${esc((clientById(x.client) || {}).pan || "")}</div>${x.remarks ? `<div class="small">${esc(x.remarks)}</div>` : ""}</td>
          <td>${edit ? `<select class="mRole" style="width:100%;min-width:150px">${GROLE.map(o => `<option ${x.role === o ? "selected" : ""}>${o}</option>`).join("")}</select>` : esc(x.role)}</td>
          <td>${edit ? `<select class="mSt" style="width:100%;min-width:180px">${GMST.map(o => `<option ${x.st === o ? "selected" : ""}>${o}</option>`).join("")}</select>` : esc(x.st)}</td>
          <td>${mc.length ? mc.map(c => `<div class="mCase" data-c="${c.id}" style="cursor:pointer;padding:3px 0;border-bottom:1px dashed var(--line)"><b>${esc(c.section ? "u/s " + c.section : c.kind)}</b>${c.ay ? ` <span class="small muted">${esc(c.ay)}</span>` : ""} · <span class="small">issued ${c.issue ? dmy(c.issue) : "—"}</span> · <span class="small ${caseOver(c) ? "red" : ""}">due ${effDue(c) ? dmy(effDue(c)) : "—"}</span> ${caseChip(c)}</div>`).join("") : '<span class="muted small">No notice yet</span>'}
            ${edit ? `<button type="button" class="link small mNew">＋ notice</button>` : ""}</td>
          <td class="small">${docTxt(docs)}<div><button type="button" class="link small mDocs">${edit ? "Member documents" : "View documents"} (${(x.docs || []).length})</button></div></td>
          <td>${edit ? `<button type="button" class="btn sm ib mRm" aria-label="Remove member" title="Remove from group">✕</button>` : ""}</td></tr>`; }).join("")}</tbody></table></div>`
        : `<div class="tablewrap"><div class="empty">No members yet.${edit ? " Use <b>＋ Add members</b> to add every person and concern covered." : ""}</div></div>`}`;
    $("#sgBack").onclick = () => go("sgroups"); $("#sgPr").onclick = () => sgPrint(g);
    if (edit) { $("#sgEd").onclick = () => sgDialog(g); $("#sgAddM").onclick = () => sgAddMembers(g, draw); }
    $$("#view tr[data-m]").forEach(tr => { const x = M[+tr.dataset.m];
      $$(".mCase", tr).forEach(d => d.onclick = () => caseDialog(S.db.cases.find(c => c.id === d.dataset.c), {}, draw));
      if ($(".mDocs", tr)) $(".mDocs", tr).onclick = () => sgMemberDocs(g, x, draw);
      if (!edit) return;
      $(".mRole", tr).onchange = e => { x.role = e.target.value; save(); };
      $(".mSt", tr).onchange = e => { x.st = e.target.value; log("Edited", "Search group", `${g.name}: ${cname(x.client)} – ${x.st}`); save(); };
      $(".mNew", tr).onclick = () => caseDialog(null, { client: x.client, group: g.id, dept: g.dept || "Income Tax", kind: g.action === "Survey" ? "Notice / information sought" : "Search / block assessment", section: g.dept === "Income Tax" && g.action === "Search" ? "158BC (block)" : "", status: "Received" }, draw);
      $(".mRm", tr).onclick = async () => { const n = C.filter(c => c.client === x.client).length; if (!(await confirmBox("Remove member", `<p>Remove <b>${esc(cname(x.client))}</b> from this group?${n ? ` Their ${n} notice(s) stay in Notices & Cases.` : ""}</p>`, "Remove"))) return viewSGroup(g.id);
        g.members = g.members.filter(y => y !== x); C.filter(c => c.client === x.client).forEach(c => c.group = ""); log("Edited", "Search group", `${g.name}: removed ${cname(x.client)}`); save(); viewSGroup(g.id); }; }); };
  draw();
}
function sgAddMembers(g, after) {
  const have = new Set(g.members.map(x => x.client)); const cl = vC().filter(c => !have.has(c.id)).sort((a, b) => a.name.localeCompare(b.name));
  const m = openModal(`<div class="mhead"><h3>Add members – ${esc(g.name)}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p class="small muted" style="margin-top:0">Tick everyone covered. A person or concern who is not yet a client can be added with ＋ New client.</p>
    <div style="display:flex;gap:6px;margin-bottom:6px"><input id="amQ" placeholder="filter clients…" style="flex:1"><select id="amR" style="width:auto">${GROLE.map(o => `<option>${o}</option>`).join("")}</select><button type="button" class="btn sm" id="amNC">＋ New client</button></div>
    <select id="amHid" hidden><option value=""></option></select>
    <div class="picklist" id="amL" style="max-height:340px">${cl.map(c => `<label data-n="${esc((c.name + " " + c.code + " " + (c.group || "")).toLowerCase())}"><input type="checkbox" value="${c.id}"> ${esc(c.name)} <span class="small muted">${esc(c.code)} · ${esc(c.type || "")}${c.group ? " · " + esc(c.group) : ""}</span></label>`).join("") || '<p class="muted">Every client is already in this group.</p>'}</div>
    <div class="err" id="amE"></div></div><div class="mfoot"><span class="small muted">Role for the ticked members:</span><span class="sp"></span><button class="btn" id="amX">Cancel</button><button class="btn primary" id="amY">Add to group</button></div>`);
  $("#mx", m).onclick = $("#amX", m).onclick = () => { closeModal(); after(); };
  $("#amQ", m).oninput = e => $$("#amL label", m).forEach(l => l.hidden = !l.dataset.n.includes(e.target.value.toLowerCase()));
  const hid = $("#amHid", m); hid.addEventListener("change", () => { const id = hid.value; if (!id) return; const c = clientById(id);
    $("#amL", m).insertAdjacentHTML("afterbegin", `<label data-n="${esc(c.name.toLowerCase())}"><input type="checkbox" value="${c.id}" checked> ${esc(c.name)} <span class="small muted">${esc(c.code)} · new</span></label>`); });
  $("#amNC", m).onclick = () => quickClient(hid);
  $("#amY", m).onclick = () => { const ids = $$("#amL input:checked", m).map(x => x.value); if (!ids.length) return $("#amE", m).textContent = "Tick at least one client.";
    const role = $("#amR", m).value; ids.forEach(id => { if (!g.members.some(x => x.client === id)) g.members.push({ client: id, role, st: "Covered in action", remarks: "", docs: [] }); });
    log("Edited", "Search group", `${g.name}: added ${ids.length} member(s)`); save(); closeModal(); toast(`${ids.length} member(s) added`); viewSGroup(g.id); };
}
function sgMemberDocs(g, x, after) {
  const L = JSON.parse(JSON.stringify(x.docs || [])), edit = can("cases"); const C = vR("cases").filter(c => c.group === g.id && c.client === x.client);
  const m = openModal(`<div class="mhead"><h3>Documents – ${esc(cname(x.client))}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody" style="max-height:calc(100vh - 230px)">
    <p class="small muted" style="margin-top:0">Documents for this member in the ${esc(g.action.toLowerCase())} – seized papers, statements, records asked for or received. Documents for a particular notice are kept in that notice.</p>
    <div class="field"><label for="mdR">Remarks for this member</label><input id="mdR" maxlength="300" value="${esc(x.remarks || "")}" ${edit ? "" : "disabled"}></div><div id="mdL"></div>
    ${C.length ? `<h4 style="margin:14px 0 6px">In this member's notices</h4>${C.map(c => `<div class="small" style="margin-bottom:4px"><b>${esc(c.section ? "u/s " + c.section : c.kind)}</b> – ${docTxt(c.docs)}</div>`).join("")}` : ""}</div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="mdX">${edit ? "Cancel" : "Close"}</button>${edit ? '<button class="btn primary" id="mdY">Save</button>' : ""}</div>`);
  m.querySelector(".mbox").style.maxWidth = "860px"; docEditor($("#mdL", m), L, !edit);
  $("#mx", m).onclick = $("#mdX", m).onclick = () => { closeModal(); after(); };
  if ($("#mdY", m)) $("#mdY", m).onclick = () => { x.docs = L.filter(d => d.name.trim()); x.remarks = $("#mdR", m).value.trim(); log("Edited", "Search group", `${g.name}: documents of ${cname(x.client)}`); save(); closeModal(); toast("Saved"); viewSGroup(g.id); };
}
function sgPrint(g) {
  const C = vR("cases").filter(c => c.group === g.id), M = g.members.filter(x => showC(x.client)); const firm = S.db.settings.firm || {};
  const html = `<!doctype html><html><head><meta charset="utf-8"><title>${esc(g.name)}</title><style>body{font:12px Arial,sans-serif;color:#111;margin:24px}h1{font-size:18px;margin:0}h2{font-size:14px;margin:18px 0 6px}table{border-collapse:collapse;width:100%}th,td{border:1px solid #bbb;padding:5px 6px;text-align:left;vertical-align:top}th{background:#eee}.m{color:#555}</style></head><body>
    <div class="m">${esc(firm.name || "")}</div><h1>${esc(g.name)}</h1><div class="m">${esc(g.action)}${g.section ? " u/s " + esc(g.section) : ""} · ${esc(g.dept || "")} · ${g.date ? dmy(g.date) : ""} · ${esc(g.authority || "")} · Status as on ${dmy(today())}</div>
    <h2>Members</h2><table><tr><th>Member</th><th>Role</th><th>Status</th><th>Notices</th><th>Documents</th></tr>${M.map(x => { const mc = C.filter(c => c.client === x.client); const docs = [...(x.docs || []), ...mc.flatMap(c => c.docs || [])]; const [p, r, d] = docCount(docs);
      return `<tr><td>${esc(cname(x.client))}</td><td>${esc(x.role)}</td><td>${esc(x.st)}</td><td>${mc.map(c => `${esc(c.section ? "u/s " + c.section : c.kind)} ${esc(c.ay || "")} – issued ${c.issue ? dmy(c.issue) : "—"}, due ${effDue(c) ? dmy(effDue(c)) : "—"}, ${esc(c.status || "")}`).join("<br>") || "—"}</td><td>${p} pending, ${r} requested, ${d} received${docs.filter(z => z.st !== "Received").length ? "<br><span class='m'>" + docs.filter(z => z.st !== "Received").map(z => esc(z.name) + " (" + z.st.toLowerCase() + ")").join("; ") + "</span>" : ""}</td></tr>`; }).join("")}</table></body></html>`;
  previewHTML(html, g.name);
}
/* ------------------------------------------------------------------ CALENDAR (month view of due dates) */
const SVCHUE = { "GST": "#2B6CB0", "TDS Return": "#6B46C1", "TDS Challan": "#805AD5", "ROC / MCA": "#C05621", "Income Tax Return": "#2F855A", "Tax Audit": "#B7791F", "Statutory Audit": "#975A16", "Advance Tax": "#38A169", "UDIN / Certification": "#4A5568" };
function viewCalendar() {
  setTitle("Calendar");
  const f = S.f.cal = S.f.cal || { m: today().slice(0, 7), done: false, cases: true, dsc: true };
  $("#view").innerHTML = `<div class="toolbar"><button class="btn" id="clP" aria-label="Previous month">‹</button><b id="clM" style="min-width:150px;text-align:center;font-size:17px"></b><button class="btn" id="clN" aria-label="Next month">›</button><button class="btn sm" id="clT">Today</button>
      ${can("viewAllWork") ? `<select id="clS"><option value="">All staff</option>${(S.db.settings.staff || []).map(s => `<option value="${esc(s)}" ${f.staff === s ? "selected" : ""}>${esc(ulabel(s))}</option>`).join("")}</select>` : ""}
      <select id="clV"><option value="">All services</option>${allSvc().map(s => `<option ${f.svc === s ? "selected" : ""}>${esc(s)}</option>`).join("")}</select>
      <label class="small" style="display:flex;gap:5px;align-items:center"><input type="checkbox" id="clD" ${f.done ? "checked" : ""}> show done</label>
      ${can("cases") ? `<label class="small" style="display:flex;gap:5px;align-items:center"><input type="checkbox" id="clC" ${f.cases ? "checked" : ""}> notices</label>` : ""}
      ${can("dsc") ? `<label class="small" style="display:flex;gap:5px;align-items:center"><input type="checkbox" id="clX" ${f.dsc ? "checked" : ""}> DSC expiry</label>` : ""}
      <span class="sp"></span><button class="btn" id="clW">📋 Work Tracker</button></div><div id="clK"></div><div class="calwrap"><div id="clG"></div><div id="clDay"></div></div>`;
  const items = (from, to) => { const out = [];
    visW().forEach(w => { if (!w.due || w.due < from || w.due > to) return; if (!f.done && !isOpen(w)) return; if (f.staff && w.assigned !== f.staff) return; if (f.svc && w.service !== f.svc) return;
      out.push({ d: w.due, k: "w", id: w.id, open: isOpen(w), over: isOpen(w) && w.due < today(), lbl: w.form || w.service, svc: w.service, who: cname(w.client), sub: [w.period, w.fy].filter(Boolean).join(" · "), st: w.status }); });
    if (f.cases && can("cases") && !f.svc) vR("cases").forEach(c => { const d = effDue(c); if (!caseOpen(c) || !d || d < from || d > to || (f.staff && c.assigned !== f.staff)) return;
      out.push({ d, k: "c", id: c.id, open: true, over: caseOver(c), lbl: "⚖ " + (c.section ? "u/s " + c.section : c.kind), svc: "Notice", who: cname(c.client), sub: c.dept + (c.ay ? " · " + c.ay : ""), st: c.status }); });
    if (f.dsc && can("dsc") && !f.svc && !f.staff) vR("dsc").forEach(r => { if (!r.expiry || r.expiry < from || r.expiry > to) return; out.push({ d: r.expiry, k: "d", id: r.id, open: true, over: r.expiry < today(), lbl: "🔑 DSC expiry", svc: "DSC", who: cname(r.client), sub: r.holder, st: "" }); });
    return out; };
  const draw = () => {
    const [Y, M] = f.m.split("-").map(Number), first = new Date(Y, M - 1, 1), last = new Date(Y, M, 0);
    $("#clM").textContent = first.toLocaleDateString("en-IN", { month: "long", year: "numeric" });
    const start = new Date(first); start.setDate(1 - ((first.getDay() + 6) % 7)); const days = []; for (let d = new Date(start); days.length < 42; d.setDate(d.getDate() + 1)) days.push(iso(d));
    while (days.length > 35 && days.slice(-7).every(d => d.slice(0, 7) !== f.m)) days.splice(-7);
    const all = items(days[0], days[days.length - 1]), by = {}; all.forEach(x => (by[x.d] = by[x.d] || []).push(x));
    const load = d => (by[d] || []).filter(x => x.open).length, mx = Math.max(1, ...days.map(load));
    const weeks = []; for (let i = 0; i < days.length; i += 7) weeks.push(days.slice(i, i + 7));
    const wl = weeks.map(w => w.reduce((a, d) => a + load(d), 0)), wmx = Math.max(1, ...wl), busiest = wl.indexOf(Math.max(...wl));
    const inM = all.filter(x => x.d.slice(0, 7) === f.m);
    const k = (l, v, c = "") => `<div class="kpi ${c}" style="cursor:default"><div class="l">${l}</div><div class="v" style="font-size:20px">${v}</div></div>`;
    $("#clK").innerHTML = `<div class="grid kpis" style="margin-bottom:12px">${k("Due this month", inM.filter(x => x.open).length)}${k("Overdue", inM.filter(x => x.over).length, inM.some(x => x.over) ? "red" : "")}${k("Busiest week", wl[busiest] ? `${dmy(weeks[busiest][0]).slice(0, 5)} – ${dmy(weeks[busiest][6]).slice(0, 5)} · ${wl[busiest]}` : "—", "amber")}${k("Busiest day", (() => { const d = days.filter(x => x.slice(0, 7) === f.m).sort((a, b) => load(b) - load(a))[0]; return d && load(d) ? `${dmy(d).slice(0, 5)} · ${load(d)}` : "—"; })())}</div>`;
    $("#clG").innerHTML = `<div class="cal"><div class="calh">${["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map(d => `<div>${d}</div>`).join("")}<div>Week load</div></div>
      ${weeks.map((w, wi) => `<div class="calr">${w.map(d => { const L = by[d] || [], n = load(d), heat = n ? 0.08 + 0.42 * (n / mx) : 0, groups = {};
        L.forEach(x => { const g = x.lbl; (groups[g] = groups[g] || { n: 0, over: 0, svc: x.svc, done: 0 }); groups[g].n++; if (x.over) groups[g].over++; if (!x.open) groups[g].done++; });
        const G = Object.entries(groups).sort((a, b) => b[1].n - a[1].n);
        return `<button type="button" class="cald ${d.slice(0, 7) !== f.m ? "out" : ""} ${d === today() ? "today" : ""} ${S.calSel === d ? "sel" : ""}" data-d="${d}" style="${heat ? `background:rgba(214,120,40,${heat.toFixed(2)})` : ""}" aria-label="${dmy(d)}: ${n} open">
          <div class="cdn"><span>${+d.slice(8)}</span>${n ? `<b>${n}</b>` : ""}</div>${G.slice(0, 3).map(([l, g]) => `<div class="cdi ${g.over ? "over" : ""} ${g.done === g.n ? "done" : ""}"><i style="background:${SVCHUE[g.svc] || (g.svc === "Notice" ? "#B3261E" : "#718096")}"></i>${esc(l)}${g.n > 1 ? ` ×${g.n}` : ""}</div>`).join("")}${G.length > 3 ? `<div class="cdi more">+${G.length - 3} more</div>` : ""}</button>`; }).join("")}
        <div class="calw ${wi === busiest && wl[wi] ? "busy" : ""}"><b>${wl[wi]}</b><div class="bar"><i style="width:${Math.round(100 * wl[wi] / wmx)}%"></i></div>${wi === busiest && wl[wi] ? '<span class="small">crunch week</span>' : ""}</div></div>`).join("")}</div>`;
    $$("#clG [data-d]").forEach(b => b.onclick = () => { S.calSel = b.dataset.d; draw(); });
    const sd = S.calSel && days.includes(S.calSel) ? S.calSel : null; const L = sd ? (by[sd] || []).slice().sort((a, b) => (b.over - a.over) || (b.open - a.open) || a.lbl.localeCompare(b.lbl)) : [];
    $("#clDay").innerHTML = sd ? `<div class="card" style="margin-top:12px"><div style="display:flex;align-items:center;gap:8px"><h3 style="margin:0;flex:1">${new Date(sd + "T00:00:00").toLocaleDateString("en-IN", { weekday: "long", day: "numeric", month: "long", year: "numeric" })} <span class="muted small">(${L.length})</span></h3>
        ${can("viewAllWork") || true ? `<button class="btn sm" id="clOpenW">Open in Work Tracker</button>` : ""}<button class="btn sm" id="clX2" aria-label="Close day">✕</button></div>
        ${L.length ? `<div class="tablewrap" style="border:none;margin-top:8px"><table class="t"><thead><tr><th>Client</th><th>Return / item</th><th>Period</th><th>Status</th></tr></thead><tbody>${L.map(x => `<tr data-k="${x.k}" data-id="${x.id}" style="cursor:pointer"><td><b>${esc(x.who)}</b></td><td>${esc(x.lbl)}</td><td class="small">${esc(x.sub || "")}</td><td>${x.over ? '<span class="chip red">Overdue</span> ' : ""}${x.st ? esc(stLabel ? stLabel(x.st) : x.st) : ""}</td></tr>`).join("")}</tbody></table></div>` : '<p class="muted">Nothing due on this day.</p>'}</div>` : '<p class="small muted" style="margin-top:10px">Click a day to see everything due on it. Darker days have more open work.</p>';
    if (sd) { $("#clX2").onclick = () => { S.calSel = null; draw(); };
      $("#clOpenW").onclick = () => { S.f.works = { from: sd, to: sd, ...(f.staff ? { assigned: [f.staff] } : {}), ...(f.svc ? { service: [f.svc] } : {}), ...(f.done ? {} : { status: ["Open (not done)"] }) }; S.archView = false; go("works"); };
      $$("#clDay tr[data-id]").forEach(tr => tr.onclick = () => { const id = tr.dataset.id; if (tr.dataset.k === "w") editRecord("works", id, draw); else if (tr.dataset.k === "c") caseDialog(S.db.cases.find(c => c.id === id), {}, draw); else editRecord("dsc", id, draw); }); } };
  const mv = n => { const [Y, M] = f.m.split("-").map(Number), d = new Date(Y, M - 1 + n, 1); f.m = iso(d).slice(0, 7); S.calSel = null; draw(); };
  $("#clP").onclick = () => mv(-1); $("#clN").onclick = () => mv(1); $("#clT").onclick = () => { f.m = today().slice(0, 7); S.calSel = today(); draw(); };
  const bind = (id, k, chk) => { const el = $(id); if (el) el.onchange = () => { f[k] = chk ? el.checked : el.value; draw(); }; };
  bind("#clS", "staff"); bind("#clV", "svc"); bind("#clD", "done", 1); bind("#clC", "cases", 1); bind("#clX", "dsc", 1); $("#clW").onclick = () => go("works");
  draw();
}

/* ------------------------------------------------------------------ SAVED VIEWS */
const VPRESET = () => [
  { id: "p_myod", name: "My overdue work", route: "works", f: { assigned: [S.user], duep: "Overdue" } },
  { id: "p_mygst", name: "My overdue GST", route: "works", f: { assigned: [S.user], service: ["GST"], duep: "Overdue" } },
  { id: "p_week", name: "Due in the next 7 days", route: "works", f: { duep: "Next 7 days", status: ["Open (not done)"] } },
  { id: "p_audrev", name: "Audits pending review", route: "works", f: { service: ["Tax Audit", "Statutory Audit"], status: ["Under review"] } },
  { id: "p_audit", name: "Audits not yet done", route: "works", f: { service: ["Tax Audit", "Statutory Audit"], status: ["Open (not done)"] } },
  { id: "p_data", name: "Data awaited from clients", route: "works", f: { status: ["Data awaited"] } },
  { id: "p_unass", name: "Unassigned open work", route: "works", f: { assigned: ["__none__"], status: ["Open (not done)"] } },
  ...(can("viewFees") ? [{ id: "p_bill", name: "Fee entered, not billed", route: "works", f: { timeline: "Not billed (fee entered)" } }] : []),
  ...(can("cases") ? [{ id: "p_nt", name: "Notices due in 7 days", route: "cases", f: { st: "soon" } }, { id: "p_nto", name: "Overdue notices", route: "cases", f: { st: "over" } }] : []) ];
const myViews = () => ((S.db.settings.views || []).filter(v => v.owner === S.user || v.shared)).filter(v => v.route !== "cases" || can("cases"));
const allViews = () => [...VPRESET().map(v => ({ ...v, preset: 1 })), ...myViews()];
const ROUTENAME = { works: "Work Tracker", cases: "Notices & Cases" };
function applyView(v) { S.f[v.route] = JSON.parse(JSON.stringify(v.f || {})); if (v.route === "works") S.archView = false; S.curView = v.id; go(v.route); toast("View: " + v.name); }
function viewsMenu(btn, route) {
  document.querySelectorAll(".kmenu").forEach(x => x.remove());
  const V = allViews().filter(v => v.route === route), mine = V.filter(v => !v.preset);
  const mnu = document.createElement("div"); mnu.className = "kmenu"; mnu.setAttribute("role", "menu");
  mnu.innerHTML = `<div class="kmh">Ready-made views</div>${V.filter(v => v.preset).map(v => `<button type="button" role="menuitem" data-v="${v.id}">${esc(v.name)}</button>`).join("")}
    <div class="kmh">Saved views</div>${mine.length ? mine.map(v => `<div class="kmrow"><button type="button" role="menuitem" data-v="${v.id}">${esc(v.name)}${v.shared ? ' <span class="small muted">· team</span>' : ""}${v.owner !== S.user ? ` <span class="small muted">· ${esc(uname(v.owner))}</span>` : ""}</button>${v.owner === S.user || isAdmin() ? `<button type="button" class="kmx" data-del="${v.id}" aria-label="Delete view ${esc(v.name)}" title="Delete">✕</button>` : ""}</div>`).join("") : '<div class="small muted" style="padding:4px 12px 6px">None yet</div>'}
    <div class="kmsep"></div><button type="button" role="menuitem" id="kmSave">★ Save current filters as a view…</button><div class="small muted" style="padding:2px 12px 8px">Tip: press Ctrl+K anywhere to open any view</div>`;
  document.body.appendChild(mnu); const r = btn.getBoundingClientRect(); mnu.style.top = (r.bottom + 4 + window.scrollY) + "px"; mnu.style.left = Math.max(8, Math.min(r.left, innerWidth - 330)) + "px";
  const close = () => { mnu.remove(); document.removeEventListener("mousedown", out, true); }; const out = e => { if (!mnu.contains(e.target) && e.target !== btn) close(); };
  setTimeout(() => document.addEventListener("mousedown", out, true), 0);
  $$("[data-v]", mnu).forEach(b => b.onclick = () => { close(); applyView(allViews().find(v => v.id === b.dataset.v)); });
  $$("[data-del]", mnu).forEach(b => b.onclick = () => { const v = (S.db.settings.views || []).find(x => x.id === b.dataset.del); if (!v) return; S.db.settings.views = S.db.settings.views.filter(x => x !== v); log("Deleted", "Saved view", v.name); save(); close(); toast("View deleted"); });
  $("#kmSave", mnu).onclick = () => { close(); saveViewDialog(route); };
}
function saveViewDialog(route) {
  const f = JSON.parse(JSON.stringify(S.f[route] || {})); Object.keys(f).forEach(k => { if (f[k] === "" || (Array.isArray(f[k]) && !f[k].length)) delete f[k]; });
  if (!Object.keys(f).length) return alertBox("Nothing to save", "<p>Set some filters first (client, service, status, staff, due date…), then save them as a view.</p>");
  const m = openModal(`<div class="mhead"><h3>Save view</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <div class="field"><label class="req" for="svN">Name</label><input id="svN" maxlength="60" placeholder="e.g. Neha – GST due this week"></div>
    <label class="small" style="display:flex;gap:6px;align-items:center;margin-top:10px"><input type="checkbox" id="svSh"> Share with the whole team</label>
    <p class="small muted">Saves the current filters of ${esc(ROUTENAME[route] || route)}. Open it from ★ Views or with Ctrl+K.</p><div class="err" id="svE"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="svX">Cancel</button><button class="btn primary" id="svY">Save view</button></div>`, true);
  $("#svN", m).focus(); $("#mx", m).onclick = $("#svX", m).onclick = closeModal;
  $("#svY", m).onclick = () => { const n = $("#svN", m).value.trim(); if (!n) return $("#svE", m).textContent = "Enter a name.";
    if (myViews().some(v => v.name.toLowerCase() === n.toLowerCase() && v.owner === S.user)) return $("#svE", m).textContent = "You already have a view with this name.";
    const v = { id: uid(), name: n, route, f, owner: S.user, shared: $("#svSh", m).checked, at: new Date().toISOString() };
    (S.db.settings.views = S.db.settings.views || []).push(v); log("Added", "Saved view", n); save(); closeModal(); toast("View saved"); };
}

/* ------------------------------------------------------------------ QUICK SEARCH (Ctrl+K) */
function kPalette() {
  if (!S.db || $("#kpal")) return; document.querySelectorAll(".kmenu").forEach(x => x.remove());
  const ov = document.createElement("div"); ov.id = "kpal"; ov.className = "kpal"; ov.setAttribute("role", "dialog"); ov.setAttribute("aria-label", "Quick search");
  ov.innerHTML = `<div class="kbox"><input id="kq" placeholder="Search clients, tasks, notices, views or pages…" autocomplete="off" spellcheck="false" aria-label="Quick search"><div id="kres" role="listbox"></div>
    <div class="kfoot"><span>↑↓ move</span><span>Enter open</span><span>Esc close</span><span class="sp"></span><span>Tip: “gst nov”, “sharma 3b”, a PAN or a GSTIN</span></div></div>`;
  document.body.appendChild(ov); const q = $("#kq", ov), R = $("#kres", ov); let list = [], sel = 0;
  const close = () => ov.remove(); ov.addEventListener("mousedown", e => { if (e.target === ov) close(); });
  const pages = [["dashboard", "Dashboard"], ["calendar", "Calendar"], ["clientsvc", "Services by client"], ...NAV.filter(n => n[0] !== "grp" && navOk(n) && !["dashboard", "calendar"].includes(n[0])).map(n => [n[0], n[1]])];
  const acts = [...(can("createWork") ? [["＋ New task", () => editRecord("works", null)], ["⟳ Generate recurring compliances", () => recurringDialog()]] : []), ...(can("manageClients") ? [["＋ New client", () => editRecord("clients", null)]] : []), ...(can("cases") ? [["＋ New notice / case", () => caseDialog(null, {}, () => go(S.route))]] : [])];
  const build = s => { const t = s.toLowerCase().trim().split(/\s+/).filter(Boolean), hit = h => t.every(w => h.includes(w)); const out = [];
    if (!t.length) { allViews().slice(0, 8).forEach(v => out.push({ ic: "★", t: v.name, s: ROUTENAME[v.route] || v.route, go: () => applyView(v) }));
      pages.slice(0, 8).forEach(p => out.push({ ic: "→", t: p[1], s: "Page", go: () => go(p[0]) })); acts.forEach(a => out.push({ ic: "＋", t: a[0].replace(/^[＋⟳] /, ""), s: "Action", go: a[1] })); return out; }
    allViews().forEach(v => { if (hit((v.name + " view").toLowerCase())) out.push({ ic: "★", t: v.name, s: "View · " + (ROUTENAME[v.route] || v.route), go: () => applyView(v), ex: v.name.toLowerCase().includes(s.toLowerCase().trim()) ? 0 : 1 }); });
    pages.forEach(p => { if (hit(p[1].toLowerCase())) out.push({ ic: "→", t: p[1], s: "Page", go: () => go(p[0]) }); });
    acts.forEach(a => { if (hit(a[0].toLowerCase())) out.push({ ic: "＋", t: a[0].replace(/^[＋⟳] /, ""), s: "Action", go: a[1] }); });
    vC().forEach(c => { const h = [c.name, c.code, c.pan, c.group, ...gstsOf(c).map(x => x.g)].join(" ").toLowerCase(); if (hit(h)) out.push({ ic: "👥", t: c.name, s: `Client · ${c.code}${c.pan ? " · " + c.pan : ""}`, go: () => go("client:" + c.id), rank: c.name.toLowerCase().startsWith(t[0]) ? 0 : 1 }); });
    const W = []; visW().forEach(w => { const h = [cname(w.client), ccode(w.client), w.form, w.service, w.period, w.fy, w.gstin, w.arn, w.udin, uname(w.assigned)].join(" ").toLowerCase(); if (hit(h)) W.push(w); });
    W.sort((a, b) => (isOpen(b) - isOpen(a)) || (a.due || "9999").localeCompare(b.due || "9999")).slice(0, 12).forEach(w => out.push({ ic: isOpen(w) ? "📋" : "✓", t: `${cname(w.client)} – ${w.form}`, s: `Task · ${[w.period, w.fy].filter(Boolean).join(" ")}${w.gstin && multiG(w.client) ? " · " + w.gstin : ""}${w.due ? " · due " + dmy(w.due) : ""} · ${stLabel(w.status)}`, go: () => editRecord("works", w.id) }));
    if (can("cases")) vR("cases").forEach(c => { const h = [cname(c.client), c.section, c.dept, c.kind, c.ay, c.din, "notice case"].join(" ").toLowerCase(); if (hit(h)) out.push({ ic: "⚖", t: `${cname(c.client)} – ${c.section ? "u/s " + c.section : c.kind}`, s: `Notice · ${c.dept}${effDue(c) ? " · due " + dmy(effDue(c)) : ""} · ${c.status}`, go: () => caseDialog(c, {}, () => go(S.route)) }); });
    const rk = x => x.ic === "★" ? (x.ex || 0) * 0.5 : x.ic === "→" || x.ic === "＋" ? 1 : x.ic === "👥" ? 2 + (x.rank || 0) : 4;
    return out.sort((a, b) => rk(a) - rk(b)).slice(0, 40); };
  const draw = () => { list = build(q.value); sel = Math.min(sel, Math.max(0, list.length - 1));
    R.innerHTML = list.length ? list.map((x, i) => `<div class="kit ${i === sel ? "on" : ""}" role="option" aria-selected="${i === sel}" data-i="${i}"><span class="kic">${x.ic}</span><span class="kt">${esc(x.t)}</span><span class="ks">${esc(x.s)}</span></div>`).join("") : '<div class="kempty">Nothing found</div>';
    $$(".kit", R).forEach(el => { el.onmousemove = () => { if (sel !== +el.dataset.i) { sel = +el.dataset.i; $$(".kit", R).forEach(z => z.classList.toggle("on", +z.dataset.i === sel)); } }; el.onclick = () => run(+el.dataset.i); });
    const on = $(".kit.on", R); if (on) on.scrollIntoView({ block: "nearest" }); };
  const run = i => { const x = list[i]; if (!x) return; close(); x.go(); };
  q.oninput = () => { sel = 0; draw(); };
  q.onkeydown = e => { if (e.key === "ArrowDown") { e.preventDefault(); sel = Math.min(list.length - 1, sel + 1); draw(); } else if (e.key === "ArrowUp") { e.preventDefault(); sel = Math.max(0, sel - 1); draw(); }
    else if (e.key === "Enter") { e.preventDefault(); run(sel); } else if (e.key === "Escape") { e.preventDefault(); close(); } };
  draw(); q.focus();
}
document.addEventListener("keydown", e => { if ((e.ctrlKey || e.metaKey) && !e.altKey && (e.key === "k" || e.key === "K")) { if (!S.db || !$("#app") || $("#app").hidden) return; e.preventDefault(); if ($("#kpal")) $("#kpal").remove(); else kPalette(); } });
function viewList(ent, opts = {}) {
  const E = ENT[ent]; setTitle(E.title);
  const f = S.f[ent] = S.f[ent] || {};
  const filt = FILTERS[ent].map(fd => fd.multi ? msHTML(fd.k, fd.l, filterOpts(fd.o), f[fd.k] || []) : `<select data-f="${fd.k}"><option value="">${fd.l}</option>${filterOpts(fd.o).map(([v, l]) => `<option value="${esc(v)}" ${f[fd.k] === v ? "selected" : ""}>${esc(l)}</option>`).join("")}</select>`).join("");
  const dates = ent === "clients" ? "" : `<input type="date" data-f="from" value="${esc(f.from || "")}" title="${ent === "works" ? "Due date from" : "Date from"}"><input type="date" data-f="to" value="${esc(f.to || "")}" title="to">`;
  $("#view").innerHTML = `
    <div class="toolbar">
      <input type="search" data-f="q" placeholder="Search…" value="${esc(f.q || "")}">${filt}${dates}
      <button class="btn sm" id="clrF">Clear</button><span class="sp"></span>
      ${ent === "works" ? '<button class="btn" id="vwBtn" title="Ready-made and saved views (Ctrl+K)">★ Views</button>' : ""}
      ${ent === "works" ? '<button class="btn" id="colBtn" title="Show, hide and reorder columns">▦ Columns</button><button class="btn" id="arcBtn"></button>' : ""}
      ${ent === "works" && can("createWork") && !S.archView ? '<button class="btn" id="recurBtn">⟳ Recurring compliances</button><button class="btn" id="multiBtn">＋＋ Add multiple tasks</button>' : ""}
      ${can("print") ? '<button class="btn" id="prBtn">🖨 Print</button>' : ""}${can("export") ? '<button class="btn" id="exBtn">⬇ Excel</button><button class="btn" id="shBtn">↗ Share</button>' : ""}
      ${ent === "clients" ? '<button class="btn" id="svcBtn" title="See and tick the services you do for every client on one screen">☑ Services by client</button>' : ""}
      ${ent === "clients" && isAdmin() ? '<button class="btn" id="mgBtn" title="Combine clients that are the same business (e.g. one per GSTIN)">⇄ Merge duplicates</button>' : ""}
      ${can(ENTPERM[ent]) ? `<button class="btn primary" id="addBtn">＋ Add ${E.one.toLowerCase()}</button>` : ""}
    </div><div id="tbl"></div>`;
  if (ent === "udins") udinTaskPanel();
  $$("[data-f]").forEach(el => el.addEventListener(el.tagName === "INPUT" && el.type === "search" ? "input" : "change", () => { f[el.dataset.f] = el.value; drawTable(ent); }));
  $("#clrF").onclick = () => { S.f[ent] = {}; viewList(ent); };
  if ($("#addBtn")) $("#addBtn").onclick = () => editRecord(ent, null);
  if ($("#mgBtn")) $("#mgBtn").onclick = mergeDialog;
  if ($("#svcBtn")) $("#svcBtn").onclick = () => go("clientsvc");
  if ($("#vwBtn")) $("#vwBtn").onclick = e => viewsMenu(e.currentTarget, "works");
  const T2 = E.title + (ent === "works" && S.archView ? " – Archive" : "");
  if ($("#prBtn")) $("#prBtn").onclick = () => { const { rows } = currentRows(ent); printRows(T2, filterDesc(ent), viewCols(ent), rows); };
  if ($("#exBtn")) $("#exBtn").onclick = () => { const { rows } = currentRows(ent); exportCSV(T2, viewCols(ent), rows); };
  if ($("#shBtn")) $("#shBtn").onclick = () => { const { rows } = currentRows(ent); shareCSV(T2, viewCols(ent), rows); };
  if (ent === "works") { const nA = dataFor("works").filter(archOf).length; setTitle(S.archView ? "Work Tracker – Archive" : E.title);
    $("#colBtn").onclick = () => colChooser("works", () => drawTable("works"));
    $("#arcBtn").textContent = S.archView ? "← Back to work list" : `📦 Archive (${nA})`; $("#arcBtn").classList.toggle("primary", !!S.archView);
    $("#arcBtn").onclick = () => { S.archView = !S.archView; S.sort.works = S.sort.works; viewList("works"); }; }
  if ($("#recurBtn")) $("#recurBtn").onclick = recurringDialog;
  if ($("#multiBtn")) $("#multiBtn").onclick = () => multiTaskDialog();
  bindMS($("#view"), (k, arr) => { f[k] = arr; drawTable(ent); });
  S.sel = new Set();
  drawTable(ent);
}
function colPref(key) { const all = S.db.settings.colPrefs = S.db.settings.colPrefs || {}; const u = all[S.user] = all[S.user] || {}; const p = u[key] = u[key] || {}; p.order = p.order || []; p.hidden = p.hidden || []; p.w = p.w || {}; return p; }
function applyColPrefs(key, cols) { const p = colPref(key); const ord = c => { const i = p.order.indexOf(c.l); return i < 0 ? 1000 + cols.indexOf(c) : i; }; const out = cols.filter(c => !p.hidden.includes(c.l)).sort((a, b) => ord(a) - ord(b)); return out.length ? out : cols; }
const viewCols = ent => ent === "works" ? applyColPrefs("works", colsFor(COLS.works)) : colsFor(COLS[ent]);
const archOf = w => !!w.archived && !isOpen(w);
function currentRows(ent) { let base = dataFor(ent).slice(); if (ent === "works") base = base.filter(w => archOf(w) === !!S.archView); let rows = applyFilters(ent, base); if (ent === "works") rows = applyColFilters(ent, rows); return { rows: sortRows(ent, rows, viewCols(ent)), total: base.length }; }
/* ---- Excel-style column filters (▾ on each heading) */
const cfVal = (c, r) => { const v = c.x ? c.x(r) : ""; const t = v == null ? "" : String(v).trim(); return t === "" ? "(Blanks)" : t; };
const cfOn = (ent, l) => !!(((S.f[ent] || {}).cf || {})[l]);
function applyColFilters(ent, rows, except) { const cf = (S.f[ent] || {}).cf || {}; const cols = colsFor(COLS[ent]);
  const act = Object.entries(cf).filter(([l]) => l !== except).map(([l, set]) => [cols.find(c => c.l === l), new Set(set)]).filter(([c]) => c);
  return act.length ? rows.filter(r => act.every(([c, set]) => set.has(cfVal(c, r)))) : rows; }
function colFilterPop(ent, label, anchor, redraw) {
  $$(".cfpop").forEach(x => x.remove()); const f = S.f[ent] = S.f[ent] || {}; f.cf = f.cf || {};
  const cols = viewCols(ent), c = colsFor(COLS[ent]).find(x => x.l === label), idx = cols.findIndex(x => x.l === label); if (!c) return;
  let base = dataFor(ent).slice(); if (ent === "works") base = base.filter(w => archOf(w) === !!S.archView); base = applyColFilters(ent, applyFilters(ent, base), label);
  const counts = new Map(), sk = new Map(); base.forEach(r => { const v = cfVal(c, r); counts.set(v, (counts.get(v) || 0) + 1); if (!sk.has(v) && c.s) sk.set(v, c.s(r)); });
  (f.cf[label] || []).forEach(v => { if (!counts.has(v)) counts.set(v, 0); });
  const vals = [...counts.keys()].sort((a, b) => a === "(Blanks)" ? 1 : b === "(Blanks)" ? -1 : (sk.has(a) && sk.has(b) && typeof sk.get(a) === typeof sk.get(b) && sk.get(a) !== sk.get(b) ? (sk.get(a) < sk.get(b) ? -1 : 1) : a.localeCompare(b, "en", { numeric: true })));
  const cur = f.cf[label] ? new Set(f.cf[label]) : null;
  const d = document.createElement("div"); d.className = "cfpop";
  d.innerHTML = `<div class="b small" style="margin-bottom:6px">${esc(label)}</div>
    <div style="display:flex;gap:6px;margin-bottom:8px"><button type="button" class="btn sm" data-srt="1">↑ Sort A → Z</button><button type="button" class="btn sm" data-srt="-1">↓ Sort Z → A</button></div>
    <input type="search" id="cfQ" placeholder="Search values…" style="width:100%;border:1px solid #cfd5df;border-radius:8px;padding:6px 9px;margin-bottom:6px">
    <label class="cfrow b"><input type="checkbox" id="cfAll"> (Select all)</label>
    <div id="cfL" style="max-height:260px;overflow:auto;border-top:1px solid #f1f3f6;margin-top:2px">${vals.map(v => `<label class="cfrow" data-n="${esc(v.toLowerCase())}"><input type="checkbox" value="${esc(v)}" ${!cur || cur.has(v) ? "checked" : ""}> <span style="flex:1">${esc(v)}</span> <span class="small muted">${counts.get(v)}</span></label>`).join("") || '<div class="small muted" style="padding:8px 0">No values</div>'}</div>
    <div style="display:flex;gap:6px;justify-content:space-between;margin-top:8px"><button type="button" class="btn sm" id="cfClr" ${cur ? "" : "disabled"}>Clear filter</button><span><button type="button" class="btn sm" id="cfN">Cancel</button> <button type="button" class="btn sm primary" id="cfY">OK</button></span></div>`;
  document.body.appendChild(d); const rc = anchor.getBoundingClientRect();
  d.style.left = Math.max(8, Math.min(window.innerWidth - 290, rc.left - 8)) + "px"; d.style.top = Math.min(window.innerHeight - 440, rc.bottom + 6) + "px";
  d.onclick = e => e.stopPropagation(); d.addEventListener("mousedown", e => e.stopPropagation());
  const boxes = () => $$("#cfL input", d), vis = () => boxes().filter(x => !x.closest("label").hidden);
  const syncAll = () => { const v = vis(); $("#cfAll", d).checked = v.length && v.every(x => x.checked); $("#cfAll", d).indeterminate = v.some(x => x.checked) && !v.every(x => x.checked); }; syncAll();
  $("#cfAll", d).onchange = e => { vis().forEach(x => x.checked = e.target.checked); syncAll(); };
  boxes().forEach(x => x.onchange = syncAll);
  $("#cfQ", d).oninput = e => { const q = e.target.value.toLowerCase(); $$("#cfL label", d).forEach(l => l.hidden = !l.dataset.n.includes(q)); syncAll(); }; setTimeout(() => $("#cfQ", d).focus(), 0);
  const close = () => { d.remove(); document.removeEventListener("mousedown", out); }; const out = () => close(); setTimeout(() => document.addEventListener("mousedown", out), 0);
  $$("[data-srt]", d).forEach(b => b.onclick = () => { S.sort[ent] = { i: idx, d: +b.dataset.srt }; close(); redraw(); });
  $("#cfN", d).onclick = close;
  $("#cfClr", d).onclick = () => { delete f.cf[label]; close(); redraw(); };
  $("#cfY", d).onclick = () => { const q = $("#cfQ", d).value.trim(); const pick = (q ? vis() : boxes()).filter(x => x.checked).map(x => x.value);
    if (!q && pick.length === boxes().length) delete f.cf[label]; else if (!pick.length) return toast("Tick at least one value"); else f.cf[label] = pick; close(); redraw(); };
  $("#cfQ", d).onkeydown = e => { if (e.key === "Enter") $("#cfY", d).click(); if (e.key === "Escape") close(); };
}
function filterDesc(ent) {
  const f = S.f[ent] || {}; const parts = [];
  FILTERS[ent].forEach(fd => { const v = f[fd.k]; if (!v || (Array.isArray(v) && !v.length)) return; const nm = x => fd.o === "client" ? cname(x) : fd.k === "assigned" ? (x === "__none__" ? "unassigned" : uname(x)) : fd.k === "flag" ? ({ __pin__: "pinned", __any__: "any flag", __none__: "no flag" }[x] || flagName(x)) : x;
    parts.push(fd.l.replace(/^All /, "") + ": " + (Array.isArray(v) ? v.map(nm).join(", ") : nm(v))); });
  if (f.from || f.to) parts.push(`Period: ${dmy(f.from) || "…"} to ${dmy(f.to) || "…"}`);
  if (f.q) parts.push(`Search: "${f.q}"`);
  Object.entries(f.cf || {}).forEach(([l, v]) => parts.push(`${l}: ${v.join(", ")}`));
  return parts.length ? "Filters – " + parts.join(" | ") : "All records";
}
function tableHTML(ent, cols, rows, sortable = true, withDel = false, sel = false, ck = "") {
  if (ck) return tableHTMLcw(ent, cols, rows, withDel, sel, ck);
  if (!rows.length) return `<div class="tablewrap"><div class="empty">No records yet. ${sortable ? "Use <b>＋ Add</b> to create one." : ""}</div></div>`;
  const st = S.sort[ent] || {};
  const hasSum = cols.some(c => c.sum);
  return `<div class="tablewrap"><table class="t"><thead><tr>${sel ? `<th style="width:28px"><input type="checkbox" class="selall" title="Select all shown"></th>` : ""}${cols.map((c, i) => `<th class="${c.num ? "num" : ""}" data-i="${i}">${esc(c.l)}${st.i === i ? (st.d > 0 ? " ▲" : " ▼") : ""}</th>`).join("")}${withDel ? "<th></th>" : ""}</tr></thead>
    <tbody>${rows.map(r => `<tr data-id="${r.id}" ${ent === "works" || ent === "mywork" || ent === "c_works" ? (isPinned(r) ? 'class="pinned"' : "") : ""}>${sel ? `<td class="selc"><input type="checkbox" class="selr" value="${r.id}" ${S.sel && S.sel.has(r.id) ? "checked" : ""}></td>` : ""}${cols.map(c => `<td class="${c.num ? "num" : ""}">${c.v(r) ?? ""}</td>`).join("")}${withDel ? `<td><button class="btn sm danger" data-del="${r.id}" title="Delete">✕</button></td>` : ""}</tr>`).join("")}</tbody>
    ${hasSum ? `<tfoot><tr>${sel ? "<td></td>" : ""}${cols.map((c, i) => `<td class="${c.num ? "num" : ""}">${c.sum ? inr(rows.reduce((a, r) => a + c.sum(r), 0)) : i === 0 ? "Total" : ""}</td>`).join("")}${withDel ? "<td></td>" : ""}</tr></tfoot>` : ""}</table></div>`;
}
function drawTable(ent) {
  const { rows, total } = currentRows(ent);
  const selOn = ent === "works";
  $("#tbl").innerHTML = (ent === "works" && S.archView ? `<div class="notice">📦 <b>Archive</b> – completed tasks you have moved out of the work list. They still show in the compliance trackers, reports and client pages. Select tasks and click <b>↩ Restore</b> to bring them back.</div>` : "")
    + (ent === "works" ? worksNotices() : "") + `<div class="count">${rows.length} of ${total} record(s)${ent === "works" && !can("viewAllWork") ? " – showing work assigned to / created by you" : ""}</div>${selOn ? '<div id="bulkBar"></div>' : ""}` + tableHTML(ent, viewCols(ent), rows, true, can("delete"), selOn, ent === "works" ? "works" : "");
  bindTable(ent, $("#tbl"), () => drawTable(ent));
  if (selOn) bindBulk(rows, () => drawTable(ent));
  if (ent === "works") { bindWorksNotices(); bindColUI("works", () => drawTable("works")); }
}
const svcExpected = w => { const h = SVCMAP.find(([re]) => re.test(w.form || "")); return h ? h[1] : ""; };
const svcMismatch = () => visW().filter(w => { const e = svcExpected(w); return e && w.service && w.service !== e && SVC.includes(w.service); });
function activeFilterText() { const f = S.f.works || {}; const out = [];
  FILTERS.works.forEach(fd => { const v = f[fd.k]; if (!v || (Array.isArray(v) && !v.length)) return; const vals = Array.isArray(v) ? v : [v];
    const nm = x => fd.o === "client" ? cname(x) : fd.k === "assigned" ? (x === "__none__" ? "unassigned" : uname(x)) : fd.k === "flag" ? ({ __pin__: "pinned", __any__: "any flag", __none__: "no flag" }[x] || flagName(x)) : x;
    out.push(`${fd.l.replace(/…$/, "")}: ${vals.slice(0, 3).map(nm).join(", ")}${vals.length > 3 ? ` +${vals.length - 3}` : ""}`); });
  if (f.q) out.push(`Search: “${f.q}”`); if (f.from || f.to) out.push(`Due ${f.from ? "from " + dmy(f.from) : ""} ${f.to ? "to " + dmy(f.to) : ""}`.trim());
  Object.entries(f.cf || {}).forEach(([l, v]) => out.push(`${l}: ${v.slice(0, 3).join(", ")}${v.length > 3 ? ` +${v.length - 3}` : ""}`)); return out; }
function worksNotices() {
  const af = activeFilterText(), mm = svcMismatch();
  return (af.length ? `<div class="notice">🔎 <b>Filters on:</b> ${esc(af.join(" · "))} – some tasks are hidden. <button class="btn sm" id="nfClr">Show all tasks</button></div>` : "")
    + (mm.length && (can("editAllWork") || isAdmin()) ? `<div class="notice warn">⚠ <b>${mm.length} task(s)</b> have a service that doesn't match the task, e.g. <b>${esc(mm[0].form)}</b> shown under <b>${esc(mm[0].service)}</b> instead of <b>${esc(svcExpected(mm[0]))}</b>. <button class="btn sm" id="nfFix">Review &amp; fix</button></div>` : "");
}
function bindWorksNotices() {
  if ($("#nfClr")) $("#nfClr").onclick = () => { S.f.works = {}; viewList("works"); };
  if ($("#nfFix")) $("#nfFix").onclick = () => svcFixDialog();
}
function svcFixDialog() {
  const mm = svcMismatch(); if (!mm.length) return toast("Nothing to fix");
  const m = openModal(`<div class="mhead"><h3>Fix task services</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p class="small" style="margin-top:0">These tasks are saved under a service that doesn't match the task name. Fixing sets the service from the task name, so they appear under the right service in the Work list, filters and reports. Nothing else on the task changes.</p>
    <div class="tablewrap" style="max-height:50vh"><table class="t"><thead><tr><th><input type="checkbox" id="sfAll" checked></th><th>Client</th><th>Task</th><th>Period</th><th>Saved as</th><th>Should be</th><th>Last changed by</th></tr></thead><tbody>
    ${mm.map(w => `<tr><td><input type="checkbox" class="sfR" value="${w.id}" checked></td><td>${esc(cname(w.client))}</td><td>${esc(w.form)}</td><td>${esc(w.fy || "")} ${esc(w.period || "")}</td><td class="red">${esc(w.service)}</td><td class="green b">${esc(svcExpected(w))}</td><td class="small">${esc(uname(w.updatedBy || w.createdBy))} ${w.updatedAt ? dmy((w.updatedAt || "").slice(0, 10)) : ""}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="sfN">Cancel</button><button class="btn primary" id="sfY">Fix selected</button></div>`);
  $("#mx", m).onclick = $("#sfN", m).onclick = closeModal;
  $("#sfAll", m).onchange = e => $$(".sfR", m).forEach(x => x.checked = e.target.checked);
  $("#sfY", m).onclick = () => { const ids = new Set($$(".sfR:checked", m).map(x => x.value)); const now = new Date().toISOString(); let n = 0;
    S.db.works.filter(w => ids.has(w.id)).forEach(w => { const e = svcExpected(w); if (e && w.service !== e) { w.service = e; w.updatedBy = S.user; w.updatedAt = now; n++; } });
    log("Bulk edit", "Work item", `Service corrected from task name – ${n} item(s)`); save(); closeModal(); toast(`${n} task(s) fixed`); viewList("works"); };
}
function bindTable(ent, root, redraw, key = ent) {
  $$("th[data-i]", root).forEach(th => th.onclick = e => { if (S._colBusy || e.target.closest(".rz")) return; const i = +th.dataset.i; const st = S.sort[key]; S.sort[key] = { i, d: st && st.i === i ? -st.d : 1 }; redraw(); });
  $$("tbody tr", root).forEach(tr => tr.onclick = e => {
    if (e.target.closest("[data-del]") || e.target.closest(".selc")) return;
    if (ent === "clients") go("client:" + tr.dataset.id); else editRecord(ent, tr.dataset.id, redraw);
  });
  $$("[data-del]", root).forEach(b => b.onclick = () => deleteRecord(ent, b.dataset.del, redraw));
}

/* ------------------------------------------------------------------ FORM / EDIT */
function gstRow(x = {}) { return `<div class="gstr" style="display:flex;gap:6px;align-items:center;margin-bottom:6px;flex-wrap:wrap"><input class="gg" maxlength="15" placeholder="06AAAAA9999A1Z5" value="${esc(x.g || "")}" style="width:170px;text-transform:uppercase;font-family:Consolas,monospace"><span class="gs small muted" style="min-width:110px">${esc(gstState(x.g))}</span><input class="gl" maxlength="60" placeholder="Branch / trade name (optional)" value="${esc(x.label || "")}" style="flex:1;min-width:160px"><button type="button" class="btn sm gx" aria-label="Remove this GSTIN">✕</button></div>`; }
function bindGstList(m) { const box = $("#f_gstins", m); if (!box) return;
  const bind = () => $$(".gstr", box).forEach(r => { $(".gg", r).oninput = e => { $(".gs", r).textContent = gstState(e.target.value.toUpperCase()); }; $(".gx", r).onclick = () => { r.remove(); }; });
  $("#gstAdd", m).onclick = () => { box.insertAdjacentHTML("beforeend", gstRow()); bind(); $(".gstr:last-child .gg", box).focus(); }; bind(); }
function bindGstSel(m, rec) { const sel = $("#f_gstin", m), cs = $("#f_client", m); if (!sel) return; const wrap = sel.closest(".field");
  const fill = () => { const L = gstsOf(clientById(cs ? cs.value : "")), cur = sel.value || sel.dataset.val; sel.innerHTML = `<option value="">— choose GSTIN —</option>` + L.map(x => `<option value="${esc(x.g)}" ${x.g === cur ? "selected" : ""}>${esc(gstLbl(x))}</option>`).join("");
    if (!sel.value && L.length) sel.value = L[0].g; wrap.hidden = L.length < 2 && !(rec && rec.gstin && L.length && rec.gstin !== L[0].g); };
  fill(); if (cs) cs.addEventListener("change", () => { sel.dataset.val = ""; sel.value = ""; fill(); }); }
function fieldHTML(fd, val) {
  const id = "f_" + fd.k; const req = fd.req ? "required" : "";
  if (fd.t === "gstlist" && !(Array.isArray(val) && val.length) && fieldHTML._rec) val = gstsOf(fieldHTML._rec);
  const lab = `<label class="${fd.req ? "req" : ""}" for="${id}">${esc(fd.l)}</label>`;
  let inp; const O = typeof fd.o === "function" ? fd.o() : fd.o;
  switch (fd.t) {
    case "select": { const list = val && O && !O.includes(val) ? [...O, val] : O; inp = `<select id="${id}" ${req}><option value=""></option>${list.map(o => `<option ${o === val ? "selected" : ""}>${esc(o)}</option>`).join("")}${fd.addNew ? `<option value="__new__">＋ ${fd.addNew === "status" ? "New status…" : "Add new…"}</option>` : ""}</select>`; break; }
    case "client": inp = `<div style="display:flex;gap:6px"><select id="${id}" ${req} style="flex:1"><option value="">— select client —</option>${vC().slice().sort((a, b) => a.name.localeCompare(b.name)).filter(c => c.active !== "Inactive" || c.id === val).map(c => `<option value="${c.id}" ${c.id === val ? "selected" : ""}>${esc(c.name)} (${esc(c.code)})</option>`).join("")}</select>${can("manageClients") ? `<button type="button" class="btn" data-newclient="${id}" title="Create a new client without leaving this form">＋ New client</button>` : ""}</div>`; break;
    case "staff": { const st = S.db.settings.staff || []; const list = val && !st.includes(val) ? [...st, val] : st; inp = `<select id="${id}"><option value=""></option>${list.map(o => `<option value="${esc(o)}" ${o === val ? "selected" : ""}>${esc(ulabel(o))}</option>`).join("")}</select>`; break; }
    case "combo": inp = `<div style="display:flex;gap:6px"><input id="${id}" list="dl_${fd.k}" value="${esc(val)}" ${req} maxlength="120" placeholder="${esc(fd.ph || "")}" style="flex:1"><datalist id="dl_${fd.k}">${O.map(o => `<option value="${esc(o)}">`).join("")}</datalist>${fd.addNew ? `<button type="button" class="btn" data-addnew="${fd.addNew}" data-for="${id}" title="Add a new task type to the list">＋ New task</button>` : ""}</div>${fd.addNew ? '<span class="small muted">Not in the list? Type it, or click ＋ New task – it is saved to the list for next time.</span>' : ""}`; break;
    case "textarea": inp = `<textarea id="${id}" maxlength="2000">${esc(val)}</textarea>`; break;
    case "gstlist": { const L = Array.isArray(val) && val.length ? val : []; inp = `<div id="${id}" class="gstl">${L.map(x => gstRow(x)).join("")}</div><button type="button" class="btn sm" id="gstAdd" style="margin-top:6px">＋ Add GSTIN</button><span class="small muted" style="margin-left:8px">A client can have one GSTIN per state or branch – keep them all here, under one client.</span>`; break; }
    case "gstsel": inp = `<select id="${id}" data-val="${esc(val || "")}"></select>`; break;
    case "multi": inp = `<div class="checks" id="${id}">${O.map(o => `<label><input type="checkbox" value="${esc(o)}" ${(val || []).includes(o) ? "checked" : ""}>${esc(o)}</label>`).join("")}</div>`; break;
    case "number": inp = `<input id="${id}" type="number" step="0.01" min="0" value="${esc(val)}" ${req}>`; break;
    case "date": inp = `<input id="${id}" type="date" value="${esc(val)}" ${req}>`; break;
    default: inp = `<input id="${id}" value="${esc(val)}" ${req} maxlength="200" placeholder="${esc(fd.ph || "")}" ${fd.upper ? 'style="text-transform:uppercase"' : ""}>`;
  }
  return `<div class="field ${fd.full ? "full" : ""}">${lab}${inp}${fd.hint ? `<span class="small muted">${esc(fd.hint)}</span>` : ""}</div>`;
}
function editRecord(ent, id, after, preset = {}) {
  if (ent === "docreq") return docReqDialog(id, after, preset); if (ent === "engage") return engDialog(id, after, preset);
  const E0 = ENT[ent]; const rec = id ? S.db[ent].find(r => r.id === id) : null;
  if (!rec && !can(ENTPERM[ent])) return toast("You do not have the right to add this record");
  const E = { ...E0, fields: E0.fields.filter(fd => !(fd.fee && !(can("editFees") || (can("viewFees") && rec))) && !(fd.adm && !isAdmin())) };
  if (rec && rec.client && !showC(rec.client)) return toast("This record is not available");
  const LK = ent === "works" && rec ? lockState(rec) : null;
  const RO = !!rec && ((ent === "clients" && !can("manageClients")) || (ent === "works" && !can("editAllWork") && !mineW(rec)) || (LK && (LK.mode === "locked" || (LK.mode === "grant" && LK.type === "delete"))));
  if (ent === "works" && !rec && !preset.assigned) preset = { ...preset, assigned: S.user };
  if (ent !== "clients" && !vC().length && !can("manageClients")) { alertBox("No clients yet", "Ask the Admin to add clients first."); return; }
  const vals = {}; E.fields.forEach(fd => { vals[fd.k] = rec ? rec[fd.k] : (preset[fd.k] ?? (typeof fd.def === "function" ? fd.def() : fd.def ?? (fd.t === "multi" ? [] : ""))); });
  const meta = rec ? `<span class="small muted">Created by ${esc(rec.createdBy || "")} ${rec.createdAt ? "on " + dmy(rec.createdAt.slice(0, 10)) : ""}${rec.updatedBy ? ` · last edited by ${esc(rec.updatedBy)} on ${dmy((rec.updatedAt || "").slice(0, 10))}` : ""}</span>` : "";
  const m = openModal(`<form id="recForm" novalidate>
    <div class="mhead"><h3>${RO ? "View" : rec ? "Edit" : "New"} ${esc(E.one.toLowerCase())}${RO ? ' <span class="chip">read-only</span>' : ""}</h3><button type="button" class="btn sm" id="mx">✕</button></div>
    <div class="mbody">${LK ? lockBanner(rec, LK) : ""}<div class="fgrid">${(fieldHTML._rec = rec, "")}${E.fields.map(fd => fieldHTML(fd, vals[fd.k])).join("")}${(fieldHTML._rec = null, "")}</div>
      ${rec && ent === "works" ? `<div class="field" style="margin-top:6px"><label>Updates / notes thread</label><div id="notes" class="picklist" style="max-height:180px">${notesHTML(rec)}</div>
        <div style="display:flex;gap:8px;margin-top:6px"><input id="noteTxt" maxlength="1000" placeholder="Write an update, query or instruction…" style="flex:1;border:1px solid #cfd5df;border-radius:8px;padding:7px 10px"><button type="button" class="btn" id="notePost">Post</button></div></div>` : ""}
      ${can("documents") ? `<div class="field" style="margin-top:8px"><label>📎 Documents</label><div id="docList" class="picklist" style="max-height:170px">${docsHTML(rec ? rec.docs : [], !RO)}</div>
        ${RO && !LK ? "" : `<div style="display:flex;gap:8px;margin-top:6px;flex-wrap:wrap"><button type="button" class="btn sm" id="docAdd">📎 Attach files</button>${CL.on ? "" : '<button type="button" class="btn sm" id="docLink">🔗 Link a file already in the folder</button>'}<input type="file" id="docFile" multiple hidden></div>`}
        <span class="small muted" id="docHint"></span></div>` : ""}
      ${rec && ent === "works" && rec.assignedBy ? `<p class="small muted">Assigned to ${esc(rec.assigned)} by ${esc(rec.assignedBy)} on ${esc(new Date(rec.assignedAt).toLocaleString("en-IN"))}</p>` : ""}
      <div class="err" id="recErr"></div></div>
    <div class="mfoot">${meta}<span class="sp"></span>${rec && (ent === "works" ? canDelW(rec) : can("delete") && !RO) ? '<button type="button" class="btn danger" id="recDel">🗑 Delete</button>' : ""}
      ${rec && ent === "works" && can("createWork") ? '<button type="button" class="btn" id="recDup">Duplicate</button>' : ""}
      <button type="button" class="btn" id="recCancel">${RO ? "Close" : "Cancel"}</button>${RO ? "" : '<button class="btn primary" type="submit">Save</button>'}</div></form>`);
  if (RO) $$(".fgrid input,.fgrid select,.fgrid textarea", m).forEach(el => el.disabled = true);
  if (!can("editFees")) E.fields.filter(fd => fd.fee).forEach(fd => { const el = $("#f_" + fd.k, m); if (el) el.disabled = true; });
  if (ent === "works" && !RO) {
    if (!can("assignWork")) { const a = $("#f_assigned", m); const cur = a.value; a.innerHTML = [...new Set([cur, S.user].filter(Boolean))].map(o => `<option ${o === cur ? "selected" : ""}>${esc(o)}</option>`).join(""); if (!rec) a.value = S.user; a.disabled = true; $("#f_reviewer", m).disabled = true; }
    if (!can("markDone")) { const st = $("#f_status", m); if (isClosedSt(st.value)) st.disabled = true; else $$("option", st).forEach(o => { if (isClosedSt(o.value)) o.remove(); }); }
  }
  if ($("#notePost", m)) $("#notePost", m).onclick = () => { const t = $("#noteTxt", m).value.trim(); if (!t) return; rec.notes = rec.notes || []; rec.notes.push({ ts: new Date().toISOString(), user: S.user, text: t });
    log("Note", "Work item", `${describe("works", rec)}: ${t.slice(0, 80)}`); save(); $("#noteTxt", m).value = ""; $("#notes", m).innerHTML = notesHTML(rec); $("#notes", m).scrollTop = 9e9; };
  $("#mx", m).onclick = $("#recCancel", m).onclick = closeModal;
  if ($("#lkReq", m)) $("#lkReq", m).onclick = () => requestChange(rec, () => { closeModal(); editRecord(ent, id, after); });
  $$("[data-newclient]", m).forEach(b => b.onclick = () => quickClient($("#" + b.dataset.newclient, m)));
  $$("[data-addnew]", m).forEach(b => b.onclick = () => addListItem("form", $("#" + b.dataset.for, m)));
  bindGstList(m); bindGstSel(m, rec); if (ent === "clients" && !RO) bindPkgPick(m);
  E.fields.filter(fd => fd.addNew && fd.t === "select").forEach(fd => { const el = $("#f_" + fd.k, m); let prev = el.value;
    el.addEventListener("focus", () => prev = el.value); el.addEventListener("change", () => { if (el.value === "__new__") { el.value = prev; addListItem(fd.addNew, el); } else prev = el.value; }); });
  const pending = [];
  const formVals = () => { const o = {}; E.fields.forEach(fd => { const el = $("#f_" + fd.k, m); if (el && fd.t !== "multi" && fd.t !== "gstlist") o[fd.k] = el.value; }); return { ...(rec || {}), ...o, ...(ent === "clients" ? {} : {}) }; };
  const redrawDocs = () => { if (!$("#docList", m)) return; $("#docList", m).innerHTML = docsHTML(rec ? rec.docs : [], !RO, pending); bindDocs(m, ent, rec, pending, redrawDocs); };
  if ($("#docList", m)) { redrawDocs(); docHint(m, ent, formVals);
    if ($("#docAdd", m)) $("#docAdd", m).onclick = async () => { if (!CL.on && !(await ensureDocRoot())) return; $("#docFile", m).value = ""; $("#docFile", m).click(); };
    if ($("#docFile", m)) $("#docFile", m).onchange = async e => { const files = [...e.target.files]; if (!files.length) return;
      if (rec) { await attachFiles(ent, rec, files); redrawDocs(); } else { files.forEach(f => pending.push(f)); redrawDocs(); } };
    if ($("#docLink", m)) $("#docLink", m).onclick = async () => { const recLike = rec || formVals(); if (!recLike.client && ent !== "clients") return toast("Select the client first");
      const got = await linkExisting(ent, rec || recLike); if (!got.length) return; if (rec) { save(); redrawDocs(); } else { (recLike.docs || []).forEach(d => pending.push({ linked: d, name: d.name })); redrawDocs(); } };
    ["f_client", "f_fy", "f_service", "f_form", "f_code", "f_name"].forEach(k => { const el = $("#" + k, m); if (el) el.addEventListener("change", () => docHint(m, ent, formVals)); });
  }
  if ($("#recDel", m)) $("#recDel", m).onclick = () => { closeModal(); deleteRecord(ent, id, after); };
  if ($("#recDup", m)) $("#recDup", m).onclick = () => { const p = { ...rec }; ["filed", "arn", "udin", "udinDate", "billno", "billdate", "received", "recdate"].forEach(k => p[k] = ""); p.status = "Not started"; closeModal(); editRecord(ent, null, after, p); };
  if (ent === "works" && rec && rec.archived && !isOpen(rec)) { const bd = $(".mbody", m); if (bd) bd.insertAdjacentHTML("afterbegin", `<div class="notice">📦 Archived by ${esc(uname(rec.archivedBy))} on ${dmy((rec.archivedAt || "").slice(0, 10))}. If you reopen it (change the status to an open one) it goes back to the work list.</div>`); }
  if (ent === "works" && !RO) { // auto service + auto assignment
    let manualAssign = !!rec || !!preset._manualAssign; const a = $("#f_assigned", m);
    if (a) a.addEventListener("change", () => manualAssign = true);
    const applyAuto = () => { const fv = $("#f_form", m).value.trim(), sv = svcFor(fv);
      if (sv && $("#f_service", m) && !$("#f_service", m).disabled) { if (![...$("#f_service", m).options].some(o => o.value === sv)) { const o = document.createElement("option"); o.textContent = sv; $("#f_service", m).appendChild(o); } $("#f_service", m).value = sv; }
      if (!rec && !manualAssign && a && !a.disabled && can("assignWork")) { const u = ruleFor($("#f_service", m).value, fv); if (u) { if (![...a.options].some(o => o.value === u)) { const o = document.createElement("option"); o.value = u; o.textContent = ulabel(u); a.appendChild(o); } a.value = u; } }
      if (!rec && $("#f_due", m) && !$("#f_due", m).value) { const d = dueFor(fv, $("#f_fy", m).value, $("#f_period", m).value); if (d) $("#f_due", m).value = d; } };
    ["input", "change"].forEach(ev => $("#f_form", m).addEventListener(ev, applyAuto));
    $("#f_service", m).addEventListener("change", () => { if (!rec && !manualAssign && a && !a.disabled && can("assignWork")) { const u = ruleFor($("#f_service", m).value, $("#f_form", m).value); if (u) a.value = u; } });
    ["f_period", "f_fy"].forEach(k => $("#" + k, m).addEventListener("change", () => { if (!rec) { const d = dueFor($("#f_form", m).value.trim(), $("#f_fy", m).value, $("#f_period", m).value); if (d) $("#f_due", m).value = d; } }));
    if (!rec) { const bt = document.createElement("button"); bt.type = "button"; bt.className = "btn sm"; bt.textContent = "＋＋ Create several tasks at once…"; bt.style.marginLeft = "8px";
      bt.onclick = () => { const c = $("#f_client", m).value; closeModal(); multiTaskDialog({ clients: c ? [c] : [] }); }; $(".mhead h3", m).appendChild(bt); }
  }
  if (ent === "works" && $("#f_status", m) && $("#f_client", m)) { const sEl = $("#f_status", m);
    const refreshSt = () => { const cur = sEl.value, list = allStatus($("#f_client", m).value); if (cur && cur !== "__new__" && !list.includes(cur)) list.push(cur);
      [...sEl.options].filter(o => o.value && o.value !== "__new__").forEach(o => o.remove()); const nw = sEl.querySelector('option[value="__new__"]');
      list.filter(x => can("markDone") || !isClosedSt(x) || x === cur).forEach(x => { const o = document.createElement("option"); o.value = x; o.textContent = stLabel(x); sEl.insertBefore(o, nw); }); sEl.value = cur; };
    $("#f_client", m).addEventListener("change", refreshSt); refreshSt(); }
  if (ent === "works" && $("#f_udinReq", m)) { const ur = $("#f_udinReq", m), ui = $("#f_udin", m), ud = $("#f_udinDate", m);
    if (rec && !rec.udinReq) ur.value = rec.udin ? "Yes" : "No";
    let urTouched = !!rec; ur.addEventListener("change", () => urTouched = true);
    const showU = () => { const on = ur.value === "Yes"; [ui, ud].forEach(el => { if (el) el.closest(".field").hidden = !on; }); };
    const autoU = () => { if (!urTouched && $("#f_service", m)) { ur.value = UDINSVC.includes($("#f_service", m).value) ? "Yes" : "No"; showU(); } };
    ur.addEventListener("change", showU); ["input", "change"].forEach(ev => { if ($("#f_form", m)) $("#f_form", m).addEventListener(ev, () => setTimeout(autoU)); }); if ($("#f_service", m)) $("#f_service", m).addEventListener("change", autoU);
    if (ui && ud && !RO) ui.addEventListener("input", () => { if (ui.value.trim() && !ud.value) ud.value = today(); });
    if (!rec) autoU(); showU(); }
  if (ent === "works") { // auto-mark done when filed date entered
    if ($("#f_filed", m)) $("#f_filed", m).addEventListener("change", e => { if (e.target.value && !isClosedSt($("#f_status", m).value) && stg($("#f_status", m).value) !== "Under review") $("#f_status", m).value = can("markDone") ? "Filed / Done" : "Under review"; });
  }
  $("#recForm", m).addEventListener("submit", async e => {
    e.preventDefault(); if (RO) return; const err = $("#recErr", m); const o = {};
    for (const fd of E.fields) {
      const el = $("#f_" + fd.k, m); let v; if (el.disabled && fd.t !== "multi") { if (!(ent === "works" && fd.k === "assigned" && !rec)) continue; }
      if (fd.t === "multi") v = $$("input:checked", el).map(x => x.value);
      else if (fd.t === "gstlist") v = $$(".gstr", el).map(r => ({ g: $(".gg", r).value.trim().toUpperCase(), label: $(".gl", r).value.trim() })).filter(x => x.g);
      else { v = (el.value || "").trim(); if (fd.upper) v = v.toUpperCase(); }
      if (fd.req && (!v || (Array.isArray(v) && !v.length))) { err.textContent = `${fd.l} is required.`; el.focus(); return; }
      o[fd.k] = v;
    }
    if (ent === "clients") {
      if (S.db.clients.some(c => c.code.toUpperCase() === o.code && c.id !== id)) { err.textContent = `Client code ${o.code} already exists.`; return; }
      if (o.pan && !/^[A-Z]{5}[0-9]{4}[A-Z]$/.test(o.pan)) { err.textContent = "PAN format should be AAAAA9999A."; return; }
      const G = o.gstins || []; const badG = G.find(x => !GSTRE.test(x.g)); if (badG) { err.textContent = `GSTIN ${badG.g} is not in the right format (15 characters, e.g. 06AAAAA9999A1Z5).`; return; }
      const dupIn = G.find((x, i) => G.findIndex(y => y.g === x.g) !== i); if (dupIn) { err.textContent = `GSTIN ${dupIn.g} is entered twice.`; return; }
      if (!o.pan && G.length) o.pan = G[0].g.slice(2, 12);
      const panMis = G.find(x => o.pan && x.g.slice(2, 12) !== o.pan); if (panMis && !e._panOk) { err.innerHTML = `GSTIN ${esc(panMis.g)} belongs to PAN ${esc(panMis.g.slice(2, 12))}, not ${esc(o.pan)}. All GSTINs of one client share its PAN. <button type="button" class="btn sm" id="panOk">Save anyway</button>`; $("#panOk", m).onclick = () => { const ev = new Event("submit", { cancelable: true }); ev._panOk = true; ev._clOk = e._clOk; $("#recForm", m).dispatchEvent(ev); }; return; }
      const other = S.db.clients.filter(c => c.id !== id); const gHit = G.map(x => [x, other.find(c => gstsOf(c).some(y => y.g === x.g))]).find(z => z[1]);
      if (gHit) { err.innerHTML = `GSTIN ${esc(gHit[0].g)} is already under <b>${esc(gHit[1].name)}</b> (${esc(gHit[1].code)}). Add any new GSTIN to that client instead of creating another one, or use Clients › Merge duplicates.`; return; }
      const pHit = o.pan && other.find(c => (c.pan || (gstsOf(c)[0] || {}).g?.slice(2, 12) || "") === o.pan);
      if (pHit && !e._clOk) { err.innerHTML = `<b>${esc(pHit.name)}</b> (${esc(pHit.code)}) has the same PAN. If this is the same business with another GSTIN, add the GSTIN to that client instead. <button type="button" class="btn sm" id="clOk">It is a different client – save</button>`; $("#clOk", m).onclick = () => { const ev = new Event("submit", { cancelable: true }); ev._clOk = true; ev._panOk = e._panOk; $("#recForm", m).dispatchEvent(ev); }; return; }
      o.gstin = G.length ? G[0].g : "";
      if (o.email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(o.email)) { err.textContent = "Email address looks invalid."; return; }
    }
    if (ent === "works" && o.udinReq !== undefined) { if (o.udinReq !== "Yes") { o.udin = ""; o.udinDate = ""; } else if (o.udin && !o.udinDate) o.udinDate = today(); }
    if (ent === "works" && o.udinReq === "Yes" && o.udin && !/^[0-9A-Z]{18}$/.test(o.udin) && !e._udinOk) { err.innerHTML = 'UDIN is normally 18 characters. <button type="button" class="btn sm" id="udinOk">Save anyway</button>'; $("#udinOk", m).onclick = () => { const ev = new Event("submit", { cancelable: true }); ev._udinOk = true; $("#recForm", m).dispatchEvent(ev); }; return; }
    if (ent === "works" && o.filed && o.due && o.filed < "2000-01-01") { err.textContent = "Check the filing date."; return; }
    if (ent === "udins" && !/^[0-9A-Z]{18}$/.test(o.udin) && !e._udinOk) { err.innerHTML = 'UDIN is normally 18 characters. <button type="button" class="btn sm" id="udinOk">Save anyway</button>'; $("#udinOk", m).onclick = () => { const ev = new Event("submit", { cancelable: true }); ev._udinOk = true; $("#recForm", m).dispatchEvent(ev); }; return; }
    const now = new Date().toISOString();
    if (ent === "works" && !can("markDone") && isClosedSt(o.status) && (!rec || rec.status !== o.status)) { err.textContent = "You cannot mark work as done – set it to 'Under review'."; return; }
    if (ent === "works" && o.assigned !== undefined && o.assigned !== (rec ? rec.assigned : undefined) && o.assigned) { o.assignedBy = S.user; o.assignedAt = now; if (o.assigned !== S.user) log("Assigned", "Work item", `${cname(o.client)} – ${o.form} → ${o.assigned}`); }
    if (ent === "works" && rec && o.status && o.status !== rec.status) log("Status", "Work item", `${describe("works", rec)} → ${o.status}`);
    if (ent === "works" && o.form && !allForms().some(x => x.toLowerCase() === o.form.toLowerCase())) { (S.db.settings.customForms = S.db.settings.customForms || []).push(o.form); log("Added", "Task type", o.form); }
    if (ent === "works" && o.service === "__new__") { err.textContent = "Choose a service."; return; }
    if (ent === "works") { const L = gstsOf(clientById(o.client)); if (o.gstin && !L.some(x => x.g === o.gstin)) o.gstin = ""; if (!o.gstin && L.length && (o.service === "GST" || L.length > 1)) o.gstin = L[0].g; }
    if (ent === "works" && !rec && !e._dupOk) { const dup = S.db.works.find(w => w.id !== id && w.client === o.client && (w.gstin || "") === (o.gstin || "") && (w.form || "").toLowerCase() === (o.form || "").toLowerCase() && (w.fy || "") === (o.fy || "") && (w.period || "") === (o.period || "") && stg(w.status) !== "Cancelled");
      if (dup) { err.innerHTML = `This task already exists: <b>${esc(dup.form)} ${esc(dup.period || "")} ${esc(dup.fy || "")}</b> (${esc(dup.status)}${dup.archived ? ", archived" : ""}${dup.assigned ? ", " + esc(uname(dup.assigned)) : ""}). <button type="button" class="btn sm" id="dupOpen">Open it</button> <button type="button" class="btn sm" id="dupOk">Save a second copy</button>`;
        $("#dupOpen", m).onclick = () => { closeModal(); editRecord("works", dup.id, after); };
        $("#dupOk", m).onclick = () => { const ev = new Event("submit", { cancelable: true }); ev._dupOk = true; $("#recForm", m).dispatchEvent(ev); }; return; } }
    if (ent === "works" && o.form && o.service && !SVCMAP.some(([re]) => re.test(o.form)) && (S.db.settings.formService || {})[o.form] !== o.service) { (S.db.settings.formService = S.db.settings.formService || {})[o.form] = o.service; }
    let target = rec;
    if (rec && LK && LK.mode === "grant" && LK.type === "modify") { rec.grant.used = now; log("Approval used", "Work item", `${describe("works", rec)} – one-time modification used`); }
    if (rec) { Object.assign(rec, o, { updatedBy: S.user, updatedAt: now }); log("Edited", E.one, describe(ent, rec)); }
    else { const r = { id: uid(), ...o, createdBy: S.user, createdAt: now }; S.db[ent].push(r); log("Added", E.one, describe(ent, r)); target = r; }
    if (pending.length) { const files = pending.filter(x => !x.linked), links = pending.filter(x => x.linked).map(x => x.linked);
      target.docs = (target.docs || []).concat(links); if (files.length) { err.textContent = "Saving documents…"; await attachFiles(ent, target, files); } }
    save(); closeModal(); toast(`${E.one} saved`); (after || (() => go(S.route)))();
  });
}
function describe(ent, r) {
  switch (ent) {
    case "clients": return `${r.code} – ${r.name}`;
    case "works": return `${cname(r.client)} – ${r.form} ${r.fy || ""} ${r.period || ""} [${r.status}]`;
    case "challans": return `${cname(r.client)} – ${r.taxtype} ₹${inr(r.amount)} ${r.cpin || ""}`;
    case "reimb": return `${cname(r.client)} – ${r.nature} ₹${inr(r.amount)}`;
    case "udins": return `${cname(r.client)} – ${r.udin}`;
    case "dsc": return `${cname(r.client)} – DSC of ${r.holder} (expires ${dmy(r.expiry)})`;
    case "docreq": return `${cname(r.client)} – ${r.title}`;
    case "engage": return `${cname(r.client)} – ${r.type} ${r.fy || ""} [${r.status || "Draft"}]`;
  } return "";
}
async function deleteRecord(ent, id, after) {
  const r = S.db[ent].find(x => x.id === id); if (!r) return;
  if (ent === "works") return deleteWorks([r], after);
  if (!can("delete") && !(ent === "works" && canSelfDelete(r))) return toast("You do not have the right to delete this record");
  if (ent === "clients") {
    const linked = ["works", "challans", "reimb", "udins", "dsc", "docreq", "engage", "creds", "cases"].reduce((a, k) => a + (S.db[k] || []).filter(x => x.client === id).length, 0) + (S.db.sgroups || []).filter(g => g.members.some(x => x.client === id)).length + (S.db.bin || []).filter(b => b.item.client === id).length;
    if (linked) return alertBox("Cannot delete", `<p>${esc(r.name)} has ${linked} linked record(s). Delete those first, or mark the client <b>Inactive</b> instead.</p>`);
  }
  if (!(await confirmBox("Delete record", `<p>Delete <b>${esc(describe(ent, r))}</b>? This cannot be undone.</p>`, "Delete"))) return;
  S.db[ent] = S.db[ent].filter(x => x.id !== id); log("Deleted", ENT[ent].one, describe(ent, r)); save(); toast("Deleted");
  if (ent === "clients") go("clients"); else (after || (() => go(S.route)))();
}

/* ------------------------------------------------------------------ RECURRING COMPLIANCES */
const D = (y, m, d) => `${y}-${pad(m)}-${pad(d)}`;
const FYMONTHS = Y => ["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"].map((p, i) => ({ p, y: i < 9 ? Y : Y + 1, m: ((i + 3) % 12) + 1 }));
const nxt = (y, m) => m === 12 ? [y + 1, 1] : [y, m + 1];
const monthly = (day, marchSpecial) => Y => FYMONTHS(Y).map(o => { const [y, m] = nxt(o.y, o.m); return { period: o.p, due: marchSpecial && o.p === "Mar" ? D(y, 4, 30) : D(y, m, day) }; });
const quarterly = dates => Y => dates.map((d, i) => ({ period: "Q" + (i + 1), due: D(d[0] === 0 ? Y : Y + 1, d[1], d[2]) }));
const annual = (yo, m, d) => Y => [{ period: "Annual", due: D(Y + yo, m, d) }];
const PRESETS = [
  { g: "GST", k: "g1m", l: "GSTR-1 – monthly (11th)", svc: "GST", form: "GSTR-1", f: monthly(11) },
  { g: "GST", k: "g3m", l: "GSTR-3B – monthly (20th)", svc: "GST", form: "GSTR-3B", f: monthly(20) },
  { g: "GST", k: "g1q", l: "GSTR-1 – QRMP quarterly (13th)", svc: "GST", form: "GSTR-1 (QRMP)", f: quarterly([[0, 7, 13], [0, 10, 13], [1, 1, 13], [1, 4, 13]]) },
  { g: "GST", k: "g3q24", l: "GSTR-3B – QRMP (24th, e.g. Haryana/Delhi)", svc: "GST", form: "GSTR-3B (QRMP)", f: quarterly([[0, 7, 24], [0, 10, 24], [1, 1, 24], [1, 4, 24]]) },
  { g: "GST", k: "g3q22", l: "GSTR-3B – QRMP (22nd states)", svc: "GST", form: "GSTR-3B (QRMP)", f: quarterly([[0, 7, 22], [0, 10, 22], [1, 1, 22], [1, 4, 22]]) },
  { g: "GST", k: "cmp", l: "CMP-08 – composition (18th)", svc: "GST", form: "CMP-08", f: quarterly([[0, 7, 18], [0, 10, 18], [1, 1, 18], [1, 4, 18]]) },
  { g: "GST", k: "g4", l: "GSTR-4 – annual (30 Jun)", svc: "GST", form: "GSTR-4", f: annual(1, 6, 30) },
  { g: "GST", k: "g9", l: "GSTR-9 – annual (31 Dec)", svc: "GST", form: "GSTR-9", f: annual(1, 12, 31) },
  { g: "GST", k: "g9c", l: "GSTR-9C (31 Dec)", svc: "GST", form: "GSTR-9C", f: annual(1, 12, 31) },
  { g: "TDS", k: "tdsp", l: "TDS/TCS payment – monthly (7th; Mar 30 Apr)", svc: "TDS Challan", form: "TDS/TCS payment", f: monthly(7, true) },
  { g: "TDS", k: "24q", l: "Form 24Q – quarterly", svc: "TDS Return", form: "Form 24Q", f: quarterly([[0, 7, 31], [0, 10, 31], [1, 1, 31], [1, 5, 31]]) },
  { g: "TDS", k: "26q", l: "Form 26Q – quarterly", svc: "TDS Return", form: "Form 26Q", f: quarterly([[0, 7, 31], [0, 10, 31], [1, 1, 31], [1, 5, 31]]) },
  { g: "TDS", k: "27q", l: "Form 27Q – quarterly", svc: "TDS Return", form: "Form 27Q", f: quarterly([[0, 7, 31], [0, 10, 31], [1, 1, 31], [1, 5, 31]]) },
  { g: "TDS", k: "27eq", l: "Form 27EQ (TCS) – quarterly", svc: "TDS Return", form: "Form 27EQ", f: quarterly([[0, 7, 15], [0, 10, 15], [1, 1, 15], [1, 5, 15]]) },
  { g: "Income Tax", k: "adv", l: "Advance tax – 4 instalments", svc: "Advance Tax", form: "Advance tax", f: quarterly([[0, 6, 15], [0, 9, 15], [0, 12, 15], [1, 3, 15]]) },
  { g: "Income Tax", k: "itrn", l: "ITR – non-audit (31 Jul)", svc: "Income Tax Return", form: "ITR (non-audit)", f: annual(1, 7, 31) },
  { g: "Income Tax", k: "ta", l: "Tax audit report 3CD (30 Sep)", svc: "Tax Audit", form: "Tax audit (3CD)", f: annual(1, 9, 30) },
  { g: "Income Tax", k: "itra", l: "ITR – audit case (31 Oct)", svc: "Income Tax Return", form: "ITR (audit)", f: annual(1, 10, 31) },
  { g: "ROC", k: "adt1", l: "ADT-1 (15 Oct, AGM 30 Sep)", svc: "ROC / MCA", form: "ADT-1", f: annual(1, 10, 15) },
  { g: "ROC", k: "aoc4", l: "AOC-4 (30 days from AGM – 29 Oct)", svc: "ROC / MCA", form: "AOC-4", f: annual(1, 10, 29) },
  { g: "ROC", k: "mgt7", l: "MGT-7 / 7A (60 days from AGM – 28 Nov)", svc: "ROC / MCA", form: "MGT-7 / MGT-7A", f: annual(1, 11, 28) },
  { g: "ROC", k: "dpt3", l: "DPT-3 (30 Jun)", svc: "ROC / MCA", form: "DPT-3", f: annual(1, 6, 30) },
  { g: "ROC", k: "dir3", l: "DIR-3 KYC (30 Sep)", svc: "ROC / MCA", form: "DIR-3 KYC", f: annual(1, 9, 30) },
  { g: "ROC", k: "llp11", l: "LLP Form 11 (30 May)", svc: "ROC / MCA", form: "LLP Form 11", f: annual(1, 5, 30) },
  { g: "ROC", k: "llp8", l: "LLP Form 8 (30 Oct)", svc: "ROC / MCA", form: "LLP Form 8", f: annual(1, 10, 30) },
  { g: "Audit", k: "stat", l: "Statutory audit report (by 30 Sep)", svc: "Statutory Audit", form: "Statutory audit report", f: annual(1, 9, 1) },
];
function recurringDialog(pre = {}) {
  if (!S.db.clients.length) return alertBox("Add a client first", "Create clients before generating compliances.");
  if (!can("createWork")) return toast("You do not have the right to create work");
  const cl = vC().filter(c => c.active !== "Inactive").sort((a, b) => a.name.localeCompare(b.name));
  const groups = [...new Set(PRESETS.map(p => p.g))];
  const m = openModal(`<div class="mhead"><h3>Generate recurring compliances</h3><button class="btn sm" id="mx">✕</button></div>
    <div class="mbody">
      <p class="small muted" style="margin-top:0">Creates one work item per period with the standard due date. Existing items (same client, return, FY and period) are skipped. Check notifications for extended due dates.</p>
      <div class="fgrid">
        <div class="field"><label>Financial year</label><select id="rFY">${FYS.map(y => `<option ${y === (pre.fy || fyLabel(curFYStart())) ? "selected" : ""}>${y}</option>`).join("")}</select></div>
        <div class="field"><label>Assign to</label><select id="rStaff">${can("assignWork") ? `<option value="__auto__">Auto – use assignment rules</option><option value="">(unassigned)</option>${(S.db.settings.staff || []).map(s => `<option value="${esc(s)}">${esc(ulabel(s))}</option>`).join("")}` : `<option value="${esc(S.user)}">${esc(ulabel(S.user))}</option>`}</select></div>
        ${can("editFees") ? '<div class="field"><label>Fee per item (₹, optional)</label><input id="rFee" type="number" min="0" step="0.01"></div>' : ""}
        <div class="field"><label>Generate for</label><select id="rScope"><option value="year">Whole year</option><option value="month">One month</option><option value="quarter">One quarter</option><option value="once">One-time task</option></select></div>
        <div class="field" id="rWhenF"><label>Only from date (skip earlier due dates)</label><input id="rFrom" type="date"></div>
        <div class="field" id="rMonF" hidden><label>Month</label><select id="rMon">${FYMONTHS(2000).map(o => `<option ${o.p === MONTHS[(new Date().getMonth() + 9) % 12] ? "selected" : ""}>${o.p}</option>`).join("")}</select></div>
        <div class="field" id="rQtrF" hidden><label>Quarter</label><select id="rQtr">${["Q1 (Apr–Jun)", "Q2 (Jul–Sep)", "Q3 (Oct–Dec)", "Q4 (Jan–Mar)"].map((q, i) => `<option value="Q${i + 1}">${q}</option>`).join("")}</select></div>
        <div class="field full" id="rOnceF" hidden><div class="fgrid" style="margin:0"><div class="field"><label class="req">Task / return name</label><input id="rOName" maxlength="120" placeholder="e.g. GST registration amendment"></div>
          <div class="field"><label>Service</label><select id="rOSvc">${allSvc().map(x => `<option>${esc(x)}</option>`).join("")}</select></div><div class="field"><label class="req">Due date</label><input id="rODue" type="date"></div>
          <div class="field"><label>Period (optional)</label><input id="rOPer" maxlength="40" placeholder="e.g. Oct, Q3, Annual"></div></div></div>
        <div class="field full"><label>Clients <span class="muted">(<b id="rCnt">0</b> of ${cl.length} selected)</span> &nbsp; <button type="button" class="link" id="rAll">select all shown</button> · <button type="button" class="link" id="rNone">none</button></label>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px;align-items:center">
            <select style="width:auto;flex:1 1 200px" id="rBySvc" title="Tick every client that has this service in Services covered"><option value="">Select by service…</option>${allSvc().map(x => `<option>${esc(x)}</option>`).join("")}</select>
            <select style="width:auto;flex:1 1 200px" id="rByPkg" title="Tick every client on this package"><option value="">Select by package…</option>${pkgs().map(p => `<option>${esc(p.name)}</option>`).join("")}</select>
            <select style="width:auto;flex:1 1 200px" id="rType"><option value="">Select by client type…</option>${CTYPE.map(t => `<option>${t}</option>`).join("")}</select>
            <label class="small" style="display:flex;gap:5px;align-items:center;font-weight:400"><input type="checkbox" id="rOnlySel"> show selected only</label></div>
          <div class="small muted" id="rSmart" style="margin-bottom:6px"></div>
          <input id="rQ" placeholder="filter clients…" style="margin-bottom:6px"><div class="picklist" id="rCl">${cl.map(c => { const pk = pkgOf(c); return `<label data-n="${esc((c.name + " " + c.code).toLowerCase())}"><input type="checkbox" value="${c.id}" data-t="${esc(c.type)}" data-s="${esc((c.services || []).join("|"))}" data-p="${esc(pk)}" ${(pre.clients || []).includes(c.id) ? "checked" : ""}>${esc(c.name)} <span class="muted small">${esc(c.code)} · ${esc(c.type)}${pk ? " · " + esc(pk) : ""}</span></label>`; }).join("")}</div></div>
        <div class="field full" id="rCompF"><label>Compliances</label>${groups.map(g => `<div class="small b" style="margin-top:6px">${g}</div><div class="checks">${PRESETS.filter(p => p.g === g).map(p => `<label><input type="checkbox" value="${p.k}" ${(pre.keys || []).includes(p.k) ? "checked" : ""}>${esc(p.l)}</label>`).join("")}</div>`).join("")}</div>
      </div><div class="err" id="rErr"></div>
    </div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="rCancel">Cancel</button><button class="btn primary" id="rGo">Generate</button></div>`);
  $("#mx", m).onclick = $("#rCancel", m).onclick = closeModal;
  const boxes = () => $$("#rCl input", m);
  const refresh = () => { const q = $("#rQ", m).value.toLowerCase(), only = $("#rOnlySel", m).checked; $$("#rCl label", m).forEach(l => { const x = $("input", l); l.hidden = !l.dataset.n.includes(q) || (only && !x.checked); }); $("#rCnt", m).textContent = boxes().filter(x => x.checked).length; };
  const tick = (fn, what) => { let n = 0; boxes().forEach(x => { if (fn(x) && !x.checked) { x.checked = true; n++; } }); refresh(); toast(`${n} client(s) added – ${what}`); };
  $("#rAll", m).onclick = () => { $$("#rCl label:not([hidden]) input", m).forEach(x => x.checked = true); refresh(); };
  $("#rNone", m).onclick = () => { boxes().forEach(x => x.checked = false); refresh(); };
  $("#rType", m).onchange = e => { const v = e.target.value; e.target.value = ""; if (v) tick(x => x.dataset.t === v, v); };
  $("#rBySvc", m).onchange = e => { const v = e.target.value; e.target.value = ""; if (v) tick(x => x.dataset.s.split("|").includes(v), v); };
  $("#rByPkg", m).onchange = e => { const v = e.target.value; e.target.value = ""; if (v) tick(x => x.dataset.p === v, v); };
  $("#rQ", m).oninput = refresh; $("#rCl", m).addEventListener("change", refresh); $("#rOnlySel", m).onchange = refresh;
  const scope = () => $("#rScope", m).value;
  $("#rScope", m).onchange = () => { const v = scope(); $("#rMonF", m).hidden = v !== "month"; $("#rQtrF", m).hidden = v !== "quarter"; $("#rOnceF", m).hidden = v !== "once"; $("#rCompF", m).hidden = v === "once"; $("#rWhenF", m).hidden = v === "once"; };
  /* opened from a tracker: pre-select the clients whose Services covered include that tracker's service */
  if (!(pre.clients || []).length && (pre.keys || []).length) { const sv = [...new Set(pre.keys.map(k => (PRESETS.find(p => p.k === k) || {}).svc).filter(Boolean))];
    let n = 0; boxes().forEach(x => { if (x.dataset.s.split("|").some(s => sv.includes(s))) { x.checked = true; n++; } });
    $("#rSmart", m).innerHTML = n ? `✓ ${n} client(s) with <b>${sv.map(esc).join(" / ")}</b> in Services covered are selected. Add or remove any client below.` : `No client has ${sv.map(esc).join(" / ")} ticked in Services covered yet – select clients below, or tick services in Clients › Services by client.`;
    if (n) $("#rOnlySel", m).checked = true; }
  refresh();
  $("#rGo", m).onclick = () => {
    const clients = $$("#rCl input:checked", m).map(x => x.value), keys = $$("#rCompF .checks input:checked", m).map(x => x.value), sc = scope();
    if (!clients.length) return $("#rErr", m).textContent = "Select at least one client.";
    const fy = $("#rFY", m).value, Y = parseInt(fy), staff = $("#rStaff", m).value, fee = $("#rFee", m) ? $("#rFee", m).value : "", from = sc === "once" ? "" : $("#rFrom", m).value;
    let made = 0, skipped = 0; const now = new Date().toISOString();
    if (sc === "once") { const nm = $("#rOName", m).value.trim(), sv = $("#rOSvc", m).value, due = $("#rODue", m).value, per = $("#rOPer", m).value.trim() || "One-time";
      if (!nm || !due) return $("#rErr", m).textContent = "Enter the task name and due date.";
      clients.forEach(cid => { const GL = sv === "GST" ? gstsOf(clientById(cid)).map(x => x.g) : []; (GL.length ? GL : [""]).forEach(g => {
        if (S.db.works.some(w => w.client === cid && w.form === nm && w.fy === fy && w.period === per && (!g || (w.gstin || "") === g))) { skipped++; return; }
        const as = staff === "__auto__" ? ruleFor(sv, nm) : staff;
        S.db.works.push({ id: uid(), client: cid, gstin: g, service: sv, form: nm, fy, period: per, due, filed: "", status: "Not started", priority: "Normal", assigned: as, assignedBy: as ? S.user : "", assignedAt: as ? now : "", reviewer: "", arn: "", udin: "", fee: fee || "", billno: "", billdate: "", received: "", recdate: "", remarks: "", createdBy: S.user, createdAt: now }); made++; }); });
      log("Generated", "Work item", `${made} one-time task(s) "${nm}" (${clients.length} client(s))`); save(); closeModal(); toast(`${made} task(s) created${skipped ? `, ${skipped} already existed` : ""}`); go(pre.back || "works"); return; }
    if (!keys.length) return $("#rErr", m).textContent = "Select at least one compliance.";
    const QOF = { Apr: "Q1", May: "Q1", Jun: "Q1", Jul: "Q2", Aug: "Q2", Sep: "Q2", Oct: "Q3", Nov: "Q3", Dec: "Q3", Jan: "Q4", Feb: "Q4", Mar: "Q4" };
    const mon = $("#rMon", m).value, qtr = $("#rQtr", m).value;
    const inScope = per => sc === "year" ? true : sc === "month" ? (per === mon || per === QOF[mon] && QEND[per] === mon) : (per === qtr || QOF[per] === qtr);
    clients.forEach(cid => keys.forEach(k => { const p = PRESETS.find(x => x.k === k); const GL = p.svc === "GST" ? gstsOf(clientById(cid)).map(x => x.g) : []; (GL.length ? GL : [""]).forEach(g =>
      p.f(Y).forEach(it => {
        if (from && it.due < from) return; if (!inScope(it.period)) return;
        if (S.db.works.some(w => w.client === cid && w.form === p.form && w.fy === fy && w.period === it.period && (!g || (w.gstin || (GL[0] || "")) === g))) { skipped++; return; }
        S.db.works.push({ id: uid(), client: cid, gstin: g, service: p.svc, form: p.form, fy, period: it.period, due: it.due, filed: "", status: "Not started", priority: "Normal",
          assigned: staff === "__auto__" ? ruleFor(p.svc, p.form) : staff, assignedBy: (staff === "__auto__" ? ruleFor(p.svc, p.form) : staff) ? S.user : "", assignedAt: staff ? now : "", reviewer: "", arn: "", udin: "", fee: fee || "", billno: "", billdate: "", received: "", recdate: "", remarks: "", createdBy: S.user, createdAt: now });
        made++;
      })); }));
    if (!made && !skipped) return $("#rErr", m).textContent = sc === "year" ? "Nothing to create for these choices." : "None of the ticked compliances falls in this " + (sc === "month" ? "month" : "quarter") + " (annual returns are created with Whole year).";
    log("Generated", "Work item", `${made} recurring item(s) for FY ${fy}${sc === "month" ? " – " + mon : sc === "quarter" ? " – " + qtr : ""} (${clients.length} client(s))`); save(); closeModal();
    toast(`${made} work item(s) created${skipped ? `, ${skipped} already existed` : ""}`); go(pre.back || "works");
  };
}

/* ------------------------------------------------------------------ DASHBOARD */
function dashClientAlerts() {
  const out = []; const ds = can("dsc") ? vR("dsc").filter(r => { const k = dscSt(r).k; return k === "Expired" || k === "Expiring in 30 days"; }).sort((a, b) => a.expiry.localeCompare(b.expiry)) : [];
  if (ds.length) out.push(`<div class="card" style="margin-top:14px"><h3>🔑 DSC expiring or expired <span class="muted small" style="font-weight:400">(${ds.length})</span></h3><div class="tablewrap" style="border:none"><table class="t"><thead><tr><th>Client</th><th>Holder</th><th>Expiry</th><th>Status</th><th>Token with</th></tr></thead><tbody>${ds.slice(0, 8).map(r => { const t = dscSt(r); return `<tr data-dsc="${r.id}"><td><b>${esc(cname(r.client))}</b></td><td>${esc(r.holder)}</td><td>${dmy(r.expiry)}</td><td><span class="chip ${t.cls}">${t.txt}</span></td><td>${esc(r.custody || "")}</td></tr>`; }).join("")}</tbody></table></div>${ds.length > 8 ? `<button class="link" data-go="dsc">View all ${ds.length} →</button>` : ""}</div>`);
  const nc = can("cases") ? vR("cases").filter(c => caseOver(c) || caseSoon(c)) : [];
  if (nc.length) out.push(`<div class="notice ${nc.some(caseOver) ? "warn" : ""}" style="margin-top:14px">⚖ <b>${nc.filter(caseOver).length} notice(s) overdue</b> and <b>${nc.filter(caseSoon).length} due in the next 7 days</b>. <button class="btn sm" data-go="cases">Open Notices & Cases</button></div>`);
  const dr = can("docreq") ? vR("docreq").filter(r => drPend(r).length && r.due && r.due < today()) : [];
  if (dr.length) out.push(`<div class="notice warn" style="margin-top:14px">📨 <b>${dr.length} document request(s)</b> are past their date with documents still pending. <button class="btn sm" data-go="docreq">Open Document Requests</button></div>`);
  setTimeout(() => { $$("[data-dsc]").forEach(tr => tr.onclick = () => editRecord("dsc", tr.dataset.dsc, viewDashboard)); $$("[data-go]").forEach(b => b.onclick = () => { if (b.dataset.go === "dsc") S.f.dsc = { dst: "" }; if (b.dataset.go === "docreq") S.f.docreq = { drs: "Pending" }; if (b.dataset.go === "cases") S.f.cases = { st: "open" }; go(b.dataset.go); }); }, 0);
  return out.join("");
}
function viewDashboard() {
  setTitle("Dashboard");
  const W = visW(), t = today(), mStart = t.slice(0, 8) + "01";
  const open = W.filter(isOpen), overdue = open.filter(w => delayInfo(w).overdue), soon = open.filter(w => w.due && w.due >= t && w.due <= addDays(t, 7));
  const doneM = W.filter(w => stg(w.status) === "Filed / Done" && w.filed >= mStart && w.filed <= t);
  const feeOut = W.reduce((a, w) => a + Math.max(0, woOut(w)), 0);
  const reimbDue = vR("challans").reduce((a, c) => a + Math.max(0, chReimbDue(c)), 0) + vR("reimb").reduce((a, r) => a + Math.max(0, reBal(r)), 0);
  const kpi = (l, v, cls, act) => `<div class="kpi ${cls}" data-act="${act}"><div class="l">${l}</div><div class="v">${v}</div></div>`;
  const svc = allSvc().map(s => { const all = W.filter(w => w.service === s); const op = all.filter(isOpen).length; return { s, all: all.length, op, od: all.filter(w => isOpen(w) && delayInfo(w).overdue).length }; }).filter(x => x.all);
  const staff = [...new Set(open.map(w => w.assigned || "(unassigned)"))].map(s => ({ s, n: open.filter(w => (w.assigned || "(unassigned)") === s).length, od: overdue.filter(w => (w.assigned || "(unassigned)") === s).length })).sort((a, b) => b.n - a.n);
  const dueOrd = (a, b) => (a.due || "").localeCompare(b.due || "") || cname(a.client).localeCompare(cname(b.client)) || (a.form || "").localeCompare(b.form || "");
  const due14 = open.filter(w => w.due && w.due >= t && w.due <= addDays(t, 14)).sort(dueOrd);
  const mini = (rows) => rows.length ? `<table class="t"><thead><tr><th>Client</th><th>Return</th><th>Period</th><th>Due</th><th>Timeline</th><th>Done by</th></tr></thead><tbody>${rows.slice(0, 12).map(w => { const d = delayInfo(w); return `<tr data-id="${w.id}"><td><b>${esc(cname(w.client))}</b></td><td>${esc(w.form)}</td><td>${esc([w.fy, w.period].filter(Boolean).join(" · "))}</td><td>${dmy(w.due)}</td><td><span class="chip ${d.cls}">${d.txt}</span></td><td>${esc(w.assigned)}</td></tr>`; }).join("")}</tbody></table>${rows.length > 12 ? `<div class="count">+ ${rows.length - 12} more</div>` : ""}` : `<div class="empty">Nothing here 🎉</div>`;
  $("#view").innerHTML = `
    <div class="grid kpis">
      ${kpi("Active clients", vC().filter(c => c.active !== "Inactive").length, "", "clients")}
      ${kpi("Open work items", open.length, "", "open")}
      ${kpi("Overdue", overdue.length, overdue.length ? "red" : "green", "overdue")}
      ${kpi("Due in next 7 days", soon.length, soon.length ? "amber" : "", "soon")}
      ${kpi("Done this month", doneM.length, "green", "done")}
      ${can("viewFees") ? kpi("Fees outstanding (₹)", inr0(feeOut), feeOut ? "red" : "", "fees") : ""}
      ${can("viewFees") && can("reimb") ? kpi("Reimbursements due (₹)", inr0(reimbDue), reimbDue ? "amber" : "", "reimb") : ""}
    </div>
    ${apprCount() ? `<div class="card" style="margin-top:14px;border-color:#f3c27a;background:#fffaf0;cursor:pointer" id="dReq"><b>🔔 ${apprCount()} item(s) waiting for your approval</b> – ${[pendReq().length ? pendReq().length + " change request(s)" : "", reviewTasks().length ? reviewTasks().length + " task(s) sent for review" : "", pendDel().length ? pendDel().length + " deletion(s) to approve" : ""].filter(Boolean).join(", ")}. <span class="link">Open Approvals →</span></div>` : ""}
    ${dashClientAlerts()}
    <div class="grid" style="margin-top:14px">
      <div class="card"><h3>⚠ Overdue <span class="muted small" style="font-weight:400">(${overdue.length}, oldest first)</span></h3><div id="dOver" style="overflow-x:auto">${mini(overdue.sort(dueOrd))}</div>${overdue.length > 12 ? `<button class="link" id="dOverAll" style="margin-top:8px">View all ${overdue.length} overdue →</button>` : ""}</div>
      <div class="card"><h3>📅 Due in the next 14 days <span class="muted small" style="font-weight:400">(${due14.length}, earliest first)</span></h3><div id="dSoon" style="overflow-x:auto">${mini(due14)}</div>${due14.length > 12 ? `<button class="link" id="dSoonAll" style="margin-top:8px">View all ${due14.length} in Work Tracker →</button>` : ""}</div>
      <div class="card"><h3>By service</h3>${svc.length ? `<table class="t"><thead><tr><th>Service</th><th class="num">Total</th><th class="num">Open</th><th class="num">Overdue</th><th style="width:35%">Completion</th></tr></thead><tbody>${svc.map(x => `<tr data-svc="${esc(x.s)}"><td>${esc(x.s)}</td><td class="num">${x.all}</td><td class="num">${x.op}</td><td class="num ${x.od ? "red b" : ""}">${x.od || ""}</td><td><div class="bar"><i style="width:${Math.round((x.all - x.op) / x.all * 100)}%"></i></div></td></tr>`).join("")}</tbody></table>` : '<div class="empty">No work items yet</div>'}</div>
      <div class="card"><h3>${can("viewAllWork") ? "Open work by staff" : "My open work"}</h3>${staff.length ? `<table class="t"><thead><tr><th>Staff</th><th class="num">Open</th><th class="num">Overdue</th></tr></thead><tbody>${staff.map(x => `<tr data-staff="${esc(x.s)}"><td>${esc(x.s)}</td><td class="num">${x.n}</td><td class="num ${x.od ? "red b" : ""}">${x.od || ""}</td></tr>`).join("")}</tbody></table>` : '<div class="empty">No open work</div>'}</div>
    </div>
    ${vC().length ? "" : `<div class="card" style="margin-top:14px"><h3>Getting started</h3><ol class="small"><li>Settings › add firm address and staff names.</li><li>Clients › add your clients.</li><li>Work Tracker › <b>Recurring compliances</b> to create a whole year of GST/TDS/ROC/ITR tasks in one go.</li><li>Settings › <b>Download encrypted backup</b> regularly (or link an auto-save file).</li></ol></div>`}`;
  const goW = (f) => { S.f.works = f; go("works"); };
  $$(".kpi").forEach(k => k.onclick = () => ({ clients: () => go("clients"), open: () => goW({ status: "Open (not done)" }), overdue: () => goW({ timeline: "Overdue" }), soon: () => goW({ timeline: "Due in 7 days" }),
    done: () => goW({ status: "Filed / Done", from: "" }), fees: () => goW({ timeline: "Fee outstanding" }), reimb: () => { S.f.reimb = { bal: "Balance due" }; go("reimb"); } })[k.dataset.act]());
  if ($("#dReq")) $("#dReq").onclick = () => go("approvals");
  if ($("#dOverAll")) $("#dOverAll").onclick = () => goW({ timeline: "Overdue" });
  if ($("#dSoonAll")) $("#dSoonAll").onclick = () => goW({ status: "Open (not done)", from: t, to: addDays(t, 14) });
  $$("#dOver tr[data-id], #dSoon tr[data-id]").forEach(tr => tr.onclick = () => editRecord("works", tr.dataset.id, viewDashboard));
  $$("tr[data-svc]").forEach(tr => tr.onclick = () => goW({ service: tr.dataset.svc, status: "Open (not done)" }));
  $$("tr[data-staff]").forEach(tr => tr.onclick = () => goW({ assigned: tr.dataset.staff === "(unassigned)" ? "" : tr.dataset.staff, status: "Open (not done)" }));
  dashCollapse();
}
function dashCollapse() {
  const KEY = "ksc_dash_collapsed"; let shut = [];
  try { shut = JSON.parse(localStorage.getItem(KEY)) || []; } catch {}
  const keep = () => { try { localStorage.setItem(KEY, JSON.stringify(shut)); } catch {} };
  $$("#view .card").forEach(card => {
    const h = card.querySelector(":scope > h3"); if (!h) return;
    const key = h.textContent.replace(/\(.*?\)/g, "").replace(/[^A-Za-z ]/g, "").trim();
    const body = [...card.children].filter(el => el !== h);
    const b = document.createElement("button"); b.type = "button"; b.className = "btn sm dcol"; b.style.marginLeft = "auto";
    h.style.display = "flex"; h.style.alignItems = "center"; h.style.gap = "8px"; h.style.cursor = "pointer"; h.appendChild(b);
    const set = closed => { body.forEach(el => el.hidden = closed); b.textContent = closed ? "▸ Expand" : "▾ Collapse"; b.setAttribute("aria-expanded", String(!closed)); h.style.marginBottom = closed ? "0" : ""; };
    set(shut.includes(key));
    h.onclick = e => { e.stopPropagation(); const closed = !shut.includes(key); shut = closed ? [...shut, key] : shut.filter(k => k !== key); keep(); set(closed); };
  });
}

/* ------------------------------------------------------------------ CLIENT STATUS (project status) */
function clientStatusRows() {
  const t = today();
  return vC().filter(c => c.active !== "Inactive").map(c => {
    const ws = visW().filter(w => w.client === c.id), op = ws.filter(isOpen), od = op.filter(w => delayInfo(w).overdue);
    const nextDue = op.filter(w => w.due).map(w => w.due).sort()[0] || "";
    const lastFiled = ws.filter(w => w.filed).map(w => w.filed).sort().pop() || "";
    const fee = ws.reduce((a, w) => a + Math.max(0, woOut(w)), 0) + S.db.challans.filter(x => x.client === c.id).reduce((a, x) => a + Math.max(0, chReimbDue(x)), 0) + S.db.reimb.filter(x => x.client === c.id).reduce((a, x) => a + Math.max(0, reBal(x)), 0);
    const st = od.length ? "Overdue" : (nextDue && nextDue <= addDays(t, 7)) ? "Due soon" : op.length ? "On track" : "No open work";
    return { id: c.id, c, total: ws.length, done: ws.filter(w => stg(w.status) === "Filed / Done").length, open: op.length, od: od.length, nextDue, lastFiled, fee, st,
      pct: ws.length ? Math.round(ws.filter(w => !isOpen(w)).length / ws.length * 100) : 0 };
  });
}
const STCOLS = [
  { l: "Client", v: r => `<b>${esc(r.c.name)}</b><div class="muted small">${esc(r.c.code)} · ${esc(r.c.type)}</div>`, s: r => r.c.name, x: r => r.c.name },
  { l: "Handled by", v: r => esc(r.c.manager), s: r => r.c.manager, x: r => r.c.manager },
  { l: "Status", v: r => `<span class="chip ${({ "Overdue": "red", "Due soon": "amber", "On track": "green" })[r.st] || ""}">${r.st}</span>`, s: r => ["Overdue", "Due soon", "On track", "No open work"].indexOf(r.st), x: r => r.st },
  { l: "Total items", v: r => r.total, num: 1, s: r => r.total, x: r => r.total },
  { l: "Done", v: r => r.done, num: 1, s: r => r.done, x: r => r.done },
  { l: "Open", v: r => r.open || "", num: 1, s: r => r.open, x: r => r.open },
  { l: "Overdue", v: r => r.od ? `<span class="red b">${r.od}</span>` : "", num: 1, s: r => r.od, x: r => r.od },
  { l: "Progress", v: r => `<div class="bar" style="min-width:90px"><i style="width:${r.pct}%"></i></div><span class="small muted">${r.pct}%</span>`, s: r => r.pct, x: r => r.pct + "%" },
  { l: "Next due", v: r => dmy(r.nextDue), s: r => r.nextDue || "9999", x: r => dmy(r.nextDue) },
  { l: "Last filed", v: r => dmy(r.lastFiled), s: r => r.lastFiled, x: r => dmy(r.lastFiled) },
  { l: "Receivable (₹)", fee: 1, v: r => r.fee ? `<span class="red b">${inr(r.fee)}</span>` : "", num: 1, s: r => r.fee, sum: r => r.fee, x: r => r.fee || "" },
];
function viewStatus() {
  setTitle("Client Status");
  const f = S.f.status = S.f.status || {};
  $("#view").innerHTML = `<div class="toolbar"><input type="search" id="stQ" placeholder="Search client…" value="${esc(f.q || "")}">
    <select id="stS"><option value="">All statuses</option>${["Overdue", "Due soon", "On track", "No open work"].map(s => `<option ${f.st === s ? "selected" : ""}>${s}</option>`).join("")}</select>
    <span class="sp"></span><button class="btn" id="prBtn">🖨 Print</button><button class="btn" id="exBtn">⬇ Excel</button><button class="btn" id="shBtn">↗ Share</button></div><div id="tbl"></div>`;
  const rows = () => { const q = (f.q || "").toLowerCase(); let r = clientStatusRows().filter(x => (!f.st || x.st === f.st) && (!q || (x.c.name + x.c.code).toLowerCase().includes(q)));
    const st = S.sort.status; if (st) { const c = STCOLS[st.i]; r.sort((a, b) => { const x = c.s(a), y = c.s(b); return st.d * ((typeof x === "number") ? x - y : String(x || "").localeCompare(String(y || ""))); }); }
    else r.sort((a, b) => ["Overdue", "Due soon", "On track", "No open work"].indexOf(a.st) - ["Overdue", "Due soon", "On track", "No open work"].indexOf(b.st) || a.c.name.localeCompare(b.c.name)); return r; };
  const draw = () => { const r = rows(); $("#tbl").innerHTML = `<div class="count">${r.length} active client(s)</div>` + tableHTML("status", colsFor(STCOLS), r, true);
    $$("#tbl th[data-i]").forEach(th => th.onclick = () => { const i = +th.dataset.i; const st = S.sort.status; S.sort.status = { i, d: st && st.i === i ? -st.d : 1 }; draw(); });
    $$("#tbl tbody tr").forEach(tr => tr.onclick = () => go("client:" + tr.dataset.id)); };
  $("#stQ").oninput = e => { f.q = e.target.value; draw(); }; $("#stS").onchange = e => { f.st = e.target.value; draw(); };
  if (!can("print")) $("#prBtn").remove(); else $("#prBtn").onclick = () => printRows("Client Status Report", f.st ? "Status: " + f.st : "All active clients", colsFor(STCOLS), rows());
  if (!can("export")) { $("#exBtn").remove(); $("#shBtn").remove(); } else { $("#exBtn").onclick = () => exportCSV("Client Status", colsFor(STCOLS), rows()); $("#shBtn").onclick = () => shareCSV("Client Status", colsFor(STCOLS), rows()); }
  draw();
}

/* ------------------------------------------------------------------ CLIENT PROFILE */
function viewClient(id) {
  const c = clientById(id); if (!c || !showC(id)) return go("clients");
  setTitle(c.name);
  S.ctab = S.ctab || "works";
  const ws = visW().filter(w => w.client === id), ch = S.db.challans.filter(x => x.client === id), re = S.db.reimb.filter(x => x.client === id), ud = S.db.udins.filter(x => x.client === id);
  const fee = ws.reduce((a, w) => a + num(w.fee), 0), rec = ws.reduce((a, w) => a + num(w.received), 0);
  if (!["works", "challans", "reimb", "udins", "docs"].includes(S.ctab) || (S.ctab !== "works" && !can(S.ctab === "docs" ? "documents" : S.ctab))) S.ctab = "works";
  const chDue = ch.reduce((a, x) => a + Math.max(0, chReimbDue(x)), 0), reDue = re.reduce((a, x) => a + Math.max(0, reBal(x)), 0);
  const dl = [["Code", c.code], ["Type", c.type], ["PAN", c.pan], [gstsOf(c).length > 1 ? `GSTINs (${gstsOf(c).length})` : "GSTIN", gstsOf(c).map(gstLbl).join("  ·  ")], ["TAN", c.tan], ["CIN / LLPIN", c.cin], ["Contact", c.contact], ["Mobile", c.mobile], ["Email", c.email], ["Group", c.group], ["Handled by", c.manager], ["Annual fee", c.fee && can("viewFees") ? "₹ " + inr(c.fee) : ""], ["Services", (c.services || []).join(", ")], ["Address", c.address]];
  $("#view").innerHTML = `
    <div class="toolbar"><button class="btn sm" id="back">← Clients</button><span class="sp"></span>
      ${can("viewFees") && can("print") ? '<button class="btn" id="cStmt">🖨 Client statement</button>' : ""}${can("viewFees") && can("export") ? '<button class="btn" id="cShare">↗ Share statement</button>' : ""}
      ${can("manageClients") ? '<button class="btn" id="cEdit">✎ Edit client</button>' : '<button class="btn" id="cEdit">View details</button>'}
      ${can("delete") ? '<button class="btn danger" id="cDel">Delete</button>' : ""}</div>
    <div class="card"><div style="display:flex;align-items:center;gap:10px;margin-bottom:12px"><h3 style="margin:0;font-size:17px">${esc(c.name)}</h3><span class="chip ${c.active === "Inactive" ? "" : "green"}">${esc(c.active || "Active")}</span></div>
      <div class="dl">${dl.filter(x => x[1]).map(([k, v]) => `<div><span>${k}</span>${esc(v)}</div>`).join("")}</div>${c.remarks ? `<p class="small muted" style="margin-bottom:0">${esc(c.remarks)}</p>` : ""}</div>
    <div class="grid kpis" style="margin-top:14px">
      <div class="kpi"><div class="l">Open work</div><div class="v">${ws.filter(isOpen).length}</div></div>
      <div class="kpi ${ws.some(w => delayInfo(w).overdue) ? "red" : "green"}"><div class="l">Overdue</div><div class="v">${ws.filter(w => delayInfo(w).overdue).length}</div></div>
      ${can("viewFees") ? `<div class="kpi"><div class="l">Fees billed (₹)</div><div class="v">${inr0(fee)}</div></div>
      <div class="kpi green"><div class="l">Fees received (₹)</div><div class="v">${inr0(rec)}</div></div>
      <div class="kpi ${fee - rec + chDue + reDue > 0 ? "red" : ""}"><div class="l">Total receivable (₹)</div><div class="v">${inr0(fee - rec + chDue + reDue)}</div></div>` : ""}
    </div>
    <div class="tabs">${[["works", `Work (${ws.length})`], ["challans", `Challans (${ch.length})`], ["reimb", `Reimbursements (${re.length})`], ["udins", `UDIN (${ud.length})`], ["docs", `📎 Documents (${clientDocs(id).length})`]].filter(([k]) => k === "works" || can(k === "docs" ? "documents" : k)).map(([k, l]) => `<button data-t="${k}" class="${S.ctab === k ? "on" : ""}">${l}</button>`).join("")}
      <span style="flex:1"></span>${S.ctab === "docs" ? '<button class="btn sm primary" id="cDocAdd" style="margin:4px 0">📎 Add client document</button><input type="file" id="cDocFile" multiple hidden>' : can(ENTPERM[S.ctab]) ? '<button class="btn sm primary" id="cAdd" style="margin:4px 0">＋ Add</button>' : ""}</div>
    <div id="ctbl"></div>`;
  const data = { works: ws, challans: ch, reimb: re, udins: ud };
  const draw = () => { if (S.ctab === "docs") return drawClientDocs(id); const ent = S.ctab; const cols = colsFor(COLS[ent]).filter(x => x.l !== "Client"); const rows = sortRows(ent, data[ent].slice(), cols, "c_" + ent);
    $("#ctbl").innerHTML = tableHTML("c_" + ent, cols, rows, true, can("delete")); bindTable(ent, $("#ctbl"), () => viewClient(id), "c_" + ent); };
  $$(".tabs button[data-t]").forEach(b => b.onclick = () => { S.ctab = b.dataset.t; viewClient(id); });
  if ($("#cAdd")) $("#cAdd").onclick = () => editRecord(S.ctab, null, () => viewClient(id), { client: id });
  if ($("#cDocAdd")) { $("#cDocAdd").onclick = async () => { if (!CL.on && !(await ensureDocRoot())) return; $("#cDocFile").value = ""; $("#cDocFile").click(); };
    $("#cDocFile").onchange = async e => { const files = [...e.target.files]; if (files.length) { await attachFiles("clients", c, files); save(); viewClient(id); } }; }
  $("#back").onclick = () => go("clients");
  $("#cEdit").onclick = () => editRecord("clients", id, () => viewClient(id));
  if ($("#cDel")) $("#cDel").onclick = () => deleteRecord("clients", id);
  if ($("#cStmt")) $("#cStmt").onclick = () => clientStatement(id, true);
  if ($("#cShare")) $("#cShare").onclick = () => clientStatement(id, false);
  draw();
}
function clientStatement(id, doPrint) {
  const c = clientById(id); const ws = S.db.works.filter(w => w.client === id).sort((a, b) => (a.due || a.filed || "").localeCompare(b.due || b.filed || ""));
  const ch = S.db.challans.filter(x => x.client === id).sort((a, b) => a.date.localeCompare(b.date)), re = S.db.reimb.filter(x => x.client === id), ud = S.db.udins.filter(x => x.client === id);
  const wc = COLS.works.filter(x => !["Client", "Remarks"].includes(x.l) && !x.pf), cc = COLS.challans.filter(x => x.l !== "Client"), rc = COLS.reimb.filter(x => x.l !== "Client"), uc = COLS.udins.filter(x => x.l !== "Client");
  const fee = ws.reduce((a, w) => a + num(w.fee), 0), rec = ws.reduce((a, w) => a + num(w.received), 0), chDue = ch.reduce((a, x) => a + Math.max(0, chReimbDue(x)), 0), reDue = re.reduce((a, x) => a + Math.max(0, reBal(x)), 0);
  if (doPrint) {
    const body = `<div class="kv"><div><b>Client:</b> ${esc(c.name)} (${esc(c.code)})</div><div><b>Type:</b> ${esc(c.type)}</div><div><b>PAN:</b> ${esc(c.pan)}</div><div><b>GSTIN:</b> ${esc(c.gstin)}</div><div><b>Contact:</b> ${esc(c.contact)} ${esc(c.mobile)}</div><div><b>Email:</b> ${esc(c.email)}</div></div>
      <div class="sec"><h2>Summary of account</h2><table><tbody>
        <tr><td>Professional fees billed</td><td class="num">${inr(fee)}</td></tr><tr><td>Less: fees received</td><td class="num">${inr(rec)}</td></tr>
        <tr><td>Add: challans paid by us on your behalf (not yet recovered)</td><td class="num">${inr(chDue)}</td></tr><tr><td>Add: other reimbursable expenses (not yet recovered)</td><td class="num">${inr(reDue)}</td></tr>
        </tbody><tfoot><tr><td>Total amount receivable (₹)</td><td class="num">${inr(fee - rec + chDue + reDue)}</td></tr></tfoot></table></div>
      ${ws.length ? `<div class="sec"><h2>Work status</h2>${printTableHTML(wc, ws)}</div>` : ""}
      ${ch.length ? `<div class="sec"><h2>Challans</h2>${printTableHTML(cc, ch)}</div>` : ""}
      ${re.length ? `<div class="sec"><h2>Reimbursable expenses</h2>${printTableHTML(rc, re)}</div>` : ""}
      ${ud.length ? `<div class="sec"><h2>UDINs generated</h2>${printTableHTML(uc, ud)}</div>` : ""}`;
    printDoc(`Client Statement – ${c.name}`, `As on ${dmy(today())}`, body);
  } else {
    const lines = [[`Client statement – ${c.name} (${c.code})`], [`As on ${dmy(today())}`], [], ["Fees billed", fee], ["Fees received", rec], ["Challans paid on your behalf (due)", chDue], ["Other reimbursements due", reDue], ["Total receivable", fee - rec + chDue + reDue], [], ["WORK STATUS"], wc.map(x => x.l), ...ws.map(r => wc.map(x => x.x(r))), [], ["CHALLANS"], cc.map(x => x.l), ...ch.map(r => cc.map(x => x.x(r)))];
    shareFile(`Statement_${c.code}_${today()}.csv`, toCSV(lines), "text/csv", `Statement for ${c.name} from ${S.db.settings.firm.name}`);
  }
}

/* ------------------------------------------------------------------ PRINT / EXPORT / SHARE */
function printTableHTML(cols, rows) {
  const hasSum = cols.some(c => c.sum);
  return `<table><thead><tr><th>#</th>${cols.map(c => `<th class="${c.num ? "num" : ""}">${esc(c.l)}</th>`).join("")}</tr></thead><tbody>${rows.map((r, i) => `<tr><td>${i + 1}</td>${cols.map(c => { const v = c.x(r); return `<td class="${c.num ? "num" : ""}">${typeof v === "number" ? (Number.isInteger(v) && !c.sum ? v : inr(v)) : esc(v ?? "")}</td>`; }).join("")}</tr>`).join("")}</tbody>
  ${hasSum ? `<tfoot><tr><td></td>${cols.map((c, i) => `<td class="${c.num ? "num" : ""}">${c.sum ? inr(rows.reduce((a, r) => a + c.sum(r), 0)) : i === 0 ? "Total" : ""}</td>`).join("")}</tr></tfoot>` : ""}</table>`;
}
function printCSS() { const st = [...document.querySelectorAll("style")].map(x => x.textContent).join("\n"); const i = st.indexOf("@media print{"); if (i < 0) return ""; let depth = 0, j = i + "@media print".length; for (; j < st.length; j++) { if (st[j] === "{") depth++; else if (st[j] === "}") { depth--; if (!depth) break; } } return st.slice(st.indexOf("{", i) + 1, j).replace(/#auth,#app,#modal,#toast\{display:none!important\}/, "").replace("#printArea{display:block;", "#printArea{"); }
function printDoc(title, sub, body) {
  const f = S.db.settings.firm;
  $("#printArea").innerHTML = `<div class="ph"><div class="fn">${esc(f.name)}${f.frn ? `<span style="font-weight:400;font-size:10px"> &nbsp; FRN ${esc(f.frn)}</span>` : ""}</div>
    <div class="fa">${esc([f.address, f.phone, f.email].filter(Boolean).join("  |  "))}</div></div>
    <h2>${esc(title)}</h2><div class="pm">${esc(sub)}</div>${body}
    <div class="pf"><span>Printed on ${dmy(today())} ${new Date().toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })} by ${esc(S.user)}</span><span>${esc(f.name)} – Practice Manager</span></div>`;
  log("Printed", "Report", title); save();
  if (CL.on) { const html = `<!DOCTYPE html><html><head><title>${esc(title)}</title><style>${printCSS()}</style></head><body><div id="printArea" style="display:block">${$("#printArea").innerHTML}</div></body></html>`;
    const m = openModal2(`<div class="mhead"><h3>🖨 ${esc(title)}</h3></div><div class="mbody"><p class="small" style="margin-top:0">The online app can't open your printer directly. Save this as a file, open it from your Downloads and print it (choose “Save as PDF” there for a PDF), or attach it to an email.</p></div>
      <div class="mfoot"><button class="btn" id="ppX">Close</button><button class="btn primary" id="ppS">⬇ Save printable file</button></div>`);
    $("#ppX", m).onclick = () => m.remove(); $("#ppS", m).onclick = () => { download(fname(title, "html"), html, "text/html"); m.remove(); }; return; }
  setTimeout(() => window.print(), 50);
}
const printRows = (title, sub, cols, rows) => printDoc(title, `${sub}  ·  ${rows.length} record(s)`, printTableHTML(cols.filter(c => !c.pOnly && !c.pf), rows));
function toCSV(lines) { return "﻿" + lines.map(l => l.map(v => { const s = String(v ?? ""); const safe = /^[=+\-@\t\r]/.test(s) && isNaN(s) ? "'" + s : s; return /[",\n]/.test(safe) ? `"${safe.replace(/"/g, '""')}"` : safe; }).join(",")).join("\r\n"); }
function rowsCSV(title, cols, rows) { return toCSV([[S.db.settings.firm.name], [title + " – " + dmy(today())], [], cols.map(c => c.l), ...rows.map(r => cols.map(c => c.x(r)))]); }
const fname = (t, ext) => `${t.replace(/[^A-Za-z0-9]+/g, "_")}_${today()}.${ext}`;
function exportCSV(title, cols, rows) { download(fname(title, "csv"), rowsCSV(title, cols, rows), "text/csv;charset=utf-8"); log("Exported", "Report", title); save(); toast("Downloaded – opens in Excel"); }
function shareCSV(title, cols, rows) { shareFile(fname(title, "csv"), rowsCSV(title, cols, rows), "text/csv", `${title} – ${S.db.settings.firm.name}`); }
async function shareFile(name, content, mime, text) {
  const file = new File([content], name, { type: mime });
  log("Shared", "Report", name); save();
  if (navigator.canShare && navigator.canShare({ files: [file] })) {
    try { await navigator.share({ files: [file], title: name, text }); return; } catch (e) { if (e.name === "AbortError") return; }
  }
  download(name, file);
  const m = openModal(`<div class="mhead"><h3>Share</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p>${CL.on ? `Confirm the download of <b>${esc(name)}</b> – it goes to your <b>Downloads</b> folder.` : `The file <b>${esc(name)}</b> has been saved to your <b>Downloads</b> folder.`}</p>
    <p>Attach it to an email or WhatsApp message. For a PDF, use <b>Print</b> and choose <b>Save as PDF</b> as the printer.</p></div>
    <div class="mfoot">${CL.on ? "" : '<button class="btn" id="mMail">Open email</button>'}<button class="btn primary" id="mOk">Done</button></div>`, true);
  $("#mx", m).onclick = $("#mOk", m).onclick = closeModal;
  if ($("#mMail", m)) $("#mMail", m).onclick = () => { window.location.href = `mailto:?subject=${encodeURIComponent(text)}&body=${encodeURIComponent("Please find attached: " + name)}`; };
}



/* ------------------------------------------------------------------ DOCUMENTS (File System Access API) */
const safeName = s => String(s || "").replace(/[\\/:*?"<>|\u0000-\u001f]+/g, " ").replace(/\s+/g, " ").trim().replace(/[. ]+$/, "").slice(0, 90) || "Untitled";
async function linkDocRoot() {
  if (!window.showDirectoryPicker) { alertBox("Not supported", "Linking a documents folder needs Google Chrome or Microsoft Edge on a computer."); return false; }
  try {
    const h = await window.showDirectoryPicker({ id: "kscdocs", mode: "readwrite" });
    S.docRoot = h; await IDB.put("docroot", h); if (S.db) { log("Edited", "Settings", `Documents folder linked on this computer: ${h.name}`); save(); }
    toast(`Documents folder linked: ${h.name}`); return true;
  } catch (e) { if (e.name !== "AbortError") alertBox("Could not link folder", esc(e.message)); return false; }
}
async function ensureDocRoot() {
  if (!S.docRoot) {
    const ok = await confirmBox("Link documents folder", `<p>This computer is not linked to a documents folder yet.</p><p>Choose your shared folder, for example <b>OneDrive › Client Documents</b>. You only need to do this once on each computer.</p>`, "Choose folder", false);
    if (!ok || !(await linkDocRoot())) return null;
  }
  try {
    if (S.docRoot.queryPermission && (await S.docRoot.queryPermission({ mode: "readwrite" })) !== "granted" && (await S.docRoot.requestPermission({ mode: "readwrite" })) !== "granted") { toast("Permission to the documents folder was not given"); return null; }
  } catch (e) { toast("Documents folder not accessible – relink it in Settings"); return null; }
  return S.docRoot;
}
function docFolder(ent, r) {
  const c = ent === "clients" ? r : clientById(r.client);
  const cf = safeName(c ? `${c.code} ${c.name}` : "Unassigned");
  if (ent === "clients") return [cf, "KYC & Documents"];
  const sub = { works: safeName(r.service || "Work"), challans: "Challans", reimb: "Bills & Expenses", udins: "UDIN & Reports" }[ent] || "Other";
  return [cf, safeName(r.fy || "General"), sub];
}
function docPrefix(ent, r) {
  if (ent === "works") return safeName([r.form, r.period].filter(Boolean).join(" ")) + " - ";
  if (ent === "challans") return safeName([r.taxtype, r.period, r.date].filter(Boolean).join(" ")) + " - ";
  return "";
}
async function getDir(root, parts, create) { let d = root; for (const p of parts) d = await d.getDirectoryHandle(p, { create }); return d; }
async function exists(dir, name) { try { await dir.getFileHandle(name); return true; } catch { return false; } }
async function attachFiles(ent, rec, files) {
  if (CL.on) return cloudAttach(ent, rec, files);
  const root = await ensureDocRoot(); if (!root) return [];
  const folder = docFolder(ent, rec), dir = await getDir(root, folder, true), out = [];
  for (const file of files) {
    let base = docPrefix(ent, rec) + safeName(file.name), name = base, i = 2;
    const dot = base.lastIndexOf("."), stem = dot > 0 ? base.slice(0, dot) : base, ext = dot > 0 ? base.slice(dot) : "";
    while (await exists(dir, name)) name = `${stem} (${i++})${ext}`;
    const fh = await dir.getFileHandle(name, { create: true }); const w = await fh.createWritable(); await w.write(file); await w.close();
    const d = { id: uid(), name: file.name, path: [...folder, name], size: file.size, type: file.type, addedBy: S.user, addedAt: new Date().toISOString() };
    (rec.docs = rec.docs || []).push(d); out.push(d);
    log("Attached", "Document", `${describe(ent, rec)} – ${d.path.join(" › ")}`);
  }
  if (S.db[ent].includes(rec)) save();
  toast(`${out.length} document(s) saved to ${root.name}`);
  return out;
}
async function linkExisting(ent, rec) {
  const root = await ensureDocRoot(); if (!root) return [];
  if (!window.showOpenFilePicker) { toast("Not supported in this browser"); return []; }
  let hs; try { hs = await window.showOpenFilePicker({ multiple: true, startIn: root }); } catch { return []; }
  const out = [], outside = [];
  for (const h of hs) {
    const rel = await root.resolve(h);
    if (!rel) { outside.push(await h.getFile()); continue; }
    const f = await h.getFile(); const d = { id: uid(), name: f.name, path: rel, size: f.size, type: f.type, addedBy: S.user, addedAt: new Date().toISOString(), linked: 1 };
    (rec.docs = rec.docs || []).push(d); out.push(d); if (S.db[ent].includes(rec)) log("Linked", "Document", `${describe(ent, rec)} – ${rel.join(" › ")}`);
  }
  if (outside.length && await confirmBox("Files outside the documents folder", `<p>${outside.length} file(s) are not inside <b>${esc(root.name)}</b>, so other computers could not open them.</p><p>Copy them into the documents folder?</p>`, "Copy into folder", false)) {
    if (S.db[ent].includes(rec)) out.push(...await attachFiles(ent, rec, outside)); else toast("Save the record first, then attach these files");
  }
  return out;
}
async function openDoc(d) {
  if (CL.on) return cloudOpenDoc(d);
  const root = await ensureDocRoot(); if (!root) return;
  try {
    const dir = await getDir(root, d.path.slice(0, -1), false); const fh = await dir.getFileHandle(d.path[d.path.length - 1]); const f = await fh.getFile();
    const url = URL.createObjectURL(f);
    if (/^(application\/pdf|image\/|text\/)/.test(f.type)) { const w = window.open(url, "_blank"); if (!w) download(d.name, f); } else download(f.name, f);
    setTimeout(() => URL.revokeObjectURL(url), 60000); log("Opened", "Document", d.path.join(" › ")); save();
  } catch (e) { alertBox("File not found", `<p>Could not find <b>${esc(d.path.join(" › "))}</b> in <b>${esc(root.name)}</b>.</p><p>It may have been moved or renamed, OneDrive may not have finished syncing on this computer, or this computer is linked to a different folder (Settings › Documents folder).</p>`); }
}
function docsHTML(docs, canEdit, pending = []) {
  const rows = (docs || []).map(d => `<div style="display:flex;gap:8px;align-items:center;padding:4px 0;border-bottom:1px solid #f1f3f6"><span style="flex:1;min-width:0"><a class="link" data-open="${d.id}" style="cursor:pointer">📄 ${esc(d.name)}</a>
      <div class="small muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(d.path ? d.path.join("\\") : "online")}">${d.cloud ? "🔒 stored online (encrypted)" : "📁 " + esc((S.docRoot ? S.docRoot.name : "Documents folder") + " › " + d.path.join(" › "))}</div><div class="small muted">${esc(d.addedBy || "")} · ${dmy((d.addedAt || "").slice(0, 10))}${d.size ? " · " + Math.max(1, Math.round(d.size / 1024)) + " KB" : ""}</div></span>
      ${d.cloud ? "" : `<button type="button" class="btn sm" data-copy="${d.id}" title="Copy path inside the documents folder">Copy path</button>`}${canEdit ? `<button type="button" class="btn sm danger" data-unlink="${d.id}" title="Remove from this record">✕</button>` : ""}</div>`).join("");
  const pend = pending.map((f, i) => `<div class="small" style="padding:3px 0">⏳ ${esc(f.name)} <span class="muted">– will be saved when you click Save</span> <button type="button" class="link" data-unpend="${i}">remove</button></div>`).join("");
  return rows + pend || '<div class="muted small">No documents attached.</div>';
}
function bindDocs(root, ent, rec, pending, redraw) {
  const docs = rec ? rec.docs || [] : [];
  $$("[data-open]", root).forEach(a => a.onclick = () => openDoc(docs.find(d => d.id === a.dataset.open)));
  $$("[data-copy]", root).forEach(b => b.onclick = async () => { const d = docs.find(x => x.id === b.dataset.copy); const txt = (S.docRoot ? S.docRoot.name + "\\" : "") + d.path.join("\\");
    try { await navigator.clipboard.writeText(txt); toast("Path copied: " + txt); } catch { alertBox("Path", `<code>${esc(txt)}</code>`); } });
  $$("[data-unlink]", root).forEach(b => b.onclick = async () => { const d = docs.find(x => x.id === b.dataset.unlink);
    const delFile = can("delete");
    const m = openModal2(`<div class="mhead"><h3>Remove document</h3></div><div class="mbody"><p>Remove <b>${esc(d.name)}</b> from this record?</p>${delFile ? `<label class="small"><input type="checkbox" id="rmFile"> Also delete the file from the documents folder</label>` : '<p class="small muted">The file stays in the documents folder.</p>'}</div>
      <div class="mfoot"><button class="btn" id="rmN">Cancel</button><button class="btn danger" id="rmY">Remove</button></div>`);
    $("#rmN", m).onclick = () => m.remove();
    $("#rmY", m).onclick = async () => { const also = $("#rmFile", m) && $("#rmFile", m).checked; m.remove();
      if (also && d.cloud) { try { await CL.assets.delete(d.cloud); } catch (e) { toast("File could not be deleted: " + ((e && e.message) || e)); } }
      else if (also) { try { const r0 = await ensureDocRoot(); const dir = await getDir(r0, d.path.slice(0, -1), false); await dir.removeEntry(d.path[d.path.length - 1]); } catch (e) { toast("File could not be deleted: " + e.message); } }
      rec.docs = docs.filter(x => x !== d); log(also ? "Deleted" : "Unlinked", "Document", d.path.join(" › ")); save(); redraw(); }; });
  $$("[data-unpend]", root).forEach(b => b.onclick = () => { pending.splice(+b.dataset.unpend, 1); redraw(); });
}
function docHint(m, ent, formVals) {
  const el = $("#docHint", m); if (!el) return; if (CL.on) { el.textContent = "Files are encrypted and stored online with this workspace (max 14 MB each)."; return; } const r = formVals();
  const c = ent === "clients" ? { code: r.code, name: r.name } : clientById(r.client);
  if (ent !== "clients" && !c) { el.textContent = "Select a client – documents are filed under the client's folder."; return; }
  const folder = ent === "clients" ? [safeName(`${r.code || ""} ${r.name || ""}`), "KYC & Documents"] : docFolder(ent, r);
  el.innerHTML = `New files go to: <b>${esc((S.docRoot ? S.docRoot.name : "[documents folder]") + " › " + folder.join(" › "))}</b>${S.docRoot ? "" : ' <span class="red">(folder not linked on this computer)</span>'}`;
}
function clientDocs(id) {
  const c = clientById(id); const out = [];
  (c.docs || []).forEach(d => out.push({ d, ent: "clients", rec: c, what: "Client document" }));
  [["works", r => `${r.form} ${r.fy || ""} ${r.period || ""}`], ["challans", r => `Challan ${r.taxtype} ${dmy(r.date)}`], ["reimb", r => `Expense ${r.nature}`], ["udins", r => `UDIN ${r.udin}`]].forEach(([ent, f]) => {
    if (ent !== "works" && !can(ent)) return;
    (ent === "works" ? visW() : S.db[ent]).filter(r => r.client === id).forEach(r => (r.docs || []).forEach(d => out.push({ d, ent, rec: r, what: f(r) }))); });
  return out.sort((a, b) => (b.d.addedAt || "").localeCompare(a.d.addedAt || ""));
}
function drawClientDocs(id) {
  const list = clientDocs(id);
  $("#ctbl").innerHTML = list.length ? `<div class="tablewrap"><table class="t"><thead><tr><th>Document</th><th>Attached to</th><th>Location in documents folder</th><th>Added by</th><th>Date</th><th></th></tr></thead><tbody>
    ${list.map((x, i) => `<tr><td><b>📄 ${esc(x.d.name)}</b></td><td>${esc(x.what)}</td><td class="small" style="white-space:normal">${x.d.cloud ? "🔒 online (encrypted)" : esc(x.d.path.join(" › "))}</td><td>${esc(x.d.addedBy || "")}</td><td>${dmy((x.d.addedAt || "").slice(0, 10))}</td>
      <td style="text-align:right"><button class="btn sm" data-i="${i}" data-act="open">Open</button> <button class="btn sm" data-i="${i}" data-act="copy">Copy path</button></td></tr>`).join("")}</tbody></table></div>` : `<div class="tablewrap"><div class="empty">No documents yet. Attach files from any work item, challan, expense or UDIN – or add client KYC documents here.</div></div>`;
  $$("#ctbl [data-act]").forEach(b => b.onclick = async e => { e.stopPropagation(); const x = list[+b.dataset.i];
    if (b.dataset.act === "open") return openDoc(x.d);
    if (x.d.cloud) return toast("Stored online – use Open"); const txt = (S.docRoot ? S.docRoot.name + "\\" : "") + x.d.path.join("\\"); try { await navigator.clipboard.writeText(txt); toast("Path copied: " + txt); } catch { alertBox("Path", `<code>${esc(txt)}</code>`); } });
}
function openModal2(html) { const d = document.createElement("div"); d.style.cssText = "position:fixed;inset:0;background:rgba(16,24,40,.45);display:flex;align-items:flex-start;justify-content:center;padding:70px 16px;z-index:60;overflow:auto";
  d.innerHTML = `<div class="mbox narrow">${html}</div>`; document.body.appendChild(d); const f = $("input,select", d); if (f) f.focus(); return d; }







/* ------------------------------------------------------------------ ONLINE WORKSPACE (claude.ai shared database, end-to-end encrypted) */
const CL = { on: false, db: null, user: null, assets: null, downloads: null, uid: null, isOwner: false, last: new Map(), q: new Map(), busy: new Set(), subs: [], metaUnsub: null,
  chain: Promise.resolve(), readonly: false, retryAt: 0, warnedQuota: false, loading: false, refreshT: null, cols: new Set() };
const BASECOLS = ["c", "ch", "re", "ud", "bi", "rq", "bn", "lg", "ds", "dr", "eg", "cr", "cs", "sg"];
const COLENT = { c: "clients", ch: "challans", re: "reimb", ud: "udins", bi: "bills", rq: "requests", bn: "bin", ds: "dsc", dr: "docreq", eg: "engage", cr: "creds", cs: "cases", sg: "sgroups" };
const ENTCOL = { clients: "c", challans: "ch", reimb: "re", udins: "ud", bills: "bi", requests: "rq", bin: "bn", dsc: "ds", docreq: "dr", engage: "eg", creds: "cr", cases: "cs", sgroups: "sg" };
const fyCol = w => "w_" + (/^\d{4}-\d{2}$/.test(w.fy || "") ? w.fy : "none");
const logKey = l => (l.ts || "").slice(0, 10).replace(/-/g, "") + "_" + (l.user || "system");
async function cloudBoot() {
  $("#authTitle").textContent = "Practice Manager"; $("#authSub").textContent = "Connecting to the online workspace…"; $("#setupForm").hidden = true; $("#loginForm").hidden = true;
  CL.db = await claude.use("db");
  if (!CL.db) { $("#authSub").innerHTML = "Could not connect to the online workspace.<br><br><span class='small'>Make sure you are signed in to Claude and that the owner has shared this page with you as an <b>Editor</b> (invited by email).</span>"; return; }
  CL.on = true;
  [CL.user, CL.assets, CL.downloads] = await Promise.all(["user", "assets", "downloads"].map(n => claude.use(n).catch(() => null)));
  if (CL.user) { try { CL.uid = await CL.user.id(); CL.isOwner = await CL.user.isOwner(); } catch {} }
  let first = true; const t = setTimeout(() => { if (first) { first = false; $("#authSub").textContent = "The online workspace is slow to answer – retrying…"; } }, 10000);
  CL.metaUnsub = CL.db.doc("pm/meta").onSnapshot(snap => {
    const d = snap.exists ? snap.data() : null;
    if (d && d.app === "KSC-PM") { const was = S.vault; S.vault = JSON.parse(JSON.stringify(d)); if (was && S.db) { (S.vault.cols || []).forEach(c => cloudSubscribe(c)); } }
    else if (!snap.metadata.fromCache) S.vault = null;
    if (first && (!snap.metadata.fromCache || d)) { first = false; clearTimeout(t); showAuth(); }
    else if (!S.db && !first) showAuth();
  }, e => { $("#authSub").textContent = "Online workspace unavailable (" + e.code + "). Reload the page to try again."; });
}
function cloudPayloadMap() {
  const want = new Map();
  for (const [ent, col] of Object.entries(ENTCOL)) (S.db[ent] || []).forEach(r => want.set(`${col}/${r.id}`, r));
  (S.db.works || []).forEach(w => want.set(`${fyCol(w)}/${w.id}`, w));
  const sets = { ...S.db.settings }; if (sets.billing) { const bil = { ...sets.billing }; BIMG.forEach(k => { want.set("st/b_" + k, { v: bil[k] || "" }); delete bil[k]; }); sets.billing = bil; }
  want.set("st/main", { settings: sets, ver: S.db.ver, created: S.db.created });
  const chunks = {}; (S.db.log || []).forEach(l => (chunks[logKey(l)] = chunks[logKey(l)] || []).push(l));
  Object.entries(chunks).forEach(([k, arr]) => want.set("lg/" + k, { entries: arr }));
  return want;
}
function cloudPush() {
  if (!CL.on || !S.db || !S.dek || CL.loading) return;
  const want = cloudPayloadMap();
  for (const [p, o] of want) { const j = JSON.stringify(o); if (CL.last.get(p) !== j) { CL.last.set(p, j); CL.q.set(p, j); } }
  for (const p of [...CL.last.keys()]) if (!want.has(p) && !p.startsWith("lg/")) { CL.last.delete(p); CL.q.set(p, null); }
  const cols = new Set([...(S.vault.cols || []), ...[...want.keys()].map(p => p.split("/")[0]).filter(c => c.startsWith("w_"))]);
  if (cols.size !== (S.vault.cols || []).length) { S.vault.cols = [...cols].sort(); cols.forEach(c => cloudSubscribe(c)); }
  const meta = JSON.stringify({ app: "KSC-PM", v: 2, firm: S.vault.firm, logo: S.vault.logo || "", users: S.vault.users, cols: S.vault.cols || [], ...(S.vault.pwb ? { pwb: S.vault.pwb } : {}), ...(S.vault.ckA ? { ckA: S.vault.ckA } : {}) });
  if (CL.metaJSON !== meta) { CL.metaJSON = meta; CL.q.set("pm/meta", "META"); }
  cloudPump();
}
function syncStatus() {
  const el = $("#sync"); if (!el) return; el.hidden = !CL.on; const n = CL.q.size + CL.busy.size;
  el.innerHTML = CL.readonly ? '<span class="red">⚠ View-only – changes are not saved</span>' : n ? `⟳ Saving ${n}…` : CL.retryAt > Date.now() ? '<span style="color:var(--amber)">⚠ Connection problem – retrying</span>' : '<span class="green">● Saved online</span>';
}
function cloudPump() {
  syncStatus();
  if (CL.retryAt > Date.now()) { setTimeout(cloudPump, CL.retryAt - Date.now() + 50); return; }
  for (const [p, j] of [...CL.q]) {
    if (CL.busy.size >= 4) break; if (CL.busy.has(p)) continue;
    CL.q.delete(p); CL.busy.add(p);
    (async () => {
      try {
        const ref = CL.db.doc(p);
        if (j === null) await ref.delete();
        else if (j === "META") await ref.set({ ...JSON.parse(CL.metaJSON), updated: new Date().toISOString() });
        else { const o = await aesEnc(S.dek, enc.encode(j)); await ref.set({ iv: o.iv, ct: o.ct, t: new Date().toISOString(), by: S.user || "" }); }
        CL.retryAt = 0;
      } catch (e) {
        const code = e && e.code;
        if (code === "unavailable" || code === "resource_exhausted") { if (!CL.q.has(p)) CL.q.set(p, j === "META" ? "META" : j); CL.retryAt = Date.now() + 2000 + Math.random() * 3000; }
        else if (code === "quota_exceeded") { if (!CL.warnedQuota) { CL.warnedQuota = true; alertBox("Online storage is full", `<p>${esc(e.message || "")}</p><p>Archive or delete old records (or attachments) to free space.</p>`); } }
        else if (code === "invalid_argument" && /permission|level|write/i.test(e.message || "")) { CL.readonly = true; }
        else { console.warn("sync failed", p, e); if (code === "invalid_argument") CL.readonly = CL.readonly || false; }
      } finally { CL.busy.delete(p); syncStatus(); if (CL.q.size) cloudPump(); else if (!CL.busy.size) CL.drainWaiters.splice(0).forEach(f => f()); }
    })();
  }
}
CL.drainWaiters = [];
function cloudDrain(ms = 30000) { if (!CL.q.size && !CL.busy.size) return Promise.resolve(); return new Promise(res => { CL.drainWaiters.push(res); setTimeout(res, ms); }); }
function cloudUnsubscribe() { CL.subs.forEach(u => { try { u(); } catch {} }); CL.subs = []; CL.cols.clear(); CL.last.clear(); clearTimeout(CL.refreshT); }
function cloudSubscribe(col, onFirst) {
  if (CL.cols.has(col)) { onFirst && onFirst(); return; } CL.cols.add(col);
  let first = true;
  CL.subs.push(CL.db.collection(col).onSnapshot(snap => {
    const changes = snap.docChanges(); const isFirst = first && !snap.metadata.fromCache;
    CL.chain = CL.chain.then(async () => { for (const ch of changes) await cloudApply(col, ch); }).then(() => { if (isFirst) { first = false; onFirst && onFirst(); } else if (!first && changes.length && !CL.loading) cloudRefreshUI(changes); });
  }, e => { console.warn("subscription ended", col, e); if (first) { first = false; onFirst && onFirst(); } }));
}
async function cloudApply(col, ch) {
  if (!S.db || !S.dek) return;
  const p = col + "/" + ch.doc.id;
  if (ch.type === "removed") { if (!CL.last.has(p)) return; CL.last.delete(p);
    if (col === "lg") { S.db.log = S.db.log.filter(l => logKey(l) !== ch.doc.id); return; }
    const ent = col.startsWith("w_") ? "works" : COLENT[col]; if (!ent) return;
    S.db[ent] = (S.db[ent] || []).filter(r => !(r.id === ch.doc.id && (ent !== "works" || fyCol(r) === col))); return; }
  const d = ch.doc.data(); if (!d || !d.iv) return;
  let j; try { j = dec.decode(await aesDec(S.dek, d)); } catch { return; }
  if (CL.last.get(p) === j) return; CL.last.set(p, j);
  const o = JSON.parse(j);
  if (col === "st") { if (ch.doc.id.startsWith("b_")) { const k = ch.doc.id.slice(2); S.db.settings.billing = S.db.settings.billing || {}; S.db.settings.billing[k] = o.v || ""; return; }
    if (ch.doc.id === "main") { const old = S.db.settings.billing || {}; S.db.settings = o.settings || S.db.settings; if (S.db.settings.billing) BIMG.forEach(k => { if (!(k in S.db.settings.billing) && old[k] !== undefined) S.db.settings.billing[k] = old[k]; }); if (o.ver) S.db.ver = o.ver; if (o.created) S.db.created = o.created; } return; }
  if (col === "lg") { S.db.log = S.db.log.filter(l => logKey(l) !== ch.doc.id).concat(o.entries || []).sort((a, b) => (b.ts || "").localeCompare(a.ts || "")); return; }
  const ent = col.startsWith("w_") ? "works" : COLENT[col]; if (!ent) return;
  const arr = S.db[ent] = S.db[ent] || []; const i = arr.findIndex(r => r.id === o.id);
  if (i >= 0) arr[i] = o; else arr.push(o);
  if (ent === "works") [...CL.last.keys()].filter(k => k.startsWith("w_") && k.endsWith("/" + o.id) && k !== p).forEach(k => CL.last.delete(k));
}
function cloudRefreshUI(changes) {
  const who = [...new Set(changes.map(c => c.doc.exists && c.doc.data() && c.doc.data().by).filter(x => x && x !== S.user))];
  clearTimeout(CL.refreshT);
  const tryRender = () => { if (!S.db) return;
    const typing = document.activeElement && /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName) && document.activeElement.closest("#view");
    if (!$("#modal").hidden || typing || document.querySelector('div[style*="z-index: 60"]')) { CL.refreshT = setTimeout(tryRender, 1500); return; }
    const sc = $("#view").scrollTop; renderNav(); go(S.route); $("#view").scrollTop = sc; };
  CL.refreshT = setTimeout(tryRender, 400);
  if (who.length) toast(`Updated by ${who.map(uname).join(", ")}`, 1800);
}
function cloudSubscribeAll() {
  const cols = ["st", ...BASECOLS, ...(S.vault.cols || [])];
  return new Promise(res => { let left = cols.length; const done = () => { if (--left <= 0) res(); }; cols.forEach(c => cloudSubscribe(c, done)); setTimeout(res, 25000); });
}
async function cloudLoad(progress) {
  CL.loading = true; cloudUnsubscribe();
  S.db = { ver: APPVER, created: "", settings: { firm: { name: S.vault.firm }, staff: [] }, clients: [], works: [], challans: [], reimb: [], udins: [], log: [], bills: [], requests: [], bin: [], dsc: [], docreq: [], engage: [], creds: [], cases: [], sgroups: [] };
  const tick = setInterval(() => progress && progress(`Loading online data… ${CL.last.size.toLocaleString("en-IN")} records`), 500);
  await cloudSubscribeAll(); await CL.chain; clearInterval(tick); CL.loading = false;
  const db = S.db; db.settings.firm = db.settings.firm || { name: S.vault.firm }; db.settings.staff = db.settings.staff || [];
  CL.metaJSON = JSON.stringify({ app: "KSC-PM", v: 2, firm: S.vault.firm, logo: S.vault.logo || "", users: S.vault.users, cols: S.vault.cols || [] });
  return db;
}
async function cloudErase() {
  CL.loading = true; const paths = [...CL.last.keys()]; CL.q.clear();
  for (let i = 0; i < paths.length; i += 4) await Promise.all(paths.slice(i, i + 4).map(p => CL.db.doc(p).delete().catch(() => {})));
  try { await CL.db.doc("pm/meta").delete(); } catch {}
  cloudUnsubscribe(); CL.metaJSON = ""; CL.loading = false;
}
async function cloudAttach(ent, rec, files) {
  if (!CL.assets) { alertBox("Uploads not available", "<p>Your access level doesn't allow uploading files. Ask the owner to share this page with you as an Editor.</p>"); return []; }
  const out = [];
  for (const file of files) {
    if (file.size > 14 * 1024 * 1024) { toast(`${file.name} is larger than 14 MB – skipped`); continue; }
    toast(`Encrypting and uploading ${file.name}…`, 8000);
    try {
      const o = await aesEnc(S.dek, new Uint8Array(await file.arrayBuffer()));
      const blob = new Blob([JSON.stringify({ v: 1, n: file.name, t: file.type || "application/octet-stream", iv: o.iv, ct: o.ct })], { type: "application/json" });
      const r = await CL.assets.upload(blob, { type: "application/json" });
      const d = { id: uid(), name: file.name, cloud: r.id, size: file.size, type: file.type, addedBy: S.user, addedAt: new Date().toISOString() };
      (rec.docs = rec.docs || []).push(d); out.push(d); log("Attached", "Document", `${describe(ent, rec)} – ${file.name} (online)`);
    } catch (e) { alertBox("Upload failed", `<p>${esc(file.name)}: ${esc((e && (e.message || e.code)) || String(e))}</p>`); }
  }
  if (S.db[ent] && S.db[ent].includes(rec)) save();
  if (out.length) toast(`${out.length} document(s) uploaded (encrypted)`);
  return out;
}
async function cloudOpenDoc(d) {
  if (!d.cloud) return alertBox("Stored on the office computer", `<p>This document was attached in the offline version and is in the documents folder:</p><p><code>${esc((d.path || []).join(" › "))}</code></p>`);
  try {
    toast("Opening…", 4000);
    const res = await fetch("/_blob/" + d.cloud); if (!res.ok) throw new Error("HTTP " + res.status);
    const j = await res.json(); const bytes = await aesDec(S.dek, j); const blob = new Blob([bytes], { type: j.t || d.type || "" }); const url = URL.createObjectURL(blob);
    log("Opened", "Document", d.name); save();
    const isImg = /^image\//.test(blob.type), isPdf = blob.type === "application/pdf";
    const m = openModal2(`<div class="mhead"><h3>📄 ${esc(d.name)}</h3></div><div class="mbody">${isImg ? `<img src="${url}" style="max-width:100%">` : isPdf ? `<iframe src="${url}" style="width:100%;height:65vh;border:1px solid var(--line)"></iframe>` : `<p class="small">Preview is not available for this file type. Use <b>Save</b> to download it.</p>`}</div>
      <div class="mfoot"><button class="btn" id="odX">Close</button><button class="btn primary" id="odS">⬇ Save</button></div>`);
    m.querySelector(".mbox").style.maxWidth = "900px";
    $("#odX", m).onclick = () => { m.remove(); URL.revokeObjectURL(url); }; $("#odS", m).onclick = () => download(d.name, blob);
  } catch (e) { alertBox("Could not open document", `<p>${esc((e && e.message) || String(e))}</p>`); }
}

const KSC_LOGO = "data:image/png;base64,";
const KSC_QR = "data:image/png;base64,";
/* ------------------------------------------------------------------ BILLING */
const BDEF = { template: "ksc", title: "", prefix: "", pad: 0, seq: {}, continuous: true, cseq: 0, pfPrefix: "PI-", pfSeq: 0, dueDays: 15, tax: "none", rate: 18, sac: "998222",
  gstin: "", pan: "", state: "", proprietor: "", bank: "", upi: "", payMode: "Credit",
  terms: "Payment is due within 15 days of the bill date.\nPlease quote the bill number with your payment.", signatory: "", logo: "", letterhead: "", qr: "", signature: "", customHTML: "",
  color: "#1f2a44", tableColor: "#8dc63f", invHeading: "Invoice", pfHeading: "Proforma Invoice", wordsStyle: "vyapar",
  show: { qty: 1, rate: 1, sac: 0, status: 0, period: 1, words: 1, payMode: 1, terms: 1, bank: 1, qr: 1, signature: 1, due: 0, clientAddr: 1, clientGstin: 1, notes: 1 } };
const BS = () => { const st = S.db.settings; st.billing = st.billing || {}; const b = st.billing;
  if (!b.v2) { b.v2 = 1; if ("template" in b && !("continuous" in b)) { b.continuous = !Object.keys(b.seq || {}).length; if (b.template === "classic") b.template = "ksc"; } }
  for (const k in BDEF) if (!(k in b)) b[k] = k === "seq" ? {} : k === "show" ? { ...BDEF.show } : BDEF[k];
  for (const k in BDEF.show) if (!(k in b.show)) b.show[k] = BDEF.show[k]; return b; };
const BIMG = ["logo", "letterhead", "qr", "signature", "customHTML"];
const fyOf = d => { const y = +d.slice(0, 4), m = +d.slice(5, 7); return fyLabel(m >= 4 ? y : y - 1); };
function nextBillNo(date, peek = true, type = "invoice") {
  const b = BS();
  if (type === "proforma") { const n = num(b.pfSeq) + 1; if (!peek) b.pfSeq = n; return (b.pfPrefix || "").replace("{FY}", fyOf(date)) + String(n).padStart(num(b.pad) || 1, "0"); }
  const fy = fyOf(date); let n;
  if (b.continuous) { n = num(b.cseq) + 1; if (!peek) b.cseq = n; } else { n = (b.seq[fy] || 0) + 1; if (!peek) b.seq[fy] = n; }
  return (b.prefix || "").replace("{FY}", fy).replace("{YY}", fy.slice(2, 4) + fy.slice(5)) + String(n).padStart(num(b.pad) || 1, "0");
}
const isPF = b => b.type === "proforma";
const billPaid = b => (b.receipts || []).reduce((a, r) => a + num(r.amount), 0);
const billBal = b => b.status === "Cancelled" || isPF(b) || b.convertedTo ? 0 : Math.round((num(b.total) - billPaid(b)) * 100) / 100;
const billStatus = b => b.status === "Cancelled" ? "Cancelled" : isPF(b) ? (b.convertedTo ? "Converted" : "Proforma") : billBal(b) <= 0.009 ? "Paid" : billPaid(b) > 0 ? "Part paid" : "Unpaid";
function words(n, style) {
  n = Math.round(n * 100) / 100; const r = Math.floor(n), p = Math.round((n - r) * 100);
  const a = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"], t = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];
  const two = x => x < 20 ? a[x] : t[Math.floor(x / 10)] + (x % 10 ? " " + a[x % 10] : ""), three = x => (x >= 100 ? a[Math.floor(x / 100)] + " Hundred" + (x % 100 ? " " : "") : "") + (x % 100 ? two(x % 100) : "");
  const f = x => { if (!x) return "Zero"; let out = []; const cr = Math.floor(x / 1e7); x %= 1e7; const la = Math.floor(x / 1e5); x %= 1e5; const th = Math.floor(x / 1e3); x %= 1e3;
    if (cr) out.push(f(cr) + " Crore"); if (la) out.push(two(la) + " Lakh"); if (th) out.push(two(th) + " Thousand"); if (x) out.push(three(x)); return out.join(" "); };
  if ((style || BS().wordsStyle) === "vyapar") return f(r) + " Rupees" + (p ? " and " + two(p) + " Paise" : "") + " only";
  return "Rupees " + f(r) + (p ? " and " + two(p) + " Paise" : "") + " Only";
}
function calcBill(lines, tax, rate) {
  const fee = lines.filter(l => l.taxable).reduce((a, l) => a + num(l.amount), 0), non = lines.filter(l => !l.taxable).reduce((a, l) => a + num(l.amount), 0);
  const r = num(rate) / 100, cg = tax === "intra" ? Math.round(fee * r / 2 * 100) / 100 : 0, ig = tax === "inter" ? Math.round(fee * r * 100) / 100 : 0;
  const raw = fee + non + cg * 2 + ig, tot = Math.round(raw);
  return { taxable: fee, nontax: non, cgst: cg, sgst: cg, igst: ig, round: Math.round((tot - raw) * 100) / 100, total: tot };
}
const workDesc = w => `${w.form}${w.period ? " – " + w.period : ""}${w.fy ? " (FY " + w.fy + ")" : ""}`;
/* every task of the client that is not on another active invoice – any status */
function unbilledFor(cid, exceptBill) {
  const out = []; const ok = x => !x.billId || x.billId === exceptBill;
  S.db.works.filter(w => w.client === cid && ok(w)).sort((a, b) => (stg(b.status) === "Filed / Done") - (stg(a.status) === "Filed / Done") || (a.due || "").localeCompare(b.due || ""))
    .forEach(w => out.push({ kind: "work", ref: w.id, desc: workDesc(w), sac: BS().sac, qty: 1, rate: num(w.fee) || "", amount: num(w.fee) || "", taxable: true, on: num(w.fee) > 0 && stg(w.status) !== "Cancelled", info: w.status, status: w.status }));
  S.db.reimb.filter(r => r.client === cid && ok(r) && (reBal(r) > 0 || r.billId === exceptBill)).forEach(r => out.push({ kind: "reimb", ref: r.id, desc: `Reimbursement – ${r.nature}${r.desc ? ": " + r.desc : ""}`, sac: "", qty: 1, rate: reBal(r), amount: reBal(r), taxable: false, on: true, info: dmy(r.date) }));
  S.db.challans.filter(c => c.client === cid && ok(c) && (chReimbDue(c) > 0 || c.billId === exceptBill)).forEach(c => out.push({ kind: "challan", ref: c.id, desc: `Challan ${c.taxtype}${c.head ? " " + c.head : ""}${c.period ? " " + c.period : ""}`, sac: "", qty: 1, rate: chReimbDue(c), amount: chReimbDue(c), taxable: false, on: true, info: dmy(c.date) + (c.cpin ? " · " + c.cpin : "") }));
  return out;
}
/* link / unlink / allocate – used by save, edit, cancel and payments */
function billFactor(bill) { const t = calcBill(bill.lines, bill.tax, bill.rate); return t.taxable ? (t.taxable + t.cgst + t.sgst + t.igst) / t.taxable : 1; }
function unallocate(bill) { const f = billFactor(bill);
  bill.lines.forEach(l => { const paid = num(l.paid); if (!paid) return; const net = l.taxable ? paid / f : paid;
    const tgt = l.kind === "work" ? S.db.works.find(x => x.id === l.ref) : l.kind === "reimb" ? S.db.reimb.find(x => x.id === l.ref) : l.kind === "challan" ? S.db.challans.find(x => x.id === l.ref) : null;
    if (tgt) { const k = l.kind === "work" ? "received" : "recovered"; tgt[k] = Math.max(0, Math.round((num(tgt[k]) - net) * 100) / 100) || ""; }
    l.paid = 0; }); }
function allocate(bill, amt, date) { const f = billFactor(bill); let left = amt;
  bill.lines.forEach(l => { if (left <= 0.0001) return; const gross = l.taxable ? num(l.amount) * f : num(l.amount); const due = Math.max(0, gross - num(l.paid)); const take = Math.min(due, left); if (take <= 0) return;
    l.paid = Math.round((num(l.paid) + take) * 100) / 100; left -= take; const net = l.taxable ? take / f : take;
    if (l.kind === "work") { const w = S.db.works.find(x => x.id === l.ref); if (w) { w.received = Math.round((num(w.received) + net) * 100) / 100; w.recdate = date; } }
    if (l.kind === "reimb") { const r = S.db.reimb.find(x => x.id === l.ref); if (r) { r.recovered = Math.round((num(r.recovered) + net) * 100) / 100; r.recdate = date; } }
    if (l.kind === "challan") { const c = S.db.challans.find(x => x.id === l.ref); if (c) c.recovered = Math.round((num(c.recovered) + net) * 100) / 100; } }); }
function unlinkBill(bill) { unallocate(bill);
  S.db.works.filter(w => w.billId === bill.id).forEach(w => { w.billId = ""; w.billno = ""; w.billdate = ""; });
  S.db.reimb.filter(r => r.billId === bill.id).forEach(r => { r.billId = ""; r.billno = ""; r.billdate = ""; });
  S.db.challans.filter(c => c.billId === bill.id).forEach(c => c.billId = ""); }
function linkBill(bill) { if (isPF(bill) || bill.status === "Cancelled") return;
  bill.lines.forEach(l => { if (l.kind === "work") { const w = S.db.works.find(x => x.id === l.ref); if (w) Object.assign(w, { billId: bill.id, billno: bill.no, billdate: bill.date, fee: num(l.amount) }); }
    if (l.kind === "reimb") { const r = S.db.reimb.find(x => x.id === l.ref); if (r) Object.assign(r, { billId: bill.id, billno: bill.no, billdate: bill.date }); }
    if (l.kind === "challan") { const c = S.db.challans.find(x => x.id === l.ref); if (c) c.billId = bill.id; } });
  (bill.receipts || []).forEach(r => allocate(bill, num(r.amount), r.date)); }

function viewBilling() {
  setTitle("Billing"); BS(); const tab = S.btab = S.btab || "bills";
  const bills = (S.db.bills = S.db.bills || []); const P = billPer(S.f.bills = S.f.bills || {}), inv = bills.filter(x => showC(x.client) && !isPF(x) && x.status !== "Cancelled"), thisFY = inv.filter(x => inPer(P, x.date));
  const recP = inv.reduce((a, x) => a + (x.receipts || []).filter(r => inPer(P, r.date)).reduce((t, r) => t + num(r.amount), 0), 0);
  const pf = bills.filter(x => isPF(x) && !x.convertedTo && x.status !== "Cancelled");
  const unb = S.db.works.filter(w => showC(w.client) && !w.billId && num(w.fee) > 0 && stg(w.status) !== "Cancelled");
  const k = (l, v, c = "") => `<div class="kpi ${c}" style="cursor:default"><div class="l">${l}</div><div class="v">${v}</div></div>`;
  $("#view").innerHTML = `<div class="grid kpis">${k(`Invoices · ${esc(P.label)}`, thisFY.length)}${k(`Billed (₹) · ${esc(P.label)}`, inr0(thisFY.reduce((a, x) => a + num(x.total), 0)))}${k(`Received (₹) · ${esc(P.label)}`, inr0(recP), "green")}
      ${k("Outstanding today (₹)", inr0(inv.reduce((a, x) => a + Math.max(0, billBal(x)), 0)), "red")}${k("Open proformas", pf.length, pf.length ? "amber" : "")}${k("Unbilled fees (₹)", inr0(unb.reduce((a, w) => a + num(w.fee), 0)), unb.length ? "amber" : "")}</div>
    <div class="tabs">${[["bills", `Invoices & proformas (${bills.length})`], ["unbilled", `Unbilled work (${new Set(unb.map(w => w.client)).size} clients)`], ["format", "Bill format & settings"]].map(([t, l]) => `<button data-bt="${t}" class="${tab === t ? "on" : ""}">${l}</button>`).join("")}
      <span style="flex:1"></span>${isAdmin() ? '<button class="btn" id="impBtn" style="margin:4px 6px 4px 0">⬆ Bulk import</button>' : ""}<button class="btn" id="newPF" style="margin:4px 6px 4px 0">＋ Proforma invoice</button><button class="btn primary" id="newBill" style="margin:4px 0">＋ New invoice</button></div><div id="bview"></div>`;
  $$("[data-bt]").forEach(x => x.onclick = () => { S.btab = x.dataset.bt; viewBilling(); });
  if ($("#impBtn")) $("#impBtn").onclick = viewImport;
  $("#newBill").onclick = () => billDialog({}); $("#newPF").onclick = () => billDialog({ type: "proforma" });
  ({ bills: drawBills, unbilled: drawUnbilled, format: drawBillFormat })[tab]();
}
const BCOLS = [
  { l: "Type", v: r => isPF(r) ? '<span class="chip amber">Proforma</span>' : '<span class="chip blue">Invoice</span>', s: r => r.type || "invoice", x: r => isPF(r) ? "Proforma" : "Invoice" },
  { l: "No.", v: r => `<b>${esc(r.no)}</b>`, s: r => r.no, x: r => r.no }, { l: "Date", v: r => dmy(r.date), s: r => r.date, x: r => dmy(r.date) },
  { l: "Client", v: r => esc(cname(r.client)), s: r => cname(r.client), x: r => cname(r.client) }, { l: "Items", v: r => r.lines.length, num: 1, x: r => r.lines.length },
  { l: "Total (₹)", v: r => inr(r.total), num: 1, s: r => num(r.total), sum: r => r.status === "Cancelled" || isPF(r) ? 0 : num(r.total), x: r => num(r.total) },
  { l: "Received (₹)", v: r => isPF(r) ? "" : inr(billPaid(r)), num: 1, s: billPaid, sum: billPaid, x: billPaid },
  { l: "Balance (₹)", v: r => billBal(r) > 0 ? `<b class="red">${inr(billBal(r))}</b>` : "", num: 1, s: billBal, sum: r => Math.max(0, billBal(r)), x: billBal },
  { l: "Due", v: r => r.due && billBal(r) > 0 && r.due < today() ? `<span class="red">${dmy(r.due)}</span>` : dmy(r.due), s: r => r.due, x: r => dmy(r.due) },
  { l: "Status", v: r => { const st = billStatus(r); return `<span class="chip ${st === "Paid" ? "green" : st === "Part paid" || st === "Proforma" ? "amber" : st === "Cancelled" || st === "Converted" ? "" : "red"}">${st}${r.convertedTo ? " → " + esc(r.convertedNo || "") : ""}</span>`; }, s: billStatus, x: billStatus },
];
COLS.bills = BCOLS;
function billPer(f) {
  const t = today(), y = +t.slice(0, 4), mo = +t.slice(5, 7), p = f.per || "cfy", mEnd = (yy, mm) => iso(new Date(yy, mm, 0)), mLab = (yy, mm) => new Date(yy, mm - 1, 1).toLocaleDateString("en-IN", { month: "short", year: "numeric" });
  if (p === "cm") return { from: `${y}-${pad(mo)}-01`, to: mEnd(y, mo), label: mLab(y, mo) };
  if (p === "pm") { const py = mo === 1 ? y - 1 : y, pn = mo === 1 ? 12 : mo - 1; return { from: `${py}-${pad(pn)}-01`, to: mEnd(py, pn), label: mLab(py, pn) }; }
  if (p === "cfy" || p === "pfy" || p.startsWith("fy:")) { const st = p === "cfy" ? curFYStart() : p === "pfy" ? curFYStart() - 1 : +p.slice(3, 7); return { from: `${st}-04-01`, to: `${st + 1}-03-31`, label: "FY " + fyLabel(st) }; }
  if (p === "custom") return { from: f.from || "", to: f.to || "", label: f.from || f.to ? `${f.from ? dmy(f.from) : "Start"} – ${f.to ? dmy(f.to) : "today"}` : "Custom dates" };
  return { from: "", to: "", label: "All periods" };
}
const inPer = (P, d) => (!P.from || (d || "") >= P.from) && (!P.to || (d || "") <= P.to);
function drawBills() {
  const f = S.f.bills = S.f.bills || {};
  $("#bview").innerHTML = `<div class="toolbar"><input type="search" id="bq" placeholder="Search number / client…" value="${esc(f.q || "")}">${msHTML("client", "Clients", filterOpts("client"), f.client || [])}
    <select id="btp"><option value="">Invoices & proformas</option><option value="invoice" ${f.tp === "invoice" ? "selected" : ""}>Invoices only</option><option value="proforma" ${f.tp === "proforma" ? "selected" : ""}>Proformas only</option></select>
    <select id="bst"><option value="">All statuses</option>${["Unpaid", "Part paid", "Paid", "Proforma", "Converted", "Cancelled"].map(x => `<option ${f.st === x ? "selected" : ""}>${x}</option>`).join("")}</select>
    <select id="bper" title="Period (invoice date)">${[["cm", "Current month"], ["pm", "Previous month"], ["cfy", "Current financial year"], ["pfy", "Previous financial year"], ["all", "All periods"], ["custom", "Custom dates…"]].map(([v, l]) => `<option value="${v}" ${(f.per || "cfy") === v ? "selected" : ""}>${l}</option>`).join("")}
      <optgroup label="Financial year">${FYS.map(y => `<option value="fy:${y}" ${f.per === "fy:" + y ? "selected" : ""}>FY ${y}</option>`).join("")}</optgroup></select>
    <span id="bcus" ${f.per === "custom" ? "" : "hidden"} style="display:inline-flex;gap:6px;align-items:center"><input type="date" id="bfrom" value="${esc(f.from || "")}" title="From date"><span class="small muted">to</span><input type="date" id="bto" value="${esc(f.to || "")}" title="To date"></span><span class="sp"></span>
    <button class="btn" id="bcols" title="Show, hide and reorder columns">▦ Columns</button>
    ${can("print") ? '<button class="btn" id="bpr">🖨 Print list</button>' : ""}${can("export") ? '<button class="btn" id="bex">⬇ Excel</button>' : ""}</div><div id="btbl"></div>`;
  const rows = () => (S.db.bills || []).filter(r => showC(r.client) && (!f.q || (r.no + " " + cname(r.client)).toLowerCase().includes(f.q.toLowerCase())) && (!(f.client || []).length || f.client.includes(r.client)) && (!f.st || billStatus(r) === f.st) && inPer(P, r.date) && (!f.tp || (r.type || "invoice") === f.tp))
    .sort((a, b) => b.date.localeCompare(a.date) || String(b.no).localeCompare(String(a.no), undefined, { numeric: true }));
  const P = billPer(f);
  const sorted = (r, cols) => { const st = S.sort.bills; const c = st && cols[st.i]; if (!c) return r; const key = c.s || c.x;
    return r.slice().sort((a, b) => { const A = key(a), B = key(b); return (typeof A === "number" && typeof B === "number" ? A - B : String(A ?? "").localeCompare(String(B ?? ""), undefined, { numeric: true })) * st.d; }); };
  const draw = () => { const cols = applyColPrefs("bills", BCOLS), r = sorted(rows(), cols);
    $("#btbl").innerHTML = `<div class="count">${r.length} document(s) · ${esc(P.label)} <span class="muted">· drag a heading to move it, drag its right edge to resize</span></div>` + tableHTML("bills", cols, r, true, false, false, "bills");
    $$("#btbl th[data-i]").forEach(th => th.onclick = e => { if (S._colBusy || e.target.closest(".rz")) return; const i = +th.dataset.i, st = S.sort.bills; S.sort.bills = { i, d: st && st.i === i ? -st.d : 1 }; draw(); });
    $$("#btbl tbody tr[data-id]").forEach(tr => tr.onclick = () => billView(tr.dataset.id)); bindColUI("bills", draw); };
  $("#bq").oninput = e => { f.q = e.target.value; draw(); }; $("#bst").onchange = e => { f.st = e.target.value; draw(); }; $("#bper").onchange = e => { f.per = e.target.value; if (f.per === "custom" && !f.from && !f.to) { f.from = today().slice(0, 8) + "01"; f.to = today(); } viewBilling(); };
  $("#bfrom").onchange = e => { f.from = e.target.value; viewBilling(); }; $("#bto").onchange = e => { f.to = e.target.value; viewBilling(); };
  $("#bcols").onclick = () => colChooser("bills", draw); $("#btp").onchange = e => { f.tp = e.target.value; draw(); };
  bindMS($("#bview"), (k, arr) => { f[k] = arr; draw(); });
  if ($("#bpr")) $("#bpr").onclick = () => printRows("Bill Register", P.label, applyColPrefs("bills", BCOLS), sorted(rows(), applyColPrefs("bills", BCOLS)));
  if ($("#bex")) $("#bex").onclick = () => exportCSV("Bill Register – " + P.label, applyColPrefs("bills", BCOLS), sorted(rows(), applyColPrefs("bills", BCOLS)));
  draw();
}
function drawUnbilled() {
  const by = {}; S.db.works.filter(w => !w.billId && stg(w.status) !== "Cancelled" && (num(w.fee) > 0 || stg(w.status) === "Filed / Done")).forEach(w => { (by[w.client] = by[w.client] || []).push(w); });
  const rows = Object.entries(by).map(([cid, ws]) => ({ id: cid, c: clientById(cid), n: ws.length, done: ws.filter(w => stg(w.status) === "Filed / Done").length, fee: ws.reduce((a, w) => a + num(w.fee), 0),
    re: unbilledFor(cid).filter(x => x.kind !== "work").reduce((a, x) => a + num(x.amount), 0) })).filter(r => r.c).sort((a, b) => b.fee - a.fee);
  $("#bview").innerHTML = rows.length ? `<div class="tablewrap"><table class="t"><thead><tr><th>Client</th><th class="num">Unbilled tasks</th><th class="num">of which done</th><th class="num">Fees entered (₹)</th><th class="num">Reimbursements due (₹)</th><th></th></tr></thead><tbody>
    ${rows.map(r => `<tr data-id="${r.id}"><td><b>${esc(r.c.name)}</b> <span class="muted small">${esc(r.c.code)}</span></td><td class="num">${r.n}</td><td class="num">${r.done}</td><td class="num">${inr(r.fee)}</td><td class="num">${r.re ? inr(r.re) : ""}</td><td style="text-align:right;white-space:nowrap"><button class="btn sm" data-pf="${r.id}">Proforma</button> <button class="btn sm primary" data-bill="${r.id}">Create invoice</button></td></tr>`).join("")}</tbody></table></div>
    <p class="small muted">Shows completed tasks and tasks with a fee entered that are not yet on an invoice. Any other task of the client – whatever its status – can be ticked inside the invoice.</p>` : '<div class="tablewrap"><div class="empty">Nothing unbilled. 🎉</div></div>';
  $$("[data-bill]").forEach(b => b.onclick = e => { e.stopPropagation(); billDialog({ client: b.dataset.bill }); });
  $$("[data-pf]").forEach(b => b.onclick = e => { e.stopPropagation(); billDialog({ client: b.dataset.pf, type: "proforma" }); });
  $$("#bview tbody tr").forEach(tr => tr.onclick = () => billDialog({ client: tr.dataset.id }));
}
/* New / edit / convert dialog. opts: {client, type, edit: bill, from: proforma} */
function billDialog(opts = {}) {
  const b = BS(); const ed = opts.edit || null, from = opts.from || null; const src = ed || from || opts._copy || null;
  const type = from ? "invoice" : ed ? (ed.type || "invoice") : (opts.type || "invoice"); const PF = type === "proforma";
  const cl = vC().slice().sort((a, c) => a.name.localeCompare(c.name)); const cid = src ? src.client : opts.client;
  const title = ed ? `Edit ${PF ? "proforma" : "invoice"} ${ed.no}` : from ? `Convert proforma ${from.no} to invoice` : PF ? "＋ New proforma invoice" : "＋ New invoice";
  const m = openModal(`<div class="mhead"><h3>${esc(title)}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    ${ed && (ed.receipts || []).length ? `<div class="small" style="background:#fff4e0;border:1px solid #f3c27a;border-radius:8px;padding:8px 10px;margin-bottom:10px">This invoice has payments of ₹ ${inr(billPaid(ed))}. They stay recorded and are re-applied to the edited lines.</div>` : ""}
    <div class="fgrid"><div class="field full"><label class="req">Client (Bill to)</label><select id="bcl" ${ed && !PF && (ed.receipts || []).length ? "disabled" : ""}><option value="">— select client —</option>${cl.map(c => `<option value="${c.id}" ${c.id === cid ? "selected" : ""}>${esc(c.name)} (${esc(c.code)})</option>`).join("")}</select></div>
      <div class="field"><label>${PF ? "Proforma" : "Invoice"} date</label><input type="date" id="bdt" value="${esc(ed ? ed.date : today())}"></div><div class="field"><label>Due date</label><input type="date" id="bdu" value="${esc(ed ? ed.due || "" : addDays(today(), num(b.dueDays) || 15))}"></div>
      <div class="field"><label>${PF ? "Proforma" : "Invoice"} no.</label><input id="bno" value="${esc(ed ? ed.no : "")}"></div>
      <div class="field"><label>Payment mode (printed)</label><input id="bpm" list="bpmL" value="${esc(src ? src.payMode || b.payMode : b.payMode)}"><datalist id="bpmL">${["Credit", "Cash", "UPI", "Bank transfer", "Cheque", "Advance"].map(x => `<option value="${x}">`).join("")}</datalist></div>
      <div class="field"><label>GST</label><select id="btx"><option value="none">No GST</option><option value="intra">CGST + SGST (same state)</option><option value="inter">IGST (other state)</option></select></div>
      <div class="field"><label>Show on this ${PF ? "proforma" : "invoice"}</label><div class="checks"><label><input type="checkbox" id="bss" ${(src ? src.showStatus : b.show.status) ? "checked" : ""}> Task status</label><label><input type="checkbox" id="bsq" ${(src ? src.showQty ?? b.show.qty : b.show.qty) ? "checked" : ""}> Qty & rate</label></div></div></div>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><label class="small b" style="flex:1">Items – tick any task of the client (any status), reimbursements or challans; edit text, quantity and rate</label>
      <input id="bfilt" placeholder="filter items…" style="border:1px solid #cfd5df;border-radius:8px;padding:5px 8px;max-width:200px"></div>
    <div class="tablewrap"><table class="t" id="bl"><thead><tr><th style="width:28px"><input type="checkbox" id="bla"></th><th>Item name / particulars</th><th>Type</th><th>Task status</th><th>SAC</th><th class="num">Qty</th><th class="num">Price/unit (₹)</th><th class="num">Amount (₹)</th><th></th></tr></thead><tbody></tbody></table></div>
    <div style="margin-top:6px;display:flex;gap:8px;flex-wrap:wrap"><button type="button" class="btn sm" id="badd">＋ Add new item</button><span class="small muted" style="align-self:center">A new item can also be saved as a task in the Work Tracker (tick “save as task”).</span></div>
    <div style="display:flex;gap:16px;margin-top:10px;align-items:flex-start;flex-wrap:wrap"><div class="field" style="flex:1;min-width:240px"><label>Notes printed on ${PF ? "proforma" : "invoice"}</label><textarea id="bnt" maxlength="800">${esc(src ? src.notes || "" : "")}</textarea></div><div id="btot" style="min-width:280px"></div></div>
    <div class="err" id="ber"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="bX">Cancel</button><button class="btn" id="bPv">Preview</button><button class="btn primary" id="bOk">${ed ? "Save changes" : PF ? "Save proforma" : "Save invoice"}</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "1060px";
  $("#btx", m).value = src ? src.tax : b.tax || "none";
  let lines = [];
  const typeLbl = l => l.kind === "work" ? "Task" : l.kind === "reimb" ? "Expense" : l.kind === "challan" ? "Challan" : (l.taxable ? "Fee" : "Reimb.");
  const lineRow = (l, i) => `<tr data-i="${i}" ${l.hide ? "hidden" : ""}><td><input type="checkbox" class="lon" ${l.on ? "checked" : ""}></td>
    <td><input class="ldesc" value="${esc(l.desc)}" style="width:100%;min-width:230px;border:1px solid #dfe3ea;border-radius:6px;padding:4px 6px">${l.info && l.kind !== "work" ? `<div class="small muted">${esc(l.info)}</div>` : ""}
      ${l.kind === "custom" ? `<div class="small" style="margin-top:3px"><label><input type="checkbox" class="ltx" ${l.taxable ? "checked" : ""}> professional fee (GST applies)</label> &nbsp; <label><input type="checkbox" class="lmk" ${l.mkTask ? "checked" : ""}> save as task</label> <select class="lms" style="font-size:11.5px">${allStatus().map(x => `<option ${x === (l.mkStatus || "Filed / Done") ? "selected" : ""}>${x}</option>`).join("")}</select></div>` : ""}</td>
    <td><span class="chip ${l.taxable ? "blue" : ""}">${typeLbl(l)}</span></td>
    <td>${l.kind === "work" ? statusChip(l.status || "") : l.kind === "custom" && l.mkTask ? statusChip(l.mkStatus || "Filed / Done") : ""}</td>
    <td><input class="lsac" value="${esc(l.sac || "")}" style="width:74px;border:1px solid #dfe3ea;border-radius:6px;padding:4px 6px" ${l.taxable ? "" : "disabled"}></td>
    <td class="num"><input type="number" class="lqty" step="0.01" min="0" value="${esc(l.qty ?? 1)}" style="width:60px;text-align:right;border:1px solid #dfe3ea;border-radius:6px;padding:4px 6px"></td>
    <td class="num"><input type="number" class="lrate" step="0.01" min="0" value="${esc(l.rate ?? l.amount)}" style="width:100px;text-align:right;border:1px solid #dfe3ea;border-radius:6px;padding:4px 6px"></td>
    <td class="num lamt b">${inr(num(l.qty ?? 1) * num(l.rate ?? l.amount))}</td><td>${l.kind === "custom" ? '<button type="button" class="btn sm danger lrm">✕</button>' : ""}</td></tr>`;
  const sync = () => { $$("#bl tbody tr[data-i]", m).forEach(tr => { const l = lines[+tr.dataset.i]; l.on = $(".lon", tr).checked; l.desc = $(".ldesc", tr).value; l.sac = $(".lsac", tr).value; l.qty = $(".lqty", tr).value; l.rate = $(".lrate", tr).value;
    l.amount = Math.round(num(l.qty) * num(l.rate) * 100) / 100; if ($(".ltx", tr)) l.taxable = $(".ltx", tr).checked; if ($(".lmk", tr)) { l.mkTask = $(".lmk", tr).checked; l.mkStatus = $(".lms", tr).value; } $(".lamt", tr).textContent = inr(l.amount); }); };
  const totals = () => { sync(); const t = calcBill(lines.filter(l => l.on), $("#btx", m).value, b.rate);
    $("#btot", m).innerHTML = `<table class="t"><tbody><tr><td>Sub total</td><td class="num">${inr(t.taxable + t.nontax)}</td></tr>${t.cgst ? `<tr><td>CGST @ ${b.rate / 2}%</td><td class="num">${inr(t.cgst)}</td></tr><tr><td>SGST @ ${b.rate / 2}%</td><td class="num">${inr(t.sgst)}</td></tr>` : ""}${t.igst ? `<tr><td>IGST @ ${b.rate}%</td><td class="num">${inr(t.igst)}</td></tr>` : ""}
      ${t.round ? `<tr><td>Round off</td><td class="num">${inr(t.round)}</td></tr>` : ""}</tbody><tfoot><tr><td>Total</td><td class="num">₹ ${inr(t.total)}</td></tr></tfoot></table><div class="small muted" style="margin-top:4px">${esc(words(t.total))}</div>`; return t; };
  const drawLines = () => { $("#bl tbody", m).innerHTML = lines.length ? lines.map(lineRow).join("") : '<tr><td colspan="9" class="muted" style="text-align:center;padding:16px">No tasks for this client yet – use “Add new item”.</td></tr>';
    $$("#bl tbody input", m).forEach(x => x.addEventListener("input", totals));
    $$("#bl tbody .lon, #bl tbody .ltx, #bl tbody .lmk, #bl tbody .lms", m).forEach(x => x.addEventListener("change", () => { if (!x.classList.contains("lon")) { sync(); drawLines(); } totals(); }));
    $$(".lrm", m).forEach(x => x.onclick = () => { sync(); lines.splice(+x.closest("tr").dataset.i, 1); drawLines(); }); totals(); };
  const fromLines = (bill) => { const avail = unbilledFor(bill.client, ed ? ed.id : null); const out = [];
    bill.lines.forEach(l => { const a = l.ref ? avail.find(x => x.kind === l.kind && x.ref === l.ref) : null; if (a) avail.splice(avail.indexOf(a), 1);
      const w = l.kind === "work" ? S.db.works.find(x => x.id === l.ref) : null;
      out.push({ ...l, qty: l.qty ?? 1, rate: l.rate ?? l.amount, on: true, status: w ? w.status : l.status, info: a ? a.info : l.info, kind: (l.kind !== "custom" && !a && !w && l.kind === "work") ? "custom" : l.kind }); });
    avail.forEach(a => out.push({ ...a, on: false })); return out; };
  const load = () => { const c = $("#bcl", m).value; lines = !c ? [] : src && c === src.client ? fromLines(src) : unbilledFor(c); drawLines(); };
  $("#bcl", m).onchange = load; $("#btx", m).onchange = totals;
  const setNo = () => { if (!ed) $("#bno", m).placeholder = nextBillNo($("#bdt", m).value || today(), true, type) + " (auto)"; };
  $("#bdt", m).onchange = () => { setNo(); if (!ed) $("#bdu", m).value = addDays($("#bdt", m).value, num(b.dueDays) || 15); }; setNo();
  $("#bla", m).onchange = e => { $$("#bl tbody tr:not([hidden]) .lon", m).forEach(x => x.checked = e.target.checked); totals(); };
  $("#bfilt", m).oninput = e => { const q = e.target.value.toLowerCase(); sync(); lines.forEach(l => l.hide = q && !(l.desc + " " + (l.status || "")).toLowerCase().includes(q)); drawLines(); };
  $("#badd", m).onclick = () => { sync(); lines.push({ kind: "custom", ref: "", desc: "", sac: b.sac, qty: 1, rate: "", amount: 0, taxable: true, on: true, mkTask: false, mkStatus: "Filed / Done" }); drawLines(); const r = $("#bl tbody tr:last-child .ldesc", m); if (r) r.focus(); };
  $("#mx", m).onclick = $("#bX", m).onclick = closeModal;
  const build = () => { sync(); const c = $("#bcl", m).value, chosen = lines.filter(l => l.on);
    if (!c) throw "Select a client."; if (!chosen.length) throw "Tick at least one item."; if (chosen.some(l => !l.desc.trim())) throw "Every line needs an item name."; if (chosen.some(l => !(num(l.amount) > 0))) throw "Every ticked line needs a quantity and price.";
    const date = $("#bdt", m).value || today(), tax = $("#btx", m).value, ls = chosen.map(l => ({ id: l.id || uid(), kind: l.kind, ref: l.ref || "", desc: l.desc.trim(), sac: l.taxable ? l.sac : "", qty: num(l.qty), rate: num(l.rate), amount: Math.round(num(l.amount) * 100) / 100, taxable: !!l.taxable, status: l.status || "", mkTask: l.mkTask, mkStatus: l.mkStatus, paid: 0 }));
    const t = calcBill(ls, tax, b.rate);
    return { no: $("#bno", m).value.trim(), date, due: $("#bdu", m).value, fy: fyOf(date), client: c, lines: ls, tax, rate: b.rate, ...t, notes: $("#bnt", m).value.trim(), payMode: $("#bpm", m).value.trim(), showStatus: $("#bss", m).checked, showQty: $("#bsq", m).checked, type }; };
  $("#bPv", m).onclick = () => { try { const bill = build(); bill.no = bill.no || nextBillNo(bill.date, true, type); bill.lines.forEach(l => { if (l.kind === "work") l.status = (S.db.works.find(x => x.id === l.ref) || {}).status || l.status; if (l.kind === "custom" && l.mkTask) l.status = l.mkStatus; }); previewHTML(renderBill(bill), "Preview – " + bill.no); } catch (e) { $("#ber", m).textContent = e; } };
  $("#bOk", m).onclick = () => { let nb; try { nb = build(); } catch (e) { return $("#ber", m).textContent = e; }
    if (nb.no && (S.db.bills || []).some(x => x.no === nb.no && (x.type || "invoice") === type && (!ed || x.id !== ed.id))) return $("#ber", m).textContent = "That number is already used.";
    const now = new Date().toISOString();
    // create tasks for new items marked "save as task"
    nb.lines.filter(l => l.kind === "custom" && l.mkTask).forEach(l => { const w = { id: uid(), client: nb.client, service: svcFor(l.desc) || "Project / Other", form: l.desc, fy: nb.fy, period: "One-time", due: "", filed: l.stg(l.mkStatus) === "Filed / Done" ? nb.date : "",
        status: l.mkStatus || "Filed / Done", priority: "Normal", assigned: S.user, fee: l.amount, createdBy: S.user, createdAt: now }; S.db.works.push(w); l.kind = "work"; l.ref = w.id; l.status = w.status; log("Added", "Work item", `${describe("works", w)} (from billing)`); });
    nb.lines.forEach(l => { delete l.mkTask; delete l.mkStatus; if (l.kind === "work") l.status = (S.db.works.find(x => x.id === l.ref) || {}).status || l.status; });
    let bill;
    if (ed) { if (!PF) unlinkBill(ed); const keep = { id: ed.id, receipts: ed.receipts || [], createdBy: ed.createdBy, createdAt: ed.createdAt, status: ed.status, convertedTo: ed.convertedTo, convertedNo: ed.convertedNo, fromPF: ed.fromPF };
      Object.assign(ed, nb, keep, { no: nb.no || ed.no, updatedBy: S.user, updatedAt: now }); bill = ed; linkBill(bill); log("Edited", PF ? "Proforma" : "Invoice", `${bill.no} – ${cname(bill.client)} – ₹${inr(bill.total)}`); }
    else { bill = { id: uid(), ...nb, status: "Active", receipts: [], createdBy: S.user, createdAt: now };
      if (!bill.no) { let g = 0; do { bill.no = nextBillNo(bill.date, false, type); } while ((S.db.bills || []).some(x => x.no === bill.no && (x.type || "invoice") === type) && g++ < 999); }
      if (from) { bill.fromPF = from.id; from.convertedTo = bill.id; from.convertedNo = bill.no; }
      (S.db.bills = S.db.bills || []).push(bill); linkBill(bill); log(PF ? "Proforma" : "Billed", PF ? "Proforma" : "Invoice", `${bill.no} – ${cname(bill.client)} – ₹${inr(bill.total)} (${bill.lines.length} item(s))${from ? " from proforma " + from.no : ""}`); }
    save(); closeModal(); toast(`${PF ? "Proforma" : "Invoice"} ${bill.no} saved`); S.btab = "bills"; go("billing"); setTimeout(() => billView(bill.id), 200); };
  load();
}
function billView(id) {
  const bill = S.db.bills.find(x => x.id === id); if (!bill) return; const PF = isPF(bill);
  bill.lines.forEach(l => { if (l.kind === "work") { const w = S.db.works.find(x => x.id === l.ref); if (w) l.status = w.status; } });
  const st = billStatus(bill); const canEd = can("billing") && bill.status !== "Cancelled" && !bill.convertedTo;
  const m = openModal(`<div class="mhead"><h3>${PF ? "Proforma" : "Invoice"} ${esc(bill.no)} <span class="chip ${st === "Paid" ? "green" : st === "Part paid" || st === "Proforma" ? "amber" : st === "Cancelled" || st === "Converted" ? "" : "red"}">${st}</span></h3><button class="btn sm" id="mx">✕</button></div>
    <div class="mbody"><iframe id="bif" sandbox="allow-same-origin allow-modals" style="width:100%;height:60vh;border:1px solid var(--line);border-radius:8px;background:#fff"></iframe>
      ${bill.fromPF ? `<p class="small muted">Created from proforma ${esc((S.db.bills.find(x => x.id === bill.fromPF) || {}).no || "")}.</p>` : ""}${bill.convertedTo ? `<p class="small muted">Converted to invoice ${esc(bill.convertedNo || "")}.</p>` : ""}
      ${(bill.receipts || []).length ? `<div class="small b" style="margin-top:10px">Payments received</div><table class="t"><thead><tr><th>Date</th><th>Mode</th><th>Reference</th><th class="num">Amount</th><th>By</th></tr></thead><tbody>${bill.receipts.map(r => `<tr><td>${dmy(r.date)}</td><td>${esc(r.mode)}</td><td>${esc(r.ref || "")}</td><td class="num">${inr(r.amount)}</td><td>${esc(uname(r.by))}</td></tr>`).join("")}</tbody></table>` : ""}</div>
    <div class="mfoot">${bill.status !== "Cancelled" && !(bill.receipts || []).length && !bill.convertedTo && (isAdmin() || can("delete")) ? '<button class="btn danger" id="bCan">Cancel</button>' : ""}${canEd ? '<button class="btn" id="bEd">✎ Edit</button>' : ""}<button class="btn" id="bDup">⧉ Duplicate</button><span class="sp"></span>
      ${PF && canEd ? '<button class="btn primary" id="bConv">→ Convert to invoice</button>' : ""}
      <button class="btn" id="bHtml">⬇ Save as file</button>${can("export") ? '<button class="btn" id="bSh">↗ Share</button>' : ""}${can("print") && !CL.on ? '<button class="btn" id="bPr">🖨 Print / PDF</button>' : ""}${!PF && bill.status !== "Cancelled" && billBal(bill) > 0 ? '<button class="btn primary" id="bPay">₹ Record payment</button>' : ""}</div>`);
  m.querySelector(".mbox").style.maxWidth = "900px";
  const html = renderBill(bill); $("#bif", m).srcdoc = html; const fn = `${PF ? "Proforma" : "Invoice"}_${String(bill.no).replace(/[^A-Za-z0-9]+/g, "_")}.html`;
  $("#mx", m).onclick = closeModal;
  if ($("#bEd", m)) $("#bEd", m).onclick = () => { closeModal(); billDialog({ edit: bill }); };
  $("#bDup", m).onclick = () => { closeModal(); const copy = JSON.parse(JSON.stringify(bill)); copy.lines.forEach(l => { if (l.kind !== "custom") { l.kind = "custom"; l.ref = ""; } l.paid = 0; delete l.id; }); copy.no = ""; copy.date = today(); copy.due = addDays(today(), num(BS().dueDays) || 15); billDialog({ type: bill.type || "invoice", client: bill.client, _copy: copy }); };
  if ($("#bConv", m)) $("#bConv", m).onclick = () => { closeModal(); billDialog({ from: bill }); };
  if ($("#bPr", m)) $("#bPr", m).onclick = () => { try { $("#bif", m).contentWindow.focus(); $("#bif", m).contentWindow.print(); log("Printed", PF ? "Proforma" : "Invoice", bill.no); save(); } catch (e) { download(fn, html, "text/html"); } };
  $("#bHtml", m).textContent = CL.on ? "⬇ Save (to print / email)" : "⬇ Save as file";
  $("#bHtml", m).onclick = () => { download(fn, html, "text/html"); toast("Saved – open it and print to PDF if needed"); };
  if ($("#bSh", m)) $("#bSh", m).onclick = () => shareFile(fn, html, "text/html", `${PF ? "Proforma" : "Invoice"} ${bill.no} from ${S.db.settings.firm.name}`);
  if ($("#bPay", m)) $("#bPay", m).onclick = () => payDialog(bill);
  if ($("#bCan", m)) $("#bCan", m).onclick = async () => { if (!(await confirmBox(`Cancel ${PF ? "proforma" : "invoice"}`, `<p>Cancel <b>${esc(bill.no)}</b>?${PF ? "" : " Its tasks become unbilled again so they can be billed afresh."} The number is not reused.</p>`, "Cancel it"))) return;
    if (!PF) unlinkBill(bill); bill.status = "Cancelled"; bill.cancelledBy = S.user; bill.cancelledAt = new Date().toISOString();
    log("Cancelled", PF ? "Proforma" : "Invoice", bill.no); save(); toast("Cancelled"); go("billing"); };
}
function payDialog(bill) {
  const bal = billBal(bill);
  const m = openModal2(`<form id="pyF"><div class="mhead"><h3>Record payment – ${esc(bill.no)}</h3></div><div class="mbody"><div class="fgrid">
    <div class="field"><label>Date</label><input type="date" id="pyD" value="${today()}"></div><div class="field"><label>Amount (₹)</label><input type="number" id="pyA" step="0.01" min="0.01" value="${bal}"></div>
    <div class="field"><label>Mode</label><select id="pyM">${["NEFT / RTGS", "UPI", "Cheque", "Cash", "Net banking", "Other"].map(x => `<option>${x}</option>`).join("")}</select></div><div class="field"><label>Reference / UTR / cheque no.</label><input id="pyR" maxlength="60"></div></div>
    <p class="small muted">Balance before this payment: ₹ ${inr(bal)}. The amount is applied to the invoice's lines in order and updates each task's fee received.</p><div class="err" id="pyE"></div></div>
    <div class="mfoot"><button type="button" class="btn" id="pyN">Cancel</button><button class="btn primary" type="submit">Save payment</button></div></form>`);
  $("#pyN", m).onclick = () => m.remove();
  $("#pyF", m).onsubmit = e => { e.preventDefault(); const amt = Math.round(num($("#pyA", m).value) * 100) / 100, date = $("#pyD", m).value || today();
    if (!(amt > 0)) return $("#pyE", m).textContent = "Enter an amount."; if (amt > bal + 0.009) return $("#pyE", m).textContent = "Amount is more than the balance.";
    (bill.receipts = bill.receipts || []).push({ id: uid(), date, amount: amt, mode: $("#pyM", m).value, ref: $("#pyR", m).value.trim(), by: S.user, at: new Date().toISOString() });
    allocate(bill, amt, date);
    log("Payment", "Invoice", `${bill.no} – ₹${inr(amt)} ${$("#pyM", m).value}`); save(); m.remove(); closeModal(); toast("Payment recorded"); go("billing"); setTimeout(() => billView(bill.id), 150); };
}
function previewHTML(html, title) {
  const m = openModal2(`<div class="mhead"><h3>${esc(title)}</h3></div><div class="mbody"><iframe sandbox="allow-same-origin allow-modals" style="width:100%;height:65vh;border:1px solid var(--line);border-radius:8px;background:#fff"></iframe></div><div class="mfoot">${CL.on ? "" : '<button class="btn" id="pvP">🖨 Print</button>'}<button class="btn primary" id="pvX">Close</button></div>`);
  m.querySelector(".mbox").style.maxWidth = "900px"; const f = $("iframe", m); f.srcdoc = html;
  $("#pvX", m).onclick = () => m.remove(); if ($("#pvP", m)) $("#pvP", m).onclick = () => { try { f.contentWindow.focus(); f.contentWindow.print(); } catch {} };
}
/* ------------------------------------------------------------------ bill rendering */
function billVars(bill) {
  const b = BS(), sh = b.show, f = S.db.settings.firm, c = clientById(bill.client) || {}, t = calcBill(bill.lines, bill.tax, bill.rate), PF = isPF(bill);
  const showQty = bill.showQty ?? sh.qty, showStatus = bill.showStatus ?? sh.status, showSac = sh.sac && bill.lines.some(l => l.sac);
  const head = `<tr><th style="width:30px">#</th><th>Item name</th>${showStatus ? '<th style="width:110px">Status</th>' : ""}${showSac ? '<th style="width:80px">SAC</th>' : ""}${showQty ? '<th class="r" style="width:80px">Quantity</th><th class="r" style="width:110px">Price/ unit</th>' : ""}<th class="r" style="width:120px">Amount</th></tr>`;
  const row = (l, i) => `<tr><td>${i + 1}</td><td><b>${esc(l.desc)}</b></td>${showStatus ? `<td>${esc(l.status || "")}</td>` : ""}${showSac ? `<td>${esc(l.sac || "")}</td>` : ""}${showQty ? `<td class="r">${num(l.qty ?? 1).toLocaleString("en-IN")}</td><td class="r">₹ ${inr(l.rate ?? l.amount)}</td>` : ""}<td class="r">₹ ${inr(l.amount)}</td></tr>`;
  const cols = 3 + (showStatus ? 1 : 0) + (showSac ? 1 : 0) + (showQty ? 2 : 0);
  const items = `<table class="items"><thead>${head}</thead><tbody>${bill.lines.map(row).join("")}<tr class="tr"><td></td><td><b>Total</b></td><td colspan="${cols - 2}" class="r"><b>₹ ${inr(t.taxable + t.nontax)}</b></td></tr></tbody></table>`;
  const fees = bill.lines.filter(l => l.taxable), reim = bill.lines.filter(l => !l.taxable);
  const tbl = (rows, sac) => `<table class="items"><thead><tr><th style="width:36px">S.No.</th><th>Particulars</th>${sac ? '<th style="width:80px">SAC</th>' : ""}<th style="width:120px" class="r">Amount (₹)</th></tr></thead><tbody>${rows.map((l, i) => `<tr><td>${i + 1}</td><td>${esc(l.desc)}${showStatus && l.status ? ` <span class="muted">(${esc(l.status)})</span>` : ""}</td>${sac ? `<td>${esc(l.sac || "")}</td>` : ""}<td class="r">${inr(l.amount)}</td></tr>`).join("")}</tbody></table>`;
  const heading = esc(b.title && !PF ? b.title : PF ? b.pfHeading || "Proforma Invoice" : b.invHeading || (bill.tax === "none" ? "Invoice" : "Tax Invoice"));
  const tot = `<table class="tot"><tbody><tr><td>Sub Total</td><td class="r">₹ ${inr(t.taxable + t.nontax)}</td></tr>${t.cgst ? `<tr><td>CGST @ ${bill.rate / 2}%</td><td class="r">₹ ${inr(t.cgst)}</td></tr><tr><td>SGST @ ${bill.rate / 2}%</td><td class="r">₹ ${inr(t.sgst)}</td></tr>` : ""}${t.igst ? `<tr><td>IGST @ ${bill.rate}%</td><td class="r">₹ ${inr(t.igst)}</td></tr>` : ""}${t.round ? `<tr><td>Round off</td><td class="r">₹ ${inr(t.round)}</td></tr>` : ""}<tr class="g"><td>Total</td><td class="r">₹ ${inr(t.total)}</td></tr></tbody></table>`;
  const bankTxt = esc(b.bank || "").replace(/\n/g, "<br>") + (b.upi ? `<br>UPI: ${esc(b.upi)}` : "");
  return { firm_name: esc(f.name), firm_address: esc(f.address).replace(/\n/g, "<br>"), firm_phone: esc(f.phone), firm_email: esc(f.email), frn: esc(f.frn), partner: esc(f.partner), proprietor: esc(b.proprietor || ""), firm_gstin: esc(b.gstin), firm_pan: esc(b.pan), firm_state: esc(b.state),
    logo: b.logo ? `<img src="${b.logo}" style="max-height:80px;max-width:200px">` : "", logo_src: b.logo || "", letterhead: b.letterhead ? `<img src="${b.letterhead}" style="width:100%">` : "",
    qr: b.qr && sh.qr ? `<img src="${b.qr}" style="width:90px;height:90px">` : "", signature: b.signature && sh.signature ? `<img src="${b.signature}" style="max-height:55px;max-width:180px">` : "",
    bill_title: heading, doc_label: PF ? "Proforma" : "Invoice", bill_no: esc(bill.no), bill_date: dmy(bill.date), due_date: dmy(bill.due), fy: esc(bill.fy), payment_mode: esc(bill.payMode || b.payMode || ""),
    client_name: esc(c.name || ""), client_code: esc(c.code || ""), client_address: sh.clientAddr ? esc(c.address || "").replace(/\n/g, "<br>") : "", client_gstin: sh.clientGstin ? esc(c.gstin || "") : "", client_pan: esc(c.pan || ""),
    items_full: items, items_table: fees.length ? tbl(fees, true) : "", reimb_table: reim.length ? `<div class="sub">Reimbursement of expenses (not subject to GST)</div>${tbl(reim, false)}` : "", totals_table: tot,
    subtotal: inr(t.taxable + t.nontax), cgst: inr(t.cgst), sgst: inr(t.sgst), igst: inr(t.igst), reimbursements: inr(t.nontax), round_off: inr(t.round), total: inr(t.total), amount_words: words(t.total),
    bank_details: bankTxt, terms: esc(b.terms || "").replace(/\n/g, "<br>"), notes: sh.notes ? esc(bill.notes || "").replace(/\n/g, "<br>") : "", signatory: esc(b.signatory || f.partner || ""), color: esc(b.color || "#1f2a44"), table_color: esc(b.tableColor || "#8dc63f"),
    status: bill.status === "Cancelled" ? '<div style="color:#c62828;font-size:28px;font-weight:700;border:3px solid #c62828;display:inline-block;padding:4px 14px;transform:rotate(-8deg)">CANCELLED</div>' : "",
    _show: { words: sh.words, payMode: sh.payMode && (bill.payMode || b.payMode), terms: sh.terms && b.terms, bank: sh.bank && (b.bank || b.upi || (b.qr && sh.qr)), due: sh.due && bill.due, notes: sh.notes && bill.notes } };
}
const BILL_CSS = `*{box-sizing:border-box}body{font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#111;margin:0;padding:28px 34px}@page{size:A4;margin:12mm}@media print{body{padding:0}}
table{border-collapse:collapse;width:100%}.items th{background:{{color}};color:#fff;text-align:left;padding:6px 8px;font-size:11px;-webkit-print-color-adjust:exact;print-color-adjust:exact}.items td{border-bottom:1px solid #ddd;padding:6px 8px;vertical-align:top}
.r{text-align:right}.tot{width:300px;margin-left:auto;margin-top:8px}.tot td{padding:4px 8px}.tot tr.g td{border-top:2px solid {{color}};font-weight:700;font-size:13px}.sub{font-weight:700;margin:14px 0 4px;color:{{color}}}
.muted{color:#555}.box{border:1px solid #ccc;border-radius:4px;padding:8px 10px}`;
const KSC_CSS = `*{box-sizing:border-box}body{font-family:Roboto,Arial,Helvetica,sans-serif;font-size:12.5px;color:#111;margin:0;padding:30px 36px}@page{size:A4;margin:10mm}@media print{body{padding:0}}
table{border-collapse:collapse;width:100%}.firm{font-size:24px;font-weight:700;letter-spacing:.2px;margin:0 0 6px}.fl{line-height:1.55}
.hr{border-bottom:1.5px solid #222;margin:12px 0 8px}.ttl{text-align:center;font-size:16px;font-weight:700;margin:2px 0 12px}
.items th{background:{{table_color}};color:#fff;text-align:left;padding:7px 8px;font-weight:700;-webkit-print-color-adjust:exact;print-color-adjust:exact}.items td{padding:7px 8px;border-bottom:1px solid #d9d9d9}
.items tr.tr td{border-bottom:1px solid #222}.r{text-align:right}.items th.r{text-align:right}.tot{width:100%}.tot td{padding:6px 8px;border-bottom:1px solid #d9d9d9}.tot tr.g td{font-weight:700;border-bottom:1.5px solid #222}
.up{text-transform:uppercase}.k{font-weight:700}.sec{margin-top:12px;line-height:1.5}.muted{color:#555}.sub{font-weight:700;margin:14px 0 4px}`;
const BILL_TEMPLATES = {
  ksc: `<!DOCTYPE html><html><head><meta charset="utf-8"><title>{{bill_no}}</title><style>${KSC_CSS}</style></head><body>
{{letterhead}}<table><tr><td style="vertical-align:top"><div class="firm up">{{firm_name}}</div><div class="fl">{{proprietor}}<br>{{firm_address}}<br>Phone no.: {{firm_phone}}<br>Email: {{firm_email}}{{gst_line}}</div></td><td style="vertical-align:middle;text-align:right;width:170px">{{logo}}</td></tr></table>
<div class="hr"></div><div class="ttl">{{bill_title}}</div>{{status}}
<table style="margin-bottom:10px"><tr><td style="vertical-align:top"><div class="k">Bill To</div><div class="k" style="margin-top:12px">{{client_name}}</div><div>{{client_address}}</div>{{client_gst_line}}</td>
<td style="vertical-align:top;text-align:right"><div class="k">{{doc_label}} Details</div><div style="margin-top:12px">{{doc_label}} No.: {{bill_no}}</div><div>Date: {{bill_date}}</div>{{due_line}}</td></tr></table>
{{items_full}}
<table style="margin-top:12px"><tr><td style="vertical-align:top;width:55%;padding-right:30px">{{words_block}}{{paymode_block}}{{terms_block}}{{notes_block}}</td><td style="vertical-align:top">{{totals_table}}</td></tr></table>
{{bank_block}}</body></html>`,
  classic: `<!DOCTYPE html><html><head><meta charset="utf-8"><title>{{bill_no}}</title><style>${BILL_CSS}</style></head><body>
{{letterhead}}<table style="border-bottom:2px solid {{color}};margin-bottom:12px"><tr><td style="vertical-align:top">{{logo}}</td><td style="text-align:right;vertical-align:top"><div style="font-size:20px;font-weight:700;color:{{color}}">{{firm_name}}</div><div class="muted">{{firm_address}}</div><div class="muted">{{firm_phone}} {{firm_email}}</div><div class="muted">FRN: {{frn}} &nbsp; GSTIN: {{firm_gstin}} &nbsp; PAN: {{firm_pan}}</div></td></tr></table>
<div style="text-align:center;font-size:16px;font-weight:700;letter-spacing:2px;margin:6px 0 12px">{{bill_title}}</div>{{status}}
<table style="margin-bottom:12px"><tr><td style="width:60%;vertical-align:top" class="box"><b>Bill to</b><br><b>{{client_name}}</b><br>{{client_address}}<br>GSTIN: {{client_gstin}} &nbsp; PAN: {{client_pan}}</td>
<td style="vertical-align:top;padding-left:12px"><table><tr><td class="muted">{{doc_label}} no.</td><td><b>{{bill_no}}</b></td></tr><tr><td class="muted">Date</td><td>{{bill_date}}</td></tr><tr><td class="muted">Due date</td><td>{{due_date}}</td></tr><tr><td class="muted">Client code</td><td>{{client_code}}</td></tr></table></td></tr></table>
{{items_table}}{{reimb_table}}{{totals_table}}<p><b>Amount in words:</b> {{amount_words}}</p><p>{{notes}}</p>
<table style="margin-top:18px"><tr><td style="vertical-align:top;width:60%"><b>Bank details</b><br>{{bank_details}}<br><br><b>Terms</b><br><span class="muted">{{terms}}</span></td><td style="text-align:right;vertical-align:bottom">For <b>{{firm_name}}</b><br>{{signature}}<br><br>{{signatory}}<br><span class="muted">Authorised signatory</span></td></tr></table></body></html>`,
  modern: `<!DOCTYPE html><html><head><meta charset="utf-8"><title>{{bill_no}}</title><style>${BILL_CSS}.band{background:{{color}};color:#fff;padding:18px 22px;border-radius:6px;-webkit-print-color-adjust:exact;print-color-adjust:exact}</style></head><body>
{{letterhead}}<div class="band"><table><tr><td style="color:#fff"><div style="font-size:22px;font-weight:700">{{firm_name}}</div><div style="opacity:.85">{{firm_address}} · {{firm_phone}} · {{firm_email}}</div><div style="opacity:.85">FRN {{frn}} · GSTIN {{firm_gstin}} · PAN {{firm_pan}}</div></td><td style="text-align:right;color:#fff"><div style="font-size:24px;font-weight:700;letter-spacing:3px">{{bill_title}}</div><div>{{bill_no}}</div></td></tr></table></div>{{status}}
<table style="margin:16px 0"><tr><td style="vertical-align:top"><div class="muted" style="font-size:10px;text-transform:uppercase;letter-spacing:1px">Billed to</div><div style="font-size:14px;font-weight:700">{{client_name}}</div><div>{{client_address}}</div><div class="muted">GSTIN {{client_gstin}} · PAN {{client_pan}}</div></td>
<td style="text-align:right;vertical-align:top"><div class="muted">Date: <b style="color:#111">{{bill_date}}</b></div><div class="muted">Due: <b style="color:#111">{{due_date}}</b></div></td></tr></table>
{{items_table}}{{reimb_table}}{{totals_table}}<p style="margin-top:6px"><i>{{amount_words}}</i></p><p>{{notes}}</p>
<table style="margin-top:22px;border-top:1px solid #ddd"><tr><td style="vertical-align:top;padding-top:10px;width:60%"><b>Pay to</b><br>{{bank_details}}<br><br><span class="muted">{{terms}}</span></td><td style="text-align:right;vertical-align:bottom">For {{firm_name}}<br>{{signature}}<br><b>{{signatory}}</b></td></tr></table></body></html>`,
  minimal: `<!DOCTYPE html><html><head><meta charset="utf-8"><title>{{bill_no}}</title><style>${BILL_CSS}.items th{background:#fff!important;color:#111!important;border-bottom:2px solid #111}</style></head><body>
{{letterhead}}<div style="font-size:18px;font-weight:700">{{firm_name}}</div><div class="muted">{{firm_address}}</div><div class="muted">GSTIN {{firm_gstin}} · PAN {{firm_pan}}</div><hr>{{status}}
<p><b>{{bill_title}} {{bill_no}}</b> &nbsp; dated {{bill_date}}<br>To: <b>{{client_name}}</b>, {{client_address}} {{client_gstin}}</p>{{items_table}}{{reimb_table}}{{totals_table}}<p>{{amount_words}}</p><p>{{notes}}</p><p class="muted">{{bank_details}}</p><p class="muted">{{terms}}</p><p style="text-align:right">{{signature}}<br>{{signatory}}</p></body></html>`,
};
function sanitizeTemplate(html) {
  const d = new DOMParser().parseFromString(html, "text/html");
  d.querySelectorAll("script,iframe,object,embed,link,meta,base,form,frame,frameset,applet").forEach(e => e.remove());
  d.querySelectorAll("*").forEach(el => [...el.attributes].forEach(a => { const n = a.name.toLowerCase(), v = a.value.trim();
    if (n.startsWith("on") || /javascript:|vbscript:/i.test(v) || n === "srcdoc") el.removeAttribute(a.name);
    else if ((n === "src" || n === "href" || n === "xlink:href" || n === "action") && !/^(data:image\/(png|jpe?g|gif|webp);|#|\{\{)/i.test(v)) el.removeAttribute(a.name); }));
  d.querySelectorAll("style").forEach(st => { st.textContent = st.textContent.replace(/@import[^;]*;?/gi, "").replace(/url\((?!\s*['"]?data:image)[^)]*\)/gi, "none"); });
  return "<!DOCTYPE html>" + d.documentElement.outerHTML;
}
function renderBill(bill) {
  const b = BS(), v = billVars(bill), s = v._show;
  // composite blocks (used by the KSC layout, also available to custom templates)
  Object.assign(v, {
    gst_line: b.gstin ? `<br>GSTIN: ${v.firm_gstin}${b.pan ? " &nbsp; PAN: " + v.firm_pan : ""}` : (b.pan ? `<br>PAN: ${v.firm_pan}` : ""),
    client_gst_line: v.client_gstin ? `<div>GSTIN: ${v.client_gstin}</div>` : "", due_line: s.due ? `<div>Due date: ${v.due_date}</div>` : "",
    words_block: s.words ? `<div class="sec"><b>${v.doc_label} Amount In Words:</b> ${esc(v.amount_words)}</div>` : "",
    paymode_block: s.payMode ? `<div class="sec"><b>Payment Mode:</b> ${v.payment_mode}</div>` : "",
    terms_block: s.terms ? `<div class="sec"><b>Terms and conditions:</b> ${v.terms}</div>` : "", notes_block: s.notes ? `<div class="sec"><b>Notes:</b> ${v.notes}</div>` : "",
    bank_block: `<table style="margin-top:22px"><tr><td style="vertical-align:top;width:55%">${s.bank ? `<div class="k" style="margin-bottom:8px">Bank Details</div><table><tr>${v.qr ? `<td style="width:100px;vertical-align:top">${v.qr}</td>` : ""}<td style="vertical-align:top;line-height:1.7">${v.bank_details}</td></tr></table>` : ""}</td>
      <td style="vertical-align:top;text-align:center"><div style="margin-top:28px">For: <span class="${b.template === "ksc" ? "up" : ""}">${v.firm_name}</span></div><div style="height:62px;display:flex;align-items:center;justify-content:center">${v.signature}</div><div class="k">Authorized Signatory</div>${v.signatory ? `<div class="muted" style="font-size:11px">${v.signatory}</div>` : ""}</td></tr></table>` });
  const tpl = b.template === "custom" && b.customHTML ? b.customHTML : BILL_TEMPLATES[b.template] || BILL_TEMPLATES.ksc;
  let out = tpl.replace(/\{\{\s*([a-z_]+)\s*\}\}/g, (m0, k) => k in v && k !== "_show" ? v[k] : "");
  if (b.template === "custom") out = out.replace("</head>", `<style>${KSC_CSS.replace(/\{\{table_color\}\}/g, v.table_color)}${BILL_CSS.replace(/\{\{color\}\}/g, v.color)}</style></head>`);
  return out;
}
function sampleBill(type) {
  const c = vC()[0] || { id: "x", name: "Sample Client Pvt Ltd", code: "C001" };
  return { no: nextBillNo(today(), true, type), type: type || "invoice", date: today(), due: addDays(today(), 15), fy: fyOf(today()), client: c.id, tax: BS().tax, rate: BS().rate, notes: "", payMode: BS().payMode, status: "Active", receipts: [],
    lines: [{ desc: "Professional", sac: BS().sac, qty: 1, rate: 12500, amount: 12500, taxable: true, status: "Filed / Done" }, { desc: "Challan roc", qty: 1, rate: 1200, amount: 1200, taxable: false, status: "" }] };
}
/* resize uploaded images so each fits comfortably in one online record */
function fitImage(file, maxW, maxH) {
  return new Promise((res, rej) => { const rd = new FileReader(); rd.onerror = rej; rd.onload = () => { const im = new Image(); im.onerror = () => rej(new Error("Not an image"));
    im.onload = () => { const sc = Math.min(1, maxW / im.width, maxH / im.height), w = Math.round(im.width * sc), h = Math.round(im.height * sc); const cv = document.createElement("canvas"); cv.width = w; cv.height = h;
      const cx = cv.getContext("2d"); cx.fillStyle = "#fff"; cx.fillRect(0, 0, w, h); cx.drawImage(im, 0, 0, w, h);
      let url = cv.toDataURL("image/png"); if (url.length > 140000) url = cv.toDataURL("image/jpeg", 0.85); if (url.length > 140000) url = cv.toDataURL("image/jpeg", 0.6); res(url); }; im.src = rd.result; }; rd.readAsDataURL(file); });
}
function drawBillFormat() {
  const b = BS(), sh = b.show, A = isAdmin() || can("billing");
  const fld = (id, l, v, extra = "") => `<div class="field"><label>${l}</label><input id="${id}" value="${esc(v ?? "")}" ${extra}></div>`;
  const tog = (k, l) => `<label><input type="checkbox" data-show="${k}" ${sh[k] ? "checked" : ""}> ${l}</label>`;
  const img = (k, l, hint) => `<div class="field"><label>${l}</label><div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">${b[k] ? `<img src="${b[k]}" style="max-height:60px;max-width:180px;border:1px solid #eee;padding:3px;border-radius:6px;background:#fff"><button class="btn sm danger" data-imgx="${k}">Remove</button>` : '<span class="small muted">None</span>'}</div><input type="file" data-img="${k}" accept="image/png,image/jpeg,image/webp">${hint ? `<span class="small muted">${hint}</span>` : ""}</div>`;
  $("#bview").innerHTML = `<div class="grid two" style="align-items:start">
   <div class="card"><h3>Layout</h3>
      <div class="checks" style="margin-bottom:8px">${[["ksc", "KSC (my current invoice)"], ["classic", "Classic"], ["modern", "Modern"], ["minimal", "Minimal"], ["custom", "My own template"]].map(([k, l]) => `<label><input type="radio" name="btpl" value="${k}" ${b.template === k ? "checked" : ""} ${k === "custom" && !b.customHTML ? "disabled" : ""}> ${l}</label>`).join("")}</div>
      <div class="fgrid">${fld("bfInvH", "Invoice heading", b.invHeading)}${fld("bfPfH", "Proforma heading", b.pfHeading)}
        <div class="field"><label>Table header colour</label><input type="color" id="bfTColor" value="${esc(b.tableColor)}" style="height:38px;padding:2px"></div><div class="field"><label>Accent colour (other layouts)</label><input type="color" id="bfColor" value="${esc(b.color)}" style="height:38px;padding:2px"></div>
        <div class="field"><label>Amount in words style</label><select id="bfWords"><option value="vyapar">Thirteen Thousand Seven Hundred Rupees only</option><option value="formal">Rupees Thirteen Thousand Seven Hundred Only</option></select></div>
        ${fld("bfPay", "Default payment mode", b.payMode)}</div>
      <div class="small b" style="margin-top:6px">Show on bills</div><div class="checks">${tog("qty", "Quantity & price/unit")}${tog("status", "Task status column")}${tog("sac", "SAC code")}${tog("words", "Amount in words")}${tog("payMode", "Payment mode")}${tog("terms", "Terms")}${tog("bank", "Bank details")}${tog("qr", "UPI QR code")}${tog("signature", "Signature")}${tog("due", "Due date")}${tog("clientAddr", "Client address")}${tog("clientGstin", "Client GSTIN")}${tog("notes", "Notes")}</div>
      <h3 style="margin-top:14px">Numbering</h3><div class="fgrid">
        <div class="field"><label>Invoice numbers</label><select id="bfCont"><option value="1">One running series (e.g. 202751, 202752…)</option><option value="0">Restart every financial year</option></select></div>
        ${fld("bfPrefix", "Invoice prefix (optional, {FY} = 2026-27)", b.prefix)}${fld("bfNext", "Next invoice number", (b.continuous ? num(b.cseq) : (b.seq[fyOf(today())] || 0)) + 1, 'type="number" min="1"')}
        ${fld("bfPad", "Minimum digits (0 = as typed)", b.pad, 'type="number" min="0" max="8"')}${fld("bfPfPrefix", "Proforma prefix", b.pfPrefix)}${fld("bfPfNext", "Next proforma number", num(b.pfSeq) + 1, 'type="number" min="1"')}</div>
      <p class="small muted">Next invoice: <b id="bfNI">${esc(nextBillNo(today()))}</b> · next proforma: <b>${esc(nextBillNo(today(), true, "proforma"))}</b></p>
      <h3 style="margin-top:14px">Firm details printed</h3><div class="fgrid">
        <div class="field full"><label>Firm name</label><input id="bfFirm" value="${esc(S.db.settings.firm.name)}" ${isAdmin() ? "" : "disabled"}></div>
        <div class="field full"><label>Address (one line each)</label><textarea id="bfAddr" ${isAdmin() ? "" : "disabled"}>${esc(S.db.settings.firm.address)}</textarea></div>
        ${fld("bfPhone", "Phone no.", S.db.settings.firm.phone, isAdmin() ? "" : "disabled")}${fld("bfEmail", "Email", S.db.settings.firm.email, isAdmin() ? "" : "disabled")}</div>
      <h3 style="margin-top:14px">Bill details</h3><div class="fgrid">
        ${fld("bfProp", "Name under firm name (e.g. Pushpender Kishore Sharma)", b.proprietor)}${fld("bfSign", "Signatory name (optional)", b.signatory)}
        ${fld("bfGstin", "Firm GSTIN (blank if not registered)", b.gstin)}${fld("bfPan", "Firm PAN (optional)", b.pan)}
        <div class="field"><label>Default GST</label><select id="bfTax"><option value="none">No GST</option><option value="intra">CGST + SGST</option><option value="inter">IGST</option></select></div>${fld("bfRate", "GST rate %", b.rate, 'type="number" step="0.01"')}
        ${fld("bfSac", "Default SAC code", b.sac)}${fld("bfDue", "Default due days", b.dueDays, 'type="number" min="0"')}${fld("bfState", "State", b.state)}${fld("bfUpi", "UPI ID (printed under bank details)", b.upi)}
        <div class="field full"><label>Bank details (one line each)</label><textarea id="bfBank">${esc(b.bank)}</textarea></div>
        <div class="field full"><label>Terms and conditions</label><textarea id="bfTerms">${esc(b.terms)}</textarea></div></div>
      <p class="small muted">Only an Admin can change firm name, address, phone and email (also in Settings › Firm details).</p>
      ${A ? '<button class="btn primary" id="bfSave">Save format</button> <button class="btn" id="bfPrev">👁 Preview invoice</button> <button class="btn" id="bfPrevP">👁 Preview proforma</button>' : ""}</div>
   <div><div class="card" style="margin-bottom:14px"><div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><h3 style="margin:0;flex:1">Live preview</h3>
        <select id="bfPvT" style="border:1px solid #cfd5df;border-radius:8px;padding:5px 8px"><option value="invoice">Invoice</option><option value="proforma">Proforma</option></select>
        ${A ? '<button class="btn sm" id="bfKsc" title="Fill in the details from your current Vyapar invoice (No. 202751)">⤓ Use my current invoice details</button>' : ""}</div>
      <iframe id="bfPv" sandbox="allow-same-origin" style="width:100%;height:560px;border:1px solid var(--line);border-radius:8px;margin-top:10px;background:#fff"></iframe>
      <p class="small muted" style="margin-bottom:0">Updates as you type. Changes are kept only when you click <b>Save format</b>.</p></div>
   <div class="card"><h3>Images</h3>${img("logo", "Logo (top right)")}${img("qr", "UPI / payment QR code")}${img("signature", "Signature")}${img("letterhead", "Full-width letterhead image (optional)")}
      <p class="small muted">Images are resized automatically. Use PNG or JPG.</p>
      <h3 style="margin-top:14px">My own template</h3>
      <div class="field"><label>Upload a bill template (.html)</label><input type="file" id="bfTpl" accept=".html,.htm">
        <span class="small muted">${b.customHTML ? "✔ Custom template uploaded. " : ""}Start from <button type="button" class="link" id="bfSample">the KSC template</button>, edit it in any HTML editor and upload it. Scripts and outside links are removed for security.</span>
        ${b.customHTML ? '<div style="margin-top:6px"><button class="btn sm" id="bfTplDl">⬇ Download my template</button> <button class="btn sm" id="bfTplEd">✎ Edit template here</button> <button class="btn sm danger" id="bfTplX">Remove</button></div>' : '<div style="margin-top:6px"><button class="btn sm" id="bfTplEd">✎ Edit a template here</button></div>'}</div>
      <details class="small"><summary class="b" style="cursor:pointer">Placeholders you can use</summary><p style="line-height:1.8"><code>{{firm_name}} {{proprietor}} {{firm_address}} {{firm_phone}} {{firm_email}} {{frn}} {{firm_gstin}} {{firm_pan}} {{logo}} {{qr}} {{signature}} {{letterhead}} {{bill_title}} {{doc_label}} {{bill_no}} {{bill_date}} {{due_date}} {{payment_mode}} {{client_name}} {{client_code}} {{client_address}} {{client_gstin}} {{client_pan}} {{items_full}} {{items_table}} {{reimb_table}} {{totals_table}} {{subtotal}} {{cgst}} {{sgst}} {{igst}} {{total}} {{amount_words}} {{bank_details}} {{terms}} {{notes}} {{signatory}} {{words_block}} {{paymode_block}} {{terms_block}} {{bank_block}} {{table_color}} {{color}}</code></p></details></div></div></div>`;
  $("#bfTax").value = b.tax; $("#bfWords").value = b.wordsStyle; $("#bfCont").value = b.continuous ? "1" : "0";
  $$("[data-img]").forEach(el => el.onchange = async () => { const f = el.files[0]; if (!f) return; if (!/^image\/(png|jpeg|webp)$/.test(f.type)) return toast("Use PNG, JPG or WEBP");
    const k = el.dataset.img; try { b[k] = await fitImage(f, k === "letterhead" ? 1400 : k === "logo" ? 360 : k === "qr" ? 320 : 480, k === "letterhead" ? 300 : 360); log("Edited", "Billing", k + " uploaded"); save(); drawBillFormat(); } catch (e) { toast("Could not read image"); } });
  $$("[data-imgx]").forEach(x => x.onclick = () => { b[x.dataset.imgx] = ""; save(); drawBillFormat(); });
  $("#bfTpl").onchange = async e => { const f = e.target.files[0]; if (!f) return; if (f.size > 120 * 1024) return toast("Template too large – max 120 KB");
    b.customHTML = sanitizeTemplate(await f.text()); b.template = "custom"; log("Edited", "Billing", "Custom bill template uploaded"); save(); toast("Template uploaded and selected"); drawBillFormat(); };
  $("#bfSample").onclick = () => download("bill_template_KSC.html", BILL_TEMPLATES.ksc.replace(`<style>${KSC_CSS}</style>`, "<style>\n/* your own styles here – the KSC styles are added automatically */\n</style>"), "text/html");
  if ($("#bfTplDl")) $("#bfTplDl").onclick = () => download("my_bill_template.html", b.customHTML, "text/html");
  if ($("#bfTplX")) $("#bfTplX").onclick = () => { b.customHTML = ""; if (b.template === "custom") b.template = "ksc"; save(); drawBillFormat(); };
  const collect = () => { if (isAdmin()) { const f = S.db.settings.firm; f.name = $("#bfFirm").value.trim() || f.name; f.address = $("#bfAddr").value.trim(); f.phone = $("#bfPhone").value.trim(); f.email = $("#bfEmail").value.trim(); }
    b.template = ($("input[name=btpl]:checked") || {}).value || "ksc"; b.invHeading = $("#bfInvH").value.trim() || "Invoice"; b.pfHeading = $("#bfPfH").value.trim() || "Proforma Invoice";
    b.tableColor = $("#bfTColor").value; b.color = $("#bfColor").value; b.wordsStyle = $("#bfWords").value; b.payMode = $("#bfPay").value.trim();
    $$("[data-show]").forEach(x => b.show[x.dataset.show] = x.checked ? 1 : 0);
    b.continuous = $("#bfCont").value === "1"; b.prefix = $("#bfPrefix").value; b.pad = num($("#bfPad").value);
    const nx = Math.max(1, Math.floor(num($("#bfNext").value) || 1)); if (b.continuous) b.cseq = nx - 1; else b.seq[fyOf(today())] = nx - 1;
    b.pfPrefix = $("#bfPfPrefix").value; b.pfSeq = Math.max(1, Math.floor(num($("#bfPfNext").value) || 1)) - 1;
    b.proprietor = $("#bfProp").value.trim(); b.signatory = $("#bfSign").value.trim(); b.gstin = $("#bfGstin").value.trim().toUpperCase(); b.pan = $("#bfPan").value.trim().toUpperCase();
    b.tax = $("#bfTax").value; b.rate = num($("#bfRate").value) || 18; b.sac = $("#bfSac").value.trim(); b.dueDays = num($("#bfDue").value); b.state = $("#bfState").value.trim(); b.upi = $("#bfUpi").value.trim();
    b.bank = $("#bfBank").value; b.terms = $("#bfTerms").value; };
  if ($("#bfSave")) $("#bfSave").onclick = () => { collect(); S.vault.firm = S.db.settings.firm.name; log("Edited", "Billing", "Bill format saved"); save(); toast("Bill format saved"); drawBillFormat(); };
  let pvT = null; const live = () => { clearTimeout(pvT); pvT = setTimeout(() => { const snapB = JSON.stringify(b), snapF = JSON.stringify(S.db.settings.firm);
      try { collect(); $("#bfPv").srcdoc = renderBill(sampleBill($("#bfPvT").value)); } finally { Object.keys(b).forEach(k => delete b[k]); Object.assign(b, JSON.parse(snapB)); Object.assign(S.db.settings.firm, JSON.parse(snapF)); } }, 250); };
  $$("#bview input, #bview textarea, #bview select").forEach(el => { if (el.type !== "file") el.addEventListener(el.tagName === "SELECT" || el.type === "checkbox" || el.type === "radio" || el.type === "color" ? "change" : "input", live); });
  live();
  if ($("#bfKsc")) $("#bfKsc").onclick = async () => { if (!(await confirmBox("Use my current invoice details", `<p>This fills in the layout, firm details, bank details, terms, UPI QR code, logo and numbering (next invoice <b>202752</b>) from your current invoice. You can change any of it afterwards.</p>`, "Fill in", false))) return;
    Object.assign(S.db.settings.firm, { name: "Kishore Sharma & Co.", address: "SCF 27, DLF, FIRST FLOOR, SECTOR 11D,\nFARIDABAD 121006 HARYANA INDIA.", phone: "9999974111", email: "capushpendersharma@outlook.com" }); S.vault.firm = S.db.settings.firm.name;
    Object.assign(b, { template: "ksc", invHeading: "Invoice", pfHeading: "Proforma Invoice", tableColor: "#8dc63f", wordsStyle: "vyapar", payMode: "Credit", proprietor: "Pushpender Kishore Sharma",
      bank: "Name: ICICI BANK LIMITED, FARIDABAD - SECTOR 35\nAccount No.: 085705002507\nIFSC code: ICIC0000857\nAccount Holder's Name: PUSHPENDER KISHORE SHARMA", upi: "",
      terms: "Kindly make payment in favour of Pushpender Kishore Sharma, UPI ID: 8826535777@paytm , NetBanking or Cheque/Demand Draft", tax: "none", continuous: true, prefix: "", pad: 0, logo: b.logo || KSC_LOGO, qr: b.qr || KSC_QR });
    if (num(b.cseq) < 202751) b.cseq = 202751;
    Object.assign(b.show, { qty: 1, rate: 1, sac: 0, status: 0, words: 1, payMode: 1, terms: 1, bank: 1, qr: 1, signature: 1, due: 0, clientAddr: 1, clientGstin: 1, notes: 1 });
    log("Edited", "Billing", "Current invoice details applied"); save(); toast("Details filled in – upload your signature under Images"); drawBillFormat(); };
  $("#bfTplEd").onclick = () => { const cur = b.customHTML || BILL_TEMPLATES[b.template === "custom" ? "ksc" : b.template] || BILL_TEMPLATES.ksc;
    const m2 = openModal2(`<div class="mhead"><h3>✎ Edit bill template</h3></div><div class="mbody"><p class="small" style="margin-top:0">Change text, layout or styles in HTML. Use the placeholders listed on the page (e.g. <code>{{client_name}}</code>, <code>{{items_full}}</code>). Scripts and outside links are removed when you save.</p>
      <textarea id="teT" spellcheck="false" style="width:100%;height:52vh;font-family:Consolas,monospace;font-size:12px;border:1px solid #cfd5df;border-radius:8px;padding:8px"></textarea></div>
      <div class="mfoot"><button class="btn" id="teX">Cancel</button><button class="btn" id="teP">👁 Preview</button><button class="btn primary" id="teS">Save as my template</button></div>`);
    m2.querySelector(".mbox").style.maxWidth = "1000px"; $("#teT", m2).value = cur;
    $("#teX", m2).onclick = () => m2.remove();
    $("#teP", m2).onclick = () => { const keep = [b.customHTML, b.template]; b.customHTML = sanitizeTemplate($("#teT", m2).value); b.template = "custom"; try { previewHTML(renderBill(sampleBill("invoice")), "Template preview"); } finally { [b.customHTML, b.template] = keep; } };
    $("#teS", m2).onclick = () => { const v = $("#teT", m2).value; if (v.length > 120 * 1024) return toast("Template too large – max 120 KB"); b.customHTML = sanitizeTemplate(v); b.template = "custom"; log("Edited", "Billing", "Bill template edited"); save(); m2.remove(); toast("Template saved and selected"); drawBillFormat(); }; };
  if ($("#bfPrev")) $("#bfPrev").onclick = () => { collect(); previewHTML(renderBill(sampleBill("invoice")), "Invoice preview (sample)"); };
  if ($("#bfPrevP")) $("#bfPrevP").onclick = () => { collect(); previewHTML(renderBill(sampleBill("proforma")), "Proforma preview (sample)"); };
}

/* ------------------------------------------------------------------ EDIT LOCK & MODIFICATION REQUESTS */
function lockBanner(w, L) {
  const box = (bg, bd, html) => `<div style="background:${bg};border:1px solid ${bd};border-radius:10px;padding:10px 12px;margin-bottom:12px;font-size:12.5px">${html}</div>`;
  if (L.mode === "free") return box("#eef7ee", "#bfe0c2", `✏ You created this task – you can edit or delete it for another <b>${L.left} min</b>. After that, changes need Admin approval.`);
  if (L.mode === "grant") return L.type === "modify" ? box("#e8f0fe", "#b9cdf5", `✅ Admin approved <b>one modification</b>. Make all your changes and click <b>Save</b> – the approval is used up after one save.`)
    : box("#e8f0fe", "#b9cdf5", `✅ Admin approved <b>deletion</b> of this task. Use the <b>Delete</b> button below.`);
  return box("#fff4e0", "#f3c27a", L.pending ? `⏳ This task is locked. Your request to <b>${L.pending.type === "delete" ? "delete" : "modify"}</b> it (sent ${esc(new Date(L.pending.ts).toLocaleString("en-IN"))}) is waiting for Admin approval.`
    : `🔒 This task is locked – it was created more than ${num(S.db.settings.editWindow || 60) >= 60 ? (num(S.db.settings.editWindow || 60) / 60) + " hour(s)" : num(S.db.settings.editWindow) + " minutes"} ago. You can still post notes and attach documents. To change or delete it, ask the Admin: <button type="button" class="btn sm primary" id="lkReq" style="margin-left:6px">Request to modify / delete</button>`);
}
function requestChange(w, after) {
  const m = openModal2(`<form id="rqF"><div class="mhead"><h3>Request Admin approval</h3></div><div class="mbody">
    <p class="small" style="margin-top:0"><b>${esc(cname(w.client))}</b> – ${esc(w.form)} ${esc(w.fy || "")} ${esc(w.period || "")}</p>
    <div class="field"><label>I want to</label><select id="rqT"><option value="modify">Modify this task (one change)</option></select><span class="small muted">To delete a task, use 🗑 Delete – it goes to the Admin for approval.</span></div>
    <div class="field"><label class="req">Reason / what needs to change</label><textarea id="rqR" maxlength="500" placeholder="e.g. wrong period selected, due date to be changed, duplicate task"></textarea></div><div class="err" id="rqE"></div></div>
    <div class="mfoot"><button type="button" class="btn" id="rqN">Cancel</button><button class="btn primary" type="submit">Send request</button></div></form>`);
  $("#rqN", m).onclick = () => m.remove();
  $("#rqF", m).onsubmit = e => { e.preventDefault(); const reason = $("#rqR", m).value.trim(); if (!reason) return $("#rqE", m).textContent = "Please give a reason.";
    const q = { id: uid(), workId: w.id, user: S.user, type: $("#rqT", m).value, reason, ts: new Date().toISOString(), status: "Pending" };
    (S.db.requests = S.db.requests || []).push(q); (w.notes = w.notes || []).push({ ts: q.ts, user: S.user, text: `Requested approval to ${q.type}: ${reason}` });
    log("Requested", "Work item", `${describe("works", w)} – ${q.type}: ${reason.slice(0, 80)}`); save(); m.remove(); toast("Request sent to Admin"); after && after(); };
}
function requestsCardHTML() {
  const rq = (S.db.requests || []).slice().sort((a, b) => (a.status === "Pending" ? 0 : 1) - (b.status === "Pending" ? 0 : 1) || b.ts.localeCompare(a.ts));
  const pend = rq.filter(q => q.status === "Pending"), recent = rq.filter(q => q.status !== "Pending").slice(0, 10);
  const row = q => { const w = S.db.works.find(x => x.id === q.workId);
    return `<tr data-wid="${q.workId}"><td>${esc(new Date(q.ts).toLocaleString("en-IN"))}</td><td><b>${esc(uname(q.user))}</b></td><td>${w ? `<a class="link" data-open="${w.id}">${esc(cname(w.client) + " – " + w.form + " " + (w.period || ""))}</a>` : '<span class="muted">(deleted)</span>'}</td>
      <td><span class="chip ${q.type === "delete" ? "red" : "blue"}">${q.type === "delete" ? "Delete" : "Modify"}</span></td><td class="small" style="white-space:normal;max-width:280px">${esc(q.reason)}</td>
      <td style="text-align:right;white-space:normal;min-width:160px">${q.status === "Pending" ? `<button class="btn sm primary" data-rqok="${q.id}">✓ Approve once</button> <button class="btn sm" data-rqno="${q.id}">✕ Reject</button>` : `<span class="chip ${q.status === "Approved" ? "green" : "red"}">${q.status}</span> <span class="small muted">${esc(uname(q.decidedBy || ""))}${w && w.grant && w.grant.reqId === q.id && w.grant.used ? " · used" : ""}</span>`}</td></tr>`; };
  return `<div class="card" style="margin-top:14px"><h3>✋ Modification requests from interns (${pend.length} pending)</h3>
    ${rq.length ? `<div class="tablewrap" style="border:none"><table class="t"><thead><tr><th>Requested</th><th>By</th><th>Task</th><th>Type</th><th>Reason</th><th></th></tr></thead><tbody>${[...pend, ...recent].map(row).join("")}</tbody></table></div>` : '<div class="small muted">No requests yet. Interns can edit or delete their own tasks only within the edit window; after that they send a request here.</div>'}</div>`;
}
function bindRequests(redraw) {
  $$("[data-open]").forEach(a => a.onclick = e => { e.stopPropagation(); editRecord("works", a.dataset.open, redraw); });
  $$("[data-rqok]").forEach(b => b.onclick = async () => { const q = S.db.requests.find(x => x.id === b.dataset.rqok); const w = S.db.works.find(x => x.id === q.workId);
    q.status = "Approved"; q.decidedBy = S.user; q.decidedAt = new Date().toISOString();
    if (w) { w.grant = { user: q.user, type: q.type, by: S.user, at: q.decidedAt, reqId: q.id }; (w.notes = w.notes || []).push({ ts: q.decidedAt, user: S.user, text: `Approved one-time ${q.type} for ${q.user}.` }); }
    log("Approved", "Request", `${q.user} – ${q.type} – ${w ? describe("works", w) : "(deleted task)"}`); await saveNow(); toast("Approved – the intern can make one change"); renderNav(); redraw(); });
  $$("[data-rqno]").forEach(b => b.onclick = () => { const q = S.db.requests.find(x => x.id === b.dataset.rqno); const w = S.db.works.find(x => x.id === q.workId);
    const m = openModal2(`<div class="mhead"><h3>Reject request</h3></div><div class="mbody"><div class="field"><label>Note for ${esc(uname(q.user))} (optional)</label><textarea id="rjT"></textarea></div></div><div class="mfoot"><button class="btn" id="rjN">Cancel</button><button class="btn danger" id="rjY">Reject</button></div>`);
    $("#rjN", m).onclick = () => m.remove();
    $("#rjY", m).onclick = async () => { q.status = "Rejected"; q.note = $("#rjT", m).value.trim(); q.decidedBy = S.user; q.decidedAt = new Date().toISOString();
      if (w) (w.notes = w.notes || []).push({ ts: q.decidedAt, user: S.user, text: `Rejected ${q.type} request${q.note ? ": " + q.note : ""}.` });
      log("Rejected", "Request", `${q.user} – ${q.type}`); await saveNow(); m.remove(); renderNav(); redraw(); }; });
}

/* ------------------------------------------------------------------ MULTI-SELECT FILTER */
function msHTML(k, label, opts, sel) {
  const n = sel.length;
  return `<div class="ms" data-ms="${k}"><button type="button" class="btn ${n ? "on" : ""}">${esc(label)}${n ? ` (${n})` : ""} ▾</button><div class="ms-pop" hidden>
    <input type="search" placeholder="Search…"><div class="ms-list">${opts.map(([v, l]) => `<label data-n="${esc(String(l).toLowerCase())}"><input type="checkbox" value="${esc(v)}" ${sel.includes(v) ? "checked" : ""}>${esc(l)}</label>`).join("") || '<div class="small muted">No options</div>'}</div>
    <div style="display:flex;justify-content:space-between;margin-top:6px"><button type="button" class="link" data-all>Select shown</button><button type="button" class="link" data-none>Clear</button></div></div></div>`;
}
function bindMS(root, onChange) {
  $$(".ms", root).forEach(ms => { const k = ms.dataset.ms, pop = $(".ms-pop", ms), btn = ms.querySelector(":scope > .btn");
    const emit = () => { const arr = $$(".ms-list input:checked", ms).map(x => x.value); const base = btn.textContent.replace(/ \(\d+\)/, "").replace(" ▾", ""); btn.textContent = base + (arr.length ? ` (${arr.length})` : "") + " ▾"; btn.classList.toggle("on", !!arr.length); onChange(k, arr); };
    btn.onclick = e => { e.stopPropagation(); const open = pop.hidden; $$(".ms-pop").forEach(p => p.hidden = true); pop.hidden = !open; if (open) $("input[type=search]", pop).focus(); };
    pop.onclick = e => e.stopPropagation();
    $("input[type=search]", pop).oninput = e => { const q = e.target.value.toLowerCase(); $$(".ms-list label", pop).forEach(l => l.hidden = !l.dataset.n.includes(q)); };
    $$(".ms-list input", pop).forEach(x => x.onchange = emit);
    $("[data-all]", pop).onclick = () => { $$(".ms-list label:not([hidden]) input", pop).forEach(x => x.checked = true); emit(); };
    $("[data-none]", pop).onclick = () => { $$(".ms-list input", pop).forEach(x => x.checked = false); emit(); }; });
}
document.addEventListener("click", () => $$(".ms-pop").forEach(p => p.hidden = true));

/* ------------------------------------------------------------------ BULK ACTIONS (work list) */
function bindBulk(rows, redraw) {
  const bar = $("#bulkBar"); const ids = new Set(rows.map(r => r.id));
  [...S.sel].forEach(id => { if (!ids.has(id)) S.sel.delete(id); });
  const draw = () => { const n = S.sel.size;
    if (!n) { bar.innerHTML = ""; return; }
    bar.innerHTML = `<b>${n} selected</b>
      ${can("assignWork") ? `<select id="bkAs"><option value="">Assign to…</option><option value="__none__">(unassigned)</option>${(S.db.settings.staff || []).map(s => `<option value="${esc(s)}">${esc(ulabel(s))}</option>`).join("")}</select>` : ""}
      <select id="bkSt"><option value="">Change status…</option>${allStatus().filter(x => can("markDone") || !isClosedSt(x)).map(x => `<option value="${esc(x)}">${esc(stLabel(x))}</option>`).join("")}</select>
      ${can("editAllWork") || isAdmin() ? `<select id="bkSv"><option value="">Service…</option><option value="__auto__">Set from task name</option>${allSvc().map(x => `<option>${esc(x)}</option>`).join("")}</select>` : ""}
      <select id="bkPr"><option value="">Priority…</option>${PRIORITY.map(x => `<option>${x}</option>`).join("")}</select>
      <button class="btn sm" id="bkPin">📌 Pin</button><button class="btn sm" id="bkUnpin">Unpin</button><button class="btn sm" id="bkFlag">${flagSVG("#d93025", true)} Flag…</button>
      ${S.archView ? '<button class="btn sm primary" id="bkRes">↩ Undo archive</button>' : '<button class="btn sm" id="bkArc" title="Move completed tasks out of the work list">📦 Archive</button>'}
      <button class="btn sm danger" id="bkDel">🗑 Delete selected</button><button class="btn sm" id="bkClr">Clear selection</button>`;
    const pick = () => S.db.works.filter(w => S.sel.has(w.id));
    const editable = w => can("editAllWork") || (mineW(w) && (!lockState(w) || lockState(w).mode !== "locked"));
    const apply = (fn, label) => { const all = pick(), ok = all.filter(editable); ok.forEach(fn); const now = new Date().toISOString(); ok.forEach(w => { w.updatedBy = S.user; w.updatedAt = now; });
      log("Bulk edit", "Work item", `${label} – ${ok.length} item(s)`); save(); toast(`${label}: ${ok.length} updated${all.length - ok.length ? `, ${all.length - ok.length} skipped (no right / locked)` : ""}`); redraw(); };
    if ($("#bkAs")) $("#bkAs").onchange = e => { const u = e.target.value; if (!u) return; const val = u === "__none__" ? "" : u; apply(w => { if (w.assigned !== val) { w.assigned = val; w.assignedBy = S.user; w.assignedAt = new Date().toISOString(); } }, "Assigned to " + (val ? uname(val) : "nobody")); };
    $("#bkSt").onchange = e => { const v = e.target.value; if (!v) return; apply(w => { w.status = v; if (v === "Filed / Done" && !w.filed) w.filed = today(); }, "Status → " + v); };
    if ($("#bkSv")) $("#bkSv").onchange = e => { const v = e.target.value; if (!v) return; apply(w => { w.service = v === "__auto__" ? (svcExpected(w) || svcFor(w.form) || w.service) : v; }, v === "__auto__" ? "Service set from task name" : "Service → " + v); };
    $("#bkPr").onchange = e => { const v = e.target.value; if (v) apply(w => w.priority = v, "Priority → " + v); };
    $("#bkClr").onclick = () => { S.sel.clear(); redraw(); };
    const canArc = w => can("editAllWork") || mineW(w);
    if ($("#bkArc")) $("#bkArc").onclick = () => { const all = pick(), ok = all.filter(w => !isOpen(w) && canArc(w)), open = all.filter(isOpen).length; const now = new Date().toISOString();
      if (!ok.length) return toast(open ? "Only completed tasks (Filed / Done or Cancelled) can be archived" : "You can't archive these tasks");
      ok.forEach(w => { w.archived = true; w.archivedBy = S.user; w.archivedAt = now; }); log("Archived", "Work item", `${ok.length} completed task(s) moved to the archive`);
      S.sel.clear(); save(); toast(`${ok.length} task(s) archived${open ? ` · ${open} still open, not archived` : ""}`); viewList("works"); };
    if ($("#bkRes")) $("#bkRes").onclick = () => { const ok = pick().filter(canArc); ok.forEach(w => { delete w.archived; delete w.archivedBy; delete w.archivedAt; });
      log("Restored", "Work item", `${ok.length} task(s) restored from the archive`); S.sel.clear(); save(); toast(`${ok.length} task(s) restored`); viewList("works"); };
    const pinAll = on => { pick().forEach(w => { const p = new Set(w.pins || []); on ? p.add(S.user) : p.delete(S.user); w.pins = [...p]; }); save(); toast(on ? "Pinned" : "Unpinned"); redraw(); };
    $("#bkPin").onclick = () => pinAll(true); $("#bkUnpin").onclick = () => pinAll(false);
    $("#bkFlag").onclick = e => { e.stopPropagation(); flagMenu($("#bkFlag"), pick().map(w => w.id), redraw); };
    $("#bkDel").onclick = () => deleteWorks(pick(), redraw);
    if (false) $("#bkDel").onclick = async () => { const all = pick(), ok = all.filter(w => can("delete") || canSelfDelete(w));
      if (!ok.length) return toast("You can't delete these tasks (no right, or the edit window has passed – request approval)");
      if (!(await confirmBox("Delete tasks", `<p>Delete <b>${ok.length}</b> task(s)?${all.length - ok.length ? ` ${all.length - ok.length} selected task(s) will be skipped (no right / locked).` : ""}</p><p class="small muted">This cannot be undone. Documents in the folder are not deleted.</p>`, "Delete"))) return;
      const del = new Set(ok.map(w => w.id)); S.db.works = S.db.works.filter(w => !del.has(w.id)); ok.forEach(w => log("Deleted", "Work item", describe("works", w)));
      S.sel.clear(); save(); toast(`${ok.length} task(s) deleted`); redraw(); };
  };
  $$(".selr").forEach(x => x.onchange = () => { x.checked ? S.sel.add(x.value) : S.sel.delete(x.value); draw(); });
  const sa = $(".selall"); if (sa) { sa.checked = rows.length && rows.every(r => S.sel.has(r.id)); sa.onchange = () => { rows.forEach(r => sa.checked ? S.sel.add(r.id) : S.sel.delete(r.id)); $$(".selr").forEach(x => x.checked = sa.checked); draw(); }; }
  draw();
}

/* ------------------------------------------------------------------ ADD MULTIPLE TASKS (multi clients × rows × periods × assignees) */
function multiTaskDialog(pre = {}) {
  if (!can("createWork")) return toast("You do not have the right to create work");
  const cl = vC().filter(c => c.active !== "Inactive").sort((a, b) => a.name.localeCompare(b.name));
  const staff = can("assignWork") ? (S.db.settings.staff || []) : [S.user];
  const periodOpts = ["", ...PERIODS, "All 12 months", "All 4 quarters"];
  const rowHTML = (i) => `<tr data-row="${i}">
    <td><input class="mtForm" list="mtDL" placeholder="Task / return" style="width:100%;min-width:150px"></td>
    <td><select class="mtSvc" style="width:100%"><option value=""></option>${allSvc().map(x => `<option>${esc(x)}</option>`).join("")}</select></td>
    <td><select class="mtPer" style="width:100%">${periodOpts.map(x => `<option>${x}</option>`).join("")}</select></td>
    <td><input type="date" class="mtDue"></td>
    <td><div class="ms" data-ms="as${i}"><button type="button" class="btn sm">Assign ▾</button><div class="ms-pop" hidden><input type="search" placeholder="Search…"><div class="ms-list">${staff.map(u => `<label data-n="${esc(ulabel(u).toLowerCase())}"><input type="checkbox" value="${esc(u)}" ${staff.length === 1 ? "checked" : ""}>${esc(ulabel(u))}</label>`).join("")}</div><div style="display:flex;justify-content:space-between;margin-top:6px"><button type="button" class="link" data-all>Select shown</button><button type="button" class="link" data-none>Clear</button></div></div></div></td>
    <td><select class="mtPri"><option>Normal</option><option>High</option><option>Low</option></select></td>
    ${can("editFees") ? '<td><input type="number" class="mtFee" min="0" step="0.01" style="width:90px"></td>' : ""}
    <td><button type="button" class="btn sm danger mtRm">✕</button></td></tr>`;
  const m = openModal(`<div class="mhead"><h3>＋＋ Add multiple tasks</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <div class="fgrid">
      <div class="field"><label>Financial year</label><select id="mtFY">${FYS.map(y => `<option ${y === fyLabel(curFYStart()) ? "selected" : ""}>${y}</option>`).join("")}</select></div>
      <div class="field"><label>Status</label><select id="mtSt"><option>Not started</option><option>Data awaited</option><option>In progress</option></select></div>
      <div class="field full"><label>Clients <span class="muted" id="mtCc"></span> &nbsp;<button type="button" class="link" id="mtAll">select shown</button> · <button type="button" class="link" id="mtNone">none</button>${can("manageClients") ? ' · <button type="button" class="link" id="mtNewC">＋ new client</button>' : ""}</label>
        <input id="mtQ" placeholder="filter clients…" style="margin-bottom:6px"><div class="picklist" id="mtCl" style="max-height:150px">${cl.map(c => `<label data-n="${esc((c.name + " " + c.code + " " + c.type).toLowerCase())}"><input type="checkbox" value="${c.id}" ${(pre.clients || []).includes(c.id) ? "checked" : ""}>${esc(c.name)} <span class="muted small">${esc(c.code)} · ${esc(c.type)}</span></label>`).join("")}</div></div>
    </div>
    <label class="small b">Tasks</label>
    <div class="tablewrap" style="overflow:visible"><table class="t" id="mtT"><thead><tr><th>Task / return</th><th>Service</th><th>Period</th><th>Due date</th><th>Assign to (one copy each)</th><th>Priority</th>${can("editFees") ? "<th>Fee ₹</th>" : ""}<th></th></tr></thead><tbody>${rowHTML(0)}${rowHTML(1)}${rowHTML(2)}</tbody></table></div>
    <datalist id="mtDL">${allForms().map(x => `<option value="${esc(x)}">`).join("")}</datalist>
    <div style="margin-top:8px"><button type="button" class="btn sm" id="mtAdd">＋ Add row</button> <span class="small muted">Service and due date fill in automatically from the task. "All 12 months / All 4 quarters" creates one task per period with standard due dates. Assignment rules apply when nobody is ticked.</span></div>
    <div class="err" id="mtErr"></div><div class="small b" id="mtPrev" style="margin-top:4px"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="mtN">Cancel</button><button class="btn primary" id="mtGo">Create tasks</button></div>`);
  let nrow = 3;
  const plan = () => { const clients = $$("#mtCl input:checked", m).map(x => x.value), fy = $("#mtFY", m).value; const out = [];
    $$("#mtT tbody tr", m).forEach(tr => { const form = $(".mtForm", tr).value.trim(); if (!form) return; const svc = $(".mtSvc", tr).value || svcFor(form) || "Project / Other";
      const per = $(".mtPer", tr).value; const pers = per === "All 12 months" ? MONTHS : per === "All 4 quarters" ? ["Q1", "Q2", "Q3", "Q4"] : [per];
      let as = $$(".ms-list input:checked", tr).map(x => x.value); const fee = $(".mtFee", tr) ? $(".mtFee", tr).value : "", pri = $(".mtPri", tr).value, dueIn = $(".mtDue", tr).value;
      clients.forEach(cid => pers.forEach(pp => { const assignees = as.length ? as : [ruleFor(svc, form) || (can("assignWork") ? "" : S.user)];
        assignees.forEach(u => out.push({ client: cid, form, service: svc, fy, period: pp, due: pers.length === 1 && dueIn ? dueIn : dueFor(form, fy, pp), assigned: u, priority: pri, fee })); })); });
    return out; };
  const refresh = () => { const p = plan(); const dup = p.filter(x => S.db.works.some(w => w.client === x.client && w.form === x.form && w.fy === x.fy && w.period === x.period)).length;
    $("#mtPrev", m).textContent = p.length ? `Will create ${p.length - dup} task(s)${dup ? ` (${dup} already exist and will be skipped)` : ""}.` : ""; $("#mtCc", m).textContent = `(${$$("#mtCl input:checked", m).length} selected)`; };
  const bindRow = tr => { const f = $(".mtForm", tr);
    const auto = () => { const sv = svcFor(f.value.trim()); if (sv) { if (![...$(".mtSvc", tr).options].some(o => o.value === sv)) $(".mtSvc", tr).insertAdjacentHTML("beforeend", `<option>${esc(sv)}</option>`); $(".mtSvc", tr).value = sv; }
      const per = $(".mtPer", tr).value; if (per && !per.startsWith("All")) { const d = dueFor(f.value.trim(), $("#mtFY", m).value, per); if (d) $(".mtDue", tr).value = d; } $(".mtDue", tr).disabled = per.startsWith("All"); refresh(); };
    f.addEventListener("input", auto); $(".mtPer", tr).addEventListener("change", auto); $(".mtSvc", tr).addEventListener("change", refresh); $(".mtDue", tr).addEventListener("change", refresh);
    $(".mtRm", tr).onclick = () => { tr.remove(); refresh(); };
    bindMS(tr, (k, arr) => refresh()); };
  $$("#mtT tbody tr", m).forEach(bindRow);
  $("#mtAdd", m).onclick = () => { $("#mtT tbody", m).insertAdjacentHTML("beforeend", rowHTML(nrow++)); bindRow($("#mtT tbody tr:last-child", m)); };
  $("#mtQ", m).oninput = e => { const q = e.target.value.toLowerCase(); $$("#mtCl label", m).forEach(l => l.hidden = !l.dataset.n.includes(q)); };
  $("#mtAll", m).onclick = () => { $$("#mtCl label:not([hidden]) input", m).forEach(x => x.checked = true); refresh(); };
  $("#mtNone", m).onclick = () => { $$("#mtCl input", m).forEach(x => x.checked = false); refresh(); };
  $("#mtCl", m).addEventListener("change", refresh); $("#mtFY", m).onchange = refresh;
  if ($("#mtNewC", m)) $("#mtNewC", m).onclick = () => { const sel = document.createElement("select"); sel.addEventListener("change", () => { const c = clientById(sel.value); if (!c) return;
      $("#mtCl", m).insertAdjacentHTML("afterbegin", `<label data-n="${esc((c.name + " " + c.code).toLowerCase())}"><input type="checkbox" value="${c.id}" checked>${esc(c.name)} <span class="muted small">${esc(c.code)} · ${esc(c.type)}</span></label>`); refresh(); }); quickClient(sel); };
  $("#mx", m).onclick = $("#mtN", m).onclick = closeModal;
  $("#mtGo", m).onclick = () => { const p = plan(); if (!$$("#mtCl input:checked", m).length) return $("#mtErr", m).textContent = "Select at least one client.";
    if (!p.length) return $("#mtErr", m).textContent = "Enter at least one task.";
    const now = new Date().toISOString(), st = $("#mtSt", m).value; let made = 0, skip = 0;
    p.forEach(x => { if (S.db.works.some(w => w.client === x.client && w.form === x.form && w.fy === x.fy && w.period === x.period && (w.createdAt !== now || (w.assigned || "") === (x.assigned || "")))) { skip++; return; }
      if (!allForms().some(f => f.toLowerCase() === x.form.toLowerCase())) (S.db.settings.customForms = S.db.settings.customForms || []).push(x.form);
      S.db.works.push({ id: uid(), ...x, status: st, filed: "", reviewer: "", arn: "", udin: "", billno: "", billdate: "", received: "", recdate: "", remarks: "",
        assignedBy: x.assigned ? S.user : "", assignedAt: x.assigned ? now : "", createdBy: S.user, createdAt: now }); made++; });
    log("Added", "Work item", `${made} task(s) via Add multiple tasks`); save(); closeModal(); toast(`${made} task(s) created${skip ? `, ${skip} skipped (already exist)` : ""}`); go(S.route === "works" ? "works" : S.route); };
  refresh();
}

/* ------------------------------------------------------------------ RENAME USERS / DISPLAY NAMES */
function editUserDialog(u) {
  const st = S.db.settings, usr = S.vault.users.find(x => x.u === u), role = (st.roles || {})[u] || usr.role;
  const m = openModal(`<div class="mhead"><h3>Edit user – ${esc(u)}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody"><div class="fgrid">
    <div class="field full"><label>Full name (shown in lists and reports)</label><input id="euN" maxlength="60" value="${esc((st.names || {})[u] || "")}" placeholder="e.g. Amit Kumar"></div>
    <div class="field"><label>Login ID</label><input id="euU" maxlength="40" value="${esc(u)}"></div>
    <div class="field"><label>Role</label><select id="euR" ${u === S.user ? "disabled" : ""}>${["Intern", "Staff", "Admin"].map(r => `<option ${r === role ? "selected" : ""}>${r}</option>`).join("")}</select></div></div>
    <p class="small muted">Changing the login ID updates every task, note, document and log entry that refers to this user; their password stays the same. Changing role applies that role's default rights – fine-tune them with <b>Rights</b>.</p><div class="err" id="euE"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="euX">Cancel</button><button class="btn primary" id="euY">Save</button></div>`, true);
  $("#mx", m).onclick = $("#euX", m).onclick = closeModal;
  $("#euY", m).onclick = async () => { const nu = $("#euU", m).value.trim().toLowerCase(), nm = $("#euN", m).value.trim(), nr = $("#euR", m).value, err = $("#euE", m);
    if (!/^[a-z0-9._-]{3,40}$/.test(nu)) return err.textContent = "Login ID: 3–40 letters, numbers, dot, dash or underscore.";
    if (nu !== u && S.vault.users.some(x => x.u === nu)) return err.textContent = "That login ID is already used.";
    if (role === "Admin" && nr !== "Admin" && S.vault.users.filter(x => ((st.roles || {})[x.u] || x.role) === "Admin").length < 2) return err.textContent = "At least one Admin is required.";
    st.names = st.names || {}; if (nm) st.names[u] = nm; else delete st.names[u];
    if (nr !== role) { st.roles[u] = nr; usr.role = nr; st.perms = st.perms || {}; if (nr === "Admin") delete st.perms[u]; else st.perms[u] = { ...PRESET[nr] }; log("Rights", "User", `${u}: role ${role} → ${nr}`); }
    if (nu !== u) { renameUser(u, nu); if (S.ak) { const b = await pwbRead(); if (b[u]) { b[nu] = b[u]; delete b[u]; S.vault.pwb = await aesEnc(S.ak, enc.encode(JSON.stringify(b))); } } }
    log("Edited", "User", `${u}${nu !== u ? " → " + nu : ""}${nm ? " (" + nm + ")" : ""}`); await saveNow(); closeModal(); toast("User updated"); if (S.user === nu) renderMe(); viewTeam(); };
}
function renameUser(a, b) {
  const st = S.db.settings, sw = x => x === a ? b : x;
  S.vault.users.forEach(x => { if (x.u === a) x.u = b; });
  ["roles", "perms", "lastLogin", "names", "avatars"].forEach(k => { if (st[k] && a in st[k]) { st[k][b] = st[k][a]; delete st[k][a]; } });
  st.staff = (st.staff || []).map(sw); st.disabled = (st.disabled || []).map(sw);
  (st.assignRules || []).forEach(r => r.user = sw(r.user));
  ["works", "challans", "reimb", "udins", "clients", "bills"].forEach(ent => (S.db[ent] || []).forEach(r => {
    ["assigned", "reviewer", "createdBy", "updatedBy", "assignedBy", "manager"].forEach(k => { if (r[k] === a) r[k] = b; });
    (r.notes || []).forEach(n => n.user = sw(n.user)); (r.docs || []).forEach(d => d.addedBy = sw(d.addedBy)); if (r.grant) r.grant.user = sw(r.grant.user); }));
  (S.db.requests || []).forEach(q => { q.user = sw(q.user); q.decidedBy = sw(q.decidedBy); });
  S.db.log.forEach(l => l.user = sw(l.user));
  if (S.user === a) { S.user = b; ss.set("ksc_last_user", b); }
}

/* ------------------------------------------------------------------ AUTO-ASSIGNMENT RULES */
function rulesCardHTML() {
  const rules = S.db.settings.assignRules || [];
  return `<div class="card" style="margin-top:14px"><h3>🎯 Auto-assignment rules</h3><p class="small" style="margin-top:0">New tasks are assigned automatically – e.g. all <b>ROC / MCA</b> work to one intern, or a particular task such as <b>GSTR-1</b> to another. A task rule wins over a service rule. You can still change the assignee on any task.</p>
    ${rules.length ? `<table class="t"><thead><tr><th>When</th><th>Is</th><th>Assign to</th><th></th></tr></thead><tbody>${rules.map((r, i) => `<tr><td>${r.type === "task" ? "Task" : "Service"}</td><td><b>${esc(r.value)}</b></td><td>${esc(ulabel(r.user))}</td><td style="text-align:right"><button class="btn sm danger" data-rr="${i}">✕</button></td></tr>`).join("")}</tbody></table>` : '<div class="small muted">No rules yet.</div>'}
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;align-items:center">
      <select id="ruT"><option value="service">Service</option><option value="task">Task</option></select>
      <select id="ruVs">${allSvc().map(x => `<option>${esc(x)}</option>`).join("")}</select><input id="ruVt" list="ruDL" placeholder="Task name" hidden style="border:1px solid #cfd5df;border-radius:8px;padding:6px 9px"><datalist id="ruDL">${allForms().map(x => `<option value="${esc(x)}">`).join("")}</datalist>
      <span>→</span><select id="ruU">${(S.db.settings.staff || []).map(s => `<option value="${esc(s)}">${esc(ulabel(s))}</option>`).join("")}</select>
      <button class="btn" id="ruAdd">＋ Add rule</button><span class="sp" style="flex:1"></span><button class="btn" id="ruApply">Apply to unassigned open tasks</button></div></div>`;
}
function bindRules(redraw) {
  const st = S.db.settings;
  $("#ruT").onchange = e => { $("#ruVs").hidden = e.target.value !== "service"; $("#ruVt").hidden = e.target.value !== "task"; };
  $("#ruAdd").onclick = async () => { const type = $("#ruT").value, value = (type === "service" ? $("#ruVs").value : $("#ruVt").value).trim(), user = $("#ruU").value;
    if (!value || !user) return toast("Choose what and whom");
    st.assignRules = (st.assignRules || []).filter(r => !(r.type === type && r.value.toLowerCase() === value.toLowerCase())); st.assignRules.push({ type, value, user });
    log("Rights", "Assignment rule", `${type} "${value}" → ${user}`); await saveNow(); redraw(); };
  $$("[data-rr]").forEach(b => b.onclick = async () => { const r = st.assignRules.splice(+b.dataset.rr, 1)[0]; log("Rights", "Assignment rule", `removed ${r.type} "${r.value}"`); await saveNow(); redraw(); });
  $("#ruApply").onclick = async () => { let n = 0; const now = new Date().toISOString();
    S.db.works.filter(w => isOpen(w) && !w.assigned).forEach(w => { const u = ruleFor(w.service, w.form); if (u) { w.assigned = u; w.assignedBy = S.user; w.assignedAt = now; n++; } });
    log("Bulk edit", "Work item", `Assignment rules applied to ${n} task(s)`); await saveNow(); toast(`${n} unassigned task(s) assigned`); };
}

/* ------------------------------------------------------------------ COMPLIANCE TRACKERS (grid views built from work items) */
const MONTHS = ["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"];
const QEND = { Q1: "Jun", Q2: "Sep", Q3: "Dec", Q4: "Mar", H1: "Sep", H2: "Mar" };
const ORDER = ["GSTR-1", "GSTR-1 (QRMP)", "GSTR-3B", "GSTR-3B (QRMP)", "CMP-08", "GSTR-4", "GSTR-9", "GSTR-9C", "TDS/TCS payment", "Form 24Q", "Form 26Q", "Form 27Q", "Form 27EQ", "Form 16 / 16A",
  "ADT-1", "AOC-4", "MGT-7 / MGT-7A", "DIR-3 KYC", "DPT-3", "MSME-1", "INC-20A", "LLP Form 11", "LLP Form 8"];
const ordIdx = f => { const i = ORDER.indexOf(f); return i < 0 ? 999 : i; };
const ITRCOL = w => w.service === "Advance Tax" ? "Adv. tax " + (QEND[w.period] ? w.period : (w.period || "")) :
  w.service === "Statutory Audit" ? "Statutory audit" : w.service === "Tax Audit" ? (/3C|tax audit/i.test(w.form || "") ? "Tax audit" : w.form) :
  /^ITR|revised|updated/i.test(w.form || "") ? "ITR" : w.form;
const TRK = {
  tgst: { title: "GST Returns Tracker", sub: "Every GST work item – monthly, QRMP (shown in the quarter's last month) and annual returns. New GST tasks for any client appear here automatically.",
    match: w => w.service === "GST", byForm: true, cols: () => [...MONTHS, "Annual / other"], colOf: w => MONTHS.includes(w.period) ? w.period : QEND[w.period] || "Annual / other",
    presets: ["g1m", "g3m"], svc: "GST" },
  ttdsq: { title: "TDS / TCS Returns – Quarterly Tracker", sub: "24Q, 26Q, 27Q, 27EQ and every other TDS / TCS task with a quarterly or annual period.",
    match: w => w.service === "TDS Return" || (w.service === "TDS / TCS" && !MONTHS.includes(w.period)), byForm: true, cols: () => ["Q1", "Q2", "Q3", "Q4", "Annual / other"], colOf: w => ["Q1", "Q2", "Q3", "Q4"].includes(w.period) ? w.period : MONTHS.includes(w.period) ? "Q" + (Math.floor(MONTHS.indexOf(w.period) / 3) + 1) : "Annual / other",
    presets: ["24q", "26q"], svc: "TDS Return" },
  ttdsm: { title: "TDS / TCS Monthly Challan Tracker", sub: "Monthly TDS / TCS payment tasks, with the challans recorded in the Challan register for that month (TDS / TCS tax type).",
    match: w => w.service === "TDS Challan" || (w.service === "TDS / TCS" && MONTHS.includes(w.period)), byForm: true, cols: () => MONTHS, colOf: w => MONTHS.includes(w.period) ? w.period : QEND[w.period] || "Mar", challans: true, presets: ["tdsp"], svc: "TDS Challan" },
  troc: { title: "ROC / MCA Filing Tracker", sub: "AOC-4, MGT-7, ADT-1, DIR-3 KYC, DPT-3, MSME-1, LLP Form 8 / 11 and any other ROC task – one row per client.",
    match: w => w.service === "ROC / MCA", byForm: false, cols: rows => dyn(rows, ["ADT-1", "AOC-4", "MGT-7 / MGT-7A", "DIR-3 KYC", "DPT-3"]), colOf: w => w.form + (["H1", "H2", "Q1", "Q2", "Q3", "Q4"].includes(w.period) ? " " + w.period : ""),
    presets: ["adt1", "aoc4", "mgt7", "dir3", "dpt3"], svc: "ROC / MCA" },
  titr: { title: "ITR, Tax Audit & Statutory Audit Tracker", sub: "Advance tax instalments, statutory audit, tax audit, ITR and any other task under these services – one row per client.",
    match: w => ["Income Tax Return", "Tax Audit", "Statutory Audit", "Advance Tax"].includes(w.service), byForm: false,
    cols: rows => dyn(rows, ["Adv. tax Q1", "Adv. tax Q2", "Adv. tax Q3", "Adv. tax Q4", "Statutory audit", "Tax audit", "ITR"]), colOf: ITRCOL, presets: ["adv", "ta", "itra"], svc: "Income Tax Return" },
};
function dyn(items, fixed) { const extra = [...new Set(items.map(x => x.col))].filter(c => !fixed.includes(c)).sort((a, b) => ordIdx(a) - ordIdx(b) || a.localeCompare(b)); return [...fixed, ...extra]; }
function dueFor(form, fy, period) { const Y = parseInt(fy); for (const p of PRESETS.filter(x => x.form === form)) { const it = p.f(Y).find(i => i.period === period); if (it) return it.due; } return ""; }
const STSHORT = { "Not started": "Not started", "Data awaited": "Data awaited", "In progress": "In progress", "Under review": "In review", "Filed / Done": "Filed", "On hold": "On hold", "Cancelled": "N/A" };
function trkChip(w) {
  const d = delayInfo(w), st = ((S.db.settings.stLabels || {})[w.status]) || STSHORT[w.status] || w.status || "Not started", cst = stColor(w.status), due = w.due ? dmy(w.due).slice(0, 5) : "";
  const tip = esc(`${w.form} ${w.period || ""} · ${w.status}${w.assigned ? " · " + uname(w.assigned) : ""}${w.due ? " · due " + dmy(w.due) : ""}${w.filed ? " · filed " + dmy(w.filed) : ""}${w.arn ? " · " + w.arn : ""}${udinApp(w) ? (w.udin ? " · UDIN " + w.udin + (w.udinDate ? " dt " + dmy(w.udinDate) : "") : " · UDIN pending") : ""}`);
  let cls, sub;
  if (stg(w.status) === "Filed / Done") { cls = d.late > 0 ? "late" : "ok"; sub = w.filed ? "on " + dmy(w.filed).slice(0, 5) + (d.late > 0 ? ` (late ${d.late}d)` : "") : ""; }
  else if (stg(w.status) === "Cancelled") { cls = "na"; sub = ""; }
  else if (d.overdue) { cls = "od"; sub = `overdue ${-days(today(), w.due)}d`; }
  else { cls = stg(w.status) === "Under review" ? "rev" : d.soon ? "soon" : stg(w.status) === "In progress" || stg(w.status) === "Data awaited" ? "prog" : "pend"; sub = due ? "due " + due : ""; }
  return `<span class="tc ${cls}" data-w="${w.id}" title="${tip}" ${cst ? `style="background:${cst}1f;color:${cst}${cls === "od" ? ";box-shadow:inset 3px 0 0 #c62828" : ""}"` : ""}>${stg(w.status) === "Filed / Done" ? "✓ " : ""}${esc(st)}${(w.docs || []).length ? " 📎" : ""}${sub ? `<small>${esc(sub)}</small>` : ""}${udinApp(w) && stg(w.status) !== "Cancelled" ? `<small class="udn ${w.udin ? "y" : "n"}">${w.udin ? "UDIN ✓" + (w.udinDate ? " " + dmy(w.udinDate).slice(0, 5) : "") : "UDIN pending"}</small>` : ""}</span>`;
}
function trkChipOld(w) {
  const d = delayInfo(w), tip = esc(`${w.form} ${w.period || ""} · ${w.status}${w.assigned ? " · " + w.assigned : ""}${w.due ? " · due " + dmy(w.due) : ""}${w.filed ? " · filed " + dmy(w.filed) : ""}${w.arn ? " · " + w.arn : ""}`);
  let cls, txt;
  if (stg(w.status) === "Filed / Done") { cls = d.late > 0 ? "late" : "ok"; txt = "✓ " + (w.filed ? dmy(w.filed).slice(0, 5) : "Done"); }
  else if (stg(w.status) === "Cancelled") { cls = "na"; txt = "N/A"; }
  else if (stg(w.status) === "Under review") { cls = "rev"; txt = "Review"; }
  else if (d.overdue) { cls = "od"; txt = "Overdue " + d.txt.replace(/\D/g, "") + "d"; }
  else if (d.soon) { cls = "soon"; txt = "Due " + dmy(w.due).slice(0, 5); }
  else { cls = "pend"; txt = w.due ? "Due " + dmy(w.due).slice(0, 5) : (stg(w.status) === "Not started" ? "Pending" : w.status); }
  return `<span class="tc ${cls}" title="${tip}">${esc(txt)}${(w.docs || []).length ? " 📎" : ""}</span>`;
}
function trkText(w) { return trkText0(w) + (udinApp(w) ? (w.udin ? ` · UDIN ${w.udin}${w.udinDate ? " dt " + dmy(w.udinDate) : ""}` : " · UDIN pending") : ""); }
function trkText0(w) { const d = delayInfo(w); return stg(w.status) === "Filed / Done" ? `Filed ${dmy(w.filed)}${d.late > 0 ? " (late " + d.late + "d)" : ""}` : stg(w.status) === "Cancelled" ? "N/A" : d.overdue ? `${w.status} – OVERDUE (due ${dmy(w.due)})` : `${w.status}${w.due ? " – due " + dmy(w.due) : ""}`; }
function buildTracker(key, f) {
  const T = TRK[key];
  let ws = visW().filter(w => T.match(w) && w.fy === f.fy);
  if (f.staff) ws = ws.filter(w => w.assigned === f.staff);
  let items = ws.map(w => ({ w, col: T.colOf(w), label: T.byForm ? w.form : "" }));
  const taskOpts = T.byForm ? [...new Set(items.map(i => i.label))].sort((a, b) => ordIdx(a) - ordIdx(b) || a.localeCompare(b)) : (typeof T.cols === "function" ? T.cols(items) : T.cols);
  const pickT = (f.tasks || []).filter(t => taskOpts.includes(t));
  if (pickT.length) items = items.filter(i => pickT.includes(T.byForm ? i.label : i.col));
  const rows = new Map(); // key -> {client, label, cells:{col:[w]}, ch:{col:[challan]}}
  const rk = (cid, label) => cid + "|" + label;
  items.forEach(it => { const g = T.svc === "GST" && multiG(it.w.client) ? (it.w.gstin || gstsOf(clientById(it.w.client))[0].g) : ""; const k = rk(it.w.client, it.label + "|" + g); if (!rows.has(k)) rows.set(k, { client: it.w.client, label: it.label, gst: g, cells: {}, ch: {} }); (rows.get(k).cells[it.col] = rows.get(k).cells[it.col] || []).push(it.w); });
  if (T.challans && can("challans")) {
    vR("challans").filter(c => c.taxtype === "TDS / TCS" && c.fy === f.fy && MONTHS.includes(c.period)).forEach(c => {
      let row = [...rows.values()].find(r => r.client === c.client && (r.label === "TDS/TCS payment" || /payment|challan/i.test(r.label))) || [...rows.values()].find(r => r.client === c.client);
      if (!row) { if (f.staff) return; row = { client: c.client, label: "TDS/TCS payment", cells: {}, ch: {} }; rows.set(rk(c.client, row.label), row); }
      (row.ch[c.period] = row.ch[c.period] || []).push(c); });
  }
  if (f.all) vC().filter(c => c.active !== "Inactive" && (!f.type || c.type === f.type)).forEach(c => { if (![...rows.values()].some(r => r.client === c.id)) rows.set(rk(c.id, ""), { client: c.id, label: "", cells: {}, ch: {}, empty: true }); });
  let list = [...rows.values()].filter(r => clientById(r.client));
  if (f.type) list = list.filter(r => clientById(r.client).type === f.type);
  if (f.q) { const q = f.q.toLowerCase(); list = list.filter(r => (cname(r.client) + " " + ccode(r.client) + " " + r.label).toLowerCase().includes(q)); }
  if (f.only === "pending") list = list.filter(r => Object.values(r.cells).flat().some(isOpen));
  if (f.only === "overdue") list = list.filter(r => Object.values(r.cells).flat().some(w => delayInfo(w).overdue));
  list.sort((a, b) => cname(a.client).localeCompare(cname(b.client)) || (a.gst || "").localeCompare(b.gst || "") || ordIdx(a.label) - ordIdx(b.label) || a.label.localeCompare(b.label));
  let cols = typeof T.cols === "function" ? T.cols(items) : T.cols;
  if (pickT.length && !T.byForm) cols = cols.filter(c => pickT.includes(c));
  if (pickT.length && f.all) list = list.filter(r => r.empty || Object.keys(r.cells).length || Object.keys(r.ch || {}).length);
  const all = list.flatMap(r => Object.values(r.cells).flat());
  const stats = { total: all.length, ok: all.filter(w => stg(w.status) === "Filed / Done" && !(delayInfo(w).late > 0)).length, late: all.filter(w => delayInfo(w).late > 0).length,
    pend: all.filter(isOpen).length, od: all.filter(w => delayInfo(w).overdue).length, rev: all.filter(w => stg(w.status) === "Under review").length, clients: new Set(list.map(r => r.client)).size };
  return { T, rows: list, cols, stats, taskOpts };
}
function viewTracker(key) {
  const T = TRK[key]; setTitle(T.title);
  const f = S.f[key] = S.f[key] || { fy: fyLabel(curFYStart()) };
  $("#view").innerHTML = `<p class="small muted" style="margin:0 0 10px">${esc(T.sub)}</p>
    <div class="toolbar"><select id="tFY">${FYS.map(y => `<option ${y === f.fy ? "selected" : ""}>${y}</option>`).join("")}</select>
      <input type="search" id="tQ" placeholder="Search client / return…" value="${esc(f.q || "")}">
      <select id="tType"><option value="">All client types</option>${CTYPE.map(t => `<option ${f.type === t ? "selected" : ""}>${t}</option>`).join("")}</select>
      ${can("viewAllWork") ? `<select id="tStaff"><option value="">All staff</option>${(S.db.settings.staff || []).map(s => `<option ${f.staff === s ? "selected" : ""}>${esc(s)}</option>`).join("")}</select>` : ""}
      <span id="tTasks"></span>
      <select id="tOnly"><option value="">All rows</option><option value="pending" ${f.only === "pending" ? "selected" : ""}>Rows with pending work</option><option value="overdue" ${f.only === "overdue" ? "selected" : ""}>Rows with overdue work</option></select>
      <label class="small" style="display:flex;gap:5px;align-items:center"><input type="checkbox" id="tAll" ${f.all ? "checked" : ""}> Show clients with no entries</label>
      <span class="sp"></span><button class="btn" id="tSel" title="Select several tasks to change them together">☑ Select tasks</button>${can("createWork") ? '<button class="btn" id="tGen">⟳ Generate for the year</button>' : ""}${can("print") ? '<button class="btn" id="tPr">🖨 Print</button>' : ""}${can("export") ? '<button class="btn" id="tEx">⬇ Excel</button>' : ""}</div>
    <div id="tStats"></div><div id="tBulk"></div><div id="tGrid"></div>
    <div class="legend" style="margin-top:10px"><span class="tc ok">✓ Filed</span> on time <span class="tc late">✓ Filed</span> late <span class="tc od">Overdue</span> <span class="tc soon">Due within 7 days</span> <span class="tc prog">In progress / data awaited</span> <span class="tc pend">Not started</span> <span class="tc rev">In review</span> <span class="tc na">N/A</span> cancelled · each cell shows the task's current status, with the due or filing date below ${T.challans ? '<span class="tc amt">₹ amount</span> challan paid' : ""} · Click a cell to open it, or an empty cell to create the task.</div>`;
  const bind = (id, k, ev = "change") => { const el = $(id); if (el) el.addEventListener(ev, () => { f[k] = el.type === "checkbox" ? el.checked : el.value; draw(); }); };
  bind("#tFY", "fy"); bind("#tQ", "q", "input"); bind("#tType", "type"); bind("#tStaff", "staff"); bind("#tOnly", "only"); bind("#tAll", "all");
  if ($("#tGen")) $("#tGen").onclick = () => recurringDialog({ keys: T.presets, fy: f.fy, back: key });
  S.tsel = null; $("#tSel").onclick = () => { S.tsel = S.tsel ? null : new Set(); $("#tSel").textContent = S.tsel ? "✕ Stop selecting" : "☑ Select tasks"; $("#tSel").classList.toggle("primary", !!S.tsel); draw(); };
  const draw = () => {
    const { rows, cols, stats, taskOpts } = buildTracker(key, f); S._trk = { rows, cols };
    const sel = (f.tasks || []).filter(t => taskOpts.includes(t));
    $("#tTasks").innerHTML = msHTML("tasks", T.byForm ? "Returns / tasks" : "Tasks (columns)", taskOpts.map(t => [t, t]), sel);
    bindMS($("#tTasks"), (k, arr) => { f.tasks = arr; draw(); });
    $("#tStats").innerHTML = `<div class="grid kpis" style="margin-bottom:12px">${[["Clients", stats.clients, ""], ["Returns / tasks", stats.total, ""], ["Filed on time", stats.ok, "green"], ["Filed late", stats.late, stats.late ? "amber" : ""], ["Pending", stats.pend, ""], ["Overdue", stats.od, stats.od ? "red" : "green"], ["In review", stats.rev, ""]].map(([l, v, c]) => `<div class="kpi ${c}" style="cursor:default;padding:10px 14px"><div class="l">${l}</div><div class="v" style="font-size:20px">${v}</div></div>`).join("")}</div>`;
    if (!rows.length) { $("#tGrid").innerHTML = `<div class="tablewrap"><div class="empty">No ${esc(T.title.split(" Tracker")[0])} tasks for FY ${esc(f.fy)} yet.<br><br>Create them with <b>⟳ Generate for the year</b>, add them one by one in the Work Tracker, or tick <b>Show clients with no entries</b> and click a cell.</div></div>`; return; }
    let prev = null;
    $("#tGrid").innerHTML = `<div class="tablewrap" style="max-height:calc(100vh - 330px)"><table class="trk"><thead><tr><th class="l">Client</th>${T.byForm ? '<th class="f">Return</th>' : ""}${cols.map(c => `<th>${esc(c)}</th>`).join("")}</tr></thead><tbody>
      ${rows.map((r, ri) => { const first = r.client !== prev; prev = r.client; const c = clientById(r.client);
        return `<tr class="${first ? "first" : ""}"><td class="l">${first ? `<a class="link" data-client="${r.client}" style="font-weight:700;color:var(--ink)">${esc(c.name)}</a><div class="small muted">${esc(c.code)} · ${esc(c.type)}</div>` : ""}</td>
          ${T.byForm ? `<td class="f">${r.empty ? '<span class="muted small">no entries</span>' : esc(r.label)}${r.gst ? `<div class="small muted" style="font-weight:400" title="${esc(gstLbl({ g: r.gst }))}">${esc(r.gst)}${gstState(r.gst) ? " · " + esc(gstState(r.gst)) : ""}</div>` : ""}</td>` : ""}
          ${cols.map(col => { const ws = r.cells[col] || [], ch = (r.ch || {})[col] || []; const amt = ch.reduce((a, x) => a + num(x.amount), 0);
            return `<td class="cell ${ws.length ? "" : "add"}" data-r="${ri}" data-c="${esc(col)}">${ws.map(trkChip).join("<br>")}${ch.length ? `${ws.length ? "<br>" : ""}<span class="tc amt" title="${esc(ch.map(x => `${dmy(x.date)} ₹${inr(x.amount)} ${x.head || ""} ${x.cpin || ""}`).join("\n"))}">₹${inr0(amt)}</span>` : ""}</td>`; }).join("")}</tr>`; }).join("")}
      </tbody></table></div>`;
    $$("#tGrid [data-client]").forEach(a => a.onclick = () => go("client:" + a.dataset.client));
    if (S.tsel) { $("#tGrid").classList.add("selmode"); $$("#tGrid .tc[data-w]").forEach(ch => { if (S.tsel.has(ch.dataset.w)) ch.classList.add("picked"); }); } else $("#tGrid").classList.remove("selmode");
    trkBulk(draw);
    $$("#tGrid td.cell").forEach(td => td.onclick = e => {
      const r = rows[+td.dataset.r], col = td.dataset.c, ws = r.cells[col] || [];
      if (S.tsel) { const chip = e.target.closest(".tc[data-w]"); const ids = chip ? [chip.dataset.w] : ws.map(w => w.id); if (!ids.length) return;
        const on = !ids.every(i => S.tsel.has(i)); ids.forEach(i => on ? S.tsel.add(i) : S.tsel.delete(i)); draw(); return; }
      if (!ws.length && (r.ch || {})[col] && (r.ch || {})[col].length) { const chs = r.ch[col]; const m = openModal2(`<div class="mhead"><h3>${esc(cname(r.client))} – ${esc(col)}</h3></div><div class="mbody"><p class="small" style="margin-top:0">Challan(s) recorded for this month, but no task yet:</p>${chs.map(c => `<div style="padding:6px 0;border-bottom:1px solid #eee"><a class="link" data-ch="${c.id}">${dmy(c.date)} · ₹${inr(c.amount)} ${esc(c.head || "")} ${esc(c.cpin || "")}</a></div>`).join("")}</div>
          <div class="mfoot">${can("createWork") ? '<button class="btn primary" id="chT">＋ Create the task for this month</button>' : ""}<button class="btn" id="mmX">Close</button></div>`);
        $("#mmX", m).onclick = () => m.remove(); $$("[data-ch]", m).forEach(a => a.onclick = () => { m.remove(); editRecord("challans", a.dataset.ch, draw); });
        if ($("#chT", m)) $("#chT", m).onclick = () => { m.remove(); editRecord("works", null, draw, { client: r.client, fy: f.fy, service: T.svc, form: r.label || "TDS/TCS payment", period: col, due: dueFor(r.label || "TDS/TCS payment", f.fy, col), status: "Filed / Done" }); }; return; }
      if (ws.length === 1) return editRecord("works", ws[0].id, draw);
      if (ws.length > 1) { const dupF = ws.map(w => w.form).filter((x, i, a) => a.indexOf(x) !== i);
        const m = openModal2(`<div class="mhead"><h3>${esc(cname(r.client))} – ${esc(col)}</h3></div><div class="mbody">${dupF.length ? `<div class="notice warn">⚠ <b>${esc(dupF[0])}</b> appears more than once for this period. If one is a duplicate, delete or cancel it.</div>` : ""}
          ${ws.map(w => `<div style="display:flex;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #eee"><div style="flex:1"><a class="link" data-w="${w.id}" style="font-weight:600">${esc(w.form)} ${esc(w.period || "")}</a> ${trkChip(w)}
            <div class="small muted">${w.assigned ? "Assigned to " + esc(uname(w.assigned)) + " · " : ""}created by ${esc(uname(w.createdBy))} ${w.createdAt ? dmy(w.createdAt.slice(0, 10)) : ""}${archOf(w) ? " · 📦 archived (hidden from the work list)" : ""}</div></div>
            <button class="btn sm" data-w="${w.id}">✎ Edit</button>${canDelW(w) ? `<button class="btn sm danger" data-wd="${w.id}">🗑</button>` : ""}</div>`).join("")}</div><div class="mfoot"><button class="btn" id="mmX">Close</button></div>`);
        m.querySelector(".mbox").style.maxWidth = "640px";
        $("#mmX", m).onclick = () => m.remove(); $$("[data-w]", m).forEach(a => a.onclick = () => { m.remove(); editRecord("works", a.dataset.w, draw); });
        $$("[data-wd]", m).forEach(b => b.onclick = async () => { m.remove(); deleteRecord("works", b.dataset.wd, draw); }); return; }
      if (!can("createWork")) return toast("No task here. You do not have the right to create work.");
      const pre = { client: r.client, fy: f.fy, service: T.svc };
      if (key === "tgst" || key === "ttdsq" || key === "ttdsm") { const form = r.label || (key === "tgst" ? "GSTR-3B" : key === "ttdsm" ? "TDS/TCS payment" : "Form 26Q");
        const period = key === "tgst" ? (col === "Annual / other" ? "Annual" : (/QRMP|CMP/.test(form) ? ({ Jun: "Q1", Sep: "Q2", Dec: "Q3", Mar: "Q4" })[col] || col : col)) : col === "Annual / other" ? "Annual" : col;
        Object.assign(pre, { form, period, due: dueFor(form, f.fy, period) }); }
      else if (key === "troc") { const form = col.replace(/ (H1|H2|Q\d)$/, ""); Object.assign(pre, { form, period: (col.match(/(H1|H2|Q\d)$/) || [])[1] || "Annual" }); pre.due = dueFor(pre.form, f.fy, pre.period); }
      else { if (col.startsWith("Adv. tax")) Object.assign(pre, { service: "Advance Tax", form: "Advance tax", period: col.split(" ").pop() });
        else if (col === "Statutory audit") Object.assign(pre, { service: "Statutory Audit", form: "Statutory audit report", period: "Annual" });
        else if (col === "Tax audit") Object.assign(pre, { service: "Tax Audit", form: "Tax audit (3CD)", period: "Annual" });
        else if (col === "ITR") Object.assign(pre, { service: "Income Tax Return", form: /Individual|HUF/.test(clientById(r.client).type) ? "ITR (non-audit)" : "ITR (audit)", period: "Annual" });
        else Object.assign(pre, { form: col, period: "Annual" });
        pre.due = dueFor(pre.form, f.fy, pre.period); }
      if (r.gst) pre.gstin = r.gst; editRecord("works", null, draw, pre);
    });
  };
  const gridText = () => { const { rows, cols } = S._trk; return { head: ["Client", "Code", ...(T.byForm ? ["Return"] : []), ...cols], body: rows.map(r => [cname(r.client), ccode(r.client), ...(T.byForm ? [r.label] : []), ...cols.map(c => [...(r.cells[c] || []).map(trkText), ...((r.ch || {})[c] || []).map(x => `Challan ₹${inr(x.amount)} ${dmy(x.date)}`)].join("; "))]) }; };
  if ($("#tEx")) $("#tEx").onclick = () => { const g = gridText(); download(fname(T.title + " " + f.fy, "csv"), toCSV([[S.db.settings.firm.name], [T.title + " – FY " + f.fy], [], g.head, ...g.body]), "text/csv;charset=utf-8"); log("Exported", "Report", T.title); save(); };
  if ($("#tPr")) $("#tPr").onclick = () => { const { rows, cols } = S._trk; let prev = null;
    const body = `<table><thead><tr><th>Client</th>${T.byForm ? "<th>Return</th>" : ""}${cols.map(c => `<th>${esc(c)}</th>`).join("")}</tr></thead><tbody>${rows.map(r => { const first = r.client !== prev; prev = r.client;
      return `<tr><td>${first ? `<b>${esc(cname(r.client))}</b><br><span style="color:#666">${esc(ccode(r.client))}</span>` : ""}</td>${T.byForm ? `<td>${esc(r.label)}</td>` : ""}${cols.map(c => { const ws = r.cells[c] || [], ch = (r.ch || {})[c] || [];
        return `<td style="text-align:center">${ws.map(w => { const d = delayInfo(w); return stg(w.status) === "Filed / Done" ? `<span style="color:${d.late > 0 ? "#b4380d" : "#1e8e3e"};font-weight:700">✓ Filed ${dmy(w.filed).slice(0, 5)}</span>` : stg(w.status) === "Cancelled" ? "N/A" : d.overdue ? `<span style="color:#c62828;font-weight:700">${esc(w.status)} – OVERDUE</span>` : `<span style="color:#444">${esc(w.status)}${w.due ? "<br>due " + dmy(w.due).slice(0, 5) : ""}</span>`; }).join("<br>")}${ch.map(x => `<br><span style="color:#2d6a33">₹${inr0(x.amount)}</span>`).join("")}</td>`; }).join("")}</tr>`; }).join("")}</tbody></table>
      <p style="font-size:9px;color:#555">Each cell shows the current status · ✓ Filed dd-mm = filing date (red = after due date) · OVERDUE = not filed after due date</p>`;
    printDoc(T.title, `FY ${f.fy}${f.type ? " · " + f.type : ""}${f.staff ? " · " + f.staff : ""}${(f.tasks || []).length ? " · " + f.tasks.join(", ") : ""} · ${rows.length} row(s)`, body); };
  draw();
}

/* ------------------------------------------------------------------ CUSTOM TASK / SERVICE LISTS */
function addListItem(kind, el) {
  if (kind === "status") return statusDialog(null, el);
  const isSvc = kind === "service";
  const m = openModal2(`<form id="alF"><div class="mhead"><h3>＋ New ${isSvc ? "service" : "task type"}</h3></div><div class="mbody">
    <div class="field"><label class="req">${isSvc ? "Service name" : "Task / return / form name"}</label><input id="alT" maxlength="80" placeholder="${isSvc ? "e.g. Valuation, FEMA, Payroll" : "e.g. Form 15CA/CB, PF return, Net worth certificate"}"></div>
    <p class="small muted">It is added to the drop-down list for everyone and can be removed later from Settings › Task & service lists.</p><div class="err" id="alE"></div></div>
    <div class="mfoot"><button type="button" class="btn" id="alN">Cancel</button><button class="btn primary" type="submit">Add</button></div></form>`);
  $("#alN", m).onclick = () => m.remove();
  $("#alF", m).onsubmit = e => { e.preventDefault(); const v = $("#alT", m).value.trim().replace(/\s+/g, " ");
    if (!v) return $("#alE", m).textContent = "Enter a name.";
    const list = isSvc ? allSvc() : allForms(); const hit = list.find(x => x.toLowerCase() === v.toLowerCase());
    if (!hit) { const key = isSvc ? "customServices" : "customForms"; (S.db.settings[key] = S.db.settings[key] || []).push(v); log("Added", isSvc ? "Service" : "Task type", v); save(); }
    const val = hit || v;
    if (el.tagName === "SELECT") { if (![...el.options].some(o => o.value === val)) { const o = document.createElement("option"); o.textContent = val; el.insertBefore(o, el.querySelector('option[value="__new__"]')); } el.value = val; }
    else { el.value = val; const dl = document.getElementById(el.getAttribute("list")); if (dl && ![...dl.options].some(o => o.value === val)) { const o = document.createElement("option"); o.value = val; dl.appendChild(o); } }
    el.dispatchEvent(new Event("change")); m.remove(); toast(hit ? `"${val}" is already in the list – selected` : `"${val}" added to the list`); };
}
function listsCardHTML() {
  const st = S.db.settings; const cf = st.customForms || [], cs = st.customServices || [];
  const chips = (arr, kind) => arr.length ? arr.map((x, i) => `<span class="chip" style="margin:3px 4px 3px 0">${esc(x)}${isAdmin() ? ` <a data-rmlist="${kind}" data-i="${i}" style="cursor:pointer;color:#c62828;margin-left:4px">✕</a>` : ""}</span>`).join("") : '<span class="small muted">None added yet</span>';
  return `<div class="card"><h3>🗂 Task & service lists</h3><p class="small" style="margin-top:0">Your own task types and services, in addition to the built-in list. New ones are also added automatically when someone types a new task in a work item.</p>
    <div class="small b">Custom task types (${cf.length})</div><div style="margin:4px 0 10px">${chips(cf, "customForms")}</div>
    <div class="small b">Custom services (${cs.length})</div><div style="margin:4px 0 10px">${chips(cs, "customServices")}</div>
    <button class="btn" id="lsAddF">＋ Add task type</button> <button class="btn" id="lsAddS">＋ Add service</button></div>
    <div class="card" style="margin-top:14px"><h3>🏷 Task statuses</h3><p class="small" style="margin-top:0">Add your own statuses, such as “Awaiting client signature” or “DSC pending”. For each one you just say whether the work is still <b>pending</b> or <b>completed</b>, and pick a colour. You can limit a status to particular clients.</p>
    <p class="small" style="margin:0 0 6px">Click a colour square to change the colour of any status – standard ones too. It changes everywhere: work list, trackers, My Work and reports.</p>
    <table class="t" style="margin:6px 0 10px"><thead><tr><th>Status</th><th>Colour</th><th>Work is</th><th>Clients</th><th>Tasks</th><th></th></tr></thead><tbody>
    ${STATUS.map(x => `<tr><td>${statusChip(x)} <span class="small muted">standard${stLabel(x) !== x ? " · was “" + esc(x) + "”" : ""}</span></td><td>${canManageSt() ? `<button type="button" class="swb" data-stc="${esc(x)}" title="Change colour" style="background:${stColor(x) || "#eef1f6"}">${stColor(x) ? "" : "Default"}</button>` : ""}</td><td>${isClosedSt(x) ? "Completed" : "Pending"}</td><td class="small">All clients</td><td>${S.db.works.filter(w => w.status === x).length}</td><td>${canManageSt() ? `<button class="btn sm" data-ststd="${esc(x)}">✎ Edit</button>` : ""}</td></tr>`).join("")}
    ${custSt().map((x, i) => `<tr><td>${statusChip(x.name)}</td><td>${canManageSt() ? `<button type="button" class="swb" data-stc="${esc(x.name)}" title="Change colour" style="background:${x.color}"></button>` : ""}</td><td>${isClosedSt(x.stage) ? "Completed" : "Pending"}</td><td class="small" style="white-space:normal">${(x.clients || []).length ? x.clients.map(cname).map(esc).join(", ") : "All clients"}</td><td>${S.db.works.filter(w => w.status === x.name).length}</td><td>${canManageSt() ? `<button class="btn sm" data-sted="${i}">✎ Edit</button> <button class="btn sm danger" data-strm="${i}">Remove</button>` : ""}</td></tr>`).join("")}
    </tbody></table>
    <button class="btn" id="stAdd">＋ Add status</button>${canManageSt() ? "" : ' <span class="small muted">Only the Admin can edit, recolour or remove statuses.</span>'}</div>`;
}

function stdStatusDialog(key, after) {
  if (!canManageSt()) return toast("Only the Admin can edit statuses");
  const cur = stColor(key);
  const m = openModal2(`<form id="ssF"><div class="mhead"><h3>✎ Edit status “${esc(stLabel(key))}”</h3></div><div class="mbody">
    <div class="field"><label class="req">Name shown</label><input id="ssN" maxlength="40" value="${esc(stLabel(key))}"><span class="small muted">Built-in status – it always counts as <b>${isClosedSt(key) ? "Completed" : "Pending"}</b>. Renaming changes the name everywhere; existing tasks keep it.</span></div>
    <div class="field"><label>Colour</label><div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">${STCOLORS.map(c => `<button type="button" class="swb" data-c="${c}" style="background:${c};${c === cur ? "outline:2px solid #1d2433;outline-offset:1px" : ""}"></button>`).join("")}<input type="color" id="ssX" value="${cur || "#455a64"}" style="width:34px;height:24px;padding:0;border:1px solid #cfd5df;border-radius:6px"> <button type="button" class="link" id="ssD">Default</button></div>
      <div class="small muted" style="margin-top:6px">Preview: <span id="ssPv"></span></div></div><div class="err" id="ssE"></div></div>
    <div class="mfoot"><button type="button" class="btn" id="ssR">Restore original name &amp; colour</button><span class="sp"></span><button type="button" class="btn" id="ssC">Cancel</button><button class="btn primary" type="submit">Save</button></div></form>`);
  let col = cur; const pv = () => { const n = $("#ssN", m).value.trim() || key; $("#ssPv", m).innerHTML = col ? `<span class="chip" style="background:${col}1f;color:${col}">${esc(n)}</span>` : `<span class="chip">${esc(n)}</span>`;
    $$("[data-c]", m).forEach(b => b.style.outline = b.dataset.c === col ? "2px solid #1d2433" : ""); };
  pv(); $("#ssN", m).oninput = pv; $$("[data-c]", m).forEach(b => b.onclick = () => { col = b.dataset.c; pv(); }); $("#ssX", m).oninput = e => { col = e.target.value; pv(); }; $("#ssD", m).onclick = () => { col = ""; pv(); };
  $("#ssC", m).onclick = () => m.remove();
  $("#ssR", m).onclick = () => { const L = { ...(S.db.settings.stLabels || {}) }, C = { ...(S.db.settings.stColors || {}) }; delete L[key]; delete C[key]; S.db.settings.stLabels = L; S.db.settings.stColors = C; log("Edited", "Status", `“${key}” restored to original`); save(); m.remove(); after && after(); };
  $("#ssF", m).onsubmit = e => { e.preventDefault(); const n = $("#ssN", m).value.trim().replace(/\s+/g, " "); if (!n) return $("#ssE", m).textContent = "Enter a name.";
    if (allStatus().some(x => x !== key && stLabel(x).toLowerCase() === n.toLowerCase())) return $("#ssE", m).textContent = "Another status already has this name.";
    const L = { ...(S.db.settings.stLabels || {}) }, C = { ...(S.db.settings.stColors || {}) }; if (n === key) delete L[key]; else L[key] = n; if (col) C[key] = col; else delete C[key];
    S.db.settings.stLabels = L; S.db.settings.stColors = C; log("Edited", "Status", `“${key}” → “${n}”${col ? " " + col : ""}`); save(); m.remove(); toast("Status saved"); after && after(); };
}
function setStColor(name, col) {
  const c = custStOf(name);
  if (c) { S.db.settings.statuses = custSt().map(x => x === c ? { ...x, color: col || STCOLORS[0] } : x); }
  else { const m = S.db.settings.stColors = { ...(S.db.settings.stColors || {}) }; if (col) m[name] = col; else delete m[name]; }
  log("Edited", "Status", `Colour of “${name}” ${col ? "→ " + col : "reset to default"}`); save();
}
function colorPop(anchor, name, after) {
  $$(".colpop").forEach(x => x.remove()); const cur = stColor(name), std = !custStOf(name);
  const d = document.createElement("div"); d.className = "colpop";
  d.innerHTML = `<div class="small b" style="margin-bottom:6px">Colour for “${esc(name)}”</div><div style="display:grid;grid-template-columns:repeat(5,28px);gap:6px">${STCOLORS.map(c => `<button type="button" data-c="${c}" title="${c}" style="background:${c};${c === cur ? "outline:2px solid #1d2433;outline-offset:2px" : ""}"></button>`).join("")}</div>
    <label class="small" style="display:flex;gap:8px;align-items:center;margin-top:10px">Any colour: <input type="color" id="cpX" value="${cur || "#1a73e8"}" style="width:44px;height:28px;padding:0;border:1px solid #cfd5df;border-radius:6px;background:#fff"></label>
    <div style="margin-top:8px;display:flex;gap:8px;align-items:center"><span class="small muted">Preview:</span> <span id="cpPv">${statusChip(name)}</span></div>
    ${std ? '<button type="button" class="link" id="cpDef" style="margin-top:8px">Reset to default colour</button>' : ""}`;
  document.body.appendChild(d); const r = anchor.getBoundingClientRect();
  d.style.left = Math.max(8, Math.min(window.innerWidth - 230, r.left)) + "px"; d.style.top = Math.min(window.innerHeight - 230, r.bottom + 6) + "px";
  d.onclick = e => e.stopPropagation();
  const pick = col => { setStColor(name, col); d.remove(); toast(col ? "Colour changed" : "Default colour restored"); after && after(); };
  $$("[data-c]", d).forEach(b => b.onclick = () => pick(b.dataset.c));
  $("#cpX", d).oninput = e => { const col = e.target.value; $("#cpPv", d).innerHTML = `<span class="chip" style="background:${col}1f;color:${col}">${esc(name)}</span>`; };
  $("#cpX", d).onchange = e => pick(e.target.value);
  if ($("#cpDef", d)) $("#cpDef", d).onclick = () => pick("");
  setTimeout(() => document.addEventListener("click", () => d.remove(), { once: true }), 0);
}
function statusDialog(ex, selEl, after) {
  if (ex && !canManageSt()) return toast("Only the Admin can edit or remove statuses");
  const cl = S.db.clients.slice().sort((a, b) => a.name.localeCompare(b.name)); const pre = ex ? ex.clients || [] : [];
  const formClient = selEl && $("#f_client") ? $("#f_client").value : "";
  const m = openModal2(`<form id="sdF"><div class="mhead"><h3>${ex ? "✎ Edit status" : "＋ New status"}</h3></div><div class="mbody">
    <div class="field"><label class="req">Status name</label><input id="sdN" maxlength="40" value="${esc(ex ? ex.name : "")}" placeholder="e.g. Awaiting client signature, DSC pending, Query raised"></div>
    <div class="field"><label class="req">When a task has this status, is the work…</label><div class="checks" style="flex-direction:column;gap:6px">
      <label><input type="radio" name="sdK" value="open" ${!ex || !isClosedSt(ex.stage) ? "checked" : ""}> <b>Still pending</b> <span class="muted small">– stays in the open list and can become overdue (e.g. Challan pending, Awaiting DSC)</span></label>
      <label><input type="radio" name="sdK" value="done" ${ex && stg(ex.stage) === "Filed / Done" ? "checked" : ""}> <b>Completed</b> <span class="muted small">– counts as done, like Filed / Done (e.g. Challan paid, Signed &amp; sent)</span></label></div>
      ${ex && !["In progress", "Filed / Done"].includes(ex.stage) ? `<input type="hidden" id="sdKeep" value="${esc(ex.stage)}">` : ""}</div>
    <div class="field"><label>Colour</label><div id="sdC" style="display:flex;gap:6px;flex-wrap:wrap">${STCOLORS.map((c, i) => `<label style="cursor:pointer"><input type="radio" name="sdc" value="${c}" ${(ex ? ex.color : STCOLORS[custSt().length % STCOLORS.length]) === c ? "checked" : ""} hidden><span style="display:inline-block;width:24px;height:24px;border-radius:6px;background:${c}"></span></label>`).join("")}
      <label style="cursor:pointer;display:flex;align-items:center;gap:4px" title="Any colour"><input type="radio" name="sdc" value="custom" ${ex && !STCOLORS.includes(ex.color) ? "checked" : ""} hidden><span style="display:inline-block;width:24px;height:24px;border-radius:6px;background:conic-gradient(red,yellow,lime,cyan,blue,magenta,red)"></span><input type="color" id="sdCx" value="${ex && !STCOLORS.includes(ex.color) ? ex.color : "#455a64"}" style="width:34px;height:26px;padding:0;border:1px solid #cfd5df;border-radius:6px"></label></div>
      <div style="margin-top:6px" class="small muted">Preview: <span id="sdPv"></span></div></div>
    <div class="field"><label>Use for</label><div class="checks"><label><input type="radio" name="sdW" value="all" ${pre.length ? "" : "checked"}> All clients</label><label><input type="radio" name="sdW" value="some" ${pre.length ? "checked" : ""}> Only selected clients</label></div>
      <div id="sdCl" ${pre.length ? "" : "hidden"}><input type="search" id="sdQ" placeholder="Find client…" style="border:1px solid #cfd5df;border-radius:8px;padding:6px 9px;width:100%;margin-bottom:6px"><div class="picklist">${cl.map(c => `<label data-n="${esc((c.name + " " + c.code).toLowerCase())}"><input type="checkbox" value="${c.id}" ${pre.includes(c.id) || (!ex && c.id === formClient) ? "checked" : ""}> ${esc(c.name)} <span class="muted small">${esc(c.code)}</span></label>`).join("")}</div></div></div>
    <div class="err" id="sdE"></div></div>
    <div class="mfoot"><button type="button" class="btn" id="sdX">Cancel</button><button class="btn primary" type="submit">${ex ? "Save" : "Add status"}</button></div></form>`);
  const curCol = () => { const v = ($("input[name=sdc]:checked", m) || {}).value; return v === "custom" ? $("#sdCx", m).value : v || STCOLORS[0]; };
  const sty = () => { $$("#sdC span", m).forEach(sp => sp.style.outline = sp.previousElementSibling.checked ? "2px solid #1d2433" : ""); const c = curCol(), nm = $("#sdN", m).value.trim() || "New status"; $("#sdPv", m).innerHTML = `<span class="chip" style="background:${c}1f;color:${c}">${esc(nm)}</span>`; };
  sty(); $$("#sdC input[type=radio]", m).forEach(x => x.onchange = sty); $("#sdN", m).addEventListener("input", sty);
  $("#sdCx", m).addEventListener("input", () => { m.querySelector('input[name=sdc][value=custom]').checked = true; sty(); });
  $$("input[name=sdW]", m).forEach(x => x.onchange = () => $("#sdCl", m).hidden = $("input[name=sdW]:checked", m).value !== "some");
  $("#sdQ", m).oninput = e => { const q = e.target.value.toLowerCase(); $$("#sdCl label", m).forEach(l => l.hidden = !l.dataset.n.includes(q)); };
  $("#sdX", m).onclick = () => m.remove();
  $("#sdF", m).onsubmit = e => { e.preventDefault(); const name = $("#sdN", m).value.trim().replace(/\s+/g, " ");
    if (!name) return $("#sdE", m).textContent = "Enter a status name.";
    if (STATUS.some(x => x.toLowerCase() === name.toLowerCase() || stLabel(x).toLowerCase() === name.toLowerCase()) || custSt().some(x => x !== ex && x.name.toLowerCase() === name.toLowerCase())) return $("#sdE", m).textContent = "A status with this name already exists.";
    const some = $("input[name=sdW]:checked", m).value === "some", clients = some ? $$("#sdCl input:checked", m).map(x => x.value) : [];
    if (some && !clients.length) return $("#sdE", m).textContent = "Tick at least one client, or choose All clients.";
    const kind = $("input[name=sdK]:checked", m).value, keep = $("#sdKeep", m) ? $("#sdKeep", m).value : "";
    const stage = kind === "done" ? (keep && isClosedSt(keep) ? keep : "Filed / Done") : (keep && !isClosedSt(keep) ? keep : "In progress");
    const o = { name, stage, color: curCol(), clients };
    const list = S.db.settings.statuses = custSt().slice();
    if (ex) { const i = list.indexOf(ex); if (ex.name !== name) { const now = new Date().toISOString(); S.db.works.filter(w => w.status === ex.name).forEach(w => { w.status = name; w.updatedBy = S.user; w.updatedAt = now; }); } list[i] = o; log("Edited", "Status", ex.name === name ? name : `${ex.name} → ${name}`); }
    else { list.push(o); log("Added", "Status", `${name} (${isClosedSt(o.stage) ? "completed" : "pending"})`); }
    save(); m.remove(); toast(ex ? "Status saved" : `Status “${name}” added`);
    if (selEl) { if (![...selEl.options].some(x => x.value === name)) { const op = document.createElement("option"); op.textContent = name; selEl.insertBefore(op, selEl.querySelector('option[value="__new__"]')); } selEl.value = name; selEl.dispatchEvent(new Event("change")); }
    if (after) after(); };
}

/* ------------------------------------------------------------------ QUICK CLIENT (from any form) */
function nextClientCode() { const n = S.db.clients.map(c => parseInt((c.code.match(/(\d+)\s*$/) || [])[1] || 0)).reduce((a, b) => Math.max(a, b), 0) + 1; return "C" + String(n).padStart(3, "0"); }
function quickClient(selectEl) {
  const m = openModal2(`<form id="qcF" novalidate><div class="mhead"><h3>＋ New client</h3><button type="button" class="btn sm" id="qcX">✕</button></div><div class="mbody"><div class="fgrid">
      <div class="field"><label class="req">Client code</label><input id="qcCode" value="${nextClientCode()}" style="text-transform:uppercase" maxlength="20"></div>
      <div class="field"><label class="req">Client type</label><select id="qcType"><option value=""></option>${CTYPE.map(t => `<option>${t}</option>`).join("")}</select></div>
      <div class="field full"><label class="req">Client name</label><input id="qcName" maxlength="200"></div>
      <div class="field"><label>PAN</label><input id="qcPan" style="text-transform:uppercase" maxlength="10"></div><div class="field"><label>GSTIN</label><input id="qcGst" style="text-transform:uppercase" maxlength="15"></div>
      <div class="field"><label>Mobile</label><input id="qcMob" maxlength="20"></div><div class="field"><label>Email</label><input id="qcMail" maxlength="120"></div>
      <div class="field full"><label>Handled by</label><select id="qcMgr"><option value=""></option>${(S.db.settings.staff || []).map(s => `<option ${s === S.user ? "selected" : ""}>${esc(s)}</option>`).join("")}</select></div></div>
      <p class="small muted">Other details can be added later from Clients.</p><div class="err" id="qcErr"></div></div>
    <div class="mfoot"><button type="button" class="btn" id="qcN">Cancel</button><button class="btn primary" type="submit">Create & select</button></div></form>`);
  $("#qcName", m).focus();
  $("#qcX", m).onclick = $("#qcN", m).onclick = () => m.remove();
  $("#qcF", m).onsubmit = e => { e.preventDefault(); const err = $("#qcErr", m);
    const o = { code: $("#qcCode", m).value.trim().toUpperCase(), name: $("#qcName", m).value.trim(), type: $("#qcType", m).value, pan: $("#qcPan", m).value.trim().toUpperCase(), gstin: $("#qcGst", m).value.trim().toUpperCase(), mobile: $("#qcMob", m).value.trim(), email: $("#qcMail", m).value.trim(), manager: $("#qcMgr", m).value, active: "Active", services: [] };
    if (!o.code || !o.name || !o.type) return err.textContent = "Code, name and type are required.";
    if (S.db.clients.some(c => c.code.toUpperCase() === o.code)) return err.textContent = `Client code ${o.code} already exists.`;
    if (S.db.clients.some(c => c.name.toLowerCase() === o.name.toLowerCase()) && !m._dupOk) { m._dupOk = true; return err.textContent = "A client with this name already exists. Click “Create & select” again to create another."; }
    if (o.pan && !/^[A-Z]{5}[0-9]{4}[A-Z]$/.test(o.pan)) return err.textContent = "PAN format should be AAAAA9999A.";
    if (o.gstin && !GSTRE.test(o.gstin)) return err.textContent = "GSTIN format is not valid (e.g. 07AAAAA9999A1Z5).";
    if (o.gstin) { const ow = S.db.clients.find(x => gstsOf(x).some(g => g.g.toUpperCase() === o.gstin)); if (ow) return err.textContent = `GSTIN ${o.gstin} is already under ${ow.name} (${ow.code}). Add the work to that client instead.`;
      if (!o.pan) o.pan = o.gstin.slice(2, 12); else if (o.pan !== o.gstin.slice(2, 12)) return err.textContent = "The PAN inside the GSTIN does not match the PAN entered."; }
    if (o.pan && !m._panOk) { const sp = S.db.clients.find(x => (x.pan || "").toUpperCase() === o.pan); if (sp) { m._panOk = true; return err.textContent = `${sp.name} (${sp.code}) already has PAN ${o.pan}. A new GSTIN of the same business should be added to that client (Clients › Edit › GST registrations). Click “Create & select” again only if this is really a different client.`; } }
    o.gstins = o.gstin ? [{ g: o.gstin, label: "" }] : [];
    const c = { id: uid(), ...o, createdBy: S.user, createdAt: new Date().toISOString() }; S.db.clients.push(c); log("Added", "Client", `${c.code} – ${c.name} (quick add)`); save();
    const opt = document.createElement("option"); opt.value = c.id; opt.textContent = `${c.name} (${c.code})`; selectEl.appendChild(opt); selectEl.value = c.id; selectEl.dispatchEvent(new Event("change"));
    m.remove(); toast(`Client ${c.code} created`); };
}

/* ------------------------------------------------------------------ BULK INTERN LOGINS */
function genPw() { const L = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz", N = "23456789", Y = "@#$%&*!?"; const all = L + N + Y; const r = n => crypto.getRandomValues(new Uint32Array(n));
  let p = [L[r(1)[0] % L.length], N[r(1)[0] % N.length], Y[r(1)[0] % Y.length], ...[...r(9)].map(x => all[x % all.length])]; const sh = r(p.length); return p.map((c, i) => [sh[i], c]).sort((a, b) => a[0] - b[0]).map(x => x[1]).join(""); }
function bulkInterns() {
  const names = []; for (let i = 1; names.length < 5 && i < 100; i++) { const n = "intern" + i; if (!S.vault.users.some(u => u.u === n)) names.push(n); }
  const m = openModal(`<div class="mhead"><h3>Create 5 intern logins</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p class="small muted" style="margin-top:0">Edit the user names if you like (e.g. intern.amit). Strong passwords are generated – you'll get a slip to print or copy. Only the Admin can change these passwords later (Team &amp; Rights › Set password).</p>
    <table class="t"><thead><tr><th>#</th><th>User name</th><th>Password</th><th></th></tr></thead><tbody>${names.map((n, i) => `<tr><td>${i + 1}</td><td><input class="bu" value="${n}" maxlength="40" style="border:1px solid #cfd5df;border-radius:6px;padding:5px 8px;width:100%"></td>
      <td><input class="bp" value="${esc(genPw())}" style="border:1px solid #cfd5df;border-radius:6px;padding:5px 8px;width:100%;font-family:Consolas,monospace"></td><td><button type="button" class="btn sm" data-gen="${i}">↻</button></td></tr>`).join("")}</tbody></table>
    <div class="err" id="buErr"></div></div><div class="mfoot"><span class="sp"></span><button class="btn" id="buN">Cancel</button><button class="btn primary" id="buY">Create logins</button></div>`);
  $("#mx", m).onclick = $("#buN", m).onclick = closeModal;
  $$("[data-gen]", m).forEach(b => b.onclick = () => $$(".bp", m)[+b.dataset.gen].value = genPw());
  $("#buY", m).onclick = async () => { const err = $("#buErr", m), st = S.db.settings; const us = $$(".bu", m).map(x => x.value.trim().toLowerCase()), ps = $$(".bp", m).map(x => x.value);
    for (let i = 0; i < us.length; i++) { if (!us[i]) continue; if (!/^[a-z0-9._-]{3,40}$/.test(us[i])) return err.textContent = `Row ${i + 1}: user name must be 3–40 letters, numbers, dot, dash or underscore.`;
      if (S.vault.users.some(x => x.u === us[i]) || us.indexOf(us[i]) !== i) return err.textContent = `Row ${i + 1}: ${us[i]} already exists.`; if (!pwOk(ps[i])) return err.textContent = `Row ${i + 1}: password must be 10+ characters with letters, numbers and a symbol.`; }
    err.textContent = "Creating logins (takes a few seconds)…"; $("#buY", m).disabled = true; const made = [];
    for (let i = 0; i < us.length; i++) { if (!us[i]) continue; S.vault.users.push(await wrapForUser(us[i], "Intern", ps[i], S.dekRaw)); await pwbSet(us[i], ps[i]);
      st.roles = st.roles || {}; st.roles[us[i]] = "Intern"; st.perms = st.perms || {}; st.perms[us[i]] = { ...PRESET.Intern }; if (!st.staff.includes(us[i])) st.staff.push(us[i]); made.push([us[i], ps[i]]); log("Added", "User", `${us[i]} (Intern)`); }
    await saveNow();
    const mm = openModal(`<div class="mhead"><h3>✔ ${made.length} intern logins created</h3></div><div class="mbody"><p class="small">Hand each intern their own line privately. Passwords are shown only now.</p>
      <table class="t"><thead><tr><th>User name</th><th>Password</th></tr></thead><tbody>${made.map(([u, p]) => `<tr><td><b>${esc(u)}</b></td><td style="font-family:Consolas,monospace">${esc(p)}</td></tr>`).join("")}</tbody></table></div>
      <div class="mfoot"><button class="btn" id="cpAll">Copy all</button><button class="btn" id="prAll">🖨 Print slips</button><button class="btn primary" id="okAll">Done</button></div>`);
    $("#cpAll", mm).onclick = async () => { try { await navigator.clipboard.writeText(made.map(([u, p]) => `${u}\t${p}`).join("\n")); toast("Copied"); } catch { toast("Copy not allowed – please note them down"); } };
    $("#prAll", mm).onclick = () => printDoc("Intern login details", "Confidential – hand over individually",
      made.map(([u, p]) => `<div style="border:1px dashed #999;padding:10px 14px;margin:10px 0;font-size:12px"><b>${esc(S.db.settings.firm.name)} – Practice Manager</b><br>User name: <b>${esc(u)}</b><br>Password: <b style="font-family:Consolas,monospace">${esc(p)}</b><br><span style="font-size:10px">Keep this password private. To change it, ask the Admin.</span></div>`).join(""));
    $("#okAll", mm).onclick = () => { closeModal(); viewTeam(); };
  };
}

/* ------------------------------------------------------------------ NOTES, MY WORK, TEAM */
function notesHTML(rec) {
  const n = rec.notes || [];
  return n.length ? n.map(x => `<div style="padding:5px 0;border-bottom:1px solid #f1f3f6"><b>${esc(x.user)}</b> <span class="muted small">${esc(new Date(x.ts).toLocaleString("en-IN"))}</span><div style="white-space:pre-wrap">${esc(x.text)}</div></div>`).join("") : '<div class="muted small">No updates yet.</div>';
}
function viewMyWork() {
  setTitle("My Work");
  const me = S.user, t = today();
  const mine = visW().filter(w => w.assigned === me);
  const open = mine.filter(isOpen), od = open.filter(w => delayInfo(w).overdue), rev = mine.filter(w => stg(w.status) === "Under review");
  const fresh = open.filter(w => w.assignedBy && w.assignedBy !== me && w.assignedAt > (S.prevLogin || ""));
  const doneM = mine.filter(w => stg(w.status) === "Filed / Done" && w.filed >= t.slice(0, 8) + "01");
  const myReq = (S.db.requests || []).filter(q => q.user === me).sort((a, b) => b.ts.localeCompare(a.ts));
  const toReview = isAdmin() || can("markDone") ? S.db.works.filter(w => showC(w.client) && stg(w.status) === "Under review" && (w.reviewer === me || (isAdmin() && !w.reviewer))) : [];
  const f = S.f.mywork = S.f.mywork || { show: "open" };
  const k = (l, v, cls, key) => `<div class="kpi ${cls}" data-show="${key}"><div class="l">${l}</div><div class="v">${v}</div></div>`;
  $("#view").innerHTML = `<div class="grid kpis">${k("My open tasks", open.length, "", "open")}${k("Overdue", od.length, od.length ? "red" : "green", "overdue")}${k("New since last login", fresh.length, fresh.length ? "amber" : "", "new")}
      ${k("Sent for review", rev.length, "", "review")}${k("Done this month", doneM.length, "green", "done")}${toReview.length ? k("Waiting for my review", toReview.length, "amber", "toreview") : ""}${myReq.length ? k("My change requests", myReq.filter(q => q.status === "Pending").length + " pending", "", "requests") : ""}</div>
    <div class="toolbar" style="margin-top:14px"><b style="font-size:14px" id="mwTitle"></b><span class="sp"></span>${can("createWork") ? '<button class="btn primary" id="mwAdd">＋ New task for me</button>' : ""}</div><div id="tbl"></div>`;
  const sets = { open: ["My open tasks", open], overdue: ["Overdue", od], new: ["Newly assigned to me", fresh], review: ["Sent for review", rev], done: ["Done this month", doneM], toreview: ["Waiting for my review", toReview] };
  const draw = () => { if (f.show === "requests") { $("#mwTitle").textContent = "My change requests";
      $("#tbl").innerHTML = `<div class="tablewrap"><table class="t"><thead><tr><th>Requested</th><th>Task</th><th>Type</th><th>Reason</th><th>Status</th><th>Admin note</th></tr></thead><tbody>${myReq.map(q => { const w = S.db.works.find(x => x.id === q.workId);
        return `<tr data-id="${q.workId}"><td>${esc(new Date(q.ts).toLocaleString("en-IN"))}</td><td>${w ? esc(cname(w.client) + " – " + w.form + " " + (w.period || "")) : '<span class="muted">(deleted)</span>'}</td><td>${q.type === "delete" ? "Delete" : "Modify"}</td><td>${esc(q.reason)}</td>
        <td><span class="chip ${q.status === "Approved" ? "green" : q.status === "Rejected" ? "red" : "amber"}">${q.status}${q.status === "Approved" && w && w.grant && w.grant.used ? " – used" : ""}</span></td><td>${esc(q.note || "")}</td></tr>`; }).join("")}</tbody></table></div>`;
      $$("#tbl tbody tr").forEach(tr => tr.onclick = () => { if (S.db.works.some(w => w.id === tr.dataset.id)) editRecord("works", tr.dataset.id, viewMyWork); }); return; }
    const [title, rows] = sets[f.show] || sets.open; $("#mwTitle").textContent = title;
    const r = rows.slice().sort((a, b) => (isPinned(b) - isPinned(a)) || (a.due || "9999").localeCompare(b.due || "9999"));
    $("#tbl").innerHTML = tableHTML("mywork", colsFor(COLS.works).filter(c => c.l !== "Done by"), r, false);
    $$("#tbl tbody tr").forEach(tr => tr.onclick = () => editRecord("works", tr.dataset.id, viewMyWork)); };
  $$(".kpi[data-show]").forEach(x => x.onclick = () => { f.show = x.dataset.show; draw(); });
  if ($("#mwAdd")) $("#mwAdd").onclick = () => editRecord("works", null, viewMyWork, { assigned: me });
  draw();
}
function editRights(u) {
  const usr = S.vault.users.find(x => x.u === u); const role = S.db.settings.roles[u] || usr.role;
  const cur = { ...(permsOf(u, role)) };
  const m = openModal(`<div class="mhead"><h3>Rights – ${esc(u)}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <div class="fgrid"><div class="field"><label>Role</label><select id="rgRole">${["Intern", "Staff", "Admin"].map(r => `<option ${r === role ? "selected" : ""}>${r}</option>`).join("")}</select></div>
    <div class="field"><label>Apply preset</label><select id="rgPre"><option value="">—</option><option>Intern</option><option>Staff</option></select></div></div>
    <div id="rgList">${PERMS.map(([k, l, d]) => `<label style="display:flex;gap:10px;align-items:flex-start;padding:7px 0;border-bottom:1px solid #f1f3f6"><input type="checkbox" data-p="${k}" ${cur[k] ? "checked" : ""} style="margin-top:3px"><span><b>${esc(l)}</b>${d ? `<br><span class="small muted">${esc(d)}</span>` : ""}</span></label>`).join("")}</div>
    <p class="small muted">Admin role always has all rights, including settings, backup, users and the activity log.</p></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="rgNo">Cancel</button><button class="btn primary" id="rgYes">Save rights</button></div>`);
  const sync = () => { const adm = $("#rgRole", m).value === "Admin"; $$("#rgList input", m).forEach(x => { x.disabled = adm; if (adm) x.checked = true; }); };
  $("#rgRole", m).onchange = sync; sync();
  $("#rgPre", m).onchange = e => { const p = PRESET[e.target.value]; if (p) $$("#rgList input", m).forEach(x => x.checked = !!p[x.dataset.p]); };
  $("#mx", m).onclick = $("#rgNo", m).onclick = closeModal;
  $("#rgYes", m).onclick = async () => {
    const nr = $("#rgRole", m).value;
    if (role === "Admin" && nr !== "Admin" && Object.entries(S.db.settings.roles).filter(([k, v]) => v === "Admin" && S.vault.users.some(x => x.u === k)).length < 2) return toast("At least one Admin is required");
    const np = {}; $$("#rgList input", m).forEach(x => np[x.dataset.p] = x.checked ? 1 : 0);
    const before = permsOf(u, role); const changes = PERMS.filter(([k]) => !!before[k] !== !!np[k]).map(([k, l]) => (np[k] ? "+ " : "– ") + l);
    S.db.settings.roles[u] = nr; usr.role = nr; S.db.settings.perms = S.db.settings.perms || {}; S.db.settings.perms[u] = np;
    log("Rights", "User", `${u}: role ${nr}${changes.length ? "; " + changes.join(", ") : ""}`); await saveNow(); closeModal(); toast("Rights updated"); viewTeam();
  };
}
function viewTeam() {
  if (!isAdmin()) return go("dashboard");
  setTitle("Team & Rights");
  const st = S.db.settings; st.roles = st.roles || {}; st.disabled = st.disabled || []; st.lastLogin = st.lastLogin || {};
  const t = today(), wk = addDays(t, -7);
  const rows = S.vault.users.map(u => { const role = st.roles[u.u] || u.role; const ws = S.db.works.filter(w => w.assigned === u.u); const op = ws.filter(isOpen);
    return { u: u.u, role, dis: st.disabled.includes(u.u), last: st.lastLogin[u.u], open: op.length, od: op.filter(w => delayInfo(w).overdue).length, rev: ws.filter(w => stg(w.status) === "Under review").length,
      done: ws.filter(w => stg(w.status) === "Filed / Done" && w.filed >= t.slice(0, 8) + "01").length, acts: S.db.log.filter(l => l.user === u.u && l.ts.slice(0, 10) >= wk).length, created: u.created }; });
  const review = S.db.works.filter(w => stg(w.status) === "Under review").sort((a, b) => (a.due || "9").localeCompare(b.due || "9"));
  $("#view").innerHTML = `
    <div class="card"><div style="display:flex;align-items:center"><h3 style="margin:0;flex:1">👤 Users</h3><button class="btn" id="tBulk" style="margin-right:8px">＋ Create 5 intern logins</button><button class="btn primary" id="tAdd">＋ Add intern / staff login</button></div>
      <div class="tablewrap" style="margin-top:12px;border:none"><table class="t teamt"><thead><tr><th>User</th><th>Role</th><th>Login</th><th>Password</th><th>Last login</th><th class="num">Open</th><th class="num">Overdue</th><th class="num">In review</th><th class="num">Done (month)</th><th class="num">Actions (7 days)</th><th></th></tr></thead>
      <tbody>${rows.map(r => `<tr data-u="${esc(r.u)}"><td><div style="display:flex;gap:10px;align-items:center">${avatarHTML(r.u, 32)}<div><b>${esc(uname(r.u))}</b>${r.u === S.user ? ' <span class="chip blue">you</span>' : ""}${uname(r.u) !== r.u ? `<div class="small muted">${esc(r.u)}</div>` : ""}</div></div></td><td><span class="chip ${r.role === "Admin" ? "blue" : r.role === "Intern" ? "amber" : ""}">${esc(r.role)}</span></td>
        <td>${r.dis ? '<span class="chip red">Disabled</span>' : '<span class="chip green">Active</span>'}${(() => { const v = S.vault.users.find(x => x.u === r.u); const at = v && (v.pwAt || v.created); return at ? `<div class="small muted">Password set ${dmy(at.slice(0, 10))}</div>` : ""; })()}</td><td class="pwc" data-pu="${esc(r.u)}"><span class="muted small">…</span></td><td>${r.last ? `${dmy(iso(new Date(r.last)))}<div class="small muted">${new Date(r.last).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })}</div>` : '<span class="muted">never</span>'}</td>
        <td class="num">${r.open || ""}</td><td class="num ${r.od ? "red b" : ""}">${r.od || ""}</td><td class="num">${r.rev || ""}</td><td class="num">${r.done || ""}</td><td class="num">${r.acts || ""}</td>
        <td style="text-align:right;white-space:nowrap"><button type="button" class="btn sm umenu" data-menu="${esc(r.u)}" aria-haspopup="menu" aria-expanded="false">Manage ▾</button></td></tr>`).join("")}</tbody></table></div>
      <p class="small muted" style="margin-bottom:0">Interns log in on this computer with their own user name and password. Everything they add, edit, assign, post or print is recorded in the Activity Log under their name.</p></div>
    ${(S.db.requests || []).some(q => q.status === "Pending") ? `<div class="notice warn" style="margin-top:14px">✋ ${(S.db.requests || []).filter(q => q.status === "Pending").length} change request(s) waiting – <a class="link" id="toAppr">open Approvals</a></div>` : ""}
    ${rulesCardHTML()}
    <div class="card" style="margin-top:14px"><h3>⏳ Work sent for review (${review.length})</h3>${review.length ? `<div class="tablewrap" style="border:none"><table class="t"><thead><tr><th>Client</th><th>Return / work</th><th>Period</th><th>Due</th><th>Done by</th><th>Filed on</th><th>ARN</th><th>Last update</th><th></th></tr></thead><tbody>
      ${review.map(w => { const ln = (w.notes || []).slice(-1)[0]; return `<tr data-id="${w.id}"><td><b>${esc(cname(w.client))}</b></td><td>${esc(w.form)}</td><td>${esc([w.fy, w.period].filter(Boolean).join(" · "))}</td><td>${dmy(w.due)}</td><td>${esc(w.assigned)}</td><td>${dmy(w.filed)}</td><td>${esc(w.arn)}</td>
        <td class="small">${ln ? esc(ln.user + ": " + ln.text.slice(0, 50)) : ""}</td><td style="text-align:right;white-space:normal;min-width:150px"><button class="btn sm primary" data-ok="${w.id}">✓ Approve as done</button> <button class="btn sm" data-back="${w.id}">↩ Send back</button></td></tr>`; }).join("")}</tbody></table></div>` : '<div class="empty">Nothing waiting for review</div>'}</div>`;
  $("#tAdd").onclick = addUserDialog; $("#tBulk").onclick = bulkInterns; bindRules(viewTeam); if ($("#toAppr")) $("#toAppr").onclick = () => go("approvals");
  const teamAct = async (u, a) => {
    if (a === "edit") return editUserDialog(u);
    if (a === "photo") return profileDialog(u);
    if (a === "assign") return editRecord("works", null, viewTeam, { assigned: u, _manualAssign: 1 });
    if (a === "tasks") { S.f.works = { assigned: u, status: "Open (not done)" }; return go("works"); }
    if (a === "log") { S.logf = { user: u }; S.logq = ""; return go("log"); }
    if (a === "rights") return editRights(u);
    if (a === "toggle") { const d = st.disabled; if (d.includes(u)) st.disabled = d.filter(x => x !== u); else { if ((st.roles[u] || "") === "Admin" && rows.filter(r => r.role === "Admin" && !r.dis).length < 2) return toast("At least one active Admin is required"); d.push(u); }
      log("Rights", "User", `${u} ${st.disabled.includes(u) ? "disabled" : "enabled"}`); await saveNow(); return viewTeam(); }
    if (a === "reset") return resetPw(u);
    if (a === "rm") return removeUser(u);
  };
  $$("[data-menu]").forEach(b => b.onclick = e => { e.stopPropagation(); const u = b.dataset.menu, r = rows.find(x => x.u === u); userMenu(b, u, r && r.dis, teamAct); });
  fillPwCells();
  $$("[data-ok]").forEach(b => b.onclick = e => { e.stopPropagation(); const w = S.db.works.find(x => x.id === b.dataset.ok); w.status = "Filed / Done"; if (!w.filed) w.filed = today(); w.reviewer = w.reviewer || S.user;
    (w.notes = w.notes || []).push({ ts: new Date().toISOString(), user: S.user, text: "Approved as done." }); w.updatedBy = S.user; w.updatedAt = new Date().toISOString();
    log("Approved", "Work item", describe("works", w)); save(); toast("Approved"); viewTeam(); });
  $$("[data-back]").forEach(b => b.onclick = e => { e.stopPropagation(); const w = S.db.works.find(x => x.id === b.dataset.back);
    const m = openModal(`<div class="mhead"><h3>Send back – ${esc(w.form)} · ${esc(cname(w.client))}</h3></div><div class="mbody"><div class="field"><label>Reason / instruction for ${esc(w.assigned || "user")}</label><textarea id="sbT"></textarea></div></div><div class="mfoot"><button class="btn" id="sbN">Cancel</button><button class="btn primary" id="sbY">Send back</button></div>`, true);
    $("#sbN", m).onclick = closeModal; $("#sbY", m).onclick = () => { const txt = $("#sbT", m).value.trim() || "Please revise."; w.status = "In progress"; (w.notes = w.notes || []).push({ ts: new Date().toISOString(), user: S.user, text: "Sent back: " + txt });
      log("Sent back", "Work item", `${describe("works", w)}: ${txt.slice(0, 80)}`); save(); closeModal(); toast("Sent back"); viewTeam(); }; });
  $$("tr[data-id]").forEach(tr => tr.onclick = () => editRecord("works", tr.dataset.id, viewTeam));
}
function addUserDialog() {
  const m = openModal(`<div class="mhead"><h3>Add login</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <div class="fgrid"><div class="field"><label class="req">User name</label><input id="nuU" maxlength="40" placeholder="e.g. intern.amit"></div>
      <div class="field"><label>Role</label><select id="nuR"><option>Intern</option><option>Staff</option><option>Admin</option></select></div>
      <div class="field full"><label class="req">Initial password</label><input id="nuP" type="password" autocomplete="new-password"><span class="small muted">Min 10 characters with letters, numbers and a symbol. Tell it to the person privately. Only the Admin can change it later.</span></div></div>
    <p class="small muted">Interns start with limited rights: create and update their own work, add challans and expenses, print. They cannot see fees, other users' work, delete, export or change settings. You can change this with <b>Rights</b>.</p>
    <div class="err" id="nuErr"></div></div>
    <div class="mfoot"><span class="sp"></span><button class="btn" id="nuN">Cancel</button><button class="btn primary" id="nuY">Create login</button></div>`, true);
  $("#mx", m).onclick = $("#nuN", m).onclick = closeModal;
  $("#nuY", m).onclick = async () => { const st = S.db.settings; const u = $("#nuU", m).value.trim().toLowerCase(), r = $("#nuR", m).value, p = $("#nuP", m).value, err = $("#nuErr", m);
    if (!/^[a-z0-9._-]{3,40}$/.test(u)) return err.textContent = "User name: 3–40 letters, numbers, dot, dash or underscore.";
    if (S.vault.users.some(x => x.u === u)) return err.textContent = "That user already exists.";
    if (!pwOk(p)) return err.textContent = "Password: min 10 characters with letters, numbers and a symbol.";
    err.textContent = "Creating…"; S.vault.users.push(await wrapForUser(u, r, p, S.dekRaw));
    st.roles = st.roles || {}; st.roles[u] = r; await afterPwSet(u, p); st.perms = st.perms || {}; if (r !== "Admin") st.perms[u] = { ...PRESET[r] };
    if (!st.staff.includes(u)) st.staff.push(u);
    log("Added", "User", `${u} (${r})`); await saveNow(); closeModal(); toast("Login created"); viewTeam(); };
}
function userMenu(btn, u, dis, act) {
  const open = $(".umenu-pop"); if (open) { open._close(); if (open._for === btn) return; }
  const self = u === S.user, I = [["edit", "Edit details"], ["photo", "Profile photo"], ["assign", "Assign work"], ["tasks", "Open tasks"], ["log", "Activity log"]];
  const J = self ? [] : [["rights", "Rights & permissions"], ["reset", "Set password"], ["toggle", dis ? "Enable login" : "Disable login"]];
  const ic = { edit: "M4 20h4L18.5 9.5a2.1 2.1 0 0 0-4-4L4 16v4Z", assign: "M12 5v14M5 12h14", tasks: "M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01", log: "M12 8v4l3 2M21 12a9 9 0 1 1-9-9 9 9 0 0 1 9 9Z",
    rights: "M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z", photo: "M4 8h3l2-3h6l2 3h3v11H4ZM12 16a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z", reset: "M15 7a4 4 0 1 1-3.5 6L5 19.5V21h3v-2h2v-2h2l1.5-1.5A4 4 0 0 1 15 7Z", toggle: "M18.4 6.6a9 9 0 1 1-12.8 0M12 2v10", rm: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" };
  const item = ([a, l], cls = "") => `<button type="button" role="menuitem" data-ma="${a}" class="${cls}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${ic[a]}"/></svg>${esc(l)}</button>`;
  const m = document.createElement("div"); m.className = "flagmenu umenu-pop"; m.setAttribute("role", "menu"); m._for = btn;
  m.innerHTML = `<div class="umh">${esc(uname(u))}<span>${esc(u)}</span></div>${I.map(x => item(x)).join("")}${J.length ? '<hr>' + J.map(x => item(x)).join("") + '<hr>' + item(["rm", "Remove user"], "danger") : ""}`;
  document.body.appendChild(m); btn.setAttribute("aria-expanded", "true");
  const r = btn.getBoundingClientRect(), h = m.offsetHeight; m.style.left = Math.max(8, r.right - m.offsetWidth) + "px"; m.style.top = (r.bottom + 4 + h > innerHeight - 8 ? Math.max(8, r.top - h - 4) : r.bottom + 4) + "px";
  const close = () => { m.remove(); btn.setAttribute("aria-expanded", "false"); document.removeEventListener("mousedown", out, true); document.removeEventListener("keydown", key, true); $("#view").removeEventListener("scroll", close); };
  const out = e => { if (!m.contains(e.target) && e.target !== btn) close(); };
  const key = e => { const its = $$("[data-ma]", m), i = its.indexOf(document.activeElement);
    if (e.key === "Escape") { close(); btn.focus(); } else if (e.key === "ArrowDown") { e.preventDefault(); its[(i + 1) % its.length].focus(); } else if (e.key === "ArrowUp") { e.preventDefault(); its[(i - 1 + its.length) % its.length].focus(); } };
  m._close = close; document.addEventListener("mousedown", out, true); document.addEventListener("keydown", key, true); $("#view").addEventListener("scroll", close);
  $$("[data-ma]", m).forEach(b => b.onclick = () => { close(); act(u, b.dataset.ma); }); $("[data-ma]", m).focus();
}
async function fillPwCells() {
  const cells = $$(".pwc"); if (!cells.length) return; const book = await pwbRead();
  cells.forEach(td => { const u = td.dataset.pu, rec = book[u];
    if (roleOfU(u) === "Admin") { td.innerHTML = '<span class="muted small">Not shown for Admins</span>'; return; }
    if (!S.ak) { td.innerHTML = '<span class="muted small" title="Ask another Admin to set your password once; after that you can see staff passwords.">Not available for your login</span>'; return; }
    if (!rec) { td.innerHTML = '<span class="muted small" title="Passwords are recorded when the Admin sets them. Use Manage › Set password to record it.">Not recorded</span>'; return; }
    td.innerHTML = `<span class="pwv" style="font-family:Consolas,monospace;letter-spacing:.06em">••••••••</span> <button type="button" class="btn sm ib" data-pws aria-label="Show password" title="Show password"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button><button type="button" class="btn sm ib" data-pwc aria-label="Copy password" title="Copy password"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></button>`;
    $("[data-pws]", td).onclick = () => { const v = $(".pwv", td), on = v.textContent !== rec.p; v.textContent = on ? rec.p : "••••••••"; $("[data-pws]", td).classList.toggle("on", on); $("[data-pws]", td).title = on ? "Hide password" : "Show password"; if (on) setTimeout(() => { if (v.isConnected && v.textContent === rec.p) { v.textContent = "••••••••"; $("[data-pws]", td).classList.remove("on"); } }, 15000); };
    $("[data-pwc]", td).onclick = async () => { try { await navigator.clipboard.writeText(rec.p); toast("Password copied"); } catch { const v = $(".pwv", td); v.textContent = rec.p; toast("Select the password and press Ctrl+C"); } };
    td.title = `Set ${new Date(rec.at).toLocaleString("en-IN")} by ${uname(rec.by)}`; });
}
function resetPw(u) {
  if (!isAdmin()) return toast("Only the Admin can set passwords");
  const usr = S.vault.users.find(x => x.u === u); if (!usr) return;
  const m = openModal(`<div class="mhead"><h3>Set new password – ${esc(uname(u))}</h3><button class="btn sm" id="mx">✕</button></div><div class="mbody">
    <p class="small" style="margin-top:0">User name <b>${esc(u)}</b> · ${esc(usr.role)}. The old password stops working as soon as you save.</p>
    <div class="field"><label class="req" for="rpP">New password</label><div style="display:flex;gap:6px"><input type="text" id="rpP" autocomplete="off" spellcheck="false" style="flex:1;font-family:Consolas,monospace" value="${esc(genPw())}"><button type="button" class="btn" id="rpG" title="Generate another strong password">↻ Generate</button><button type="button" class="btn" id="rpC">Copy</button></div>
      <div class="meter"><i id="rpM"></i></div><span class="small muted">Min 10 characters with letters, numbers and a symbol. A strong one is filled in; you can type your own.</span></div>
    <div class="err" id="rpE"></div></div><div class="mfoot"><span class="sp"></span><button class="btn" id="rpN">Cancel</button><button class="btn primary" id="rpY">Set password</button></div>`, true);
  const inp = $("#rpP", m), upd = () => meter($("#rpM", m), inp.value); upd(); inp.oninput = upd;
  $("#rpG", m).onclick = () => { inp.value = genPw(); upd(); };
  $("#rpC", m).onclick = async () => { try { await navigator.clipboard.writeText(inp.value); toast("Copied"); } catch { inp.select(); toast("Press Ctrl+C to copy"); } };
  $("#mx", m).onclick = $("#rpN", m).onclick = () => { closeModal(); const bk = S.pwBack; S.pwBack = null; if (bk) bk(); };
  $("#rpY", m).onclick = async () => { const p = inp.value; if (!pwOk(p)) return $("#rpE", m).textContent = "Min 10 characters with letters, numbers and a symbol.";
    $("#rpE", m).textContent = "Saving…"; Object.assign(usr, await wrapForUser(u, usr.role, p, S.dekRaw), { pwAt: new Date().toISOString(), pwBy: S.user }); await afterPwSet(u, p);
    log("Edited", "User", "Password set by Admin – " + u); await saveNow();
    $(".mbody", m).innerHTML = `<p>New password for <b>${esc(u)}</b> is saved.</p><div style="font-family:Consolas,monospace;font-size:18px;padding:10px 12px;border:1px dashed var(--line);border-radius:6px;user-select:all">${esc(p)}</div><p class="small muted">Give it to ${esc(uname(u))} privately. It is not shown again.</p>`;
    $(".mfoot", m).innerHTML = '<span class="sp"></span><button class="btn" id="rpC2">Copy</button><button class="btn primary" id="rpOk">Done</button>';
    $("#rpC2", m).onclick = async () => { try { await navigator.clipboard.writeText(p); toast("Copied"); } catch { toast("Select the password and press Ctrl+C"); } };
    $("#rpOk", m).onclick = () => { closeModal(); const bk = S.pwBack; S.pwBack = null; if (bk) bk(); else if (S.route === "team") viewTeam(); }; };
}
async function removeUser(u) {
  const st = S.db.settings; const role = (st.roles || {})[u] || S.vault.users.find(x => x.u === u).role;
  if (role === "Admin" && S.vault.users.filter(x => ((st.roles || {})[x.u] || x.role) === "Admin").length < 2) return toast("At least one Admin is required");
  const open = S.db.works.filter(w => w.assigned === u && isOpen(w)).length;
  if (!(await confirmBox("Remove user", `<p>Remove login <b>${esc(u)}</b>? They will no longer be able to log in.</p>${open ? `<p>${open} open task(s) are assigned to ${esc(u)} – reassign them from the Work Tracker.</p>` : ""}<p class="small muted">Their past activity stays in the log. An old backup file still contains their access – take a fresh backup after removing. Prefer <b>Disable</b> if they may return.</p>`, "Remove"))) return;
  S.vault.users = S.vault.users.filter(x => x.u !== u); if (st.perms) delete st.perms[u]; log("Deleted", "User", u); await pwbSet(u, null); await saveNow(); viewTeam();
}

/* ------------------------------------------------------------------ REPORTS */
const REPORTS = [
  { k: "overdue", l: "Overdue & due-soon work", d: "All open items overdue or due within the chosen days.", p: ["days"] },
  { k: "done", l: "Work completed in a period", d: "Items filed / completed between two dates.", p: ["from", "to", "client", "service"] },
  { k: "pending", l: "Pending work by staff", d: "Open items grouped by the person responsible.", p: ["staff"] },
  { k: "late", l: "Late filings", d: "Items filed after the due date in a period.", p: ["from", "to"] },
  { k: "recv", fee: 1, l: "Receivables – client-wise", d: "Fees outstanding plus reimbursable challans and expenses.", p: [] },
  { k: "billing", fee: 1, l: "Fees billed / received in a period", d: "Professional fees by bill date.", p: ["from", "to", "client"] },
  { k: "chsum", perm: "challans", l: "Challan summary", d: "Challans paid in a period by client and tax type.", p: ["from", "to", "client", "taxtype"] },
  { k: "udin", perm: "udins", l: "UDIN register", d: "UDINs generated in a period.", p: ["from", "to"] },
];
const repOk = r => !(r.fee && !can("viewFees")) && !(r.perm && !can(r.perm));
function viewReports() {
  setTitle("Reports");
  const fy = curFYStart(); const R = S.rep = S.rep || { k: "overdue", days: 7, from: D(fy, 4, 1), to: today() };
  $("#view").innerHTML = `<div class="grid" style="grid-template-columns:260px 1fr;align-items:start">
    <div class="card" style="padding:8px">${REPORTS.filter(repOk).map(r => `<a data-k="${r.k}" style="display:block;padding:9px 10px;border-radius:8px;cursor:pointer;${R.k === r.k ? "background:#eef2fb;font-weight:700;color:#1f2a44" : ""}">${r.l}<div class="small muted" style="font-weight:400">${r.d}</div></a>`).join("")}</div>
    <div><div class="toolbar" id="rp"></div><div id="rout"></div></div></div>`;
  $$("a[data-k]").forEach(a => a.onclick = () => { R.k = a.dataset.k; viewReports(); });
  if (!repOk(REPORTS.find(r => r.k === R.k))) R.k = "overdue";
  const rep = REPORTS.find(r => r.k === R.k);
  const ctl = { days: `<label class="small">Due within <input type="number" id="pdays" value="${R.days}" min="0" style="width:60px"> days</label>`,
    from: `<label class="small">From <input type="date" id="pfrom" value="${R.from}"></label>`, to: `<label class="small">To <input type="date" id="pto" value="${R.to}"></label>`,
    client: `<select id="pclient"><option value="">All clients</option>${filterOpts("client").map(([v, l]) => `<option value="${v}" ${R.client === v ? "selected" : ""}>${esc(l)}</option>`).join("")}</select>`,
    service: `<select id="pservice"><option value="">All services</option>${allSvc().map(s => `<option ${R.service === s ? "selected" : ""}>${esc(s)}</option>`).join("")}</select>`,
    staff: `<select id="pstaff"><option value="">All staff</option>${(S.db.settings.staff || []).map(s => `<option ${R.staff === s ? "selected" : ""}>${esc(s)}</option>`).join("")}</select>`,
    taxtype: `<select id="ptaxtype"><option value="">All tax types</option>${TAXTYPE.map(s => `<option ${R.taxtype === s ? "selected" : ""}>${s}</option>`).join("")}</select>` };
  $("#rp").innerHTML = rep.p.map(p => ctl[p]).join("") + `<span class="sp"></span>${can("print") ? '<button class="btn" id="prBtn">🖨 Print</button>' : ""}${can("export") ? '<button class="btn" id="exBtn">⬇ Excel</button><button class="btn" id="shBtn">↗ Share</button>' : ""}`;
  rep.p.forEach(p => { const el = $("#p" + p); el.onchange = el.oninput = () => { R[p] = el.value; draw(); }; });
  const draw = () => { const o = runReport(R); $("#rout").innerHTML = `<div class="count"><b>${esc(o.title)}</b> · ${esc(o.sub)} · ${o.rows.length} row(s)</div>` + tableHTML("rep_" + R.k, o.cols, o.rows, false); S._rep = o;
    $$("#rout tbody tr[data-id]").forEach(tr => { const w = S.db.works.find(x => x.id === tr.dataset.id); if (w) tr.onclick = () => editRecord("works", w.id, draw); }); };
  if ($("#prBtn")) $("#prBtn").onclick = () => printRows(S._rep.title, S._rep.sub, S._rep.cols, S._rep.rows);
  if ($("#exBtn")) $("#exBtn").onclick = () => exportCSV(S._rep.title, S._rep.cols, S._rep.rows);
  if ($("#shBtn")) $("#shBtn").onclick = () => shareCSV(S._rep.title, S._rep.cols, S._rep.rows);
  draw();
}
function runReport(R) {
  const W = visW(), wc = colsFor(COLS.works).filter(c => c.l !== "Remarks"), inRange = d => d && (!R.from || d >= R.from) && (!R.to || d <= R.to);
  const per = `${dmy(R.from)} to ${dmy(R.to)}`;
  switch (R.k) {
    case "overdue": { const lim = addDays(today(), num(R.days)); const rows = W.filter(w => isOpen(w) && w.due && w.due <= lim).sort((a, b) => a.due.localeCompare(b.due)); return { title: "Overdue & Due-soon Work", sub: `Open items due on or before ${dmy(lim)}`, cols: wc, rows }; }
    case "done": { const rows = W.filter(w => stg(w.status) === "Filed / Done" && inRange(w.filed) && (!R.client || w.client === R.client) && (!R.service || w.service === R.service)).sort((a, b) => a.filed.localeCompare(b.filed)); return { title: "Work Completed", sub: per + (R.client ? " · " + cname(R.client) : "") + (R.service ? " · " + R.service : ""), cols: wc, rows }; }
    case "pending": { const rows = W.filter(w => isOpen(w) && (!R.staff || w.assigned === R.staff)).sort((a, b) => (a.assigned || "~").localeCompare(b.assigned || "~") || (a.due || "9").localeCompare(b.due || "9"));
      const cols = [{ l: "Done by", v: r => `<b>${esc(r.assigned || "(unassigned)")}</b>`, x: r => r.assigned || "(unassigned)" }, ...wc.filter(c => c.l !== "Done by")]; return { title: "Pending Work by Staff", sub: R.staff || "All staff", cols, rows }; }
    case "late": { const rows = W.filter(w => w.filed && w.due && w.filed > w.due && inRange(w.filed)).sort((a, b) => a.filed.localeCompare(b.filed)); return { title: "Late Filings", sub: per, cols: wc, rows }; }
    case "recv": { const rows = vC().map(c => { const fee = W.filter(w => w.client === c.id).reduce((a, w) => a + num(w.fee), 0), rec = W.filter(w => w.client === c.id).reduce((a, w) => a + num(w.received), 0);
        const ch = S.db.challans.filter(x => x.client === c.id).reduce((a, x) => a + Math.max(0, chReimbDue(x)), 0), re = S.db.reimb.filter(x => x.client === c.id).reduce((a, x) => a + Math.max(0, reBal(x)), 0);
        return { id: c.id, c, fee, rec, out: fee - rec, ch, re, tot: fee - rec + ch + re }; }).filter(r => r.fee || r.ch || r.re).sort((a, b) => b.tot - a.tot);
      const cols = [{ l: "Client", v: r => `<b>${esc(r.c.name)}</b>`, x: r => r.c.name }, { l: "Code", v: r => esc(r.c.code), x: r => r.c.code },
        { l: "Fees billed (₹)", v: r => inr(r.fee), num: 1, sum: r => r.fee, x: r => r.fee }, { l: "Received (₹)", v: r => inr(r.rec), num: 1, sum: r => r.rec, x: r => r.rec },
        { l: "Fee outstanding (₹)", v: r => inr(r.out), num: 1, sum: r => r.out, x: r => r.out }, { l: "Challans due (₹)", v: r => inr(r.ch), num: 1, sum: r => r.ch, x: r => r.ch },
        { l: "Expenses due (₹)", v: r => inr(r.re), num: 1, sum: r => r.re, x: r => r.re }, { l: "Total receivable (₹)", v: r => `<b class="${r.tot > 0 ? "red" : ""}">${inr(r.tot)}</b>`, num: 1, sum: r => r.tot, x: r => r.tot }];
      return { title: "Receivables – Client-wise", sub: `As on ${dmy(today())}`, cols, rows }; }
    case "billing": { const rows = W.filter(w => num(w.fee) && inRange(w.billdate || w.filed) && (!R.client || w.client === R.client)).sort((a, b) => (a.billdate || "").localeCompare(b.billdate || ""));
      const cols = [{ l: "Bill date", v: r => dmy(r.billdate), x: r => dmy(r.billdate) }, { l: "Bill no.", v: r => esc(r.billno), x: r => r.billno }, ...COLS.works.filter(c => ["Client", "Return / work", "FY", "Period", "Fee (₹)"].includes(c.l)),
        { l: "Received (₹)", v: r => inr(r.received), num: 1, sum: r => num(r.received), x: r => num(r.received) }, { l: "Received on", v: r => dmy(r.recdate), x: r => dmy(r.recdate) }, COLS.works.find(c => c.l === "Outstanding (₹)")];
      return { title: "Fees Billed / Received", sub: per + (R.client ? " · " + cname(R.client) : ""), cols, rows }; }
    case "chsum": { const rows = vR("challans").filter(x => inRange(x.date) && (!R.client || x.client === R.client) && (!R.taxtype || x.taxtype === R.taxtype)).sort((a, b) => cname(a.client).localeCompare(cname(b.client)) || a.date.localeCompare(b.date)); return { title: "Challan Summary", sub: per + (R.taxtype ? " · " + R.taxtype : ""), cols: COLS.challans, rows }; }
    case "udin": { const rows = vR("udins").filter(x => inRange(x.date)).sort((a, b) => a.date.localeCompare(b.date)); return { title: "UDIN Register", sub: per, cols: COLS.udins, rows }; }
  }
}

/* ------------------------------------------------------------------ ACTIVITY LOG */
function viewLog() {
  if (!isAdmin()) return go("dashboard");
  setTitle("Activity Log");
  const cols = [{ l: "Date & time", v: r => esc(new Date(r.ts).toLocaleString("en-IN")), x: r => new Date(r.ts).toLocaleString("en-IN") }, { l: "User", v: r => esc(r.user), x: r => r.user },
    { l: "Action", v: r => `<span class="chip ${r.action === "Deleted" ? "red" : r.action === "Added" ? "green" : ""}">${esc(r.action)}</span>`, x: r => r.action }, { l: "Record", v: r => esc(r.entity), x: r => r.entity }, { l: "Details", v: r => esc(r.desc), x: r => r.desc }];
  const q = S.logq || ""; const LF = S.logf = S.logf || {};
  const users = [...new Set([...S.vault.users.map(u => u.u), ...S.db.log.map(l => l.user)])].filter(Boolean);
  $("#view").innerHTML = `<div class="toolbar"><input type="search" id="lq" placeholder="Search log…" value="${esc(q)}">
    <select id="lu"><option value="">All users</option>${users.map(u => `<option ${LF.user === u ? "selected" : ""}>${esc(u)}</option>`).join("")}</select>
    <select id="la"><option value="">All actions</option>${[...new Set(S.db.log.map(l => l.action))].sort().map(a => `<option ${LF.action === a ? "selected" : ""}>${esc(a)}</option>`).join("")}</select>
    <input type="date" id="lf" value="${esc(LF.from || "")}"><input type="date" id="lt" value="${esc(LF.to || "")}">
    <span class="sp"></span><button class="btn" id="prBtn">🖨 Print</button><button class="btn" id="exBtn">⬇ Excel</button></div><div id="tbl"></div>`;
  const rows = () => S.db.log.filter(l => (!S.logq || Object.values(l).join(" ").toLowerCase().includes(S.logq.toLowerCase())) && (!LF.user || l.user === LF.user) && (!LF.action || l.action === LF.action)
    && (!LF.from || l.ts.slice(0, 10) >= LF.from) && (!LF.to || l.ts.slice(0, 10) <= LF.to));
  [["#lu", "user"], ["#la", "action"], ["#lf", "from"], ["#lt", "to"]].forEach(([sel, k]) => $(sel).onchange = e => { LF[k] = e.target.value; draw(); });
  const draw = () => { const r = rows(); $("#tbl").innerHTML = `<div class="count">${r.length} entr${r.length === 1 ? "y" : "ies"} (latest 5,000 kept)</div>` + tableHTML("log", cols, r.slice(0, 1000), false); };
  $("#lq").oninput = e => { S.logq = e.target.value; draw(); };
  $("#prBtn").onclick = () => printRows("Activity Log", "Audit trail", cols, rows().slice(0, 1000)); $("#exBtn").onclick = () => exportCSV("Activity Log", cols, rows());
  draw();
}

/* ------------------------------------------------------------------ SETTINGS & SECURITY */
function viewSettings() {
  setTitle("Settings & Security");
  const st = S.db.settings, f = st.firm, A = isAdmin();
  $("#view").innerHTML = `<div class="grid two">
    <div class="card"><h3>Firm details <span class="small muted">(appear on printouts)</span></h3>
      <div class="fgrid">
        <div class="field full"><label>Firm name & logo</label><div style="display:flex;gap:12px;align-items:center"><div class="logo ${f.logo ? "haslogo" : ""}" style="width:44px;height:44px;flex-shrink:0;border-radius:8px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700">${f.logo ? `<img src="${f.logo}" alt="" style="width:100%;height:100%;object-fit:contain">` : esc(firmInitials(f.name))}</div>${A ? '<button type="button" class="btn" id="sFirmLogo">Change name &amp; logo</button>' : ""}</div></div>
        <div class="field full"><label>Firm name</label><input id="sFirm" value="${esc(f.name)}" ${A ? "" : "disabled"}></div>
        <div class="field full"><label>Address</label><input id="sAddr" value="${esc(f.address)}" ${A ? "" : "disabled"}></div>
        <div class="field"><label>Phone</label><input id="sPhone" value="${esc(f.phone)}" ${A ? "" : "disabled"}></div>
        <div class="field"><label>Email</label><input id="sEmail" value="${esc(f.email)}" ${A ? "" : "disabled"}></div>
        <div class="field"><label>FRN</label><input id="sFrn" value="${esc(f.frn)}" ${A ? "" : "disabled"}></div>
        <div class="field"><label>Partner & M. No.</label><input id="sPartner" value="${esc(f.partner)}" ${A ? "" : "disabled"}></div>
        <div class="field full"><label>Staff names (one per line – used in drop-downs)</label><textarea id="sStaff" ${A ? "" : "disabled"}>${esc((st.staff || []).join("\n"))}</textarea></div>
      </div>${A ? '<button class="btn primary" id="sSave">Save firm details</button>' : '<p class="small muted">Only an Admin can change these.</p>'}</div>

    <div class="card"><h3>🔒 Security</h3>
      <div class="field"><label>Interns can freely edit / delete their own new tasks for</label><select id="sWin" ${A ? "" : "disabled"}>${[[15, "15 minutes"], [30, "30 minutes"], [60, "1 hour"], [120, "2 hours"], [240, "4 hours"], [1440, "1 day"]].map(([v, l]) => `<option value="${v}" ${num(st.editWindow || 60) === v ? "selected" : ""}>${l}</option>`).join("")}</select><span class="small muted">After this, a change needs your approval (one change per approval). Applies to users without the "Edit / delete own tasks any time" right.</span></div>
      <div class="field"><label>Auto-lock after inactivity</label><select id="sLock" ${A ? "" : "disabled"}>${[2, 5, 10, 15, 30, 60].map(n => `<option value="${n}" ${num(st.autolock) === n ? "selected" : ""}>${n} minutes</option>`).join("")}</select></div>
      <div class="small" style="line-height:1.7;margin:8px 0 14px">
        ✔ AES-256-GCM encryption of all data at rest<br>✔ Password key derivation: PBKDF2-SHA256, ${ITER.toLocaleString("en-IN")} iterations<br>
        ✔ Data is encrypted in your browser before it is saved anywhere<br>✔ Lock-out after 5 wrong passwords (increasing delay)<br>
        ✔ Role-based access (Admin / Staff) and full activity log<br>✔ Encrypted backups – useless without a password</div>
${A ? `      <h3 style="margin-top:6px">Change my password</h3>
      <div class="field"><label>Current password</label><input type="password" id="cpOld" autocomplete="current-password"></div>
      <div class="field"><label>New password</label><input type="password" id="cpNew" autocomplete="new-password"><div class="meter"><i id="cpMeter"></i></div></div>
      <div class="field"><label>Confirm new password</label><input type="password" id="cpNew2" autocomplete="new-password"></div>
      <div class="err" id="cpErr"></div><button class="btn primary" id="cpBtn">Change password</button>` : `<h3 style="margin-top:6px">Your password</h3><p class="small" style="margin:0">Passwords for staff and interns are set by the Admin. If you need a new password, or have forgotten it, ask the Admin to reset it in Team &amp; Rights.</p>`}</div>

    ${A ? `<div class="card"><h3>👤 Users & rights</h3><p class="small">Add interns / staff, give or take rights, disable logins and see their activity in <b>Team & Rights</b>.</p><button class="btn primary" id="goTeam">Open Team & Rights</button></div>` : ""}

    <div class="card"><h3>👤 My profile</h3><div style="display:flex;gap:14px;align-items:center">${avatarHTML(S.user, 56)}<div><b>${esc(uname(S.user))}</b><div class="small muted">${esc(S.user)} · ${esc(S.role)}</div></div></div><button class="btn" id="myProf" style="margin-top:12px">Edit name and photo</button></div>
    <div class="card"><h3>ℹ About this software</h3><p style="margin:0 0 8px">KSC Practice Manager · <b>${verText()}</b></p><p class="small muted" style="margin-top:0">Each published change gets a new version number. The full list is in What's new.</p><button class="btn" id="aboutCh">What's new</button> ${A ? '<button class="btn" id="aboutVer">Versions &amp; rollback</button>' : ""}</div>
    ${listsCardHTML()}
    ${can("documents") && CL.on ? `<div class="card"><h3>📎 Documents</h3><p class="small" style="margin-top:0">In the online workspace, attached files are encrypted in your browser and stored with this workspace, so every intern can open them from anywhere. Maximum 14 MB per file.</p></div>` : ""}
    ${can("documents") && !CL.on ? `<div class="card"><h3>📁 Documents folder <span class="small muted">(this computer)</span></h3>
      <p class="small" style="margin-top:0">Documents are saved as normal files in a folder you choose – ideally inside OneDrive so every PC gets them. Each computer links <b>its own</b> copy of that folder once (OneDrive paths differ per PC); the app stores only the path <i>inside</i> the folder, so links work on every PC.</p>
      <p class="small">Linked here: ${S.docRoot ? `<b>📁 ${esc(S.docRoot.name)}</b>` : '<span class="red b">not linked on this computer</span>'}</p>
      <button class="btn primary" id="docRootBtn">${S.docRoot ? "Change folder" : "Link documents folder"}</button>
      <p class="small muted">Folder structure created automatically:<br><code>Client code + name › FY › Service › file</code> &nbsp;(client KYC under <code>› KYC & Documents</code>). Files in the folder are ordinary files – not encrypted – so OneDrive and Explorer can open them.</p></div>` : ""}
    ${A ? `<div class="card"><h3>💾 Backup & data</h3>
      ${CL.on ? `<p class="small" style="margin-top:0">🌐 <b>Online workspace.</b> Data is encrypted in your browser before it is stored online and syncs live to everyone you've shared this page with. Online records used: <b>${CL.last.size.toLocaleString("en-IN")}</b> of 25,000. Download a backup regularly as well.</p>` : ""}
      <p class="small" style="margin-top:0" ${CL.on ? "hidden" : ""}>Data lives inside this browser on this computer. <b>Take a backup at least weekly</b> and keep it on a pen drive / cloud folder – clearing browser data would otherwise erase it. Backups stay encrypted.</p>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        <button class="btn primary" id="bkDown">⬇ Download encrypted backup</button><button class="btn" id="bkRest">⬆ Restore backup</button>
        ${CL.on ? "" : `<button class="btn" id="bkLink">🔗 ${S.fileHandle ? "Change" : "Link"} auto-save file</button>${S.fileHandle ? '<button class="btn" id="bkUnlink">Unlink</button>' : ""}`}
        <button class="btn" id="bkXls">⬇ Export everything to Excel</button></div>
      <p class="small muted">${S.fileHandle ? `Auto-saving an encrypted copy to <b>${esc(S.fileHandle.name)}</b> on every change.` : "Auto-save file: pick a file in a OneDrive / Google Drive / pen-drive folder and an encrypted copy is written on every change (Chrome / Edge)."}</p>
      <p class="small muted">Last saved: ${S.vault.updated ? new Date(S.vault.updated).toLocaleString("en-IN") : "-"} · Records: ${vC().length} clients, ${S.db.works.length} work items, ${S.db.challans.length} challans, ${S.db.reimb.length} expenses, ${S.db.udins.length} UDINs</p>
      <h3 style="margin-top:16px;color:var(--red)">Danger zone</h3><button class="btn danger" id="wipe">${CL.on ? "Erase online workspace" : "Erase all data on this computer"}</button></div>` : ""}
  </div>`;
  if (A) {
    $("#sSave").onclick = () => { Object.assign(f, { name: $("#sFirm").value.trim() || f.name, address: $("#sAddr").value.trim(), phone: $("#sPhone").value.trim(), email: $("#sEmail").value.trim(), frn: $("#sFrn").value.trim(), partner: $("#sPartner").value.trim() });
      st.staff = [...new Set($("#sStaff").value.split("\n").map(s => s.trim()).filter(Boolean))]; S.vault.firm = f.name; log("Edited", "Settings", "Firm details"); save(); enterApp(); go("settings"); toast("Saved"); };
    $("#sWin").onchange = e => { st.editWindow = num(e.target.value); log("Edited", "Settings", "Intern edit window " + st.editWindow + " min"); save(); toast("Edit window updated"); };
    $("#sLock").onchange = e => { st.autolock = num(e.target.value); log("Edited", "Settings", "Auto-lock " + st.autolock + " min"); save(); toast("Auto-lock updated"); };
    $("#goTeam").onclick = () => go("team");
    $("#bkDown").onclick = async () => { await saveNow(); const bv = CL.on ? { app: "KSC-PM", v: 1, firm: S.vault.firm, logo: S.vault.logo || "", users: S.vault.users, data: await aesEnc(S.dek, enc.encode(JSON.stringify(S.db))), updated: new Date().toISOString() } : S.vault;
      download(`PracticeManager_Backup_${today()}.${CL.on ? "json" : "kscbak"}`, JSON.stringify(bv), "application/json"); log("Backup", "System", "Encrypted backup downloaded"); save(); toast("Encrypted backup downloaded"); };
    $("#bkRest").onclick = pickRestore;
    if ($("#bkLink")) $("#bkLink").onclick = async () => { if (!window.showSaveFilePicker) return alertBox("Not supported", "Auto-save files need Google Chrome or Microsoft Edge. Use <b>Download encrypted backup</b> instead.");
      try { const h = await window.showSaveFilePicker({ suggestedName: "PracticeManager_Data.kscbak", types: [{ description: "Practice Manager encrypted data", accept: { "application/json": [".kscbak"] } }] });
        S.fileHandle = h; await IDB.put("filehandle", h); await saveNow(); log("Edited", "Settings", "Auto-save file linked"); viewSettings(); toast("Auto-save file linked"); } catch (e) { if (e.name !== "AbortError") alertBox("Could not link file", esc(e.message)); } };
    if ($("#bkUnlink")) $("#bkUnlink").onclick = async () => { S.fileHandle = null; await IDB.del("filehandle"); viewSettings(); };
    $("#bkXls").onclick = async () => { if (await confirmBox("Unencrypted export", "<p>The Excel file will <b>not be encrypted</b>. Store it securely and delete it when no longer needed.</p>", "Export", false)) exportAllExcel(); };
    $("#wipe").onclick = async () => {
      const m = openModal(`<div class="mhead"><h3>Erase all data</h3></div><div class="mbody"><p>This permanently deletes all clients, work, challans and users stored in this browser. Make sure you have a backup.</p><div class="field"><label>Type ERASE to confirm</label><input id="wTxt"></div></div><div class="mfoot"><button class="btn" id="wNo">Cancel</button><button class="btn danger" id="wYes">Erase everything</button></div>`, true);
      $("#wNo", m).onclick = closeModal; $("#wYes", m).onclick = async () => { if ($("#wTxt", m).value !== "ERASE") return;
        if (CL.on) { $("#wYes", m).disabled = true; $("#wYes", m).textContent = "Erasing…"; await cloudErase(); closeModal(); S.vault = null; S.db = null; showAuth(); return; }
        await IDB.del("vault"); await IDB.del("filehandle"); S.vault = null; S.db = null; S.fileHandle = null; closeModal(); showAuth(); };
    };
  }
  const tmp = document.createElement("input");
  $("#lsAddF").onclick = () => { addListItem("form", tmp); setTimeout(() => { const obs = setInterval(() => { if (!document.getElementById("alF")) { clearInterval(obs); viewSettings(); } }, 300); }, 100); };
  $("#lsAddS").onclick = () => { addListItem("service", tmp); setTimeout(() => { const obs = setInterval(() => { if (!document.getElementById("alF")) { clearInterval(obs); viewSettings(); } }, 300); }, 100); };
  if ($("#stAdd")) $("#stAdd").onclick = () => statusDialog(null, null, viewSettings);
  $$("[data-sted]").forEach(b => b.onclick = () => statusDialog(custSt()[+b.dataset.sted], null, viewSettings));
  $$("[data-ststd]").forEach(b => b.onclick = () => stdStatusDialog(b.dataset.ststd, viewSettings));
  $$("[data-stc]").forEach(b => b.onclick = e => { e.stopPropagation(); colorPop(b, b.dataset.stc, () => viewSettings()); });
  $$("[data-strm]").forEach(b => b.onclick = async () => { const x = custSt()[+b.dataset.strm], ws = S.db.works.filter(w => w.status === x.name);
    if (!(await confirmBox("Remove status", `<p>Remove the status <b>${esc(x.name)}</b>?</p>${ws.length ? `<p><b>${ws.length}</b> task(s) have this status. They will be changed to <b>${esc(x.stage)}</b>.</p>` : ""}`, "Remove"))) return;
    const now = new Date().toISOString(); ws.forEach(w => { w.status = x.stage; w.updatedBy = S.user; w.updatedAt = now; });
    S.db.settings.statuses = custSt().filter(y => y !== x); log("Deleted", "Status", `${x.name}${ws.length ? ` – ${ws.length} task(s) moved to ${x.stage}` : ""}`); save(); viewSettings(); });
  $$("[data-rmlist]").forEach(a => a.onclick = async () => { const k = a.dataset.rmlist, i = +a.dataset.i, v = S.db.settings[k][i];
    if (!(await confirmBox("Remove from list", `<p>Remove <b>${esc(v)}</b> from the drop-down list? Existing work items keep their value.</p>`, "Remove"))) return;
    S.db.settings[k].splice(i, 1); log("Deleted", k === "customForms" ? "Task type" : "Service", v); save(); viewSettings(); });
  if ($("#aboutCh")) $("#aboutCh").onclick = showChanges; if ($("#aboutVer")) $("#aboutVer").onclick = () => window.kscVersions && window.kscVersions(); if ($("#sFirmLogo")) $("#sFirmLogo").onclick = firmDialog; if ($("#myProf")) $("#myProf").onclick = () => profileDialog(S.user);
  if ($("#docRootBtn") && !CL.on) $("#docRootBtn").onclick = async () => { if (await linkDocRoot()) viewSettings(); };
  if ($("#cpNew")) $("#cpNew").oninput = e => meter($("#cpMeter"), e.target.value);
  if ($("#cpBtn")) $("#cpBtn").onclick = async () => { if (!isAdmin()) return; const err = $("#cpErr"), o = $("#cpOld").value, n = $("#cpNew").value, n2 = $("#cpNew2").value; const usr = S.vault.users.find(x => x.u === S.user);
    try { const kek = await deriveKEK(o, unb64(usr.salt), usr.iter || ITER); await aesDec(kek, { iv: usr.wiv, ct: usr.wct }); } catch { return err.textContent = "Current password is incorrect."; }
    if (!pwOk(n)) return err.textContent = "New password: min 10 characters with letters, numbers and a symbol."; if (n !== n2) return err.textContent = "New passwords do not match.";
    err.textContent = "Updating…"; const nu = await wrapForUser(S.user, usr.role, n, S.dekRaw); Object.assign(usr, nu); await akWrapFor(usr, n); log("Edited", "User", "Password changed – " + S.user); await saveNow();
    $("#cpOld").value = $("#cpNew").value = $("#cpNew2").value = ""; err.textContent = ""; toast("Password changed. Download a fresh backup."); };
}
function drawUsers() {
  $("#uList").innerHTML = `<table class="t"><thead><tr><th>User</th><th>Role</th><th>Created</th><th></th></tr></thead><tbody>${S.vault.users.map(u => `<tr><td><b>${esc(u.u)}</b>${u.u === S.user ? ' <span class="chip blue">you</span>' : ""}</td><td>${esc(u.role)}</td><td>${dmy((u.created || "").slice(0, 10))}</td>
    <td style="text-align:right">${u.u !== S.user ? `<button class="btn sm" data-reset="${esc(u.u)}">Reset password</button> <button class="btn sm danger" data-rm="${esc(u.u)}">Remove</button>` : ""}</td></tr>`).join("")}</tbody></table>`;
  $$("[data-rm]").forEach(b => b.onclick = async () => { const u = b.dataset.rm; const usr = S.vault.users.find(x => x.u === u);
    if (usr.role === "Admin" && S.vault.users.filter(x => x.role === "Admin").length < 2) return toast("At least one Admin is required");
    if (!(await confirmBox("Remove user", `<p>Remove user <b>${esc(u)}</b>? They will no longer be able to log in on this computer.</p><p class="small muted">Note: an old backup file still contains their access – take a fresh backup after removing.</p>`, "Remove"))) return;
    S.vault.users = S.vault.users.filter(x => x.u !== u); log("Deleted", "User", u); await saveNow(); viewSettings(); });
  $$("[data-reset]").forEach(b => b.onclick = () => resetPw(b.dataset.reset));
}
function exportAllExcel() {
  if (CL.on) { const full = ent => ENT[ent].fields.map(fd => ({ l: fd.l, x: r => fd.t === "client" ? cname(r[fd.k]) : fd.t === "multi" ? (r[fd.k] || []).join(", ") : fd.t === "date" ? dmy(r[fd.k]) : (r[fd.k] ?? "") }));
    const parts = [["Clients", "clients"], ["Work", "works"], ["Challans", "challans"], ["Reimbursements", "reimb"], ["UDIN", "udins"]];
    const m = openModal(`<div class="mhead"><h3>Export everything</h3></div><div class="mbody"><p class="small">Download each register as a CSV file (opens in Excel). These files are not encrypted.</p>${parts.map(([l, e]) => `<button class="btn" data-ex="${e}" style="margin:4px">⬇ ${l} (${S.db[e].length})</button>`).join("")}</div><div class="mfoot"><button class="btn primary" id="exX">Done</button></div>`, true);
    $("#exX", m).onclick = closeModal; $$("[data-ex]", m).forEach(b => b.onclick = () => { const e = b.dataset.ex; download(`PracticeManager_${e}_${today()}.csv`, rowsCSV(ENT[e].title, full(e), S.db[e]), "text/csv"); log("Exported", "System", e + " (unencrypted CSV)"); save(); }); return; }
  // SpreadsheetML 2003 – opens in Excel with one sheet per register
  const x = s => String(s ?? "").replace(/[<>&"]/g, c => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" }[c]));
  const sheet = (name, cols, rows) => `<Worksheet ss:Name="${x(name)}"><Table><Row>${cols.map(c => `<Cell ss:StyleID="h"><Data ss:Type="String">${x(c.l)}</Data></Cell>`).join("")}</Row>${rows.map(r => `<Row>${cols.map(c => { const v = c.x(r); return typeof v === "number" ? `<Cell><Data ss:Type="Number">${v}</Data></Cell>` : `<Cell><Data ss:Type="String">${x(v)}</Data></Cell>`; }).join("")}</Row>`).join("")}</Table></Worksheet>`;
  const full = ent => ENT[ent].fields.map(fd => ({ l: fd.l, x: r => fd.t === "client" ? cname(r[fd.k]) : fd.t === "multi" ? (r[fd.k] || []).join(", ") : fd.t === "number" ? (r[fd.k] === "" || r[fd.k] == null ? "" : num(r[fd.k])) : fd.t === "date" ? dmy(r[fd.k]) : (r[fd.k] ?? "") }));
  const xml = `<?xml version="1.0"?><?mso-application progid="Excel.Sheet"?><Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"><Styles><Style ss:ID="h"><Font ss:Bold="1"/><Interior ss:Color="#D9E1F2" ss:Pattern="Solid"/></Style></Styles>
    ${sheet("Clients", full("clients"), vC())}${sheet("Work Tracker", full("works"), isAdmin() ? S.db.works : visW())}${sheet("Challans", full("challans"), vR("challans"))}${sheet("Reimbursements", full("reimb"), vR("reimb"))}${sheet("UDIN", full("udins"), vR("udins"))}</Workbook>`;
  download(`PracticeManager_AllData_${today()}.xls`, xml, "application/vnd.ms-excel"); log("Exported", "System", "All data to Excel (unencrypted)"); save();
}

/* ------------------------------------------------------------------ start */
window.addEventListener("beforeunload", () => { if (S.db) saveNow(); });
window.addEventListener("afterprint", () => { $("#printArea").innerHTML = ""; });
boot().catch(e => { document.body.innerHTML = `<p style="padding:40px">Could not start: ${esc(e.message)}</p>`; });
</script>
<style id="kvCSS">
.kv-ov{position:fixed;inset:0;background:rgba(13,26,38,.5);z-index:200;display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto;font-family:"IBM Plex Sans","Segoe UI",Arial,sans-serif;color:#0D1A26}
.kv-box{background:#fff;border-radius:8px;width:100%;max-width:640px;box-shadow:0 24px 60px rgba(0,0,0,.3)}
.kv-h{display:flex;align-items:center;gap:8px;padding:14px 18px;border-bottom:2px solid #0D1A26}.kv-h b{flex:1;font-size:16px}
.kv-b{padding:6px 18px 14px;max-height:calc(100vh - 200px);overflow:auto}
.kv-row{display:flex;gap:12px;align-items:flex-start;padding:12px 0;border-top:1px solid #E1E7E4}.kv-row:first-child{border-top:none}
.kv-row .kv-t{flex:1;min-width:0}.kv-row ul{margin:4px 0 0;padding-left:18px;font-size:12.5px;color:#4B5A62}
.kv-chip{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:10px;background:#E4F2E6;color:#2E7D32;margin-left:6px}
.kv-btn{border:1px solid #B9C7C2;background:#fff;border-radius:4px;padding:6px 12px;cursor:pointer;font-weight:600;font-size:12.5px;font-family:inherit;color:#0D1A26;white-space:nowrap}.kv-btn:hover{background:#EEF3F1}
.kv-btn.p{background:#0A6B4C;border-color:#0A6B4C;color:#fff}.kv-btn.p:hover{background:#085A40}.kv-btn:disabled{opacity:.5;cursor:default}
.kv-m{font-size:12.5px;color:#4B5A62}.kv-e{color:#B3261E;font-size:13px;margin-top:8px}.kv-w{background:#FFF6E5;border:1px solid #F1D29A;border-radius:6px;padding:10px 12px;font-size:13px;margin:10px 0}
#kvSide{display:block;margin-top:6px;background:none;border:none;padding:0;cursor:pointer;color:#9fb0cf;font-size:11px;text-decoration:underline}
</style>
<script id="kvMod">
(() => {
  if (window.kscVersions) return;
  const CUR = window.__KSC_VER || (typeof RELEASE !== "undefined" ? RELEASE.v : "");
  const online = () => !!(window.claude && typeof window.claude.use === "function");
  const isAdm = () => { try { return typeof S !== "undefined" && S && S.role === "Admin"; } catch (e) { return false; } };
  const h = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const fmt = at => { if (!at) return ""; const p = String(at).split("T"), d = p[0].split("-").reverse().join("-"); if (!p[1]) return d; const hh = +p[1].slice(0, 2), mm = p[1].slice(3, 5); return `${d}, ${(hh % 12) || 12}:${mm} ${hh < 12 ? "am" : "pm"} IST`; };
  const cmp = (a, b) => { const x = String(a).split(".").map(Number), y = String(b).split(".").map(Number); for (let i = 0; i < Math.max(x.length, y.length); i++) { const d = (x[i] || 0) - (y[i] || 0); if (d) return d; } return 0; };
  async function list() { const db = await window.claude.use("db"); if (!db) throw new Error("The online workspace is not available."); const s = await db.doc("pmver/list").get(); const v = s.exists ? (s.data().versions || []) : []; return v.slice().sort((a, b) => cmp(b.v, a.v)); }
  function open() {
    const ov = document.createElement("div"); ov.className = "kv-ov"; ov.setAttribute("role", "dialog"); ov.setAttribute("aria-label", "Versions");
    ov.innerHTML = `<div class="kv-box"><div class="kv-h"><b>Versions</b><button class="kv-btn" id="kvX">Close</button></div><div class="kv-b" id="kvB"><p class="kv-m">Loading versions…</p></div></div>`;
    document.body.appendChild(ov); const close = () => ov.remove(); ov.querySelector("#kvX").onclick = close; ov.addEventListener("mousedown", e => { if (e.target === ov) close(); });
    const B = ov.querySelector("#kvB");
    if (!online()) { B.innerHTML = `<p>Switching versions works in the online app only. In a downloaded copy, open the file of the version you want instead.</p>`; return; }
    list().then(vs => {
      if (!vs.length) { B.innerHTML = `<p>No saved versions yet.</p>`; return; }
      B.innerHTML = `<p class="kv-m" style="margin:8px 0 4px">You are using <b>version ${h(CUR || "?")}</b>. ${isAdm() ? "Choose a version to switch the app to it for everyone in the firm. Your data is not changed." : "Only the Admin can switch versions."}</p>` +
        vs.map(x => `<div class="kv-row"><div class="kv-t"><b>Version ${h(x.v)}</b>${x.v === CUR ? '<span class="kv-chip">in use</span>' : ""}<div class="kv-m">${h(fmt(x.at))}</div><ul>${(x.notes || []).map(n => `<li>${h(n)}</li>`).join("")}</ul></div>
          ${isAdm() && x.v !== CUR && x.asset ? `<button class="kv-btn" data-kv="${h(x.v)}">Use this version</button>` : ""}</div>`).join("");
      B.querySelectorAll("[data-kv]").forEach(btn => btn.onclick = () => confirmSwitch(vs.find(x => x.v === btn.dataset.kv), B, close));
    }).catch(e => { B.innerHTML = `<p class="kv-e">Could not load the versions: ${h(e && (e.message || e.code) || e)}</p>`; });
  }
  function confirmSwitch(x, B, close) {
    const older = cmp(x.v, CUR) < 0;
    B.innerHTML = `<p style="margin-top:10px">Switch the app to <b>version ${h(x.v)}</b> (${h(fmt(x.at))})?</p>
      <div class="kv-w">Everyone using Practice Manager will move to this version; open screens reload by themselves. Your clients, tasks, bills and settings stay as they are.${older ? " Features added after this version will not be available until you switch back. You can switch back at any time from this same list." : ""}</div>
      <p class="kv-m">Tip: download a backup first (Settings › Backup).</p><div class="kv-e" id="kvE"></div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px"><button class="kv-btn" id="kvN">Back</button><button class="kv-btn p" id="kvY">Switch to ${h(x.v)}</button></div>`;
    B.querySelector("#kvN").onclick = () => { close(); open(); };
    B.querySelector("#kvY").onclick = async () => { const y = B.querySelector("#kvY"), E = B.querySelector("#kvE"); y.disabled = true; y.textContent = "Switching…"; E.textContent = "";
      try {
        if (!isAdm()) throw { code: "not_admin" };
        const art = await window.claude.use("artifact"); if (!art) throw { code: "unavailable" };
        const r = await fetch("/_blob/" + x.asset); if (!r.ok) throw { code: "missing" }; const html = await r.text();
        if (!/^<!doctype html>/i.test(html) || html.length < 50000) throw { code: "missing" };
        try { if (typeof saveNow === "function") await saveNow(); } catch (e) {}
        try { if (typeof log === "function" && typeof S !== "undefined" && S.db) { log("Edited", "System", `Software switched from version ${CUR} to ${x.v}`); if (typeof saveNow === "function") await saveNow(); } } catch (e) {}
        await art.publish(html); y.textContent = "Done – reloading…";
      } catch (e) { y.disabled = false; y.textContent = "Switch to " + x.v; const c = e && e.code;
        E.textContent = c === "not_writer" || c === "not_granted" ? "Your Claude account can view this app but not change it. The owner of the app must switch versions."
          : c === "conflict" ? "The app was changed a moment ago. The page is reloading; try again after it opens."
          : c === "missing" ? "This version's file could not be loaded. Ask Claude to restore it."
          : c === "unavailable" ? "Switching versions is not available in this view." : c === "not_admin" ? "Only the Admin can switch versions."
          : "Could not switch: " + ((e && (e.message || e.code)) || e); }
    };
  }
  window.kscVersions = open;
  setInterval(() => { const who = document.querySelector("#side .who"); if (!who) return; const b = document.getElementById("kvSide"), want = online() && isAdm();
    if (want && !b) { const x = document.createElement("button"); x.type = "button"; x.id = "kvSide"; x.textContent = "Versions & rollback"; x.onclick = open; who.appendChild(x); } else if (!want && b) b.remove(); }, 1000);
})();
</script>

</body></html>
