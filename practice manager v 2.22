    { k: "pan", l: "PAN", upper: 1, ph: "AAAAA9999A" }, { k: "tan", l: "TAN", upper: 1 }, { k: "cin", l: "CIN / LLPIN", upper: 1 },
    { k: "contact", l: "Contact person" }, { k: "mobile", l: "Mobile" }, { k: "email", l: "Email" }, { k: "group", l: "Group / family" },
    { k: "gstins", l: "GST registrations (GSTIN)", t: "gstlist", full: 1 },
    { k: "manager", l: "Handled by", t: "staff" }, { k: "fee", l: "Annual fee agreed (₹)", t: "number", fee: 1 },
    { k: "adminOnly", l: "Admin only? (Yes = hidden from staff & interns)", t: "select", o: ["No", "Yes"], def: "No", adm: 1, full: 1 },
    { k: "services", l: "Services covered", t: "multi", o: allSvc, full: 1 }, { k: "address", l: "Address", t: "textarea", full: 1 }, { k: "remarks", l: "Remarks", t: "textarea", full: 1 }] },
  works: { title: "Work Tracker", one: "Work item", icon: "📋", fields: [
    { k: "client", l: "Client", t: "client", req: 1, full: 1 }, { k: "gstin", l: "GSTIN (this client has more than one)", t: "gstsel", full: 1 },
    { k: "assigned", l: "Assign to (done by)", t: "staff" }, { k: "reviewer", l: "Reviewer (approval always goes to Admin)", t: "staff", def: () => firstAdmin() },
    { k: "service", l: "Service", t: "select", o: allSvc, req: 1, addNew: "service" }, { k: "form", l: "Return / form / task", t: "combo", o: allForms, req: 1, addNew: "form", ph: "Pick from list or type any new task" },
    { k: "fy", l: "Financial year", t: "select", o: FYS, def: () => fyLabel(curFYStart()) }, { k: "period", l: "Period", t: "select", o: PERIODS },
    { k: "due", l: "Due date", t: "date" }, { k: "filed", l: "Date filed / completed", t: "date" },
    { k: "status", l: "Status", t: "select", o: () => allStatus(), def: "Not started", addNew: "status" }, { k: "priority", l: "Priority", t: "select", o: PRIORITY, def: "Normal" },
    { k: "arn", l: "ARN / Ack. / SRN no." }, { k: "udinReq", l: "UDIN applicable?", t: "select", o: ["No", "Yes"], def: "No" },
    { k: "udin", l: "UDIN", upper: 1, ph: "18-character UDIN" }, { k: "udinDate", l: "UDIN date", t: "date" },
    { k: "fee", l: "Professional fee (₹)", t: "number", fee: 1 }, { k: "billno", l: "Bill no.", fee: 1 }, { k: "billdate", l: "Bill date", t: "date", fee: 1 },
    { k: "received", l: "Fee received (₹)", t: "number", fee: 1 }, { k: "recdate", l: "Received on", t: "date", fee: 1 }, { k: "remarks", l: "Remarks", t: "textarea", full: 1 }] },
  challans: { title: "Challans", one: "Challan", icon: "🧾", fields: [
    { k: "date", l: "Payment date", t: "date", req: 1, def: today }, { k: "client", l: "Client", t: "client", req: 1 },
    { k: "taxtype", l: "Tax type", t: "select", o: TAXTYPE, req: 1 }, { k: "head", l: "Head", t: "select", o: HEAD, def: "Tax" },
    { k: "fy", l: "Financial year", t: "select", o: FYS, def: () => fyLabel(curFYStart()) }, { k: "period", l: "Period", t: "select", o: PERIODS },
    { k: "cpin", l: "Challan / CPIN / SRN no." }, { k: "cin", l: "CIN / BSR code" }, { k: "serial", l: "Challan serial no." }, { k: "bank", l: "Bank" },
    { k: "mode", l: "Mode", t: "select", o: MODE }, { k: "amount", l: "Amount (₹)", t: "number", req: 1 }, { k: "paidby", l: "Paid by", t: "select", o: PAIDBY, def: "Client" },
    { k: "recovered", l: "Recovered from client (₹)", t: "number", hint: "Only if paid by firm" }, { k: "work", l: "Linked return / work", t: "combo", o: allForms }, { k: "remarks", l: "Remarks", t: "textarea", full: 1 }] },
  reimb: { title: "Reimbursements", one: "Expense", icon: "💼", fields: [
